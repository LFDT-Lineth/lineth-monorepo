{
  "name": "besu-plugin-options-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Generate Linea-Besu plugin CLI option MDX partials from Java @Option sources. Standalone pnpm project — not a workspace package.",
  "scripts": {
    "generate": "node generate.js",
    "generate:seed-wrapper": "node generate.js --seed-wrapper",
    "check": "node check.js",
    "test": "node --test lib.test.js",
    "prettier:check": "prettier --check \"*.js\" \"output/**/*.mdx\" \"templates/**/*.mdx\" \"output/**/*.json\""
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.9.0"
  },
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "prettier": "3.8.4"
  }
}
