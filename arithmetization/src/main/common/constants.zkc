include "type.zkc"

// Sign extension / arithmetic helpers
const MAX_UINT_64:u64 = 0xffffffffffffffff
const MAX_UINT_64_AS_U128:u128 = 0xffffffffffffffff
const MAX_UINT_32:u32 = 0xffffffff
const MAX_UINT_32_AS_U64:u64 = 0xffffffff

const OVERFLOW_DIVIDEND:u64 = 0x8000000000000000
const NEGATIVE_ONE_AS_I64:u64 = 0xffffffffffffffff
const MASK_64_ERASE_LAST_BIT:u64 = 0xfffffffffffffffe

// Syscalls
const EXIT_SYSCALL:DoubleWord = 93
const WRITE_SYSCALL:DoubleWord = 64

// =======================
// Predecoding operations
// =======================
//
// ComputeOp values are dense: 0 = NO_OP, 1..69 = semantic ops,
// 255 = COMPUTE_INVALID. Ranges: I 1-24, R 25-55, S 56-59, B 60-65, J 66-67, U 68-69.

// I-type ops (writeback variants only; rd=x0 inert paths use NO_OP)
const READ8_SGN_WB:ComputeOp = 1
const READ16_SGN_WB:ComputeOp = 2
const READ32_SGN_WB:ComputeOp = 3
const READ64_WB:ComputeOp = 4
const READ8_ZEXT_WB:ComputeOp = 5
const READ16_ZEXT_WB:ComputeOp = 6
const READ32_ZEXT_WB:ComputeOp = 7
const OP_ADDI_WB:ComputeOp = 8
const OP_SLTI_WB:ComputeOp = 9
const OP_SLTIU_WB:ComputeOp = 10
const OP_XORI_WB:ComputeOp = 11
const OP_ORI_WB:ComputeOp = 12
const OP_ANDI_WB:ComputeOp = 13
const OP_SLLI_WB:ComputeOp = 14
const OP_SRLI_WB:ComputeOp = 15
const OP_SRAI_WB:ComputeOp = 16
const OP_ADDIW_WB:ComputeOp = 17
const OP_SLLIW_WB:ComputeOp = 18
const OP_SRLIW_WB:ComputeOp = 19
const OP_SRAIW_WB:ComputeOp = 20
const ITYPE_JALR:ComputeOp = 21
const ITYPE_JALR_WB:ComputeOp = 22
const ITYPE_ECALL:ComputeOp = 23
const ITYPE_EBREAK:ComputeOp = 24

// R-type ops (writeback variants only; rd=x0 inert paths use NO_OP)
const RTYPE_ADD_WB:ComputeOp = 25
const RTYPE_SUB_WB:ComputeOp = 26
const RTYPE_SLL_WB:ComputeOp = 27
const RTYPE_SLT_WB:ComputeOp = 28
const RTYPE_SLTU_WB:ComputeOp = 29
const RTYPE_XOR_WB:ComputeOp = 30
const RTYPE_SRL_WB:ComputeOp = 31
const RTYPE_SRA_WB:ComputeOp = 32
const RTYPE_OR_WB:ComputeOp = 33
const RTYPE_AND_WB:ComputeOp = 34
const RTYPE_MUL_WB:ComputeOp = 35
const RTYPE_MULH_WB:ComputeOp = 36
const RTYPE_MULHSU_WB:ComputeOp = 37
const RTYPE_MULHU_WB:ComputeOp = 38
const RTYPE_DIV_WB:ComputeOp = 39
const RTYPE_DIVU_WB:ComputeOp = 40
const RTYPE_REM_WB:ComputeOp = 41
const RTYPE_REMU_WB:ComputeOp = 42
const RTYPE_ADDW_WB:ComputeOp = 43
const RTYPE_SUBW_WB:ComputeOp = 44
const RTYPE_SLLW_WB:ComputeOp = 45
const RTYPE_SRLW_WB:ComputeOp = 46
const RTYPE_SRAW_WB:ComputeOp = 47
const RTYPE_MULW_WB:ComputeOp = 48
const RTYPE_DIVW_WB:ComputeOp = 49
const RTYPE_DIVUW_WB:ComputeOp = 50
const RTYPE_REMW_WB:ComputeOp = 51
const RTYPE_REMUW_WB:ComputeOp = 52
const RTYPE_KECCAK:ComputeOp = 53
const RTYPE_POSEIDON2:ComputeOp = 54
const RTYPE_WRITE_OUTPUT:ComputeOp = 55

// S-type ops
const STYPE_STORE8:ComputeOp = 56
const STYPE_STORE16:ComputeOp = 57
const STYPE_STORE32:ComputeOp = 58
const STYPE_STORE64:ComputeOp = 59

// B-type ops
const BRANCH_BEQ:ComputeOp = 60
const BRANCH_BNE:ComputeOp = 61
const BRANCH_BLT:ComputeOp = 62
const BRANCH_BGE:ComputeOp = 63
const BRANCH_BLTU:ComputeOp = 64
const BRANCH_BGEU:ComputeOp = 65

// J-type ops
const JTYPE_JAL:ComputeOp = 66
const JTYPE_JAL_WB:ComputeOp = 67

// U-type ops (writeback variants only; rd=x0 inert paths use NO_OP)
const UTYPE_LUI_WB:ComputeOp = 68
const UTYPE_AUIPC_WB:ComputeOp = 69

// Unified semantic compute ops stored in decoded.

const NO_OP:ComputeOp = 0

// Marker emitted by elf_to_json_gen (computeInvalid) for words in the executable
// span that are not instructions the interpreter models (e.g. CSR ops such as
// `csrrw x0, cycle, x0`, embedded data, or padding). Never executed as a real
// op; the pre-decoding pass treats it as a no-op-equivalent record.

const COMPUTE_INVALID:ComputeOp = 255

// ============================
// RISC-V base opcodes (7-bit)
// ============================

// Must match elf_to_json_gen opcode constants.
const OPCODE_OP:Opcode = 0b0110011
const OPCODE_OP32:Opcode = 0b0111011
const OPCODE_LOAD:Opcode = 0b0000011
const OPCODE_OPIMM:Opcode = 0b0010011
const OPCODE_OPIMM32:Opcode = 0b0011011
const OPCODE_JALR:Opcode = 0b1100111
const OPCODE_SYSTEM:Opcode = 0b1110011
const OPCODE_STORE:Opcode = 0b0100011
const OPCODE_BRANCH:Opcode = 0b1100011
const OPCODE_LUI:Opcode = 0b0110111
const OPCODE_AUIPC:Opcode = 0b0010111
const OPCODE_JAL:Opcode = 0b1101111
const OPCODE_CUSTOM1:Opcode = 0b0101011
const OPCODE_MISCMEM:Opcode = 0b0001111

// ===============
// decoding funct3
// ===============

// ===============================
// R-type funct3 and funct7 values
// ===============================

// OP (0110011) — R-type register-register arithmetic
// funct3 values and funct7 values
const FUNCT3_ADD:Funct3 = 0b000, FUNCT7_ADD:Funct7 = 0b0000000
const FUNCT3_SUB:Funct3 = 0b000, FUNCT7_SUB:Funct7 = 0b0100000
const FUNCT3_SLL:Funct3 = 0b001, FUNCT7_SLL:Funct7 = 0b0000000
const FUNCT3_SLT:Funct3 = 0b010, FUNCT7_SLT:Funct7 = 0b0000000
const FUNCT3_SLTU:Funct3 = 0b011, FUNCT7_SLTU:Funct7 = 0b0000000
const FUNCT3_XOR:Funct3 = 0b100, FUNCT7_XOR:Funct7 = 0b0000000
const FUNCT3_SRL:Funct3 = 0b101, FUNCT7_SRL:Funct7 = 0b0000000
const FUNCT3_SRA:Funct3 = 0b101, FUNCT7_SRA:Funct7 = 0b0100000
const FUNCT3_OR:Funct3 = 0b110, FUNCT7_OR:Funct7 = 0b0000000
const FUNCT3_AND:Funct3 = 0b111, FUNCT7_AND:Funct7 = 0b0000000

// OP-32 (0111011) — R-type 32-bit register-register arithmetic (RV64I)
const FUNCT3_ADDW:Funct3 = 0b000, FUNCT7_ADDW:Funct7 = 0b0000000
const FUNCT3_SUBW:Funct3 = 0b000, FUNCT7_SUBW:Funct7 = 0b0100000
const FUNCT3_SLLW:Funct3 = 0b001, FUNCT7_SLLW:Funct7 = 0b0000000
const FUNCT3_SRLW:Funct3 = 0b101, FUNCT7_SRLW:Funct7 = 0b0000000
const FUNCT3_SRAW:Funct3 = 0b101, FUNCT7_SRAW:Funct7 = 0b0100000

// M extension — Integer multiplication and division
// OP (0110011) + funct7=0000001
const FUNCT3_MUL:Funct3 = 0b000, FUNCT7_MUL:Funct7 = 0b0000001
const FUNCT3_MULH:Funct3 = 0b001, FUNCT7_MULH:Funct7 = 0b0000001
const FUNCT3_MULHSU:Funct3 = 0b010, FUNCT7_MULHSU:Funct7 = 0b0000001
const FUNCT3_MULHU:Funct3 = 0b011, FUNCT7_MULHU:Funct7 = 0b0000001
const FUNCT3_DIV:Funct3 = 0b100, FUNCT7_DIV:Funct7 = 0b0000001
const FUNCT3_DIVU:Funct3 = 0b101, FUNCT7_DIVU:Funct7 = 0b0000001
const FUNCT3_REM:Funct3 = 0b110, FUNCT7_REM:Funct7 = 0b0000001
const FUNCT3_REMU:Funct3 = 0b111, FUNCT7_REMU:Funct7 = 0b0000001

// OP-32 (0111011) + funct7=0000001
const FUNCT3_MULW:Funct3 = 0b000, FUNCT7_MULW:Funct7 = 0b0000001
const FUNCT3_DIVW:Funct3 = 0b100, FUNCT7_DIVW:Funct7 = 0b0000001
const FUNCT3_DIVUW:Funct3 = 0b101, FUNCT7_DIVUW:Funct7 = 0b0000001
const FUNCT3_REMW:Funct3 = 0b110, FUNCT7_REMW:Funct7 = 0b0000001
const FUNCT3_REMUW:Funct3 = 0b111, FUNCT7_REMUW:Funct7 = 0b0000001

// ======================
// I-type funct3 values
// ======================
// LOAD
const FUNCT3_LB:Funct3 = 0b000 // Load Byte
const FUNCT3_LH:Funct3 = 0b001 // Load Halfword
const FUNCT3_LW:Funct3 = 0b010 // Load Word
const FUNCT3_LD:Funct3 = 0b011 // Load Doubleword
const FUNCT3_LBU:Funct3 = 0b100 // Load Byte Unsigned
const FUNCT3_LHU:Funct3 = 0b101 // Load Halfword Unsigned
const FUNCT3_LWU:Funct3 = 0b110 // Load Word Unsigned

// OP_IMM
const FUNCT3_ADDI:Funct3 = 0b000 // Add Immediate
const FUNCT3_SLTI:Funct3 = 0b010 // Set Less Than Immediate
const FUNCT3_SLTIU:Funct3 = 0b011 // Set Less Than Immediate Unsigned
const FUNCT3_XORI:Funct3 = 0b100 // XOR Immediate
const FUNCT3_ORI:Funct3 = 0b110 // OR Immediate
const FUNCT3_ANDI:Funct3 = 0b111 // AND Immediate
const FUNCT3_SLLI:Funct3 = 0b001, FUNCT6_SLLI:Funct6 = 0b000000 // Shift Left Logical Immediate
const FUNCT3_SRLI:Funct3 = 0b101, FUNCT6_SRLI:Funct6 = 0b000000 // Shift Right Logical Immediate
const FUNCT6_SRAI:Funct6 = 0b010000 // Shift Right Arithmetic Immediate

// OP_IMM_32
const FUNCT3_ADDIW:Funct3 = 0b000 // Add Immediate Word
const FUNCT3_SLLIW:Funct3 = 0b001, FUNCT7_SLLIW:Funct7 = 0b0000000 // Shift Left Logical Immediate Word
const FUNCT3_SRLIW:Funct3 = 0b101, FUNCT7_SRLIW:Funct7 = 0b0000000 // Shift Right Logical Immediate Word
const FUNCT7_SRAIW:Funct7 = 0b0100000 // Shift Right Arithmetic Immediate Word

// SYSTEM
const FUNCT3_ECALL:Funct3 = 0b000, FUNCT12_ECALL:Funct12 = 0b000000000000 // ECALL
const FUNCT12_EBREAK:Funct12 = 0b000000000001 // EBREAK
const FUNCT3_JALR:Funct3 = 0b000 // RV64I JALR requires funct3 = 0

// Flatten opcode::funct3 for I-type encoding tags (see check_i_type.zkc).
// u11 dispatch keys append rd_is_zero: *_FOLD when rd=x0, base name when rd≠0.
const I_LB_INST:u10 = (((OPCODE_LOAD as u10) << 3) | (FUNCT3_LB as u10))
const I_LH_INST:u10 = (((OPCODE_LOAD as u10) << 3) | (FUNCT3_LH as u10))
const I_LW_INST:u10 = (((OPCODE_LOAD as u10) << 3) | (FUNCT3_LW as u10))
const I_LBU_INST:u10 = (((OPCODE_LOAD as u10) << 3) | (FUNCT3_LBU as u10))
const I_LHU_INST:u10 = (((OPCODE_LOAD as u10) << 3) | (FUNCT3_LHU as u10))
const I_LWU_INST:u10 = (((OPCODE_LOAD as u10) << 3) | (FUNCT3_LWU as u10))
const I_LD_INST:u10 = (((OPCODE_LOAD as u10) << 3) | (FUNCT3_LD as u10))
const I_ADDI_INST:u10 = (((OPCODE_OPIMM as u10) << 3) | (FUNCT3_ADDI as u10))
const I_SLLI_INST:u10 = (((OPCODE_OPIMM as u10) << 3) | (FUNCT3_SLLI as u10))
const I_SLTI_INST:u10 = (((OPCODE_OPIMM as u10) << 3) | (FUNCT3_SLTI as u10))
const I_SLTIU_INST:u10 = (((OPCODE_OPIMM as u10) << 3) | (FUNCT3_SLTIU as u10))
const I_XORI_INST:u10 = (((OPCODE_OPIMM as u10) << 3) | (FUNCT3_XORI as u10))
const I_SRLI_INST:u10 = (((OPCODE_OPIMM as u10) << 3) | (FUNCT3_SRLI as u10))
const I_ORI_INST:u10 = (((OPCODE_OPIMM as u10) << 3) | (FUNCT3_ORI as u10))
const I_ANDI_INST:u10 = (((OPCODE_OPIMM as u10) << 3) | (FUNCT3_ANDI as u10))
const I_ADDIW_INST:u10 = (((OPCODE_OPIMM32 as u10) << 3) | (FUNCT3_ADDIW as u10))
const I_SLLIW_INST:u10 = (((OPCODE_OPIMM32 as u10) << 3) | (FUNCT3_SLLIW as u10))
const I_SRLIW_INST:u10 = (((OPCODE_OPIMM32 as u10) << 3) | (FUNCT3_SRLIW as u10))
const I_JALR_INST:u10 = (((OPCODE_JALR as u10) << 3) | (FUNCT3_JALR as u10))
const I_ECALL_INST:u10 = (((OPCODE_SYSTEM as u10) << 3) | (FUNCT3_ECALL as u10))

// Flatten I_ECALL_INST::imm12 for single-switch SYSTEM dispatch (check_i_type.zkc).
const I_ECALL_ECALL_INST:u22 = ((I_ECALL_INST as u22) << 12) | (FUNCT12_ECALL as u22)
const I_ECALL_EBREAK_INST:u22 = ((I_ECALL_INST as u22) << 12) | (FUNCT12_EBREAK as u22)

// Flatten I_INST::rd_is_zero for single-switch check_i_type dispatch.
const I_LB_FOLD:u11 = ((I_LB_INST as u11) << 1) | (1 as u11)
const I_LB:u11 = ((I_LB_INST as u11) << 1)
const I_LH_FOLD:u11 = ((I_LH_INST as u11) << 1) | (1 as u11)
const I_LH:u11 = ((I_LH_INST as u11) << 1)
const I_LW_FOLD:u11 = ((I_LW_INST as u11) << 1) | (1 as u11)
const I_LW:u11 = ((I_LW_INST as u11) << 1)
const I_LBU_FOLD:u11 = ((I_LBU_INST as u11) << 1) | (1 as u11)
const I_LBU:u11 = ((I_LBU_INST as u11) << 1)
const I_LHU_FOLD:u11 = ((I_LHU_INST as u11) << 1) | (1 as u11)
const I_LHU:u11 = ((I_LHU_INST as u11) << 1)
const I_LWU_FOLD:u11 = ((I_LWU_INST as u11) << 1) | (1 as u11)
const I_LWU:u11 = ((I_LWU_INST as u11) << 1)
const I_LD_FOLD:u11 = ((I_LD_INST as u11) << 1) | (1 as u11)
const I_LD:u11 = ((I_LD_INST as u11) << 1)
const I_ADDI_FOLD:u11 = ((I_ADDI_INST as u11) << 1) | (1 as u11)
const I_ADDI:u11 = ((I_ADDI_INST as u11) << 1)
const I_SLLI_FOLD:u11 = ((I_SLLI_INST as u11) << 1) | (1 as u11)
const I_SLLI:u11 = ((I_SLLI_INST as u11) << 1)
const I_SLTI_FOLD:u11 = ((I_SLTI_INST as u11) << 1) | (1 as u11)
const I_SLTI:u11 = ((I_SLTI_INST as u11) << 1)
const I_SLTIU_FOLD:u11 = ((I_SLTIU_INST as u11) << 1) | (1 as u11)
const I_SLTIU:u11 = ((I_SLTIU_INST as u11) << 1)
const I_XORI_FOLD:u11 = ((I_XORI_INST as u11) << 1) | (1 as u11)
const I_XORI:u11 = ((I_XORI_INST as u11) << 1)
const I_SRLI_FOLD:u11 = ((I_SRLI_INST as u11) << 1) | (1 as u11)
const I_SRLI:u11 = ((I_SRLI_INST as u11) << 1)
const I_ORI_FOLD:u11 = ((I_ORI_INST as u11) << 1) | (1 as u11)
const I_ORI:u11 = ((I_ORI_INST as u11) << 1)
const I_ANDI_FOLD:u11 = ((I_ANDI_INST as u11) << 1) | (1 as u11)
const I_ANDI:u11 = ((I_ANDI_INST as u11) << 1)
const I_ADDIW_FOLD:u11 = ((I_ADDIW_INST as u11) << 1) | (1 as u11)
const I_ADDIW:u11 = ((I_ADDIW_INST as u11) << 1)
const I_SLLIW_FOLD:u11 = ((I_SLLIW_INST as u11) << 1) | (1 as u11)
const I_SLLIW:u11 = ((I_SLLIW_INST as u11) << 1)
const I_SRLIW_FOLD:u11 = ((I_SRLIW_INST as u11) << 1) | (1 as u11)
const I_SRLIW:u11 = ((I_SRLIW_INST as u11) << 1)
const I_JALR_FOLD:u11 = ((I_JALR_INST as u11) << 1) | (1 as u11)
const I_JALR:u11 = ((I_JALR_INST as u11) << 1)

// ======================
// S-type funct3 values
// ======================

const FUNCT3_SB:Funct3 = 0b000 // Store Byte
const FUNCT3_SH:Funct3 = 0b001 // Store Halfword
const FUNCT3_SW:Funct3 = 0b010 // Store Word
const FUNCT3_SD:Funct3 = 0b011 // Store Doubleword

// ======================
// B-type funct3 values
// ======================

const FUNCT3_BEQ:Funct3 = 0b000
const FUNCT3_BNE:Funct3 = 0b001
const FUNCT3_BLT:Funct3 = 0b100
const FUNCT3_BGE:Funct3 = 0b101
const FUNCT3_BLTU:Funct3 = 0b110
const FUNCT3_BGEU:Funct3 = 0b111

// ===============
// Custom funct3 values
// ===============

// Extraneous precompiles
const FUNCT3_KECCAK:Funct3 = 0b000
const FUNCT7_KECCAK:Funct7 = 0b0000000
const FUNCT3_POSEIDON2:Funct3 = 0b001
const FUNCT7_POSEIDON2:Funct7 = 0b0000000
const FUNCT3_WRITE_OUTPUT:Funct3 = 0b010
const FUNCT7_WRITE_OUTPUT:Funct7 = 0b0000000

// Flatten opcode::funct3::funct7 for R-type encoding tags (see check_r_type.zkc).
// u18 dispatch keys append rd_is_zero: *_FOLD when rd=x0, base name when rd≠0.
const R_ADD_INST:u17 = (((OPCODE_OP as u17) << 10) | ((FUNCT3_ADD as u17) << 7) | (FUNCT7_ADD as u17))
const R_SUB_INST:u17 = (((OPCODE_OP as u17) << 10) | ((FUNCT3_ADD as u17) << 7) | (FUNCT7_SUB as u17))
const R_MUL_INST:u17 = (((OPCODE_OP as u17) << 10) | ((FUNCT3_ADD as u17) << 7) | (FUNCT7_MUL as u17))
const R_SLL_INST:u17 = (((OPCODE_OP as u17) << 10) | ((FUNCT3_SLL as u17) << 7) | (FUNCT7_SLL as u17))
const R_MULH_INST:u17 = (((OPCODE_OP as u17) << 10) | ((FUNCT3_SLL as u17) << 7) | (FUNCT7_MULH as u17))
const R_SLT_INST:u17 = (((OPCODE_OP as u17) << 10) | ((FUNCT3_SLT as u17) << 7) | (FUNCT7_SLT as u17))
const R_MULHSU_INST:u17 = (((OPCODE_OP as u17) << 10) | ((FUNCT3_SLT as u17) << 7) | (FUNCT7_MULHSU as u17))
const R_SLTU_INST:u17 = (((OPCODE_OP as u17) << 10) | ((FUNCT3_SLTU as u17) << 7) | (FUNCT7_SLTU as u17))
const R_MULHU_INST:u17 = (((OPCODE_OP as u17) << 10) | ((FUNCT3_SLTU as u17) << 7) | (FUNCT7_MULHU as u17))
const R_XOR_INST:u17 = (((OPCODE_OP as u17) << 10) | ((FUNCT3_XOR as u17) << 7) | (FUNCT7_XOR as u17))
const R_DIV_INST:u17 = (((OPCODE_OP as u17) << 10) | ((FUNCT3_XOR as u17) << 7) | (FUNCT7_DIV as u17))
const R_SRL_INST:u17 = (((OPCODE_OP as u17) << 10) | ((FUNCT3_SRL as u17) << 7) | (FUNCT7_SRL as u17))
const R_SRA_INST:u17 = (((OPCODE_OP as u17) << 10) | ((FUNCT3_SRL as u17) << 7) | (FUNCT7_SRA as u17))
const R_DIVU_INST:u17 = (((OPCODE_OP as u17) << 10) | ((FUNCT3_SRL as u17) << 7) | (FUNCT7_DIVU as u17))
const R_OR_INST:u17 = (((OPCODE_OP as u17) << 10) | ((FUNCT3_OR as u17) << 7) | (FUNCT7_OR as u17))
const R_REM_INST:u17 = (((OPCODE_OP as u17) << 10) | ((FUNCT3_OR as u17) << 7) | (FUNCT7_REM as u17))
const R_AND_INST:u17 = (((OPCODE_OP as u17) << 10) | ((FUNCT3_AND as u17) << 7) | (FUNCT7_AND as u17))
const R_REMU_INST:u17 = (((OPCODE_OP as u17) << 10) | ((FUNCT3_AND as u17) << 7) | (FUNCT7_REMU as u17))
const R_ADDW_INST:u17 = (((OPCODE_OP32 as u17) << 10) | ((FUNCT3_ADDW as u17) << 7) | (FUNCT7_ADDW as u17))
const R_SUBW_INST:u17 = (((OPCODE_OP32 as u17) << 10) | ((FUNCT3_ADDW as u17) << 7) | (FUNCT7_SUBW as u17))
const R_MULW_INST:u17 = (((OPCODE_OP32 as u17) << 10) | ((FUNCT3_ADDW as u17) << 7) | (FUNCT7_MULW as u17))
const R_SLLW_INST:u17 = (((OPCODE_OP32 as u17) << 10) | ((FUNCT3_SLLW as u17) << 7) | (FUNCT7_SLLW as u17))
const R_DIVW_INST:u17 = (((OPCODE_OP32 as u17) << 10) | ((FUNCT3_DIVW as u17) << 7) | (FUNCT7_DIVW as u17))
const R_SRLW_INST:u17 = (((OPCODE_OP32 as u17) << 10) | ((FUNCT3_SRLW as u17) << 7) | (FUNCT7_SRLW as u17))
const R_SRAW_INST:u17 = (((OPCODE_OP32 as u17) << 10) | ((FUNCT3_SRLW as u17) << 7) | (FUNCT7_SRAW as u17))
const R_DIVUW_INST:u17 = (((OPCODE_OP32 as u17) << 10) | ((FUNCT3_SRLW as u17) << 7) | (FUNCT7_DIVUW as u17))
const R_REMW_INST:u17 = (((OPCODE_OP32 as u17) << 10) | ((FUNCT3_REMW as u17) << 7) | (FUNCT7_REMW as u17))
const R_REMUW_INST:u17 = (((OPCODE_OP32 as u17) << 10) | ((FUNCT3_REMUW as u17) << 7) | (FUNCT7_REMUW as u17))
const R_KECCAK_INST:u17 = (((OPCODE_CUSTOM1 as u17) << 10) | ((FUNCT3_KECCAK as u17) << 7) | (FUNCT7_KECCAK as u17))
const R_POSEIDON2_INST:u17 = (((OPCODE_CUSTOM1 as u17) << 10) | ((FUNCT3_POSEIDON2 as u17) << 7) | (FUNCT7_POSEIDON2 as u17))
const R_WRITE_OUTPUT_INST:u17 = (((OPCODE_CUSTOM1 as u17) << 10) | ((FUNCT3_WRITE_OUTPUT as u17) << 7) | (FUNCT7_WRITE_OUTPUT as u17))


// Flatten R_INST::rd_is_zero for single-switch check_r_type dispatch.
const R_ADD_FOLD:u18 = ((R_ADD_INST as u18) << 1) | (1 as u18)
const R_ADD:u18 = ((R_ADD_INST as u18) << 1)
const R_SUB_FOLD:u18 = ((R_SUB_INST as u18) << 1) | (1 as u18)
const R_SUB:u18 = ((R_SUB_INST as u18) << 1)
const R_MUL_FOLD:u18 = ((R_MUL_INST as u18) << 1) | (1 as u18)
const R_MUL:u18 = ((R_MUL_INST as u18) << 1)
const R_SLL_FOLD:u18 = ((R_SLL_INST as u18) << 1) | (1 as u18)
const R_SLL:u18 = ((R_SLL_INST as u18) << 1)
const R_MULH_FOLD:u18 = ((R_MULH_INST as u18) << 1) | (1 as u18)
const R_MULH:u18 = ((R_MULH_INST as u18) << 1)
const R_SLT_FOLD:u18 = ((R_SLT_INST as u18) << 1) | (1 as u18)
const R_SLT:u18 = ((R_SLT_INST as u18) << 1)
const R_MULHSU_FOLD:u18 = ((R_MULHSU_INST as u18) << 1) | (1 as u18)
const R_MULHSU:u18 = ((R_MULHSU_INST as u18) << 1)
const R_SLTU_FOLD:u18 = ((R_SLTU_INST as u18) << 1) | (1 as u18)
const R_SLTU:u18 = ((R_SLTU_INST as u18) << 1)
const R_MULHU_FOLD:u18 = ((R_MULHU_INST as u18) << 1) | (1 as u18)
const R_MULHU:u18 = ((R_MULHU_INST as u18) << 1)
const R_XOR_FOLD:u18 = ((R_XOR_INST as u18) << 1) | (1 as u18)
const R_XOR:u18 = ((R_XOR_INST as u18) << 1)
const R_DIV_FOLD:u18 = ((R_DIV_INST as u18) << 1) | (1 as u18)
const R_DIV:u18 = ((R_DIV_INST as u18) << 1)
