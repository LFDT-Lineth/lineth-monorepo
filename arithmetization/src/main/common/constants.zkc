const R_SRL:u18 = ((R_SRL_INST as u18) << 1)
const R_SRA_FOLD:u18 = ((R_SRA_INST as u18) << 1) | (1 as u18)
const R_SRA:u18 = ((R_SRA_INST as u18) << 1)
const R_DIVU_FOLD:u18 = ((R_DIVU_INST as u18) << 1) | (1 as u18)
const R_DIVU:u18 = ((R_DIVU_INST as u18) << 1)
const R_OR_FOLD:u18 = ((R_OR_INST as u18) << 1) | (1 as u18)
const R_OR:u18 = ((R_OR_INST as u18) << 1)
const R_REM_FOLD:u18 = ((R_REM_INST as u18) << 1) | (1 as u18)
const R_REM:u18 = ((R_REM_INST as u18) << 1)
const R_AND_FOLD:u18 = ((R_AND_INST as u18) << 1) | (1 as u18)
const R_AND:u18 = ((R_AND_INST as u18) << 1)
const R_REMU_FOLD:u18 = ((R_REMU_INST as u18) << 1) | (1 as u18)
const R_REMU:u18 = ((R_REMU_INST as u18) << 1)
const R_ADDW_FOLD:u18 = ((R_ADDW_INST as u18) << 1) | (1 as u18)
const R_ADDW:u18 = ((R_ADDW_INST as u18) << 1)
const R_SUBW_FOLD:u18 = ((R_SUBW_INST as u18) << 1) | (1 as u18)
const R_SUBW:u18 = ((R_SUBW_INST as u18) << 1)
const R_MULW_FOLD:u18 = ((R_MULW_INST as u18) << 1) | (1 as u18)
const R_MULW:u18 = ((R_MULW_INST as u18) << 1)
const R_SLLW_FOLD:u18 = ((R_SLLW_INST as u18) << 1) | (1 as u18)
const R_SLLW:u18 = ((R_SLLW_INST as u18) << 1)
const R_DIVW_FOLD:u18 = ((R_DIVW_INST as u18) << 1) | (1 as u18)
const R_DIVW:u18 = ((R_DIVW_INST as u18) << 1)
const R_SRLW_FOLD:u18 = ((R_SRLW_INST as u18) << 1) | (1 as u18)
const R_SRLW:u18 = ((R_SRLW_INST as u18) << 1)
const R_SRAW_FOLD:u18 = ((R_SRAW_INST as u18) << 1) | (1 as u18)
const R_SRAW:u18 = ((R_SRAW_INST as u18) << 1)
const R_DIVUW_FOLD:u18 = ((R_DIVUW_INST as u18) << 1) | (1 as u18)
const R_DIVUW:u18 = ((R_DIVUW_INST as u18) << 1)
const R_REMW_FOLD:u18 = ((R_REMW_INST as u18) << 1) | (1 as u18)
const R_REMW:u18 = ((R_REMW_INST as u18) << 1)
const R_REMUW_FOLD:u18 = ((R_REMUW_INST as u18) << 1) | (1 as u18)
const R_REMUW:u18 = ((R_REMUW_INST as u18) << 1)

// ===============
// decoding types
// ===============

const UNDEFINED_TYPE:Type = 0
const R_TYPE:Type = 1
const I_TYPE:Type = 2
const S_TYPE:Type = 3
const B_TYPE:Type = 4
const U_TYPE:Type = 5
const J_TYPE:Type = 6
// MISC-MEM opcode (FENCE / FENCE.I). On a single-hart machine with no caches
// or memory hierarchy, both are architecturally allowed to be no-ops, so we
// treat them as such — advance PC by 4, do nothing else.
const MISC_MEM_TYPE:Type = 7

