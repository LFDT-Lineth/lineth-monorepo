// Canonical `pub input` declarations for the RISC-V arithmetization.
//
// Shared file for:
//   - riscv/memory.zkc       
//   - predecoding/main.zkc 
include "type.zkc"

// Entry point of the RISC-V executable binary and number of sparse memory blobs to copy into RAM before execution
pub input entry_point_and_blobs_count(i:u1) -> (entry_point:Address, blobs_count:u64)

// RAM offset where each blob must be written and number of bytes in each blob
pub input blobs_offset_and_size(i:u64) -> (blob_offset:Address, blob_size:Length)

// Whether blob i holds executable (SHF_EXECINSTR) section bytes (1) or data (0).
pub input blobs_executable(i:u64) -> (executable:u1)

// Concatenated bytes for all sparse memory blobs, in blob order
pub input blobs_data(i:Address) -> (byte:u8)

// Lowest executable instruction address (4-aligned). Used to convert a pc into
// an index into the pre-decoded instruction tables below: index = (pc - base) >> 2
pub input instruction_base(i:u1) -> (base:Address)

// Pre-decoded instruction stream, indexed by instruction index (one record per
// 4-byte word of the executable region). Each record holds the unified semantic
// compute op and operands for direct dispatch in interpreter.zkc.
//
// `rs1_plus_imm` holds the sign-extended immediate addend paired with `rs1` at
// execution time: signed_sum_of_double_word(registers[rs1], rs1_plus_imm).
// For I-type and S-type it equals `imm`; otherwise 0.
pub input decoded(i:u64) -> (compute_op:ComputeOp, imm:DoubleWord, rs1:Register, rs2:Register, rd:Register, rs1_plus_imm:DoubleWord)
