fn check_j_type_operands(instruction_parameters:u25, rs1_decoded:Register, rd_decoded:Register, imm_decoded:DoubleWord) {
    var rd:Register
    var imm20:u1
    var imm10_1:u10
    var imm11:u1
    var imm19_12:u8
    var imm:DoubleWord

    imm20::imm10_1::imm11::imm19_12::rd = instruction_parameters
    var imm21:u21 = ((imm20::imm19_12::imm11::imm10_1) as u21) << 1
    imm = sgn_extension_u21_u64(imm21)

    if rs1_decoded != rs1 {
        printf "[ERROR] rs1 mismatch for compute_op %d\n", compute_op
        fail
    }
    if rd_decoded != rd {
        printf "[ERROR] rd mismatch for compute_op %d\n", compute_op
        fail
    }
    if imm_decoded != imm {
        printf "[ERROR] imm mismatch for compute_op %d\n", compute_op
        fail
    }
}

fn check_u_type_operands(instruction_parameters:u25, rs1_decoded:Register, imm_decoded:DoubleWord) {
    var imm20:DoubleWord
    var imm:DoubleWord
    imm20::rs1 = instruction_parameters
    imm = sgn_extension_u32_u64(((imm20 as u32) << 12) as u32)

    if rs1_decoded != rs1 {
        printf "[ERROR] rs1 mismatch for compute_op %d\n", compute_op
        fail
    }
    if imm_decoded != imm {
        printf "[ERROR] imm mismatch for compute_op %d\n", compute_op
