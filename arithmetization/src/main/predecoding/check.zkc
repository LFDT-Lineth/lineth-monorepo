fn check_b_type_operands(instruction_parameters:u25, rs1_decoded:Register, rs2_decoded:Register, imm_decoded:DoubleWord) {
    var funct3:Funct3
    var imm_sign:SignBit
    var imm_11:u1
    var imm_10_5:u6
    var imm_4_1:u4
    var rs1:Register
    var rs2:Register
    var imm:DoubleWord        
    imm_sign::imm_10_5::rs2::rs1::funct3::imm_4_1::imm_11 = instruction_parameters

    if imm_sign == 1 {
        imm = DWORD_SIGN_EXT_PREFIX_52_ONES::imm_11::imm_10_5::imm_4_1::(0 as u1)
    } else {
        imm = (imm_11::imm_10_5::imm_4_1::(0 as u1)) as DoubleWord
    }

    if rs1_decoded != rs1 {
        printf "[ERROR] rs1 mismatch for compute_op %d\n", compute_op
        fail
    }
    if rs2_decoded != rs2 {
        printf "[ERROR] rs2 mismatch for compute_op %d\n", compute_op
        fail
    }
    if imm_decoded != imm {
        printf "[ERROR] imm mismatch for compute_op %d\n", compute_op
        fail
    }
}

fn check_i_type_operands(instruction_parameters:u25, rs1_decoded:Register, rd_decoded:Register, imm_decoded:DoubleWord) {
    var funct3:Funct3
    var imm12:Imm12
    var rs1:Register
    var rd:Register

    imm12::rs1::funct3::rd = instruction_parameters
    var imm:DoubleWord = sgn_extension_u12_u64(imm12)

    if rs1_decoded != rs1 {
        printf "[ERROR] rs1 mismatch for compute_op %d\n", compute_op
        fail
    }
    if rd_decoded != rd {
        printf "[ERROR] rd mismatch for compute_op %d\n", compute_op
        fail
    }
    if imm_decoded != imm {
        printf "[ERROR] imm mismatch for compute_op %d\n", compute_op
        fail
    }
}

