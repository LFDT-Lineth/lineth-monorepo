fn check_b_type(instruction_parameters:u25, compute_op:ComputeOp, rs1_decoded:Register, rs2_decoded:Register, imm_decoded:DoubleWord) {
    var funct3:Funct3
    var imm_sign:SignBit
    var imm_11:u1
    var imm_10_5:u6
    var imm_4_1:u4
    var rs1:Register
    var rs2:Register
    var imm:DoubleWord
    imm_sign::imm_10_5::rs2::rs1::funct3::imm_4_1::imm_11 = instruction_parameters

    // Verify the raw funct3 field actually encodes the claimed branch compute_op.
    // Mapping (see elf_to_json_gen unifiedComputeOp / bTypeUnifiedIndex):
    //   BEQ=0b000, BNE=0b001, BLT=0b100, BGE=0b101, BLTU=0b110, BGEU=0b111
    switch funct3 {
        case 0: {
            if compute_op != BRANCH_BEQ {
                printf "[ERROR] compute_op mismatch\n"
                fail
            }
        }
        case 1: {
            if compute_op != BRANCH_BNE {
                printf "[ERROR] compute_op mismatch\n"
                fail
            }
        }
        case 4: {
            if compute_op != BRANCH_BLT {
                printf "[ERROR] compute_op mismatch\n"
                fail
            }
        }
        case 5: {
            if compute_op != BRANCH_BGE {
                printf "[ERROR] compute_op mismatch\n"
                fail
            }
        }
        case 6: {
            if compute_op != BRANCH_BLTU {
                printf "[ERROR] compute_op mismatch\n"
                fail
            }
        }
        case 7: {
            if compute_op != BRANCH_BGEU {
                printf "[ERROR] compute_op mismatch\n"
                fail
            }
        }
        default: {
            printf "[ERROR] invalid B-type funct3\n"
            fail
        }
    }

    // Reassemble imm[12:1] (sign = imm[12]) and sign-extend, then << 1 (imm[0] = 0).
    imm = sgn_extension_u12_u64(imm_sign::imm_11::imm_10_5::imm_4_1) << 1

    if rs1_decoded != rs1 {
        printf "[ERROR] rs1 mismatch\n"
        fail
    }
    if rs2_decoded != rs2 {
        printf "[ERROR] rs2 mismatch\n"
        fail
    }
    if imm_decoded != imm {
        printf "[ERROR] imm mismatch\n"
        fail
    }
}

fn check_i_type_operands(instruction_parameters:u25, rs1_decoded:Register, rd_decoded:Register, imm_decoded:DoubleWord) {
    var funct3:Funct3
    var imm12:Imm12
    var rs1:Register
    var rd:Register

    imm12::rs1::funct3::rd = instruction_parameters
    var imm:DoubleWord = sgn_extension_u12_u64(imm12)

    if rs1_decoded != rs1 {
        printf "[ERROR] rs1 mismatch\n"
        fail
    }
    if rd_decoded != rd {
        printf "[ERROR] rd mismatch\n"
        fail
    }
    if imm_decoded != imm {
        printf "[ERROR] imm mismatch\n"
        fail
    }
}

fn check_r_type_operands(instruction_parameters:u25, rs1_decoded:Register, rs2_decoded:Register, rd_decoded:Register) {
    var funct7:Funct7
    var funct3:Funct3
    var rs1:Register
    var rs2:Register
    var rd:Register
    funct7::rs2::rs1::funct3::rd = instruction_parameters
    if rs1_decoded != rs1 {
        printf "[ERROR] rs1 mismatch\n"
        fail
    }
    if rs2_decoded != rs2 {
        printf "[ERROR] rs2 mismatch\n"
        fail
    }
    if rd_decoded != rd {
        printf "[ERROR] rd mismatch\n"
        fail
    }
}

fn check_j_type_operands(instruction_parameters:u25, rs1_decoded:Register, rd_decoded:Register, imm_decoded:DoubleWord) {
    var rd:Register
    var imm20:u1
    var imm10_1:u10
    var imm11:u1
    var imm19_12:u8
    var imm:DoubleWord

    imm20::imm10_1::imm11::imm19_12::rd = instruction_parameters
    var imm21:u21 = ((imm20::imm19_12::imm11::imm10_1) as u21) << 1
    imm = sgn_extension_u21_u64(imm21)

    if rs1_decoded != 0 {
        printf "[ERROR] rs1 mismatch\n"
        fail
    }
    if rd_decoded != rd {
        printf "[ERROR] rd mismatch\n"
        fail
    }
    if imm_decoded != imm {
        printf "[ERROR] imm mismatch\n"
        fail
    }
}

fn check_u_type_operands(instruction_parameters:u25, rd_decoded:Register, imm_decoded:DoubleWord) {
    var imm20:u20
    var rd:Register
    imm20::rd = instruction_parameters
    var imm:DoubleWord = sgn_extension_u32_u64((imm20 as u32) << 12)

    if rd_decoded != rd {
        printf "[ERROR] rd mismatch\n"
        fail
    }
    if imm_decoded != imm {
        printf "[ERROR] imm mismatch\n"
        fail
    }
}

fn check_s_type(instruction_parameters:u25, compute_op:ComputeOp, rs1_decoded:Register, rs2_decoded:Register, imm_decoded:DoubleWord) {
    var imm_sign:u1
    var funct3:Funct3
    var rs1:Register
    var rs2:Register
    var uimm5:UImm5
    var uimm6:UImm6
    imm_sign::uimm6::rs2::rs1::funct3::uimm5 = instruction_parameters

    // Verify the raw funct3 field actually encodes the claimed store compute_op.
    // Mapping (see elf_to_json_gen decodeSTypeSemantic):
    //   STORE8=0b000, STORE16=0b001, STORE32=0b010, STORE64=0b011
    switch funct3 {
        case 0: {
            if compute_op != STYPE_STORE8 {
                printf "[ERROR] compute_op mismatch\n"
                fail
            }
        }
        case 1: {
            if compute_op != STYPE_STORE16 {
                printf "[ERROR] compute_op mismatch\n"
                fail
            }
        }
        case 2: {
            if compute_op != STYPE_STORE32 {
                printf "[ERROR] compute_op mismatch\n"
                fail
            }
        }
        case 3: {
            if compute_op != STYPE_STORE64 {
                printf "[ERROR] compute_op mismatch\n"
                fail
            }
        }
        default: {
            printf "[ERROR] invalid S-type funct3\n"
            fail
        }
    }

    var imm:DoubleWord = sgn_extension_u12_u64(imm_sign::uimm6::uimm5)
    
    if rs1_decoded != rs1 {
        printf "[ERROR] rs1 mismatch\n"
        fail
    }
    if rs2_decoded != rs2 {
        printf "[ERROR] rs2 mismatch\n"
        fail
    }
    if imm_decoded != imm {
        printf "[ERROR] imm mismatch\n"
        fail
    }
}