// Definitions the predecoding correspondence checker needs. The shared files
// keep them commented out ("PREDECODING PROOF SECTION") because the main RISC-V
// circuit must not carry unreachable modules or require the blobs_executable
// input. Included only by predecoding/main.zkc; the main circuit never
// includes this file.
include "../common/type.zkc"
include "../common/constants.zkc"
include "../riscv/utils/sign_extend.zkc"

// from common/inputs.zkc
// Whether blob i holds executable (SHF_EXECINSTR) section bytes (1) or data (0).
pub input blobs_executable(i:u32) -> (executable:u1)

// from riscv/utils/sign_extend.zkc
//#[inline]
fn sgn_extension_u21_u64(value:u21) -> (ext_value:u64) {
    var sign:u1, tmp:u20
    //
    sign::tmp = value
    //
    if sign == 1 {
        ext_value = (value as u64) + SGNEXTMASK_U21
    } else {
        ext_value = (value as u64)
    }
}

// from riscv/utils/sign_extend.zkc
//#[inline]
fn sgn_extension_u12_u64(value:u12) -> (ext_value:u64) {
    var sign:u1, tmp:u11
    //
    sign::tmp = value
    //
    if sign == 1 {
        ext_value = (value as u64) + SGNEXTMASK_U12
    } else {
        ext_value = (value as u64)
    }
}

