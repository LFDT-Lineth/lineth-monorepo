include "../riscv/utils/sign_extend.zkc"
include "../common/constants.zkc"
include "../common/type.zkc"
include "check/check_b_type.zkc"
include "check/check_i_type.zkc"
include "check/check_r_type.zkc"
include "check/check_j_type.zkc"
include "check/check_u_type.zkc"
include "check/check_s_type.zkc"

// Verify that the raw instruction word `instruction` decodes to the pre-decoded
// record `decoded[index]`.
fn predecoding(index:u64, instruction:Instruction) {

    // Variables from raw RISCV program
    var instruction_parameters:u25
    var opcode:Opcode
    instruction_parameters::opcode = instruction

    // Variables from pre-decoded instruction table
    var compute_op:ComputeOp
    var imm_decoded:DoubleWord
    var rs1_decoded:Register
    var rs2_decoded:Register
    var rd_decoded:Register
    compute_op, imm_decoded, rs1_decoded, rs2_decoded, rd_decoded = decoded[index]

    var instruction_type:Type = instruction_type_from_opcode(opcode)
    switch instruction_type {
        case B_TYPE: {
            check_b_type(index, instruction_parameters, opcode, compute_op, rs1_decoded, rs2_decoded, imm_decoded)
        }
        case S_TYPE: {
            check_s_type(index, instruction_parameters, opcode, compute_op, rs1_decoded, rs2_decoded, imm_decoded)
        }
        case J_TYPE: {
            check_j_type(index, instruction_parameters, opcode, compute_op, rs1_decoded, rd_decoded, imm_decoded)
        }
        case U_TYPE: {
            check_u_type(index, instruction_parameters, opcode, compute_op, rd_decoded, imm_decoded)
        }
        case I_TYPE: {
            check_i_type(index, instruction_parameters, opcode, compute_op, rs1_decoded, rd_decoded, imm_decoded)
        }
        case R_TYPE: {
            check_r_type(index, instruction_parameters, opcode, compute_op, rs1_decoded, rs2_decoded, rd_decoded)
        }
        case MISC_MEM_TYPE: {
        }
        default: {
            printf "[ERROR] invalid instruction type (index=%d opcode=%x params=%x)\n", index, opcode, instruction_parameters
            fail
        }
    }

}
