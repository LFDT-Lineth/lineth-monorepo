                }
            } else if compute_op != RTYPE_REM_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_REMU: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_REMU_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_ADD: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_ADD_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_SLL: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_SLL_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_SLT: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_SLT_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_SLTU: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_SLTU_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_XOR: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_XOR_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_SRL: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_SRL_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_OR: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_OR_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_AND: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_AND_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_SUB: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_SUB_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_SRA: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_SRA_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_MULW: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_MULW_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_DIVW: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_DIVW_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_DIVUW: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_DIVUW_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_REMW: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_REMW_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_REMUW: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_REMUW_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_ADDW: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_ADDW_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_SLLW: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_SLLW_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_SRLW: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_SRLW_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_SUBW: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_SUBW_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_SRAW: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_SRAW_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_KECCAK: {
            if compute_op != RTYPE_KECCAK {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                fail
            }
        }
        case R_POSEIDON2: {
            if compute_op != RTYPE_POSEIDON2 {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                fail
            }
        }
        case R_WRITE_OUTPUT: {
            if compute_op != RTYPE_WRITE_OUTPUT {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                fail
            }
        }
        default: {
            if compute_op != COMPUTE_INVALID {
                printf "[ERROR] invalid R-type encoding requires COMPUTE_INVALID (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
            return
        }
    }

    if compute_op == COMPUTE_MISC_MEM {
        return
    }

    if rs1_decoded != rs1 {
        printf "[ERROR] rs1 mismatch (compute_op=%x opcode=%x rs1_decoded=%d)\n", compute_op, opcode, rs1_decoded
        fail
    }
    if rs2_decoded != rs2 {
        printf "[ERROR] rs2 mismatch (compute_op=%x opcode=%x rs2_decoded=%d)\n", compute_op, opcode, rs2_decoded
        fail
    }
    if rd_decoded != rd {
        printf "[ERROR] rd mismatch (compute_op=%x opcode=%x rd_decoded=%d)\n", compute_op, opcode, rd_decoded
        fail
    }
}
