                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_MULHSU_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_MULHU: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
                }
            } else if compute_op != RTYPE_MULHU_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_DIV: {
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                    fail
