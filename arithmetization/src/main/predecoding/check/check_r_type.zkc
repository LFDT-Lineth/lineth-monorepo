                if rs1 == 0 && rs2 == 0 {
                    if compute_op != COMPUTE_MISC_MEM {
                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                        fail
                    }
                } else if compute_op != RTYPE_SRAW {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
                }
            } else if compute_op != RTYPE_SRAW_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_KECCAK: {
            if compute_op != RTYPE_KECCAK {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                fail
            }
        }
        case R_POSEIDON2: {
            if compute_op != RTYPE_POSEIDON2 {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                fail
            }
        }
        case R_WRITE_OUTPUT: {
            if compute_op != RTYPE_WRITE_OUTPUT {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                fail
            }
        }
        default: {
            if compute_op != COMPUTE_INVALID {
                printf "[ERROR] invalid R-type encoding requires COMPUTE_INVALID (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
            return
        }
    }

    // Folded rd=x0, rs1=x0, rs2=x0 no-ops: operands are not semantically observed.
    if compute_op == COMPUTE_MISC_MEM {
        return
    }

    // Check that the decoded operands match the raw instruction parameters.
    if rs1_decoded != rs1 {
        printf "[ERROR] rs1 mismatch (compute_op=%x opcode=%x rs1_decoded=%d)\n", compute_op, opcode, rs1_decoded
        fail
    }
    if rs2_decoded != rs2 {
        printf "[ERROR] rs2 mismatch (compute_op=%x opcode=%x rs2_decoded=%d)\n", compute_op, opcode, rs2_decoded
        fail
    }
    if rd_decoded != rd {
        printf "[ERROR] rd mismatch (compute_op=%x opcode=%x rd_decoded=%d)\n", compute_op, opcode, rd_decoded
        fail
    }
}
