                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                } else { // rd=x0, rs1≠x0 or rs2≠x0: base compute_op.
                                    if compute_op != RTYPE_DIVW {
                                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                }
                            } else if compute_op != RTYPE_DIVW_WB { // rd≠x0: writeback variant.
                                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                        }
                        case FUNCT3_DIVUW: {
                            if rd == 0 {
                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                } else { // rd=x0, rs1≠x0 or rs2≠x0: base compute_op.
                                    if compute_op != RTYPE_DIVUW {
                                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                }
                            } else if compute_op != RTYPE_DIVUW_WB { // rd≠x0: writeback variant.
                                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                        }
                        case FUNCT3_REMW: {
                            if rd == 0 {
                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                } else { // rd=x0, rs1≠x0 or rs2≠x0: base compute_op.
                                    if compute_op != RTYPE_REMW {
                                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                }
                            } else if compute_op != RTYPE_REMW_WB { // rd≠x0: writeback variant.
                                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                        }
                        case FUNCT3_REMUW: {
                            if rd == 0 {
                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                } else { // rd=x0, rs1≠x0 or rs2≠x0: base compute_op.
                                    if compute_op != RTYPE_REMUW {
                                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                }
                            } else if compute_op != RTYPE_REMUW_WB { // rd≠x0: writeback variant.
                                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                        }
                        default: {
                            if compute_op != COMPUTE_INVALID {
                                printf "[ERROR] invalid OP32 funct3 requires COMPUTE_INVALID (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                            return
                        }
                    }
                }
                case FUNCT7_ADDW: {
                    switch funct3 {
                        case FUNCT3_ADDW: {
                            if rd == 0 {
                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                } else { // rd=x0, rs1≠x0 or rs2≠x0: base compute_op.
                                    if compute_op != RTYPE_ADDW {
                                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                }
                            } else if compute_op != RTYPE_ADDW_WB { // rd≠x0: writeback variant.
                                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                        }
                        case FUNCT3_SLLW: {
                            if rd == 0 {
                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                } else { // rd=x0, rs1≠x0 or rs2≠x0: base compute_op.
                                    if compute_op != RTYPE_SLLW {
                                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                }
                            } else if compute_op != RTYPE_SLLW_WB { // rd≠x0: writeback variant.
                                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                        }
                        case FUNCT3_SRLW: {
                            if rd == 0 {
                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                } else { // rd=x0, rs1≠x0 or rs2≠x0: base compute_op.
                                    if compute_op != RTYPE_SRLW {
                                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                }
                            } else if compute_op != RTYPE_SRLW_WB { // rd≠x0: writeback variant.
                                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                        }
                        default: {
                            if compute_op != COMPUTE_INVALID {
                                printf "[ERROR] invalid OP32 funct3 requires COMPUTE_INVALID (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                            return
                        }
                    }
                }
                case FUNCT7_SUBW: {
                    switch funct3 {
                        case FUNCT3_SUBW: {
                            if rd == 0 {
                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                } else { // rd=x0, rs1≠x0 or rs2≠x0: base compute_op.
                                    if compute_op != RTYPE_SUBW {
                                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                }
                            } else if compute_op != RTYPE_SUBW_WB { // rd≠x0: writeback variant.
                                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                        }
                        case FUNCT3_SRAW: {
                            if rd == 0 {
                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                } else { // rd=x0, rs1≠x0 or rs2≠x0: base compute_op.
                                    if compute_op != RTYPE_SRAW {
                                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                }
                            } else if compute_op != RTYPE_SRAW_WB { // rd≠x0: writeback variant.
                                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                        }
                        default: {
                            if compute_op != COMPUTE_INVALID {
                                printf "[ERROR] invalid OP32 funct3 requires COMPUTE_INVALID (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                            return
                        }
                    }
                }
                default: {
                    if compute_op != COMPUTE_INVALID {
                        printf "[ERROR] invalid OP32 funct7 requires COMPUTE_INVALID (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                        fail
                    }
                    return
                }
            }
        }
        case OPCODE_CUSTOM1: {
            // Custom-1 precompiles are never folded (memory side effects).
            if funct7 != FUNCT7_KECCAK {
                if compute_op != COMPUTE_INVALID {
                    printf "[ERROR] invalid CUSTOM1 funct7 requires COMPUTE_INVALID (compute_op=%x opcode=%x params=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct7
                    fail
                }
                return
            }
            switch funct3 {
                case FUNCT3_KECCAK: {
                    if compute_op != RTYPE_KECCAK {
                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                        fail
                    }
                }
                case FUNCT3_POSEIDON2: {
                    if compute_op != RTYPE_POSEIDON2 {
                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                        fail
                    }
                }
                default: {
                    if compute_op != COMPUTE_INVALID {
                        printf "[ERROR] invalid CUSTOM1 funct3 requires COMPUTE_INVALID (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                        fail
                    }
                    return
                }
            }
        }
        default: {
            if compute_op != COMPUTE_INVALID {
                printf "[ERROR] invalid R-type opcode requires COMPUTE_INVALID (compute_op=%x opcode=%x params=%x)\n", compute_op, opcode, instruction_parameters
                fail
            }
            return
        }
    }

    // Folded rd=x0, rs1=x0, rs2=x0 no-ops: operands are not semantically observed.
    if compute_op == COMPUTE_MISC_MEM {
        return
    }

    // Check that the decoded operands match the raw instruction parameters.
    if rs1_decoded != rs1 {
        printf "[ERROR] rs1 mismatch (compute_op=%x opcode=%x rs1_decoded=%d)\n", compute_op, opcode, rs1_decoded
        fail
    }
    if rs2_decoded != rs2 {
        printf "[ERROR] rs2 mismatch (compute_op=%x opcode=%x rs2_decoded=%d)\n", compute_op, opcode, rs2_decoded
        fail
    }
    if rd_decoded != rd {
        printf "[ERROR] rd mismatch (compute_op=%x opcode=%x rd_decoded=%d)\n", compute_op, opcode, rd_decoded
        fail
    }
}
