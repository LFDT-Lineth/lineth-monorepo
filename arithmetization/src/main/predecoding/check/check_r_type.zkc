fn check_r_type(instruction_parameters:u25, opcode:Opcode, compute_op:ComputeOp, rs1_decoded:Register, rs2_decoded:Register, rd_decoded:Register) {
    var funct7:Funct7
    var funct3:Funct3
    var rs1:Register
    var rs2:Register
    var rd:Register
    funct7::rs2::rs1::funct3::rd = instruction_parameters


    // Verify the raw (opcode, funct7, funct3) fields encode the claimed compute_op.
    // Fold + writeback pairing for OP/OP32:
    //   rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM; rd=x0 otherwise → base; rd≠x0 → *_WB.
    switch opcode {
        case OPCODE_OP: {
            switch funct7 {
                case FUNCT7_MUL: {
                    switch funct3 {
                        case FUNCT3_MUL: {
                            if rd == 0 {
                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                } else { // rd=x0, rs1≠x0 or rs2≠x0: base compute_op.
                                    if compute_op != RTYPE_MUL {
                                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                }
                            } else if compute_op != RTYPE_MUL_WB { // rd≠x0: writeback variant.
                                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                        }
                        case FUNCT3_MULH: {
                            if rd == 0 {
                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                } else { // rd=x0, rs1≠x0 or rs2≠x0: base compute_op.
                                    if compute_op != RTYPE_MULH {
                                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                }
                            } else if compute_op != RTYPE_MULH_WB { // rd≠x0: writeback variant.
                                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                        }
                        case FUNCT3_MULHSU: {
                            if rd == 0 {
                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                } else { // rd=x0, rs1≠x0 or rs2≠x0: base compute_op.
                                    if compute_op != RTYPE_MULHSU {
                                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                }
                            } else if compute_op != RTYPE_MULHSU_WB { // rd≠x0: writeback variant.
                                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                        }
                        case FUNCT3_MULHU: {
                            if rd == 0 {
                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                } else { // rd=x0, rs1≠x0 or rs2≠x0: base compute_op.
                                    if compute_op != RTYPE_MULHU {
                                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                }
                            } else if compute_op != RTYPE_MULHU_WB { // rd≠x0: writeback variant.
                                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                        }
                        case FUNCT3_DIV: {
                            if rd == 0 {
                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                } else { // rd=x0, rs1≠x0 or rs2≠x0: base compute_op.
                                    if compute_op != RTYPE_DIV {
                                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                }
                            } else if compute_op != RTYPE_DIV_WB { // rd≠x0: writeback variant.
                                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                        }
                        case FUNCT3_DIVU: {
                            if rd == 0 {
                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                } else { // rd=x0, rs1≠x0 or rs2≠x0: base compute_op.
                                    if compute_op != RTYPE_DIVU {
                                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                }
                            } else if compute_op != RTYPE_DIVU_WB { // rd≠x0: writeback variant.
                                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                        }
                        case FUNCT3_REM: {
                            if rd == 0 {
                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                } else { // rd=x0, rs1≠x0 or rs2≠x0: base compute_op.
                                    if compute_op != RTYPE_REM {
                                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                }
                            } else if compute_op != RTYPE_REM_WB { // rd≠x0: writeback variant.
                                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                        }
                        case FUNCT3_REMU: {
                            if rd == 0 {
                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                } else { // rd=x0, rs1≠x0 or rs2≠x0: base compute_op.
                                    if compute_op != RTYPE_REMU {
                                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                }
                            } else if compute_op != RTYPE_REMU_WB { // rd≠x0: writeback variant.
                                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                        }
                        default: {
                            if compute_op != COMPUTE_INVALID {
                                printf "[ERROR] invalid OP funct3 requires COMPUTE_INVALID (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                            return
                        }
                    }
                }
                case FUNCT7_ADD: {
                    switch funct3 {
                        case FUNCT3_ADD: {
                            if rd == 0 {
                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                } else { // rd=x0, rs1≠x0 or rs2≠x0: base compute_op.
                                    if compute_op != RTYPE_ADD {
                                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                }
                            } else if compute_op != RTYPE_ADD_WB { // rd≠x0: writeback variant.
                                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                        }
                        case FUNCT3_SLL: {
                            if rd == 0 {
                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                } else { // rd=x0, rs1≠x0 or rs2≠x0: base compute_op.
                                    if compute_op != RTYPE_SLL {
                                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                }
                            } else if compute_op != RTYPE_SLL_WB { // rd≠x0: writeback variant.
                                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                        }
                        case FUNCT3_SLT: {
                            if rd == 0 {
                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                } else { // rd=x0, rs1≠x0 or rs2≠x0: base compute_op.
                                    if compute_op != RTYPE_SLT {
                                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                }
                            } else if compute_op != RTYPE_SLT_WB { // rd≠x0: writeback variant.
                                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                        }
                        case FUNCT3_SLTU: {
                            if rd == 0 {
                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                } else { // rd=x0, rs1≠x0 or rs2≠x0: base compute_op.
                                    if compute_op != RTYPE_SLTU {
                                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                }
                            } else if compute_op != RTYPE_SLTU_WB { // rd≠x0: writeback variant.
                                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                        }
                        case FUNCT3_XOR: {
                            if rd == 0 {
                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                } else { // rd=x0, rs1≠x0 or rs2≠x0: base compute_op.
                                    if compute_op != RTYPE_XOR {
                                        printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
                                    }
                                }
                            } else if compute_op != RTYPE_XOR_WB { // rd≠x0: writeback variant.
                                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                fail
                            }
                        }
                        case FUNCT3_SRL: {
                            if rd == 0 {
                                // Fold: rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM.
                                if rs1 == 0 && rs2 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                                        fail
