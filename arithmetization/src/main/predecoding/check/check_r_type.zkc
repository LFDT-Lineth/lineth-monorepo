fn check_r_type(instruction_parameters:u25, opcode:Opcode, compute_op:ComputeOp, rs1_decoded:Register, rs2_decoded:Register, rd_decoded:Register) {
    var funct7:Funct7
    var funct3:Funct3
    var rs1:Register
    var rs2:Register
    var rd:Register
    funct7::rs2::rs1::funct3::rd = instruction_parameters

    var R_inst:u17 = opcode::funct3::funct7

    // Verify the raw (opcode, funct7, funct3) fields encode the claimed compute_op.
    // Fold + writeback pairing for OP/OP32:
    //   rd=x0, rs1=x0, rs2=x0 → COMPUTE_MISC_MEM; rd=x0 otherwise → base; rd≠x0 → *_WB.
    // Custom-1 precompiles are never folded (memory side effects).
    switch R_inst {
        case R_MUL: {
            if rd == 0 {
                if rs1 == 0 && rs2 == 0 {
                    if compute_op != COMPUTE_MISC_MEM {
                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                        fail
                    }
                } else if compute_op != RTYPE_MUL {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
                }
            } else if compute_op != RTYPE_MUL_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_MULH: {
            if rd == 0 {
                if rs1 == 0 && rs2 == 0 {
                    if compute_op != COMPUTE_MISC_MEM {
                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                        fail
                    }
                } else if compute_op != RTYPE_MULH {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
                }
            } else if compute_op != RTYPE_MULH_WB {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                fail
            }
        }
        case R_MULHSU: {
            if rd == 0 {
                if rs1 == 0 && rs2 == 0 {
                    if compute_op != COMPUTE_MISC_MEM {
                        printf "[ERROR] folded R-type requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
                        fail
                    }
                } else if compute_op != RTYPE_MULHSU {
                printf "[ERROR] R-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x funct7=%x)\n", compute_op, opcode, instruction_parameters, funct3, funct7
