include "fold_noop.zkc"

fn check_u_type(index:u64, instruction_parameters:u25, opcode:Opcode, compute_op:ComputeOp, rd_decoded:Register, imm_decoded:DoubleWord) {
    var imm20:u20
    var rd:Register
    imm20::rd = instruction_parameters

    // U-type has no funct3; verify the raw opcode encodes the claimed compute_op.
    // Mapping (see elf_to_json_gen decodeUTypeSemantic / utypeOpForRd):
    //   LUI -> UTYPE_LUI / UTYPE_LUI_WB, AUIPC -> UTYPE_AUIPC / UTYPE_AUIPC_WB
    switch opcode {
        case OPCODE_LUI: {
            // Check for folded rd=x0 no-op.
            if rd == 0 {
                if compute_op != COMPUTE_MISC_MEM {
                    printf "[ERROR] U-type compute_op mismatch (compute_op=%x opcode=%x params=%x)\n", compute_op, opcode, instruction_parameters
                    fail
                }
            } else if compute_op != UTYPE_LUI && compute_op != UTYPE_LUI_WB {
                    printf "[ERROR] U-type compute_op mismatch (compute_op=%x opcode=%x params=%x)\n", compute_op, opcode, instruction_parameters
                    fail
            }
        }
        case OPCODE_AUIPC: {
            if compute_op != UTYPE_AUIPC {
                if compute_op != UTYPE_AUIPC_WB {
                    printf "[ERROR] U-type compute_op mismatch (compute_op=%x opcode=%x params=%x)\n", compute_op, opcode, instruction_parameters
                    fail
                }
            }
        }
        default: {
            // Unrecognised U-type opcode → elf_to_json_gen maps to COMPUTE_INVALID.
            if compute_op != COMPUTE_INVALID {
                printf "[ERROR] invalid U-type opcode requires COMPUTE_INVALID (compute_op=%x opcode=%x params=%x)\n", compute_op, opcode, instruction_parameters
                fail
            }
            return
        }
    }

    var imm:DoubleWord = sgn_extension_u32_u64((imm20 as u32) << 12)

    // Check that the decoded operands match the raw instruction parameters.
    if rd_decoded != rd {
        printf "[ERROR] rd mismatch (index=%d compute_op=%x opcode=%x rd_decoded=%d)\n", index, compute_op, opcode, rd_decoded
        fail
    }
    if imm_decoded != imm {
        printf "[ERROR] imm mismatch (index=%d compute_op=%x opcode=%x imm_decoded=%x)\n", index, compute_op, opcode, imm_decoded
        fail
    }
}
