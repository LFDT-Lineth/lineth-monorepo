fn check_s_type(instruction_parameters:u25, opcode:Opcode, compute_op:ComputeOp, rs1_decoded:Register, rs2_decoded:Register, imm_decoded:DoubleWord) {

    var imm_sign:u1
    var funct3:Funct3
    var rs1:Register
    var rs2:Register
    var uimm5:UImm5
    var uimm6:UImm6
    imm_sign::uimm6::rs2::rs1::funct3::uimm5 = instruction_parameters

    // Verify the raw funct3 field actually encodes the claimed store compute_op.
    // Mapping (see elf_to_json_gen decodeSTypeSemantic):
    //   STORE8=0b000, STORE16=0b001, STORE32=0b010, STORE64=0b011
    switch funct3 {
        case FUNCT3_SB: {
            if compute_op != STYPE_STORE8 {
                printf "[ERROR] S-type compute_op mismatch (compute_op=%x params=%x funct3=%x)\n", compute_op, instruction_parameters, funct3
                fail
            }
        }
        case FUNCT3_SH: {
            if compute_op != STYPE_STORE16 {
                printf "[ERROR] S-type compute_op mismatch (compute_op=%x params=%x funct3=%x)\n", compute_op, instruction_parameters, funct3
                fail
            }
        }
        case FUNCT3_SW: {
            if compute_op != STYPE_STORE32 {
                printf "[ERROR] S-type compute_op mismatch (compute_op=%x params=%x funct3=%x)\n", compute_op, instruction_parameters, funct3
                fail
            }
        }
        case FUNCT3_SD: {
            if compute_op != STYPE_STORE64 {
                printf "[ERROR] S-type compute_op mismatch (compute_op=%x params=%x funct3=%x)\n", compute_op, instruction_parameters, funct3
                fail
            }
        }
        default: {
            // Unrecognised store funct3 → elf_to_json_gen maps to COMPUTE_INVALID.
            if compute_op != COMPUTE_INVALID {
                printf "[ERROR] invalid S-type funct3 requires COMPUTE_INVALID (compute_op=%x params=%x funct3=%x)\n", compute_op, instruction_parameters, funct3
                fail
            }
            return
        }
    }

    var imm:DoubleWord = sgn_extension_u12_u64(imm_sign::uimm6::uimm5)

    // Check that the decoded operands match the raw instruction parameters.
    if rs1_decoded != rs1 {
        printf "[ERROR] rs1 mismatch (compute_op=%x opcode=%x rs1_decoded=%d)\n", compute_op, opcode, rs1_decoded
        fail
    }
    if rs2_decoded != rs2 {
        printf "[ERROR] rs2 mismatch (compute_op=%x opcode=%x rs2_decoded=%d)\n", compute_op, opcode, rs2_decoded
        fail
    }
    if imm_decoded != imm {
        printf "[ERROR] imm mismatch (compute_op=%x opcode=%x imm_decoded=%x)\n", compute_op, opcode, imm_decoded
        fail
    }
}