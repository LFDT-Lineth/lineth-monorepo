fn check_s_type_operands(index:u64, instruction_parameters:u25, opcode:Opcode, compute_op:ComputeOp, rs1_decoded:Register, rs2_decoded:Register, imm_decoded:DoubleWord) {
    if opcode != OPCODE_STORE {
        printf "[ERROR] invalid S-type opcode (index=%d opcode=%x params=%x)\n", index, opcode, instruction_parameters
        fail
    }

    var imm_sign:u1
    var funct3:Funct3
    var rs1:Register
    var rs2:Register
    var uimm5:UImm5
    var uimm6:UImm6
    imm_sign::uimm6::rs2::rs1::funct3::uimm5 = instruction_parameters

    var imm:DoubleWord = sgn_extension_u12_u64(imm_sign::uimm6::uimm5)

    // Check that the decoded operands match the raw instruction parameters.
    if rs1_decoded != rs1 {
        printf "[ERROR] rs1 mismatch (index=%d compute_op=%x opcode=%x rs1_decoded=%d)\n", index, compute_op, opcode, rs1_decoded
        fail
    }
    if rs2_decoded != rs2 {
        printf "[ERROR] rs2 mismatch (index=%d compute_op=%x opcode=%x rs2_decoded=%d)\n", index, compute_op, opcode, rs2_decoded
        fail
    }
    if imm_decoded != imm {
        printf "[ERROR] imm mismatch (index=%d compute_op=%x opcode=%x imm_decoded=%x)\n", index, compute_op, opcode, imm_decoded
        fail
    }
}