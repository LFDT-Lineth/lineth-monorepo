// Mirrors isRdZeroNoop in elf_to_json_gen/main.go.
// Uses B_TYPE / U_TYPE from constants.zkc (included by the caller).

fn is_rd_zero_noop(opcode:Opcode, instruction_type:Type, rd:Register, rs1:Register, rs2:Register, funct3:Funct3, imm12:Imm12, funct7:Funct7) -> (folded:Boolean) {
    if rd != 0 {
        folded = 0 as Boolean
        return
    }
    switch instruction_type {
        case U_TYPE: {
            // lui x0, imm is folded; auipc x0, imm is not (uses PC).
            if opcode == OPCODE_LUI {
                folded = 1 as Boolean
            } else {
                folded = 0 as Boolean
            }
        }
        case B_TYPE: {
            // Branches change control flow; isRdZeroNoop has no bType arm → always false.
            folded = 0 as Boolean
        }
        default: {
            folded = 0 as Boolean
        }
    }
}
