fn check_b_type_operands(index:u64, instruction_parameters:u25, opcode:Opcode, compute_op:ComputeOp, rs1_decoded:Register, rs2_decoded:Register, imm_decoded:DoubleWord) {
    if opcode != OPCODE_BRANCH {
        printf "[ERROR] invalid B-type opcode (index=%d opcode=%x params=%x)\n", index, opcode, instruction_parameters
        fail
    }

    var funct3:Funct3
    var imm_sign:SignBit
    var imm_11:u1
    var imm_10_5:u6
    var imm_4_1:u4
    var rs1:Register
    var rs2:Register
    var imm:DoubleWord
    imm_sign::imm_10_5::rs2::rs1::funct3::imm_4_1::imm_11 = instruction_parameters

    // Reassemble imm[12:1] (sign = imm[12]) and sign-extend, then << 1 (imm[0] = 0).
    imm = sgn_extension_u12_u64(imm_sign::imm_11::imm_10_5::imm_4_1) << 1

    // Check that the decoded operands match the raw instruction parameters.
    if rs1_decoded != rs1 {
        printf "[ERROR] rs1 mismatch (index=%d compute_op=%x opcode=%x rs1_decoded=%d)\n", index, compute_op, opcode, rs1_decoded
        fail
    }
    if rs2_decoded != rs2 {
        printf "[ERROR] rs2 mismatch (index=%d compute_op=%x opcode=%x rs2_decoded=%d)\n", index, compute_op, opcode, rs2_decoded
        fail
    }
    if imm_decoded != imm {
        printf "[ERROR] imm mismatch (index=%d compute_op=%x opcode=%x imm_decoded=%x)\n", index, compute_op, opcode, imm_decoded
        fail
    }
}

