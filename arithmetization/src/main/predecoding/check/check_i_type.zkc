fn check_i_type(index:u64, instruction_parameters:u25, opcode:Opcode, compute_op:ComputeOp, rs1_decoded:Register, rd_decoded:Register, imm_decoded:DoubleWord) {
    var funct3:Funct3
    var imm12:Imm12
    var rs1:Register
    var rd:Register

    imm12::rs1::funct3::rd = instruction_parameters
    var imm:DoubleWord = sgn_extension_u12_u64(imm12)

    // Verify the raw (opcode, funct3) fields encode the claimed compute_op
    switch opcode {
        case OPCODE_LOAD: {
            switch funct3 {
                case FUNCT3_LB: {
                    if rd == 0 {
                        if compute_op != READ8_SGN {
                            printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                            fail
                        }
                    } else if compute_op != READ8_SGN_WB {
                        printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                        fail
                    }
                }
                case FUNCT3_LH: {
                    if rd == 0 {
                        if compute_op != READ16_SGN {
                            printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                            fail
                        }
                    } else if compute_op != READ16_SGN_WB {
                        printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                        fail
                    }
                }
                case FUNCT3_LW: {
                    if rd == 0 {
                        if compute_op != READ32_SGN {
                            printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                            fail
                        }
                    } else if compute_op != READ32_SGN_WB {
                        printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                        fail
                    }
                }
                case FUNCT3_LD: {
                    if rd == 0 {
                        if compute_op != READ64 {
                            printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                            fail
                        }
                    } else if compute_op != READ64_WB {
                        printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                        fail
                    }
                }
                case FUNCT3_LBU: {
                    if rd == 0 {
                        if compute_op != READ8_ZEXT {
                            printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                            fail
                        }
                    } else if compute_op != READ8_ZEXT_WB {
                        printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                        fail
                    }
                }
                case FUNCT3_LHU: {
                    if rd == 0 {
                        if compute_op != READ16_ZEXT {
                            printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                            fail
                        }
                    } else if compute_op != READ16_ZEXT_WB {
                        printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                        fail
                    }
                }
                case FUNCT3_LWU: {
                    if rd == 0 {
                        if compute_op != READ32_ZEXT {
                            printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                            fail
                        }
                    } else if compute_op != READ32_ZEXT_WB {
                        printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                        fail
                    }
                }
                default: {
                    if compute_op != COMPUTE_INVALID {
                        printf "[ERROR] invalid LOAD funct3 requires COMPUTE_INVALID (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                        fail
                    }
                    return
                }
            }
        }
        case OPCODE_OPIMM: {
            switch funct3 {
                case FUNCT3_ADDI: {
                    // Check for folded rd=x0 no-op (requires rs1=x0).
                    if rd == 0 {
                        if rs1 == 0 {
                            if compute_op != COMPUTE_MISC_MEM {
                                printf "[ERROR] folded ADDI requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                                fail
                            }
                        } else {
                            if compute_op != OP_ADDI {
                                printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                                fail
                            }
                        }
                    } else if compute_op != OP_ADDI_WB {
                        printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                        fail
                    }
                }
                case FUNCT3_SLTI: {
                    if rd == 0 {
                        if rs1 == 0 {
                            if compute_op != COMPUTE_MISC_MEM {
                                printf "[ERROR] folded SLTI requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                                fail
                            }
                        } else if compute_op != OP_SLTI {
                            printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                            fail
                        }
                    } else if compute_op != OP_SLTI_WB {
                        printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                        fail
                    }
                }
                case FUNCT3_SLTIU: {
                    if rd == 0 {
                        if rs1 == 0 {
                            if compute_op != COMPUTE_MISC_MEM {
                                printf "[ERROR] folded SLTIU requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                                fail
                            }
                        } else if compute_op != OP_SLTIU {
                            printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                            fail
                        }
                    } else if compute_op != OP_SLTIU_WB {
                        printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                        fail
                    }
                }
                case FUNCT3_XORI: {
                    if rd == 0 {
                        if rs1 == 0 {
                            if compute_op != COMPUTE_MISC_MEM {
                                printf "[ERROR] folded XORI requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                                fail
                            }
                        } else if compute_op != OP_XORI {
                            printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                            fail
                        }
                    } else if compute_op != OP_XORI_WB {
                        printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                        fail
                    }
                }
                case FUNCT3_ORI: {
                    if rd == 0 {
                        if rs1 == 0 {
                            if compute_op != COMPUTE_MISC_MEM {
                                printf "[ERROR] folded ORI requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                                fail
                            }
                        } else if compute_op != OP_ORI {
                            printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                            fail
                        }
                    } else if compute_op != OP_ORI_WB {
                        printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                        fail
                    }
                }
                case FUNCT3_ANDI: {
                    if rd == 0 {
                        if rs1 == 0 {
                            if compute_op != COMPUTE_MISC_MEM {
                                printf "[ERROR] folded ANDI requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                                fail
                            }
                        } else if compute_op != OP_ANDI {
                            printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                            fail
                        }
                    } else if compute_op != OP_ANDI_WB {
                        printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                        fail
                    }
                }
                case FUNCT3_SLLI: {
                    // SLLI: funct6 must be 0; imm is the low 6-bit shift amount.
                    var funct6:Funct6
                    var shamt6:UImm6
                    funct6::shamt6 = imm12
                    if funct6 != FUNCT6_SLLI {
                        if compute_op != COMPUTE_INVALID {
                            printf "[ERROR] invalid SLLI funct6 requires COMPUTE_INVALID (compute_op=%x opcode=%x params=%x)\n", compute_op, opcode, instruction_parameters
                            fail
                        }
                        return
                    }
                    imm = shamt6 as DoubleWord
                    if rd == 0 {
                        if rs1 == 0 {
                            if compute_op != COMPUTE_MISC_MEM {
                                printf "[ERROR] folded SLLI requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                                fail
                            }
                        } else if compute_op != OP_SLLI {
                            printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                            fail
                        }
                    } else if compute_op != OP_SLLI_WB {
                        printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                        fail
                    }
                }
                case FUNCT3_SRLI: {
                    // SRLI/SRAI: funct6 selects the op; imm is the low 6-bit shift amount.
                    var funct6:Funct6
                    var shamt6:UImm6
                    funct6::shamt6 = imm12
                    imm = shamt6 as DoubleWord
                    switch funct6 {
                        case FUNCT6_SRLI: {
                            if rd == 0 {
                                if rs1 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded SRLI requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                                        fail
                                    }
                                } else if compute_op != OP_SRLI {
                                    printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                                    fail
                                }
                            } else if compute_op != OP_SRLI_WB {
                                printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                                fail
                            }
                        }
                        case FUNCT6_SRAI: {
                            if rd == 0 {
                                if rs1 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded SRAI requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                                        fail
                                    }
                                } else if compute_op != OP_SRAI {
                                    printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                                    fail
                                }
                            } else if compute_op != OP_SRAI_WB {
                                printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                                fail
                            }
                        }
                        default: {
                            if compute_op != COMPUTE_INVALID {
                                printf "[ERROR] invalid SRLI/SRAI funct6 requires COMPUTE_INVALID (compute_op=%x opcode=%x params=%x)\n", compute_op, opcode, instruction_parameters
                                fail
                            }
                            return
                        }
                    }
                }
                default: {
                    if compute_op != COMPUTE_INVALID {
                        printf "[ERROR] invalid OPIMM funct3 requires COMPUTE_INVALID (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                        fail
                    }
                    return
                }
            }
        }
        case OPCODE_OPIMM32: {
            switch funct3 {
                case FUNCT3_ADDIW: {
                    if rd == 0 {
                        if rs1 == 0 {
                            if compute_op != COMPUTE_MISC_MEM {
                                printf "[ERROR] folded ADDIW requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                                fail
                            }
                        } else if compute_op != OP_ADDIW {
                            printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                            fail
                        }
                    } else if compute_op != OP_ADDIW_WB {
                        printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                        fail
                    }
                }
                case FUNCT3_SLLIW: {
                    // SLLIW: funct7 must be 0; imm is the low 5-bit shift amount.
                    var funct7:Funct7
                    var shamt5:UImm5
                    funct7::shamt5 = imm12
                    if funct7 != FUNCT7_SLLIW {
                        if compute_op != COMPUTE_INVALID {
                            printf "[ERROR] invalid SLLIW funct7 requires COMPUTE_INVALID (compute_op=%x opcode=%x params=%x)\n", compute_op, opcode, instruction_parameters
                            fail
                        }
                        return
                    }
                    imm = shamt5 as DoubleWord
                    if rd == 0 {
                        if rs1 == 0 {
                            if compute_op != COMPUTE_MISC_MEM {
                                printf "[ERROR] folded SLLIW requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                                fail
                            }
                        } else if compute_op != OP_SLLIW {
                            printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                            fail
                        }
                    } else if compute_op != OP_SLLIW_WB {
                        printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                        fail
                    }
                }
                case FUNCT3_SRLIW: {
                    // SRLIW/SRAIW: funct7 selects the op; imm is the low 5-bit shift amount.
                    var funct7:Funct7
                    var shamt5:UImm5
                    funct7::shamt5 = imm12
                    imm = shamt5 as DoubleWord
                    switch funct7 {
                        case FUNCT7_SRLIW: {
                            if rd == 0 {
                                if rs1 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded SRLIW requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                                        fail
                                    }
                                } else if compute_op != OP_SRLIW {
                                    printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                                    fail
                                }
                            } else if compute_op != OP_SRLIW_WB {
                                printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                                fail
                            }
                        }
                        case FUNCT7_SRAIW: {
                            if rd == 0 {
                                if rs1 == 0 {
                                    if compute_op != COMPUTE_MISC_MEM {
                                        printf "[ERROR] folded SRAIW requires COMPUTE_MISC_MEM (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                                        fail
                                    }
                                } else if compute_op != OP_SRAIW {
                                    printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                                    fail
                                }
                            } else if compute_op != OP_SRAIW_WB {
                                printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                                fail
                            }
                        }
                        default: {
                            if compute_op != COMPUTE_INVALID {
                                printf "[ERROR] invalid SRLIW/SRAIW funct7 requires COMPUTE_INVALID (compute_op=%x opcode=%x params=%x)\n", compute_op, opcode, instruction_parameters
                                fail
                            }
                            return
                        }
                    }
                }
                default: {
                    if compute_op != COMPUTE_INVALID {
                        printf "[ERROR] invalid OPIMM32 funct3 requires COMPUTE_INVALID (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                        fail
                    }
                    return
                }
            }
        }
        case OPCODE_JALR: {
            // JALR has no funct3 discrimination (see decodeITypeSemantic).
            if rd == 0 {
                if compute_op != ITYPE_JALR {
                    printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x)\n", compute_op, opcode, instruction_parameters
                    fail
                }
            } else if compute_op != ITYPE_JALR_WB {
                printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x)\n", compute_op, opcode, instruction_parameters
                fail
            }
        }
        case OPCODE_SYSTEM: {
            if funct3 != FUNCT3_ECALL {
                if compute_op != COMPUTE_INVALID {
                    printf "[ERROR] invalid SYSTEM funct3 requires COMPUTE_INVALID (compute_op=%x opcode=%x params=%x funct3=%x)\n", compute_op, opcode, instruction_parameters, funct3
                    fail
                }
                return
            }
            // ECALL/EBREAK are selected by the full imm12 field; neither writes back.
            switch imm12 {
                case FUNCT12_ECALL: {
                    if compute_op != ITYPE_ECALL {
                        printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x)\n", compute_op, opcode, instruction_parameters
                        fail
                    }
                }
                case FUNCT12_EBREAK: {
                    if compute_op != ITYPE_EBREAK {
                        printf "[ERROR] I-type compute_op mismatch (compute_op=%x opcode=%x params=%x)\n", compute_op, opcode, instruction_parameters
                        fail
                    }
                }
                default: {
                    if compute_op != COMPUTE_INVALID {
                        printf "[ERROR] invalid SYSTEM imm12 requires COMPUTE_INVALID (compute_op=%x opcode=%x params=%x imm12=%x)\n", compute_op, opcode, instruction_parameters, imm12
                        fail
                    }
                    return
                }
            }
        }
        default: {
            if compute_op != COMPUTE_INVALID {
                printf "[ERROR] invalid I-type opcode requires COMPUTE_INVALID (compute_op=%x opcode=%x params=%x)\n", compute_op, opcode, instruction_parameters
                fail
            }
            return
        }
    }

    // Check that the decoded operands match the raw instruction parameters.
    if rs1_decoded != rs1 {
        printf "[ERROR] rs1 mismatch (index=%d compute_op=%x opcode=%x rs1_decoded=%d)\n", index, compute_op, opcode, rs1_decoded
        fail
    }
    if rd_decoded != rd {
        printf "[ERROR] rd mismatch (index=%d compute_op=%x opcode=%x rd_decoded=%d)\n", index, compute_op, opcode, rd_decoded
        fail
    }
    if imm_decoded != imm {
        printf "[ERROR] imm mismatch (index=%d compute_op=%x opcode=%x imm_decoded=%x)\n", index, compute_op, opcode, imm_decoded
        fail
    }
}
