include "predecoding.zkc"
include "read_instruction.zkc"
include "../common/type.zkc"
include "inputs.zkc"


// Justify (in a one-time proof) that the raw RISC-V program in the input JSON
// corresponds to its pre-decoded instruction table - a static linear pass
// over instruction indices: read each raw word from the blob image and
// verify it matches decoded[index]
fn main() {
    var base:Address = instruction_base[0]
    var count:u64 = instruction_count[0]

    var pc:Address = base
    for index:u64 = 0; index<count; index = index + 1 {
        var instruction:Instruction = read_instruction_from_blobs(pc)
        predecoding(index, instruction)
        pc = (pc + 4) as Address
    }
}