// Read a 32-bit little-endian instruction word from the blob image
fn read_instruction_from_blobs(pc:Address) -> (instruction:Instruction) {
    var blobs_count:u64
    var entry_point:Address
    entry_point, blobs_count = entry_point_and_blobs_count[0]
    var internal_offset:Length = 0

    for i:u64 = 0; i<blobs_count; i = i + 1 {
        var blob_offset:Address
        var blob_size:Length
        blob_offset, blob_size = blobs_offset_and_size[i]

        if pc >= blob_offset && (pc + 4) <= (blob_offset + blob_size) {
            var in_blob:Address = pc - blob_offset
            var b0:Byte = blobs_data[internal_offset + in_blob]
            var b1:Byte = blobs_data[internal_offset + in_blob + 1]
            var b2:Byte = blobs_data[internal_offset + in_blob + 2]
            var b3:Byte = blobs_data[internal_offset + in_blob + 3]
            instruction = (b0 as Instruction) | ((b1 as Instruction) << 8) | ((b2 as Instruction) << 16) | ((b3 as Instruction) << 24)
            return
        }
        internal_offset = internal_offset + blob_size
    }

    // Dense-table padding slot with no backing bytes in any loadable blob.
    instruction = 0
}
