// Instruction type identifiers (must match elf_to_json_gen/main.go).
const TYPE_UNDEFINED:Type = 0
const TYPE_R:Type = 1
const TYPE_I:Type = 2
const TYPE_S:Type = 3
const TYPE_B:Type = 4
const TYPE_U:Type = 5
const TYPE_J:Type = 6
const TYPE_MISC_MEM:Type = 7

const OPCODE_MISCMEM:Opcode = 0b0001111

fn instruction_type_from_opcode(opcode:Opcode) -> (instruction_type:Type) {
    switch opcode {
        case OPCODE_OP, OPCODE_OP32, OPCODE_CUSTOM1: {
            instruction_type = TYPE_R
        }
        case OPCODE_LOAD, OPCODE_OPIMM, OPCODE_OPIMM32, OPCODE_JALR, OPCODE_SYSTEM: {
            instruction_type = TYPE_I
        }
        case OPCODE_STORE: {
            instruction_type = TYPE_S
        }
        case OPCODE_BRANCH: {
            instruction_type = TYPE_B
        }
        case OPCODE_LUI, OPCODE_AUIPC: {
            instruction_type = TYPE_U
        }
        case OPCODE_JAL: {
            instruction_type = TYPE_J
        }
        case OPCODE_MISCMEM: {
            instruction_type = TYPE_MISC_MEM
        }
        default: {
            instruction_type = TYPE_UNDEFINED
        }
    }
}
