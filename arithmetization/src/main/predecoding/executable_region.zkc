// Upper bound of the dense executable span: align-up the max end of every
// executable-flagged blob. Matches collectExecutableImage in elf_to_json_gen.
fn executable_region_end() -> (end:Address) {
    var blobs_count:u64
    var entry_point:Address
    entry_point, blobs_count = entry_point_and_blobs_count[0]
    var max_end:Address = instruction_base[0]

    for i:u64 = 0; i<blobs_count; i = i + 1 {
        var executable:u1 = blobs_executable[i]
        if executable != 0 {
            var blob_offset:Address
            var blob_size:Length
            blob_offset, blob_size = blobs_offset_and_size[i]
            var blob_end:Address = (blob_offset + blob_size) as Address
            if blob_end > max_end {
                max_end = blob_end
            }
        }
    }

    // Align up to the next 4-byte boundary
    var rem:Address = max_end % 4
    if rem != 0 {
        end = (max_end + (4 - rem)) as Address
    } else {
        end = max_end
    }
}
