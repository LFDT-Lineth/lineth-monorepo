include "../memory.zkc"
include "../utils/absolute_value.zkc"
include "../utils/bit_flip.zkc"
include "../utils/negative.zkc"
include "../utils/sign_bit.zkc"
include "../utils/sign_extend.zkc"
include "../utils/signed_comparisons.zkc"

// Process R-type instructions that write back to rd (*_WB compute_op variants).
//
// R-type instructions operate on two source registers (rs1, rs2) and write the
// result to a destination register (rd). They never affect the program counter
// (no pc parameter — the caller always advances by 4).  
// 
// In the predecoding phase, the operands for R-type instructions come from the 25-bit
// encoding (opcode stripped) that is laid out as:
// 
//   funct7 :: rs2 :: rs1 :: funct3 :: rd
//
// Runtime execution is a flat switch on *_WB compute_op variants; every case
// writes the result to registers[rd]. Dispatched from interpreter R_TYPE_WB.
//
// Supported operation groups:
//
//   Base RV64I — register arithmetic/logic (64-bit):
//     ADD, SUB, SLL, SLT, SLTU, XOR, SRL, SRA, OR, AND
//
//   RV64I *W — word-width (32-bit) variants, result sign-extended to 64 bits:
//     ADDW, SUBW, SLLW, SRLW, SRAW
//
//   M-extension — integer multiply/divide/remainder (64-bit):
//     MUL, MULH, MULHSU, MULHU, DIV, DIVU, REM, REMU
//
//   M-extension *W — word-width multiply/divide/remainder, sign-extended to 64 bits:
//     MULW, DIVW, DIVUW, REMW, REMUW
//
//   Custom-1 — Keccak precompile (no register writeback)
//
// Signed operations (SLT, SRA, MULH, MULHSU, DIV, REM, and their *W variants)
// treat register values as two's-complement integers.  Division and remainder
// follow RISC-V semantics: division by zero returns −1 (or the dividend for REM),
// and signed overflow (INT_MIN / −1) returns INT_MIN (or 0 for REM).
fn process_R_WB_type_instruction<registers, ram, state_row0, state_row1, state_row2, state_row3, state_row4, b0, b1, b2, b3, b4, c, d, padded_input_block>(index:u64) {

    var v1:DoubleWord
    var v2:DoubleWord
    var shift_discard_6:u58 // 58 + 6 = 64, used for DoubleWords
    var shift_amount_6:u6
    var shift_discard_5:u27 // 27 + 5 = 32, used for Words
    var shift_amount_5:u5
    var word_working_copy:Word
    var overflow:SignBit
    var v1_upper:Word
    var v1_lower:Word
    var v2_upper:Word
    var v2_lower:Word
    var v1_lower_abs:Word
    var v2_lower_abs:Word
    var product_upper:Word
    var product_lower:Word
    var word_wip:Word
    var result:DoubleWord

    var compute_op:RTypeComputeOp
    var rs1:Register
    var rs2:Register
    var rd:Register
    compute_op, rs1, rs2, rd = decoded_rtype[index]

    v1 = registers[rs1]
    v2 = registers[rs2]

    switch compute_op {
        case RTYPE_ADD_WB: {
            printf "RTYPE_ADD "
            print_r_operands(rd, rs1, rs2)
            overflow::result = (v1 as u65) + (v2 as u65)
            registers[rd] = result
        }
        case RTYPE_SUB_WB: {
            printf "RTYPE_SUB "
            print_r_operands(rd, rs1, rs2)
            overflow::result = ((1 as u1)::(v1 as u64)) - (v2 as u65)
            registers[rd] = result
        }
        case RTYPE_SLL_WB: {
            printf "RTYPE_SLL "
            print_r_operands(rd, rs1, rs2)
            shift_discard_6::shift_amount_6 = v2
            registers[rd] = v1 << shift_amount_6
        }
        case RTYPE_SLT_WB: {
            printf "RTYPE_SLT "
            print_r_operands(rd, rs1, rs2)
            registers[rd] = signed_LT(v1, v2) as DoubleWord
        }
        case RTYPE_SLTU_WB: {
            printf "RTYPE_SLTU "
            print_r_operands(rd, rs1, rs2)
            if (v1 < v2) {
            registers[rd] = 1
            } else {
            registers[rd] = 0
            }
        }
        case RTYPE_XOR_WB: {
            printf "RTYPE_XOR "
            print_r_operands(rd, rs1, rs2)
            registers[rd] = v1 ^ v2
        }
        case RTYPE_SRL_WB: {
            printf "RTYPE_SRL "
            print_r_operands(rd, rs1, rs2)
            shift_discard_6::shift_amount_6 = v2
            registers[rd] = v1 >> shift_amount_6
        }
        case RTYPE_SRA_WB: {
            printf "RTYPE_SRA "
            print_r_operands(rd, rs1, rs2)
            shift_discard_6::shift_amount_6 = v2
            registers[rd] = _ashr_u64(v1, shift_amount_6)
        }
        case RTYPE_OR_WB: {
            printf "RTYPE_OR "
            print_r_operands(rd, rs1, rs2)
            registers[rd] = v1 | v2
        }
        case RTYPE_AND_WB: {
            printf "RTYPE_AND "
            print_r_operands(rd, rs1, rs2)
            registers[rd] = v1 & v2
        }
        case RTYPE_MUL_WB: {
            printf "RTYPE_MUL "
            print_r_operands(rd, rs1, rs2)
            registers[rd] = (((v1 as u128) * (v2 as u128)) & MAX_UINT_64_AS_U128) as u64
        }
        case RTYPE_MULH_WB: {
            printf "RTYPE_MULH "
            print_r_operands(rd, rs1, rs2)
            var v1_times_v2_as_u128:u128 = (absolute_value_double_word(v1) as u128) * (absolute_value_double_word(v2) as u128)
            if (sign_bit_of_double_word(v1) ^ sign_bit_of_double_word(v2)) == 1 && v1_times_v2_as_u128 != 0 {
            v1_times_v2_as_u128 = (~v1_times_v2_as_u128) + 1
            }
            registers[rd] = (v1_times_v2_as_u128 >> 64) as u64
        }
        case RTYPE_MULHSU_WB: {
            printf "RTYPE_MULHSU "
            print_r_operands(rd, rs1, rs2)
            var v1_times_v2_as_u128:u128 = (absolute_value_double_word(v1) as u128) * (v2 as u128)
            if sign_bit_of_double_word(v1) == 1 && v1_times_v2_as_u128 != 0 {
            v1_times_v2_as_u128 = (~v1_times_v2_as_u128) + 1
            }
            registers[rd] = (v1_times_v2_as_u128 >> 64) as u64
        }
        case RTYPE_MULHU_WB: {
            printf "RTYPE_MULHU "
            print_r_operands(rd, rs1, rs2)
            registers[rd] = (((v1 as u128) * (v2 as u128)) >> 64) as u64
        }
        case RTYPE_DIV_WB: {
            printf "RTYPE_DIV "
            print_r_operands(rd, rs1, rs2)
            if v2 == 0 {
            result = NEGATIVE_ONE_AS_I64
            } else if (v1 == OVERFLOW_DIVIDEND) && (v2 == NEGATIVE_ONE_AS_I64) {
            result = OVERFLOW_DIVIDEND
            } else {
            result = absolute_value_double_word(v1) / absolute_value_double_word(v2)
            if (sign_bit_of_double_word(v1) ^ sign_bit_of_double_word(v2)) == 1 {
            result = negative_of_double_word(result)
            }
            }
            registers[rd] = result
        }
        case RTYPE_DIVU_WB: {
            printf "RTYPE_DIVU "
            print_r_operands(rd, rs1, rs2)
            if v2 == 0 {
            registers[rd] = NEGATIVE_ONE_AS_I64
            } else {
            registers[rd] = v1 / v2
            }
        }
        case RTYPE_REM_WB: {
            printf "RTYPE_REM "
            print_r_operands(rd, rs1, rs2)
            if v2 == 0 {
            result = v1
            } else if (v1 == OVERFLOW_DIVIDEND) && (v2 == NEGATIVE_ONE_AS_I64) {
            result = 0
            } else {
            result = absolute_value_double_word(v1) % absolute_value_double_word(v2)
            if sign_bit_of_double_word(v1) == 1 {
            result = negative_of_double_word(result)
            }
            }
            registers[rd] = result
        }
        case RTYPE_REMU_WB: {
            printf "RTYPE_REMU "
            print_r_operands(rd, rs1, rs2)
            if v2 == 0 {
            registers[rd] = v1
            } else {
            registers[rd] = v1 % v2
            }
        }
        case RTYPE_ADDW_WB: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_ADDW "
            print_r_operands(rd, rs1, rs2)
            overflow::word_wip = (v1_lower as u33) + (v2_lower as u33)
            registers[rd] = sgn_extension_u32_u64(word_wip)
        }
        case RTYPE_SUBW_WB: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_SUBW "
            print_r_operands(rd, rs1, rs2)
            overflow::word_wip = ((1 as u1)::v1_lower) - (v2_lower as u33)
            registers[rd] = sgn_extension_u32_u64(word_wip)
        }
        case RTYPE_SLLW_WB: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_SLLW "
            print_r_operands(rd, rs1, rs2)
            shift_discard_5::shift_amount_5 = v2_lower
            registers[rd] = sgn_extension_u32_u64(v1_lower << shift_amount_5)
        }
        case RTYPE_SRLW_WB: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_SRLW "
            print_r_operands(rd, rs1, rs2)
            shift_discard_5::shift_amount_5 = v2_lower
            registers[rd] = sgn_extension_u32_u64(v1_lower >> shift_amount_5)
        }
        case RTYPE_SRAW_WB: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_SRAW "
            print_r_operands(rd, rs1, rs2)
            shift_discard_5::shift_amount_5 = v2_lower
            if (sign_bit_of_word(v1_lower) == 1) {
            registers[rd] = sgn_extension_u32_u64(bit_flip_word((bit_flip_word(v1_lower) >> shift_amount_5)))
            } else {
            registers[rd] = sgn_extension_u32_u64(v1_lower >> shift_amount_5)
            }
        }
        case RTYPE_MULW_WB: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_MULW "
            print_r_operands(rd, rs1, rs2)
            product_upper::product_lower = (v1_lower as DoubleWord) * (v2_lower as DoubleWord)
            if (sign_bit_of_word(product_lower) == 1) {
            registers[rd] = MAX_UINT_32::product_lower
            } else {
            registers[rd] = product_lower as DoubleWord
            }
        }
        case RTYPE_DIVW_WB: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            print_r_operands(rd, rs1, rs2)
            if (v2_lower == 0) {
            registers[rd] = NEGATIVE_ONE_AS_I64
            } else {
            if (sign_bit_of_word(v1_lower) == sign_bit_of_word(v2_lower)) {
            registers[rd] = sgn_extension_u32_u64((absolute_value_word(v1_lower) / absolute_value_word(v2_lower)))
            } else {
            registers[rd] = sgn_extension_u32_u64(negative_of_word((absolute_value_word(v1_lower) / absolute_value_word(v2_lower))))
            }
            }
        }
        case RTYPE_DIVUW_WB: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_DIVUW "
            print_r_operands(rd, rs1, rs2)
            if (v2_lower == 0) {
            registers[rd] = NEGATIVE_ONE_AS_I64
            } else {
            registers[rd] = sgn_extension_u32_u64(v1_lower / v2_lower)
            }
        }
        case RTYPE_REMW_WB: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_REMW "
            print_r_operands(rd, rs1, rs2)
            if (v2_lower == 0) {
            registers[rd] = sgn_extension_u32_u64(v1_lower)
            } else {
            if (sign_bit_of_word(v1_lower) == 0) {
            registers[rd] = sgn_extension_u32_u64(absolute_value_word(v1_lower) % absolute_value_word(v2_lower))
            } else {
            registers[rd] = sgn_extension_u32_u64(negative_of_word((absolute_value_word(v1_lower) % absolute_value_word(v2_lower))))
            }
            }
        }
        case RTYPE_REMUW_WB: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_REMUW "
            print_r_operands(rd, rs1, rs2)
            if (v2_lower == 0) {
            registers[rd] = sgn_extension_u32_u64(v1_lower)
            } else {
            registers[rd] = sgn_extension_u32_u64(v1_lower % v2_lower)
            }
        }
        default: {
            printf "[ERROR] Unsupported R-type instruction with\n"
            printf "\tcompute_op ≡ %x\n", compute_op
            fail
        }
    }
}
