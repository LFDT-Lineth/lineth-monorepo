include "../memory.zkc"
include "../utils/absolute_value.zkc"
include "../utils/bit_flip.zkc"
include "../utils/negative.zkc"
include "../utils/sign_bit.zkc"
include "../utils/sign_extend.zkc"
include "../utils/signed_comparisons.zkc"
include "../../lib/keccak/impl.zkc"
include "../../lib/poseidon2/ram.zkc"

// Process a RISC-V R-type instruction, writing the result into the register file.
//
// R-type instructions operate on two source registers (rs1, rs2) and write the
// result to a destination register (rd).  They never affect the program counter
// (no pc parameter — the caller always advances by 4).  The 23-bit semantic
// record is pre-decoded at ELF time:
//
//   compute_op :: writeback :: rs1 :: rs2 :: rd
//
// Supported operation groups:
//
//   Base RV64I — register arithmetic/logic (64-bit):
//     ADD, SUB, SLL, SLT, SLTU, XOR, SRL, SRA, OR, AND
//
//   RV64I *W — word-width (32-bit) variants, result sign-extended to 64 bits:
//     ADDW, SUBW, SLLW, SRLW, SRAW
//
//   M-extension — integer multiply/divide/remainder (64-bit):
//     MUL, MULH, MULHSU, MULHU, DIV, DIVU, REM, REMU
//
//   M-extension *W — word-width multiply/divide/remainder, sign-extended to 64 bits:
//     MULW, DIVW, DIVUW, REMW, REMUW
//
//   Custom-1 — Keccak precompile (no register writeback)
//
// Signed operations (SLT, SRA, MULH, MULHSU, DIV, REM, and their *W variants)
// treat register values as two's-complement integers.  Division and remainder
// follow RISC-V semantics: division by zero returns −1 (or the dividend for REM),
// and signed overflow (INT_MIN / −1) returns INT_MIN (or 0 for REM).
fn process_R_type_instruction<registers, ram, state_row0, state_row1, state_row2, state_row3, state_row4, b0, b1, b2, b3, b4, c, d, padded_input_block, opcode_stats,poseidon2_state>(index:u64) {

    var v1:DoubleWord
    var v2:DoubleWord
    var v1_sign:SignBit
    var v2_sign:SignBit
    var v1_abs:UnsignedDoubleWord
    var v2_abs:UnsignedDoubleWord
    var shift_discard_6:u58 // 58 + 6 = 64, used for DoubleWords
    var shift_amount_6:u6
    var shift_discard_5:u27 // 27 + 5 = 32, used for Words
    var shift_amount_5:u5
    var word_working_copy:Word
    var overflow:SignBit
    var v1_upper:Word
    var v1_lower:Word
    var v2_upper:Word
    var v2_lower:Word
    var v1_lower_abs:Word
    var v2_lower_abs:Word
    var product_upper:Word
    var product_lower:Word
    var word_wip:Word

    var compute_op:RTypeComputeOp
    var writeback:ITypeWriteback
    var rs1:Register
    var rs2:Register
    var rd:Register
    compute_op, writeback, rs1, rs2, rd = decoded_rtype[index]

    v1 = registers[rs1]
    v2 = registers[rs2]

    // Note. If x = 0b... and y = 0b... are two bit strings of length N
    // and you interpret them either as uintN or intN, then the underlying
    // bit string of their additions is the same in both interpretations.
    // This also holds for subtraction.

    switch compute_op {
        case RTYPE_ADD: {
            printf "RTYPE_ADD "
            print_r_operands(rd, rs1, rs2)
            overflow::result = (v1 as u65) + (v2 as u65)
            result = result
        }
        case RTYPE_SUB: {
            printf "RTYPE_SUB "
            print_r_operands(rd, rs1, rs2)
            overflow::result = ((1 as u1)::(v1 as u64)) - (v2 as u65)
            result = result
        }
        case RTYPE_SLL: {
            printf "RTYPE_SLL "
            print_r_operands(rd, rs1, rs2)
            shift_discard_6::shift_amount_6 = v2
            result = v1 << shift_amount_6
        }
        case RTYPE_SLT: {
            printf "RTYPE_SLT "
            print_r_operands(rd, rs1, rs2)
            result = signed_LT(v1, v2) as DoubleWord
        }
        case RTYPE_SLTU: {
            printf "RTYPE_SLTU "
            print_r_operands(rd, rs1, rs2)
            if (v1 < v2) {
                result = 1
            } else {
                result = 0
            }
        }
        case RTYPE_XOR: {
            printf "RTYPE_XOR "
            print_r_operands(rd, rs1, rs2)
            result = v1 ^ v2
        }
        case RTYPE_SRL: {
            printf "RTYPE_SRL "
            print_r_operands(rd, rs1, rs2)
            shift_discard_6::shift_amount_6 = v2
            result = v1 >> shift_amount_6
        }
        case RTYPE_SRA: {
            printf "RTYPE_SRA "
            print_r_operands(rd, rs1, rs2)
            v1_sign = sign_bit_of_double_word(v1)
            shift_discard_6::shift_amount_6 = v2
            if (v1_sign == 1) {
                result = bit_flip_double_word(v1)
            } else {
                result = v1
            }
            result = result >> shift_amount_6
            if (v1_sign == 1) {
                result = bit_flip_double_word(result)
            }
            result = result
        }
        case RTYPE_OR: {
            printf "RTYPE_OR "
            print_r_operands(rd, rs1, rs2)
            result = v1 | v2
        }
        case RTYPE_AND: {
            printf "RTYPE_AND "
            print_r_operands(rd, rs1, rs2)
            result = v1 & v2
        }
        case RTYPE_MUL: {
            printf "RTYPE_MUL "
            print_r_operands(rd, rs1, rs2)
            result = (((v1 as u128) * (v2 as u128)) & MAX_UINT_64_AS_U128) as u64
        }
        case RTYPE_MULH: {
            printf "RTYPE_MULH "
            print_r_operands(rd, rs1, rs2)
            v1_sign = sign_bit_of_double_word(v1)
            v2_sign = sign_bit_of_double_word(v2)
            v1_abs = absolute_value_double_word(v1)
            v2_abs = absolute_value_double_word(v2)
            var v1_times_v2_as_u128:u128 = (v1_abs as u128) * (v2_abs as u128)
            if (v1_sign ^ v2_sign) == 1 && v1_times_v2_as_u128 != 0 {
                v1_times_v2_as_u128 = (~v1_times_v2_as_u128) + 1
            }
            result = (v1_times_v2_as_u128 >> 64) as u64
        }
        case RTYPE_MULHSU: {
            printf "RTYPE_MULHSU "
            print_r_operands(rd, rs1, rs2)
            v1_abs = absolute_value_double_word(v1)
            var v1_times_v2_as_u128:u128 = (v1_abs as u128) * (v2 as u128)
            v1_sign = sign_bit_of_double_word(v1)
            if v1_sign == 1 && v1_times_v2_as_u128 != 0 {
                v1_times_v2_as_u128 = (~v1_times_v2_as_u128) + 1
            }
            result = (v1_times_v2_as_u128 >> 64) as u64
        }
        case RTYPE_MULHU: {
            printf "RTYPE_MULHU "
            print_r_operands(rd, rs1, rs2)
            result = (((v1 as u128) * (v2 as u128)) >> 64) as u64
        }
        case RTYPE_DIV: {
            printf "RTYPE_DIV "
            print_r_operands(rd, rs1, rs2)
            if v2 == 0 {
                result = NEGATIVE_ONE_AS_I64
            } else if (v1 == OVERFLOW_DIVIDEND) && (v2 == NEGATIVE_ONE_AS_I64) {
                result = OVERFLOW_DIVIDEND
            } else {
                v1_sign = sign_bit_of_double_word(v1)
                v2_sign = sign_bit_of_double_word(v2)
                v1_abs = absolute_value_double_word(v1)
                v2_abs = absolute_value_double_word(v2)
                result = v1_abs / v2_abs
                if (v1_sign ^ v2_sign) == 1 {
                    result = negative_of_double_word(result)
                }
            }
        }
        case RTYPE_DIVU: {
            printf "RTYPE_DIVU "
            print_r_operands(rd, rs1, rs2)
            if v2 == 0 {
                result = NEGATIVE_ONE_AS_I64
            } else {
                result = v1 / v2
            }
        }
        case RTYPE_REM: {
            printf "RTYPE_REM "
            print_r_operands(rd, rs1, rs2)
            if v2 == 0 {
                result = v1
            } else if (v1 == OVERFLOW_DIVIDEND) && (v2 == NEGATIVE_ONE_AS_I64) {
                result = 0
            } else {
                v1_sign = sign_bit_of_double_word(v1)
                v1_abs = absolute_value_double_word(v1)
                v2_abs = absolute_value_double_word(v2)
                result = v1_abs % v2_abs
                if v1_sign == 1 {
                    result = negative_of_double_word(result)
                }
            }
        }
        case RTYPE_REMU: {
            printf "RTYPE_REMU "
            print_r_operands(rd, rs1, rs2)
            if v2 == 0 {
                result = v1
            } else {
                result = v1 % v2
            }
        }
        case RTYPE_ADDW: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_ADDW "
            print_r_operands(rd, rs1, rs2)
            overflow::word_wip = (v1_lower as u33) + (v2_lower as u33)
            result = sgn_extension_u32_u64(word_wip)
        }
        case RTYPE_SUBW: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_SUBW "
            print_r_operands(rd, rs1, rs2)
            overflow::word_wip = ((1 as u1)::v1_lower) - (v2_lower as u33)
            result = sgn_extension_u32_u64(word_wip)
        }
        case RTYPE_SLLW: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_SLLW "
            print_r_operands(rd, rs1, rs2)
            shift_discard_5::shift_amount_5 = v2_lower
            result = sgn_extension_u32_u64(v1_lower << shift_amount_5)
        }
        case RTYPE_SRLW: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_SRLW "
            print_r_operands(rd, rs1, rs2)
            shift_discard_5::shift_amount_5 = v2_lower
            result = sgn_extension_u32_u64(v1_lower >> shift_amount_5)
        }
        case RTYPE_SRAW: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_SRAW "
            print_r_operands(rd, rs1, rs2)
            shift_discard_5::shift_amount_5 = v2_lower
            if (sign_bit_of_word(v1_lower) == 1) {
                word_working_copy = bit_flip_word(v1_lower)
            } else {
                word_working_copy = v1_lower
            }
            word_working_copy = word_working_copy >> shift_amount_5
            if (sign_bit_of_word(v1_lower) == 1) {
                word_working_copy = bit_flip_word(word_working_copy)
            }
            result = sgn_extension_u32_u64(word_working_copy)
        }
        case RTYPE_MULW: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_MULW "
            print_r_operands(rd, rs1, rs2)
            product_upper::product_lower = (v1_lower as DoubleWord) * (v2_lower as DoubleWord)
            sign_bit = sign_bit_of_word(product_lower)
            if (sign_bit == 1) {
                result = MAX_UINT_32::product_lower
            } else {
                result = product_lower as DoubleWord
            }
        }
        case RTYPE_DIVW: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            v1_lower_abs = absolute_value_word(v1_lower)
            v2_lower_abs = absolute_value_word(v2_lower)
            printf "RTYPE_DIVW "
            print_r_operands(rd, rs1, rs2)
            if (v2_lower == 0) {
                result = NEGATIVE_ONE_AS_I64
            } else {
                word_wip = v1_lower_abs / v2_lower_abs
                if (sign_bit_of_word(v1_lower) == sign_bit_of_word(v2_lower)) {
                    result = sgn_extension_u32_u64(word_wip)
                } else {
                    result = sgn_extension_u32_u64(negative_of_word(word_wip))
                }
            }
        }
        case RTYPE_DIVUW: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_DIVUW "
            print_r_operands(rd, rs1, rs2)
            if (v2_lower == 0) {
                result = NEGATIVE_ONE_AS_I64
            } else {
                result = sgn_extension_u32_u64(v1_lower / v2_lower)
            }
        }
        case RTYPE_REMW: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            v1_lower_abs = absolute_value_word(v1_lower)
            v2_lower_abs = absolute_value_word(v2_lower)
            printf "RTYPE_REMW "
            print_r_operands(rd, rs1, rs2)
            if (v2_lower == 0) {
                result = sgn_extension_u32_u64(v1_lower)
            } else {
                word_wip = v1_lower_abs % v2_lower_abs
                if (sign_bit_of_word(v1_lower) == 0) {
                    result = sgn_extension_u32_u64(word_wip)
                } else {
                    result = sgn_extension_u32_u64(negative_of_word(word_wip))
                }
            }
        }
        case RTYPE_REMUW: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_REMUW "
            print_r_operands(rd, rs1, rs2)
            if (v2_lower == 0) {
                result = sgn_extension_u32_u64(v1_lower)
            } else {
                result = sgn_extension_u32_u64(v1_lower % v2_lower)
            }
        }
        case RTYPE_KECCAK: {
            printf "RTYPE_KECCAK "
            keccak(v1 as Address, v2 as u32, registers[rd] as Address)
            return
        }
        case RTYPE_INVALID: {
            printf "[ERROR] Unsupported R-type instruction (invalid semantic op)\n"
            fail
        }
        default: {
            printf "[ERROR] Unsupported R-type instruction with\n"
            printf "\tcompute_op ≡ %x\n", compute_op
            fail
        }
    }

    switch writeback {
        case WB_STORE_REG: {
            registers[rd] = result
        }
        case WB_NONE: {
            // no register writeback
        }
        default: {
            printf "[ERROR] Unsupported R-type writeback %d\n", writeback
            fail
        }
    }
}
