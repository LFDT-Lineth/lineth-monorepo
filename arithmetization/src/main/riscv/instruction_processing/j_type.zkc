include "../memory.zkc"
include "../utils/constants.zkc"
include "../utils/signed_sum.zkc"

// Process a RISC-V J-type instruction (JAL Jump and Link) and return the next
// program counter.
//
// J-type semantics are pre-decoded at ELF time into a semantic compute op and
// operands (see decoded_jtype in memory.zkc).
//
// In the predecoding phase, the operands for J-type instructions come from a
// common 25-bit encoding (opcode stripped) that is laid out as:
//
//   imm[20] :: imm[10:1] :: imm[11] :: imm[19:12] :: rd
//
// The 21-bit signed jump offset is then reassembled:
//
//  var imm21:u21 = ((imm20::imm19_12::imm11::imm10_1) as u21) << 1
//
// and sign-extended into `imm`:
//
//  var imm:DoubleWord = sgn_extension_u21_u64(imm21)
//
// Runtime execution is a flat switch on compute_op with separate cases for
// JTYPE_JAL (jump only) and JTYPE_JAL_WB (jump + link writeback when rd is
// not x0). Invalid opcodes (JTYPE_INVALID) fall through to default.
//
// Effect:
//   JTYPE_JAL    — pc_new = pc + imm
//   JTYPE_JAL_WB — pc_new = pc + imm; rd = pc + 4
//
fn process_J_type_instruction<registers>(index:u64, pc:Address) -> (pc_new:Address) {

    var compute_op:JTypeComputeOp
    var imm:DoubleWord
    var rd:Register
    compute_op, imm, rd = decoded_jtype[index]

    switch compute_op {
        case JTYPE_JAL: {
            printf "JTYPE_JAL "
            print_j_operands(rd, imm)
            pc_new = signed_sum_of_double_word(pc, imm) as Address
        }
        case JTYPE_JAL_WB: {
            printf "JTYPE_JAL "
            print_j_operands(rd, imm)
            pc_new = signed_sum_of_double_word(pc, imm) as Address
            registers[rd] = signed_sum_of_double_word(pc, 4)
        }
        default: {
            printf "[ERROR] Unsupported J-type instruction with\n"
            printf "\tcompute_op ≡ %x\n", compute_op
            fail
        }
    }
}
