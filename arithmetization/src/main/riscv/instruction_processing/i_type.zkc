include "../memory.zkc"
include "../ram/read.zkc"
include "../utils/constants.zkc"
include "../utils/signed_comparisons.zkc"
include "../utils/sign_extend.zkc"
include "../utils/signed_sum.zkc"

// Process a RISC-V I-type instruction and return the next program counter.
//
// I-type semantics are pre-decoded at ELF time into a semantic compute op,
// a writeback kind, and operands (see decoded_itype in memory.zkc). Runtime
// execution is a flat switch on compute_op (READ*, OP*, JALR, ECALL, …)
// followed by a separate STORE_REG writeback step when applicable.
fn process_I_type_instruction<ram, registers>(index:u64, pc:Address) -> (new_pc:Address) {

    var compute_op:ITypeComputeOp
    var writeback:ITypeWriteback
    var imm12:Imm12
    var rs1:Register
    var rd:Register
    compute_op, writeback, imm12, rs1, rd = decoded_itype[index]

    var signext_imm12_64:DoubleWord = sgn_extension_u12_u64(imm12)
    var rs1_plus_signext_imm12:u64 = signed_sum_of_double_word(registers[rs1], signext_imm12_64)
    var result:DoubleWord
    new_pc = (pc + 4) as Address

    switch compute_op {

        // ===============================
        // ----- READ (loads) -----
        // ===============================

        case READ8_SGN: {
            printf "LB "
            print_i_memory_operands(rd, rs1, signext_imm12_64)
            result = sgn_extension_u8_u64(read_8(rs1_plus_signext_imm12))
        }
        case READ16_SGN: {
            printf "LH "
            print_i_memory_operands(rd, rs1, signext_imm12_64)
            result = sgn_extension_u16_u64(read_16(rs1_plus_signext_imm12))
        }
        case READ32_SGN: {
            printf "LW "
            print_i_memory_operands(rd, rs1, signext_imm12_64)
            result = sgn_extension_u32_u64(read_32(rs1_plus_signext_imm12))
        }
        case READ64: {
            printf "LD "
            print_i_memory_operands(rd, rs1, signext_imm12_64)
            result = read_64(rs1_plus_signext_imm12) as DoubleWord
        }
        case READ8_ZEXT: {
            printf "LBU "
            print_i_memory_operands(rd, rs1, signext_imm12_64)
            result = read_8(rs1_plus_signext_imm12) as DoubleWord
        }
        case READ16_ZEXT: {
            printf "LHU "
            print_i_memory_operands(rd, rs1, signext_imm12_64)
            result = read_16(rs1_plus_signext_imm12) as DoubleWord
        }
        case READ32_ZEXT: {
            printf "LWU "
            print_i_memory_operands(rd, rs1, signext_imm12_64)
            result = read_32(rs1_plus_signext_imm12) as DoubleWord
        }

        // ===================================
        // ----- OP-IMM -----
        // ===================================

        case OP_ADDI: {
            printf "ADDI "
            print_i_operands(rd, rs1, signext_imm12_64)
            result = rs1_plus_signext_imm12
        }
        case OP_SLLI: {
            var uimm6:UImm6 = imm12 as UImm6
            printf "SLLI "
            print_i_shift6_operands(rd, rs1, uimm6)
            result = registers[rs1] << uimm6
        }
        case OP_SLTI: {
            printf "SLTI "
            print_i_operands(rd, rs1, signext_imm12_64)
            var is_lt:Boolean = signed_LT(registers[rs1], signext_imm12_64)
            if is_lt == 1 {
                result = 1
            } else {
                result = 0
            }
        }
        case OP_SLTIU: {
            printf "SLTIU "
            print_i_operands(rd, rs1, signext_imm12_64)
            if registers[rs1]<signext_imm12_64 {
                result = 1
            } else {
                result = 0
            }
        }
        case OP_XORI: {
            printf "XORI "
            print_i_operands(rd, rs1, signext_imm12_64)
            result = registers[rs1] ^ signext_imm12_64
        }
        case OP_SRLI: {
            var uimm6:UImm6 = imm12 as UImm6
            printf "SRLI "
            print_i_shift6_operands(rd, rs1, uimm6)
            result = registers[rs1] >> uimm6
        }
        case OP_SRAI: {
            var uimm6:UImm6 = imm12 as UImm6
            printf "SRAI "
            print_i_shift6_operands(rd, rs1, uimm6)
            result = _ashr_u64(registers[rs1], uimm6)
        }
        case OP_ORI: {
            printf "ORI "
            print_i_operands(rd, rs1, signext_imm12_64)
            result = registers[rs1] | signext_imm12_64
        }
        case OP_ANDI: {
            printf "ANDI "
            print_i_operands(rd, rs1, signext_imm12_64)
            result = registers[rs1] & signext_imm12_64
        }

        // ===================================
        // ----- OP-IMM-32 (RV64 *W) -----
        // ===================================

        case OP_ADDIW: {
            printf "ADDIW "
            print_i_operands(rd, rs1, signext_imm12_64)
            result = sgn_extension_u32_u64((rs1_plus_signext_imm12 & MAX_UINT_32_AS_U64) as Word)
        }
        case OP_SLLIW: {
            var uimm5:UImm5 = imm12 as UImm5
            printf "SLLIW "
            print_i_shift5_operands(rd, rs1, uimm5)
            result = sgn_extension_u32_u64(((registers[rs1] & MAX_UINT_32_AS_U64) as Word) << uimm5)
        }
        case OP_SRLIW: {
            var uimm5:UImm5 = imm12 as UImm5
            printf "SRLIW "
            print_i_shift5_operands(rd, rs1, uimm5)
            result = sgn_extension_u32_u64(((registers[rs1] & MAX_UINT_32_AS_U64) as Word) >> uimm5)
        }
        case OP_SRAIW: {
            var uimm5:UImm5 = imm12 as UImm5
            printf "SRAIW "
            print_i_shift5_operands(rd, rs1, uimm5)
            result = sgn_extension_u32_u64(_ashr_u32(registers[rs1], uimm5))
        }

        // =================
        // ----- JALR -----
        // =================

        case ITYPE_JALR: {
            printf "JALR "
            print_i_memory_operands(rd, rs1, signext_imm12_64)
            result = (pc + 4) as DoubleWord
            new_pc = rs1_plus_signext_imm12 & MASK_64_ERASE_LAST_BIT
        }

        // ===================
        // ----- SYSTEM -----
        // ===================

        case ITYPE_ECALL: {
            printf "ECALL\n"
            new_pc = process_syscall(pc)
            return
        }
        case ITYPE_EBREAK: {
            printf "[ERROR] EBREAK instruction triggered\n"
            fail
        }
        case ITYPE_INVALID: {
            printf "[ERROR] Unsupported I-Type instruction (invalid semantic op)\n"
            fail
        }
        default: {
            printf "[ERROR] Unsupported I-Type instruction with\n"
            printf "\tcompute_op ≡ %x\n", compute_op
            fail
        }
    }

    switch writeback {
        case WB_STORE_REG: {
            if (rd != 0) {
                registers[rd] = result
            }
        }
        case WB_NONE: {
            // no register writeback
        }
        default: {
            printf "[ERROR] Unsupported I-Type writeback %d\n", writeback
            fail
        }
    }
}

fn process_syscall<registers, ram>(pc:Address) -> (new_pc:Address) {
    var call_num:DoubleWord = registers[17]
    //
    switch call_num {
        case EXIT_SYSCALL: { // exit
            printf "ECALL for exit\n"
            var a0:DoubleWord = registers[10] // exit code
            if a0 == 0 {
                printf "EXIT CODE = 0\n"
            } else {
                fail "EXIT CODE = %d\n", a0
            }
            // set stop signal to terminate execution
            new_pc = MAX_UINT_64
        }
        case WRITE_SYSCALL: {
            // write(fd, buf, count) — Linux RISC-V syscall convention
            // a0 = fd (ignored — we treat every write as going to stdout);
            // a1 = pointer to byte buffer in RAM;
            // a2 = number of bytes to write.
            // ACT4's RVMODEL_IO_WRITE_STR (in rvmodel_macros.h) issues this
            // syscall so the framework's failure messages (failing PC,
            // label, expected vs actual) surface on our printf channel
            // verbatim — each byte is rendered as its ASCII character via
            // the zkc %c format specifier (issue #1759).
            printf "ECALL for write\n"
            var a1:Address = registers[11] as Address // buf
            var a2:DoubleWord = registers[12] // count
            var addr:Address = a1
            for i:DoubleWord = 0; i<a2; i = i + 1 {
                printf "%c", read_8(addr)
                addr = addr + 1
            }
            printf "\n"
            registers[10] = a2 // return value: bytes written
            new_pc = (pc + 4) as Address
        }
        default: {
            fail "unsupported system call (%d)", call_num
        }
    }
}
