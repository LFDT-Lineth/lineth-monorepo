include "../memory.zkc"
include "../ram/read.zkc"
include "../utils/constants.zkc"
include "../utils/signed_comparisons.zkc"
include "../utils/sign_extend.zkc"
include "../utils/signed_sum.zkc"

// Process a RISC-V I-type instruction and return the next program counter.
//
// I-type semantics are pre-decoded at ELF time into a semantic compute op and
// operands (see decoded_itype in memory.zkc).
//
// In the predecoding phase, the operands for I-type instructions come from a
// common 25-bit encoding (opcode stripped) that is laid out as:
//
//   imm12 :: rs1 :: funct3 :: rd
//
// Each operation that may write rd has a pair of opcodes: BASE (compute only)
// and BASE_WB (compute + registers[rd] = result). When rd is x0, the BASE
// opcode is encoded at ELF time; otherwise BASE_WB is used. Shift amounts are
// normalized at ELF time; the immediate is sign-extended into `imm`: 
//
// var signext_imm12_64:DoubleWord = sgn_extension_u12_u64(imm12)
// var imm:u64 = signed_sum_of_double_word(registers[rs1], signext_imm12_64)
//
// Runtime execution is a flat switch on compute_op. Invalid opcodes (ITYPE_INVALID)
// are handled by the default arm.
//
fn process_I_type_instruction<ram, registers>(index:u64, pc:Address) -> (new_pc:Address) {

    var compute_op:ITypeComputeOp
    var imm:DoubleWord
    var rs1:Register
    var rd:Register
    compute_op, imm, rs1, rd = decoded_itype[index]

    var rs1_plus_imm:u64 = signed_sum_of_double_word(registers[rs1], imm)
    var result:DoubleWord

    new_pc = (pc + 4) as Address

    switch compute_op {

        // ===============================
        // ----- READ (loads) -----
        // ===============================

        case READ8_SGN: {
            printf "READ8_SGN "
            print_i_memory_operands(rd, rs1, imm)
            result = sgn_extension_u8_u64(read_8(rs1_plus_imm))
        }
        case READ8_SGN_WB: {
            printf "READ8_SGN "
            print_i_memory_operands(rd, rs1, imm)
            registers[rd] = sgn_extension_u8_u64(read_8(rs1_plus_imm))
        }
        case READ16_SGN: {
            printf "READ16_SGN "
            print_i_memory_operands(rd, rs1, imm)
            result = sgn_extension_u16_u64(read_16(rs1_plus_imm))
        }
        case READ16_SGN_WB: {
            printf "READ16_SGN "
            print_i_memory_operands(rd, rs1, imm)
            registers[rd] = sgn_extension_u16_u64(read_16(rs1_plus_imm))
        }
        case READ32_SGN: {
            printf "READ32_SGN "
            print_i_memory_operands(rd, rs1, imm)
            result = sgn_extension_u32_u64(read_32(rs1_plus_imm))
        }
        case READ32_SGN_WB: {
            printf "READ32_SGN "
            print_i_memory_operands(rd, rs1, imm)
            registers[rd] = sgn_extension_u32_u64(read_32(rs1_plus_imm))
        }
        case READ64: {
            printf "READ64 "
            print_i_memory_operands(rd, rs1, imm)
            result = read_64(rs1_plus_imm) as DoubleWord
        }
        case READ64_WB: {
            printf "READ64 "
            print_i_memory_operands(rd, rs1, imm)
            registers[rd] = read_64(rs1_plus_imm) as DoubleWord
        }
        case READ8_ZEXT: {
            printf "READ8_ZEXT "
            print_i_memory_operands(rd, rs1, imm)
            result = read_8(rs1_plus_imm) as DoubleWord
        }
        case READ8_ZEXT_WB: {
            printf "READ8_ZEXT "
            print_i_memory_operands(rd, rs1, imm)
            registers[rd] = read_8(rs1_plus_imm) as DoubleWord
        }
        case READ16_ZEXT: {
            printf "READ16_ZEXT "
            print_i_memory_operands(rd, rs1, imm)
            result = read_16(rs1_plus_imm) as DoubleWord
        }
        case READ16_ZEXT_WB: {
            printf "READ16_ZEXT "
            print_i_memory_operands(rd, rs1, imm)
            registers[rd] = read_16(rs1_plus_imm) as DoubleWord
        }
        case READ32_ZEXT: {
            printf "READ32_ZEXT "
            print_i_memory_operands(rd, rs1, imm)
            result = read_32(rs1_plus_imm) as DoubleWord
        }
        case READ32_ZEXT_WB: {
            printf "READ32_ZEXT "
            print_i_memory_operands(rd, rs1, imm)
            registers[rd] = read_32(rs1_plus_imm) as DoubleWord
        }

        // ===================================
        // ----- OP-IMM -----
        // ===================================

        case OP_ADDI: {
            printf "OP_ADDI "
            print_i_operands(rd, rs1, imm)
            result = rs1_plus_imm
        }
        case OP_ADDI_WB: {
            printf "OP_ADDI "
            print_i_operands(rd, rs1, imm)
            registers[rd] = rs1_plus_imm
        }
        case OP_SLLI: {
            var uimm6:UImm6 = imm as UImm6
            printf "OP_SLLI "
            print_i_shift6_operands(rd, rs1, uimm6)
            result = registers[rs1] << uimm6
        }
        case OP_SLLI_WB: {
            var uimm6:UImm6 = imm as UImm6
            printf "OP_SLLI "
            print_i_shift6_operands(rd, rs1, uimm6)
            registers[rd] = registers[rs1] << uimm6
        }
        case OP_SLTI: {
            printf "OP_SLTI "
            print_i_operands(rd, rs1, imm)
            result = signed_LT(registers[rs1], imm) as DoubleWord
        }
        case OP_SLTI_WB: {
            printf "OP_SLTI "
            print_i_operands(rd, rs1, imm)
            registers[rd] = signed_LT(registers[rs1], imm) as DoubleWord
        }
        case OP_SLTIU: {
            printf "OP_SLTIU "
            print_i_operands(rd, rs1, imm)
            // Warn: this is an unsigned comparison (even if imm12 is SGN_EXT)
            result = registers[rs1] < imm ? 1 : 0
        }
        case OP_SLTIU_WB: {
            printf "OP_SLTIU "
            print_i_operands(rd, rs1, imm)
            // Warn: this is an unsigned comparison (even if imm12 is SGN_EXT)
            registers[rd] = registers[rs1] < imm ? 1 : 0
        }
        case OP_XORI: {
            printf "OP_XORI "
            print_i_operands(rd, rs1, imm)
            result = registers[rs1] ^ imm
        }
        case OP_XORI_WB: {
            printf "OP_XORI "
            print_i_operands(rd, rs1, imm)
            registers[rd] = registers[rs1] ^ imm
        }
        case OP_SRLI: {
            var uimm6:UImm6 = imm as UImm6
            printf "OP_SRLI "
            print_i_shift6_operands(rd, rs1, uimm6)
            result = registers[rs1] >> uimm6
        }
        case OP_SRLI_WB: {
            var uimm6:UImm6 = imm as UImm6
            printf "OP_SRLI "
            print_i_shift6_operands(rd, rs1, uimm6)
            registers[rd] = registers[rs1] >> uimm6
        }
        case OP_SRAI: {
            var uimm6:UImm6 = imm as UImm6
            printf "OP_SRAI "
            print_i_shift6_operands(rd, rs1, uimm6)
            result = _ashr_u64(registers[rs1], uimm6)
        }
        case OP_SRAI_WB: {
            var uimm6:UImm6 = imm as UImm6
            printf "OP_SRAI "
            print_i_shift6_operands(rd, rs1, uimm6)
            registers[rd] = _ashr_u64(registers[rs1], uimm6)
        }
        case OP_ORI: {
            printf "OP_ORI "
            print_i_operands(rd, rs1, imm)
            result = registers[rs1] | imm
        }
        case OP_ORI_WB: {
            printf "OP_ORI "
            print_i_operands(rd, rs1, imm)
            registers[rd] = registers[rs1] | imm
        }
        case OP_ANDI: {
            printf "OP_ANDI "
            print_i_operands(rd, rs1, imm)
            result = registers[rs1] & imm
        }
        case OP_ANDI_WB: {
            printf "OP_ANDI "
            print_i_operands(rd, rs1, imm)
            registers[rd] = registers[rs1] & imm
        }

        // ===================================
        // ----- OP-IMM-32 (RV64 *W) -----
        // ===================================

        case OP_ADDIW: {
            printf "OP_ADDIW "
            print_i_operands(rd, rs1, imm)
            result = sgn_extension_u32_u64((rs1_plus_imm & MAX_UINT_32_AS_U64) as Word)
        }
        case OP_ADDIW_WB: {
            printf "OP_ADDIW "
            print_i_operands(rd, rs1, imm)
            registers[rd] = sgn_extension_u32_u64((rs1_plus_imm & MAX_UINT_32_AS_U64) as Word)
        }
        case OP_SLLIW: {
            var uimm5:UImm5 = imm as UImm5
            printf "OP_SLLIW "
            print_i_shift5_operands(rd, rs1, uimm5)
            result = sgn_extension_u32_u64(((registers[rs1] & MAX_UINT_32_AS_U64) as Word) << uimm5)
        }
        case OP_SLLIW_WB: {
            var uimm5:UImm5 = imm as UImm5
            printf "OP_SLLIW "
            print_i_shift5_operands(rd, rs1, uimm5)
            registers[rd] = sgn_extension_u32_u64(((registers[rs1] & MAX_UINT_32_AS_U64) as Word) << uimm5)
        }
        case OP_SRLIW: {
            var uimm5:UImm5 = imm as UImm5
            printf "OP_SRLIW "
            print_i_shift5_operands(rd, rs1, uimm5)
            result = sgn_extension_u32_u64(((registers[rs1] & MAX_UINT_32_AS_U64) as Word) >> uimm5)
        }
        case OP_SRLIW_WB: {
            var uimm5:UImm5 = imm as UImm5
            printf "OP_SRLIW "
            print_i_shift5_operands(rd, rs1, uimm5)
            registers[rd] = sgn_extension_u32_u64(((registers[rs1] & MAX_UINT_32_AS_U64) as Word) >> uimm5)
        }
        case OP_SRAIW: {
            var uimm5:UImm5 = imm as UImm5
            printf "OP_SRAIW "
            print_i_shift5_operands(rd, rs1, uimm5)
            result = sgn_extension_u32_u64(_ashr_u32(registers[rs1], uimm5))
        }
        case OP_SRAIW_WB: {
            var uimm5:UImm5 = imm as UImm5
            printf "OP_SRAIW "
            print_i_shift5_operands(rd, rs1, uimm5)
            registers[rd] = sgn_extension_u32_u64(_ashr_u32(registers[rs1], uimm5))
        }

        // =================
        // ----- JALR -----
        // =================

        case ITYPE_JALR: {
            printf "ITYPE_JALR "
            print_i_memory_operands(rd, rs1, imm)
            result = (pc + 4) as DoubleWord
            new_pc = rs1_plus_imm & MASK_64_ERASE_LAST_BIT
        }
        case ITYPE_JALR_WB: {
            printf "ITYPE_JALR "
            print_i_memory_operands(rd, rs1, imm)
            new_pc = rs1_plus_imm & MASK_64_ERASE_LAST_BIT
            registers[rd] = (pc + 4) as DoubleWord
        }

        // ===================
        // ----- SYSTEM -----
        // ===================

        case ITYPE_ECALL: {
            printf "ITYPE_ECALL\n"
            new_pc = process_syscall(pc)
            return
        }
        case ITYPE_EBREAK: {
            printf "[ERROR] ITYPE_EBREAK instruction triggered\n"
            fail
        }

        // ===================
        // ----- DEFAULT -----
        // ===================

        default: {
            printf "[ERROR] Unsupported I-Type instruction with\n"
            printf "\tcompute_op ≡ %x\n", compute_op
            fail
        }
    }
}

fn process_syscall<registers, ram>(pc:Address) -> (new_pc:Address) {
    var call_num:DoubleWord = registers[17]
    //
    switch call_num {
        case EXIT_SYSCALL: { // exit
            printf "ECALL for exit\n"
            var a0:DoubleWord = registers[10] // exit code
            if a0 == 0 {
                printf "EXIT CODE = 0\n"
            } else {
                fail "EXIT CODE = %d\n", a0
            }
            // set stop signal to terminate execution
            new_pc = MAX_UINT_64
        }
        case WRITE_SYSCALL: {
            // write(fd, buf, count) — Linux RISC-V syscall convention
            // a0 = fd (ignored — we treat every write as going to stdout);
            // a1 = pointer to byte buffer in RAM;
            // a2 = number of bytes to write.
            // ACT4's RVMODEL_IO_WRITE_STR (in rvmodel_macros.h) issues this
            // syscall so the framework's failure messages (failing PC,
            // label, expected vs actual) surface on our printf channel
            // verbatim — each byte is rendered as its ASCII character via
            // the zkc %c format specifier (issue #1759).
            printf "ECALL for write\n"
            var a1:Address = registers[11] as Address // buf
            var a2:DoubleWord = registers[12] // count
            var addr:Address = a1
            for i:DoubleWord = 0; i<a2; i = i + 1 {
                printf "%c", read_8(addr)
                addr = addr + 1
            }
            printf "\n"
            registers[10] = a2 // return value: bytes written
            new_pc = (pc + 4) as Address
        }
        default: {
            fail "unsupported system call (%d)", call_num
        }
    }
}
