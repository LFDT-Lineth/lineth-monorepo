include "../memory.zkc"
include "../utils/constants.zkc"
include "../utils/signed_sum.zkc"

// Process a RISC-V U-type instruction, writing an upper-immediate value to a register.
//
// U-type semantics are pre-decoded at ELF time into a semantic compute op and
// operands (see decoded_utype in memory.zkc).
//
// In the predecoding phase, the operands for U-type instructions come from the 25-bit
// encoding (opcode stripped) is simply:
//
//   imm20 :: rd
//
// The upper immediate is placed into bits [31:12] of a 32-bit word (lower 12 bits
// zeroed) and sign-extended to 64 bits at ELF time into `imm`.
//
//   var imm:DoubleWord = sgn_extension_u32_u64(((imm20 as u32) << 12) as u32)
//
// Runtime execution is a flat switch on compute_op (UTYPE_LUI, UTYPE_AUIPC, and
// their *_WB variants). Invalid opcodes (UTYPE_INVALID) are handled by
// the default arm.
//
//   LUI   — load upper immediate:
//             rd = imm
//
//   AUIPC — add upper immediate to PC:
//             rd = imm + pc
//
// LUI is typically paired with an ADDI to materialise a full 32-bit constant in a
// register.  AUIPC is used to form PC-relative addresses for data or call targets.
//
fn process_U_type_instruction<registers>(index:u64, pc:Address) -> () {

    var compute_op:UTypeComputeOp
    var imm:DoubleWord
    var rd:Register
    compute_op, imm, rd = decoded_utype[index]

    switch compute_op {
        case UTYPE_LUI: {
            printf "UTYPE_LUI "
            print_u_operands(rd, (imm >> 12) as Imm20)
        }
        case UTYPE_LUI_WB: {
            printf "UTYPE_LUI "
            print_u_operands(rd, (imm >> 12) as Imm20)
            registers[rd] = imm
        }
        case UTYPE_AUIPC: {
            printf "UTYPE_AUIPC "
            print_u_operands(rd, (imm >> 12) as Imm20)
            var result:DoubleWord = signed_sum_of_double_word(imm, pc) as DoubleWord
        }
        case UTYPE_AUIPC_WB: {
            printf "UTYPE_AUIPC "
            print_u_operands(rd, (imm >> 12) as Imm20)
            registers[rd] = signed_sum_of_double_word(imm, pc) as DoubleWord
        }
        default: {
            printf "[ERROR] Unsupported U-type instruction with\n"
            printf "\tcompute_op ≡ %x\n", compute_op
            fail
        }
    }
}
