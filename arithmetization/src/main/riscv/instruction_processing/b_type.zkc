include "../memory.zkc"
include "../utils/constants.zkc"
include "../utils/signed_comparisons.zkc"
include "../utils/signed_sum.zkc"

// Process a RISC-V B-type (branch) instruction and return the next program counter.
//
// For B-type instructions branch, compute_op and operands are pre-decoded at ELF time
// (see decoded_btype in memory.zkc). For the values of compute_op, we kept the raw
// funct3 value (BRANCH_BEQ = 0b000, BRANCH_BNE = 0b001, …). 
//
// In the predecoding phase, the sub-fields for B-type instructions come from a 
// common 25-bit encoding (opcode stripped) that is laid out as:
// 
//   imm[12] :: imm[10:5] :: rs2 :: rs1 :: compute_op(funct3) :: imm[4:1] :: imm[11]
//
// Runtime execution is a flat switch on compute_op.
// The 13-bit signed PC-relative offset sub-fields are reassembled and
// sign-extended here.
//
// The six branch variants and their conditions are:
//   BEQ  (compute_op = BRANCH_BEQ = funct3 = 0b000) — branch if rs1 == rs2
//   BNE  (compute_op = BRANCH_BNE = funct3 = 0b001) — branch if rs1 != rs2
//   BLT  (compute_op = BRANCH_BLT = funct3 = 0b100) — branch if rs1 <  rs2 (signed)
//   BGE  (compute_op = BRANCH_BGE = funct3 = 0b101) — branch if rs1 >= rs2 (signed)
//   BLTU (compute_op = BRANCH_BLTU = funct3 = 0b110) — branch if rs1 <  rs2 (unsigned)
//   BGEU (compute_op = BRANCH_BGEU = funct3 = 0b111) — branch if rs1 >= rs2 (unsigned)
//
// When the branch condition is false, pc_new = pc + 4 (fall-through).
// When the branch condition is true,  pc_new = pc + imm (taken branch).
//
fn process_B_type_instruction<registers>(index:u64, pc:Address) -> (pc_new:Address) {

    var compute_op:BTypeComputeOp
    var imm_sign:SignBit
    var imm_10_5:u6
    var rs2:Register
    var rs1:Register
    var imm_4_1:u4
    var imm_11:u1
    var imm:DoubleWord
    
    compute_op, imm_sign, imm_10_5, rs2, rs1, imm_4_1, imm_11 = decoded_btype[index]

    if imm_sign == 1 {
        imm = DWORD_SIGN_EXT_PREFIX_52_ONES::imm_11::imm_10_5::imm_4_1::(0 as u1)
    } else {
        imm = (imm_11::imm_10_5::imm_4_1::(0 as u1)) as DoubleWord
    }

    // "no branching" value of pc_new; gets overwritten if branching occurs
    pc_new = pc + 4

    switch compute_op {
        case BRANCH_BEQ: {
            printf "BRANCH_BEQ "
            print_b_operands(rs1, rs2, imm)
            if registers[rs1] == registers[rs2] {
                pc_new = signed_sum_of_double_word(pc, imm)
            }
        }
        case BRANCH_BNE: {
            printf "BRANCH_BNE "
            print_b_operands(rs1, rs2, imm)
            if registers[rs1] != registers[rs2] {
                pc_new = signed_sum_of_double_word(pc, imm)
            }
        }
        case BRANCH_BLT: {
            printf "BRANCH_BLT "
            print_b_operands(rs1, rs2, imm)
            if signed_LT(registers[rs1], registers[rs2]) == 1 {
                // the branch case
                pc_new = signed_sum_of_double_word(pc, imm)
            }
        }
        case BRANCH_BGE: {
            printf "BRANCH_BGE "
            print_b_operands(rs1, rs2, imm)
            if signed_LT(registers[rs1], registers[rs2]) == 0 {
                // the branch case
                pc_new = signed_sum_of_double_word(pc, imm)
            }
        }
        case BRANCH_BLTU: {
            printf "BRANCH_BLTU "
            print_b_operands(rs1, rs2, imm)
            if registers[rs1]<registers[rs2] {
                pc_new = signed_sum_of_double_word(pc, imm)
            }
        }
        case BRANCH_BGEU: {
            printf "BRANCH_BGEU "
            print_b_operands(rs1, rs2, imm)
            if registers[rs1] >= registers[rs2] {
                pc_new = signed_sum_of_double_word(pc, imm)
            }
        }
        default: {
            printf "[ERROR] Unsupported B-Type instruction with\n"
            printf "\tcompute_op ≡ %x\n", compute_op
            fail
        }
    }
}
