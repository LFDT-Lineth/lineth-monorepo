include "type.zkc"

const UNDEFINED_TYPE:Type = 0
const R_TYPE:Type = 1
const I_TYPE:Type = 2
const S_TYPE:Type = 3
const B_TYPE:Type = 4
const U_TYPE:Type = 5
const J_TYPE:Type = 6
// MISC-MEM opcode (FENCE / FENCE.I). On a single-hart machine with no caches
// or memory hierarchy, both are architecturally allowed to be no-ops, so we
// treat them as such — advance PC by 4, do nothing else.
const MISC_MEM_TYPE:Type = 7

// ===============
// decoding types
// ===============

// TODO: add support for sparse reference tables
static instruction_type_from_opcode(opcode:Opcode) -> (instruction_type:Type) {
    UNDEFINED_TYPE, // 0b0000000
    UNDEFINED_TYPE, // 0b0000001
    UNDEFINED_TYPE, // 0b0000010
    I_TYPE, // 0b0000011
    UNDEFINED_TYPE, // 0b0000100
    UNDEFINED_TYPE, // 0b0000101
    UNDEFINED_TYPE, // 0b0000110
    UNDEFINED_TYPE, // 0b0000111
    UNDEFINED_TYPE, // 0b0001000
    UNDEFINED_TYPE, // 0b0001001
    UNDEFINED_TYPE, // 0b0001010
    R_TYPE, // 0b0001011 ≡ 0x0b ≡ custom-0 opcode
    UNDEFINED_TYPE, // 0b0001100
    UNDEFINED_TYPE, // 0b0001101
    UNDEFINED_TYPE, // 0b0001110
    MISC_MEM_TYPE, // 0b0001111  (FENCE, FENCE.I — no-op on this implementation)
    UNDEFINED_TYPE, // 0b0010000
    UNDEFINED_TYPE, // 0b0010001
    UNDEFINED_TYPE, // 0b0010010
    I_TYPE, // 0b0010011
    UNDEFINED_TYPE, // 0b0010100
    UNDEFINED_TYPE, // 0b0010101
    UNDEFINED_TYPE, // 0b0010110
    U_TYPE, // 0b0010111
    UNDEFINED_TYPE, // 0b0011000
    UNDEFINED_TYPE, // 0b0011001
    UNDEFINED_TYPE, // 0b0011010
    I_TYPE, // 0b0011011
    UNDEFINED_TYPE, // 0b0011100
    UNDEFINED_TYPE, // 0b0011101
    UNDEFINED_TYPE, // 0b0011110
    UNDEFINED_TYPE, // 0b0011111
    UNDEFINED_TYPE, // 0b0100000
    UNDEFINED_TYPE, // 0b0100001
    UNDEFINED_TYPE, // 0b0100010
    S_TYPE, // 0b0100011
    UNDEFINED_TYPE, // 0b0100100
    UNDEFINED_TYPE, // 0b0100101
    UNDEFINED_TYPE, // 0b0100110
    UNDEFINED_TYPE, // 0b0100111
    UNDEFINED_TYPE, // 0b0101000
    UNDEFINED_TYPE, // 0b0101001
    UNDEFINED_TYPE, // 0b0101010
    R_TYPE, // 0b0101011 ≡ 0x2b ≡ custom-1 opcode
    UNDEFINED_TYPE, // 0b0101100
    UNDEFINED_TYPE, // 0b0101101
    UNDEFINED_TYPE, // 0b0101110
    UNDEFINED_TYPE, // 0b0101111
    UNDEFINED_TYPE, // 0b0110000
    UNDEFINED_TYPE, // 0b0110001
    UNDEFINED_TYPE, // 0b0110010
    R_TYPE, // 0b0110011
    UNDEFINED_TYPE, // 0b0110100
    UNDEFINED_TYPE, // 0b0110101
    UNDEFINED_TYPE, // 0b0110110
    U_TYPE, // 0b0110111
    UNDEFINED_TYPE, // 0b0111000
    UNDEFINED_TYPE, // 0b0111001
    UNDEFINED_TYPE, // 0b0111010
    R_TYPE, // 0b0111011
    UNDEFINED_TYPE, // 0b0111100
    UNDEFINED_TYPE, // 0b0111101
    UNDEFINED_TYPE, // 0b0111110
    UNDEFINED_TYPE, // 0b0111111
    UNDEFINED_TYPE, // 0b1000000
    UNDEFINED_TYPE, // 0b1000001
    UNDEFINED_TYPE, // 0b1000010
    UNDEFINED_TYPE, // 0b1000011
    UNDEFINED_TYPE, // 0b1000100
    UNDEFINED_TYPE, // 0b1000101
    UNDEFINED_TYPE, // 0b1000110
    UNDEFINED_TYPE, // 0b1000111
    UNDEFINED_TYPE, // 0b1001000
    UNDEFINED_TYPE, // 0b1001001
    UNDEFINED_TYPE, // 0b1001010
    UNDEFINED_TYPE, // 0b1001011
    UNDEFINED_TYPE, // 0b1001100
    UNDEFINED_TYPE, // 0b1001101
    UNDEFINED_TYPE, // 0b1001110
    UNDEFINED_TYPE, // 0b1001111
    UNDEFINED_TYPE, // 0b1010000
    UNDEFINED_TYPE, // 0b1010001
    UNDEFINED_TYPE, // 0b1010010
    UNDEFINED_TYPE, // 0b1010011
    UNDEFINED_TYPE, // 0b1010100
    UNDEFINED_TYPE, // 0b1010101
    UNDEFINED_TYPE, // 0b1010110
    UNDEFINED_TYPE, // 0b1010111
    UNDEFINED_TYPE, // 0b1011000
    UNDEFINED_TYPE, // 0b1011001
    UNDEFINED_TYPE, // 0b1011010
    UNDEFINED_TYPE, // 0b1011011
    UNDEFINED_TYPE, // 0b1011100
    UNDEFINED_TYPE, // 0b1011101
    UNDEFINED_TYPE, // 0b1011110
    UNDEFINED_TYPE, // 0b1011111
    UNDEFINED_TYPE, // 0b1100000
    UNDEFINED_TYPE, // 0b1100001
    UNDEFINED_TYPE, // 0b1100010
    B_TYPE, // 0b1100011
    UNDEFINED_TYPE, // 0b1100100
    UNDEFINED_TYPE, // 0b1100101
    UNDEFINED_TYPE, // 0b1100110
    I_TYPE, // 0b1100111
    UNDEFINED_TYPE, // 0b1101000
    UNDEFINED_TYPE, // 0b1101001
    UNDEFINED_TYPE, // 0b1101010
    UNDEFINED_TYPE, // 0b1101011
    UNDEFINED_TYPE, // 0b1101100
    UNDEFINED_TYPE, // 0b1101101
    UNDEFINED_TYPE, // 0b1101110
    J_TYPE, // 0b1101111
    UNDEFINED_TYPE, // 0b1110000
    UNDEFINED_TYPE, // 0b1110001
    UNDEFINED_TYPE, // 0b1110010
    I_TYPE, // 0b1110011
    UNDEFINED_TYPE, // 0b1110100
    UNDEFINED_TYPE, // 0b1110101
    UNDEFINED_TYPE, // 0b1110110
    UNDEFINED_TYPE, // 0b1110111
    UNDEFINED_TYPE, // 0b1111000
    UNDEFINED_TYPE, // 0b1111001
    UNDEFINED_TYPE, // 0b1111010
    UNDEFINED_TYPE, // 0b1111011
    UNDEFINED_TYPE, // 0b1111100
    UNDEFINED_TYPE, // 0b1111101
    UNDEFINED_TYPE, // 0b1111110
    UNDEFINED_TYPE, // 0b1111111
}

// R_type
const OP:Opcode = 0b0110011 // ADD, SUB, SLL, SLT, SLTU, XOR, SRL, SRA, OR, AND
const OP_32:Opcode = 0b0111011 // ADDW, SUBW, SLLW, SRLW, SRAW (RV64 only)
const CUSTOM_0:Opcode = 0b0001011 // custom-0
const CUSTOM_1:Opcode = 0b0101011 // custom-1

// Extraneous precompiles
const FUNCT3_KECCAK:Funct3 = 0b000
const FUNCT7_KECCAK:Funct7 = 0b0000000
const FUNCT3_POSEIDON2:Funct3 = 0b001
const FUNCT7_POSEIDON2:Funct7 = 0b0000000

// I_type
const LOAD:Opcode = 0b0000011 // LB, LH, LW, LBU, LHU, LWU, LD
const OP_IMM:Opcode = 0b0010011 // ADDI, SLTI, SLTIU, XORI, ORI, ANDI, SLLI, SRLI, SRAI
const OP_IMM_32:Opcode = 0b0011011 // ADDIW, SLLIW, SRLIW, SRAIW (RV64 only)
const JALR:Opcode = 0b1100111 // JALR
const SYSTEM:Opcode = 0b1110011 // ECALL, EBREAK, CSR*
const MISC_MEM:Opcode = 0b0001111 // FENCE, FENCE.I — treated as no-op (see MISC_MEM_TYPE)

//  S_type
const STORE:Opcode = 0b0100011 // SB, SH, SW, SD

//  B_type (branches)
const BRANCH:Opcode = 0b1100011 // BEQ, BNE, BLT, BGE, BLTU, BGEU

//  U_type
const LUI:Opcode = 0b0110111 // LUI
const AUIPC:Opcode = 0b0010111 // AUIPC

//  J_type
const JAL:Opcode = 0b1101111 // JAL

// ===============
// decoding funct3
// ===============

// ===============================
// R-type funct3 and funct7 values
// ===============================

// OP (0110011) — R-type register-register arithmetic
// funct3 values and funct7 values
const FUNCT3_ADD:Funct3 = 0b000, FUNCT7_ADD:Funct7 = 0b0000000
const FUNCT3_SUB:Funct3 = 0b000, FUNCT7_SUB:Funct7 = 0b0100000
const FUNCT3_SLL:Funct3 = 0b001, FUNCT7_SLL:Funct7 = 0b0000000
const FUNCT3_SLT:Funct3 = 0b010, FUNCT7_SLT:Funct7 = 0b0000000
const FUNCT3_SLTU:Funct3 = 0b011, FUNCT7_SLTU:Funct7 = 0b0000000
const FUNCT3_XOR:Funct3 = 0b100, FUNCT7_XOR:Funct7 = 0b0000000
const FUNCT3_SRL:Funct3 = 0b101, FUNCT7_SRL:Funct7 = 0b0000000
const FUNCT3_SRA:Funct3 = 0b101, FUNCT7_SRA:Funct7 = 0b0100000
const FUNCT3_OR:Funct3 = 0b110, FUNCT7_OR:Funct7 = 0b0000000
const FUNCT3_AND:Funct3 = 0b111, FUNCT7_AND:Funct7 = 0b0000000

// OP-32 (0111011) — R-type 32-bit register-register arithmetic (RV64I)
const FUNCT3_ADDW:Funct3 = 0b000, FUNCT7_ADDW:Funct7 = 0b0000000
const FUNCT3_SUBW:Funct3 = 0b000, FUNCT7_SUBW:Funct7 = 0b0100000
const FUNCT3_SLLW:Funct3 = 0b001, FUNCT7_SLLW:Funct7 = 0b0000000
const FUNCT3_SRLW:Funct3 = 0b101, FUNCT7_SRLW:Funct7 = 0b0000000
const FUNCT3_SRAW:Funct3 = 0b101, FUNCT7_SRAW:Funct7 = 0b0100000

// M extension — Integer multiplication and division
// OP (0110011) + funct7=0000001
const FUNCT3_MUL:Funct3 = 0b000, FUNCT7_MUL:Funct7 = 0b0000001
const FUNCT3_MULH:Funct3 = 0b001, FUNCT7_MULH:Funct7 = 0b0000001
const FUNCT3_MULHSU:Funct3 = 0b010, FUNCT7_MULHSU:Funct7 = 0b0000001
const FUNCT3_MULHU:Funct3 = 0b011, FUNCT7_MULHU:Funct7 = 0b0000001
const FUNCT3_DIV:Funct3 = 0b100, FUNCT7_DIV:Funct7 = 0b0000001
const FUNCT3_DIVU:Funct3 = 0b101, FUNCT7_DIVU:Funct7 = 0b0000001
const FUNCT3_REM:Funct3 = 0b110, FUNCT7_REM:Funct7 = 0b0000001
const FUNCT3_REMU:Funct3 = 0b111, FUNCT7_REMU:Funct7 = 0b0000001

// OP-32 (0111011) + funct7=0000001
const FUNCT3_MULW:Funct3 = 0b000, FUNCT7_MULW:Funct7 = 0b0000001
const FUNCT3_DIVW:Funct3 = 0b100, FUNCT7_DIVW:Funct7 = 0b0000001
const FUNCT3_DIVUW:Funct3 = 0b101, FUNCT7_DIVUW:Funct7 = 0b0000001
const FUNCT3_REMW:Funct3 = 0b110, FUNCT7_REMW:Funct7 = 0b0000001
const FUNCT3_REMUW:Funct3 = 0b111, FUNCT7_REMUW:Funct7 = 0b0000001

// ======================
// I-type funct3 values
// ======================
// LOAD
const FUNCT3_LB:Funct3 = 0b000 // Load Byte
const FUNCT3_LH:Funct3 = 0b001 // Load Halfword
const FUNCT3_LW:Funct3 = 0b010 // Load Word
const FUNCT3_LD:Funct3 = 0b011 // Load Doubleword
const FUNCT3_LBU:Funct3 = 0b100 // Load Byte Unsigned
const FUNCT3_LHU:Funct3 = 0b101 // Load Halfword Unsigned
const FUNCT3_LWU:Funct3 = 0b110 // Load Word Unsigned

// OP_IMM
const FUNCT3_ADDI:Funct3 = 0b000 // Add Immediate
const FUNCT3_SLTI:Funct3 = 0b010 // Set Less Than Immediate
const FUNCT3_SLTIU:Funct3 = 0b011 // Set Less Than Immediate Unsigned
const FUNCT3_XORI:Funct3 = 0b100 // XOR Immediate
const FUNCT3_ORI:Funct3 = 0b110 // OR Immediate
const FUNCT3_ANDI:Funct3 = 0b111 // AND Immediate
const FUNCT3_SLLI:Funct3 = 0b001, FUNCT6_SLLI:Funct6 = 0b000000 // Shift Left Logical Immediate
const FUNCT3_SRLI:Funct3 = 0b101, FUNCT6_SRLI:Funct6 = 0b000000 // Shift Right Logical Immediate
const FUNCT3_SRAI:Funct3 = 0b101, FUNCT6_SRAI:Funct6 = 0b010000 // Shift Right Arithmetic Immediate

// OP_IMM_32
const FUNCT3_ADDIW:Funct3 = 0b000 // Add Immediate Word
const FUNCT3_SLLIW:Funct3 = 0b001, FUNCT7_SLLIW:Funct7 = 0b0000000 // Shift Left Logical Immediate Word
const FUNCT3_SRLIW:Funct3 = 0b101, FUNCT7_SRLIW:Funct7 = 0b0000000 // Shift Right Logical Immediate Word
const FUNCT3_SRAIW:Funct3 = 0b101, FUNCT7_SRAIW:Funct7 = 0b0100000 // Shift Right Arithmetic Immediate Word

// JALR
const FUNCT3_JALR:Funct3 = 0b000 // JALR

// SYSTEM
const FUNCT3_ECALL:Funct3 = 0b000, FUNCT12_ECALL:Funct12 = 0b000000000000 // ECALL
const FUNCT3_EBREAK:Funct3 = 0b000, FUNCT12_EBREAK:Funct12 = 0b000000000001 // EBREAK

// ======================
// S-type funct3 values
// ======================

// Sign extension constants
// sign extend to a DOUBLE WORD
const DWORD_SIGN_EXT_PREFIX_52_ONES:u52 = 0b1111111111111111111111111111111111111111111111111111
const MAX_UINT_64:u64 = 0xffffffffffffffff
const MAX_UINT_64_AS_U128:u128 = 0xffffffffffffffff
const MAX_UINT_32:u32 = 0xffffffff
const MAX_UINT_32_AS_U64:u64 = 0xffffffff
const U32_FIRST_BIT_MASK:u32 = 0x80000000
const U64_FIRST_BIT_MASK:u64 = 0x8000000000000000

const OVERFLOW_DIVIDEND:u64 = 0x8000000000000000
const NEGATIVE_ONE_AS_I64:u64 = 0xffffffffffffffff
const MASK_64_ERASE_LAST_BIT:u64 = 0xfffffffffffffffe

// ======================
// Syscalls
// ======================
const EXIT_SYSCALL:DoubleWord = 93
const WRITE_SYSCALL:DoubleWord = 64

// ======================
// I-type semantic micro-ops (pre-decoded)
// ======================
//
// Each operation that may write rd has a pair: BASE (compute only) and BASE_WB
// (compute + registers[rd] = result). At ELF time, rd = x0 selects the BASE
// opcode; rd != x0 selects BASE_WB. Control/system ops have no _WB variant.

// READ — load from memory at (rs1 + sign_extend(imm12))
const READ8_SGN:ITypeComputeOp = 0
const READ8_SGN_WB:ITypeComputeOp = 1
const READ16_SGN:ITypeComputeOp = 2
const READ16_SGN_WB:ITypeComputeOp = 3
const READ32_SGN:ITypeComputeOp = 4
const READ32_SGN_WB:ITypeComputeOp = 5
const READ64:ITypeComputeOp = 6
const READ64_WB:ITypeComputeOp = 7
const READ8_ZEXT:ITypeComputeOp = 8
const READ8_ZEXT_WB:ITypeComputeOp = 9
const READ16_ZEXT:ITypeComputeOp = 10
const READ16_ZEXT_WB:ITypeComputeOp = 11
const READ32_ZEXT:ITypeComputeOp = 12
const READ32_ZEXT_WB:ITypeComputeOp = 13

// OP-IMM — immediate arithmetic/logic on rs1
const OP_ADDI:ITypeComputeOp = 14
const OP_ADDI_WB:ITypeComputeOp = 15
const OP_SLTI:ITypeComputeOp = 16
const OP_SLTI_WB:ITypeComputeOp = 17
const OP_SLTIU:ITypeComputeOp = 18
const OP_SLTIU_WB:ITypeComputeOp = 19
const OP_XORI:ITypeComputeOp = 20
const OP_XORI_WB:ITypeComputeOp = 21
const OP_ORI:ITypeComputeOp = 22
const OP_ORI_WB:ITypeComputeOp = 23
const OP_ANDI:ITypeComputeOp = 24
const OP_ANDI_WB:ITypeComputeOp = 25
const OP_SLLI:ITypeComputeOp = 26
const OP_SLLI_WB:ITypeComputeOp = 27
const OP_SRLI:ITypeComputeOp = 28
const OP_SRLI_WB:ITypeComputeOp = 29
const OP_SRAI:ITypeComputeOp = 30
const OP_SRAI_WB:ITypeComputeOp = 31

// OP-IMM-32 — RV64 word-width (*W) variants
const OP_ADDIW:ITypeComputeOp = 32
const OP_ADDIW_WB:ITypeComputeOp = 33
const OP_SLLIW:ITypeComputeOp = 34
const OP_SLLIW_WB:ITypeComputeOp = 35
const OP_SRLIW:ITypeComputeOp = 36
const OP_SRLIW_WB:ITypeComputeOp = 37
const OP_SRAIW:ITypeComputeOp = 38
const OP_SRAIW_WB:ITypeComputeOp = 39

// Control / system
const ITYPE_JALR:ITypeComputeOp = 40
const ITYPE_JALR_WB:ITypeComputeOp = 41
const ITYPE_ECALL:ITypeComputeOp = 42
const ITYPE_EBREAK:ITypeComputeOp = 43
const ITYPE_INVALID:ITypeComputeOp = 63

// Writeback kinds (second micro-step after compute)
const WB_NONE:ITypeWriteback = 0
const WB_STORE_REG:ITypeWriteback = 1
const WB_MEM_8:ITypeWriteback = 2
const WB_MEM_16:ITypeWriteback = 3
const WB_MEM_32:ITypeWriteback = 4
const WB_MEM_64:ITypeWriteback = 5

// R-type semantic compute ops (pre-decoded at ELF time).
// Each register-writing op has a BASE (even) and BASE_WB (odd) pair.
const RTYPE_ADD:RTypeComputeOp = 0
const RTYPE_ADD_WB:RTypeComputeOp = 1
const RTYPE_SUB:RTypeComputeOp = 2
const RTYPE_SUB_WB:RTypeComputeOp = 3
const RTYPE_SLL:RTypeComputeOp = 4
const RTYPE_SLL_WB:RTypeComputeOp = 5
const RTYPE_SLT:RTypeComputeOp = 6
const RTYPE_SLT_WB:RTypeComputeOp = 7
const RTYPE_SLTU:RTypeComputeOp = 8
const RTYPE_SLTU_WB:RTypeComputeOp = 9
const RTYPE_XOR:RTypeComputeOp = 10
const RTYPE_XOR_WB:RTypeComputeOp = 11
const RTYPE_SRL:RTypeComputeOp = 12
const RTYPE_SRL_WB:RTypeComputeOp = 13
const RTYPE_SRA:RTypeComputeOp = 14
const RTYPE_SRA_WB:RTypeComputeOp = 15
const RTYPE_OR:RTypeComputeOp = 16
const RTYPE_OR_WB:RTypeComputeOp = 17
const RTYPE_AND:RTypeComputeOp = 18
const RTYPE_AND_WB:RTypeComputeOp = 19

const RTYPE_MUL:RTypeComputeOp = 20
const RTYPE_MUL_WB:RTypeComputeOp = 21
const RTYPE_MULH:RTypeComputeOp = 22
const RTYPE_MULH_WB:RTypeComputeOp = 23
const RTYPE_MULHSU:RTypeComputeOp = 24
const RTYPE_MULHSU_WB:RTypeComputeOp = 25
const RTYPE_MULHU:RTypeComputeOp = 26
const RTYPE_MULHU_WB:RTypeComputeOp = 27
const RTYPE_DIV:RTypeComputeOp = 28
const RTYPE_DIV_WB:RTypeComputeOp = 29
const RTYPE_DIVU:RTypeComputeOp = 30
const RTYPE_DIVU_WB:RTypeComputeOp = 31
const RTYPE_REM:RTypeComputeOp = 32
const RTYPE_REM_WB:RTypeComputeOp = 33
const RTYPE_REMU:RTypeComputeOp = 34
const RTYPE_REMU_WB:RTypeComputeOp = 35

const RTYPE_ADDW:RTypeComputeOp = 36
const RTYPE_ADDW_WB:RTypeComputeOp = 37
const RTYPE_SUBW:RTypeComputeOp = 38
const RTYPE_SUBW_WB:RTypeComputeOp = 39
const RTYPE_SLLW:RTypeComputeOp = 40
const RTYPE_SLLW_WB:RTypeComputeOp = 41
const RTYPE_SRLW:RTypeComputeOp = 42
const RTYPE_SRLW_WB:RTypeComputeOp = 43
const RTYPE_SRAW:RTypeComputeOp = 44
const RTYPE_SRAW_WB:RTypeComputeOp = 45

const RTYPE_MULW:RTypeComputeOp = 46
const RTYPE_MULW_WB:RTypeComputeOp = 47
const RTYPE_DIVW:RTypeComputeOp = 48
const RTYPE_DIVW_WB:RTypeComputeOp = 49
const RTYPE_DIVUW:RTypeComputeOp = 50
const RTYPE_DIVUW_WB:RTypeComputeOp = 51
const RTYPE_REMW:RTypeComputeOp = 52
const RTYPE_REMW_WB:RTypeComputeOp = 53
const RTYPE_REMUW:RTypeComputeOp = 54
const RTYPE_REMUW_WB:RTypeComputeOp = 55

const RTYPE_KECCAK:RTypeComputeOp = 56
const RTYPE_INVALID:RTypeComputeOp = 63

// S-type semantic compute ops (pre-decoded at ELF time).
const STYPE_STORE8:STypeComputeOp = 0
const STYPE_STORE16:STypeComputeOp = 1
const STYPE_STORE32:STypeComputeOp = 2
const STYPE_STORE64:STypeComputeOp = 3
const STYPE_INVALID:STypeComputeOp = 63

// B-type semantic compute ops (pre-decoded at ELF time; values are raw funct3).
const BRANCH_BEQ:BTypeComputeOp = 0b000
const BRANCH_BNE:BTypeComputeOp = 0b001
const BRANCH_BLT:BTypeComputeOp = 0b100
const BRANCH_BGE:BTypeComputeOp = 0b101
const BRANCH_BLTU:BTypeComputeOp = 0b110
const BRANCH_BGEU:BTypeComputeOp = 0b111
const BTYPE_INVALID:BTypeComputeOp = 0b111111

// J-type semantic compute ops (pre-decoded at ELF time).
const JTYPE_JAL:JTypeComputeOp = 0
const JTYPE_JAL_WB:JTypeComputeOp = 1
const JTYPE_INVALID:JTypeComputeOp = 63

// U-type semantic compute ops (pre-decoded at ELF time).
const UTYPE_LUI:UTypeComputeOp = 0
const UTYPE_LUI_WB:UTypeComputeOp = 1
const UTYPE_AUIPC:UTypeComputeOp = 2
const UTYPE_AUIPC_WB:UTypeComputeOp = 3
const UTYPE_INVALID:UTypeComputeOp = 63
