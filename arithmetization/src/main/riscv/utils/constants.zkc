include "type.zkc"

// R_type
const OP:Opcode = 0b0110011 // ADD, SUB, SLL, SLT, SLTU, XOR, SRL, SRA, OR, AND
const OP_32:Opcode = 0b0111011 // ADDW, SUBW, SLLW, SRLW, SRAW (RV64 only)
const CUSTOM_0:Opcode = 0b0001011 // custom-0
const CUSTOM_1:Opcode = 0b0101011 // custom-1

// Extraneous precompiles
const FUNCT3_KECCAK:Funct3 = 0b000
const FUNCT7_KECCAK:Funct7 = 0b0000000
const FUNCT3_POSEIDON2:Funct3 = 0b001
const FUNCT7_POSEIDON2:Funct7 = 0b0000000

// I_type
const LOAD:Opcode = 0b0000011 // LB, LH, LW, LBU, LHU, LWU, LD
const OP_IMM:Opcode = 0b0010011 // ADDI, SLTI, SLTIU, XORI, ORI, ANDI, SLLI, SRLI, SRAI
const OP_IMM_32:Opcode = 0b0011011 // ADDIW, SLLIW, SRLIW, SRAIW (RV64 only)
const JALR:Opcode = 0b1100111 // JALR
const SYSTEM:Opcode = 0b1110011 // ECALL, EBREAK, CSR*
const MISC_MEM:Opcode = 0b0001111 // FENCE, FENCE.I — treated as no-op (see MISC_MEM_TYPE)

//  S_type
const STORE:Opcode = 0b0100011 // SB, SH, SW, SD

//  B_type (branches)
const BRANCH:Opcode = 0b1100011 // BEQ, BNE, BLT, BGE, BLTU, BGEU

//  U_type
const LUI:Opcode = 0b0110111 // LUI
const AUIPC:Opcode = 0b0010111 // AUIPC

//  J_type
const JAL:Opcode = 0b1101111 // JAL

// ===============
// decoding funct3
// ===============

// ===============================
// R-type funct3 and funct7 values
// ===============================

// OP (0110011) — R-type register-register arithmetic
// funct3 values and funct7 values
const FUNCT3_ADD:Funct3 = 0b000, FUNCT7_ADD:Funct7 = 0b0000000
const FUNCT3_SUB:Funct3 = 0b000, FUNCT7_SUB:Funct7 = 0b0100000
const FUNCT3_SLL:Funct3 = 0b001, FUNCT7_SLL:Funct7 = 0b0000000
const FUNCT3_SLT:Funct3 = 0b010, FUNCT7_SLT:Funct7 = 0b0000000
const FUNCT3_SLTU:Funct3 = 0b011, FUNCT7_SLTU:Funct7 = 0b0000000
const FUNCT3_XOR:Funct3 = 0b100, FUNCT7_XOR:Funct7 = 0b0000000
const FUNCT3_SRL:Funct3 = 0b101, FUNCT7_SRL:Funct7 = 0b0000000
const FUNCT3_SRA:Funct3 = 0b101, FUNCT7_SRA:Funct7 = 0b0100000
const FUNCT3_OR:Funct3 = 0b110, FUNCT7_OR:Funct7 = 0b0000000
const FUNCT3_AND:Funct3 = 0b111, FUNCT7_AND:Funct7 = 0b0000000

// OP-32 (0111011) — R-type 32-bit register-register arithmetic (RV64I)
const FUNCT3_ADDW:Funct3 = 0b000, FUNCT7_ADDW:Funct7 = 0b0000000
const FUNCT3_SUBW:Funct3 = 0b000, FUNCT7_SUBW:Funct7 = 0b0100000
const FUNCT3_SLLW:Funct3 = 0b001, FUNCT7_SLLW:Funct7 = 0b0000000
const FUNCT3_SRLW:Funct3 = 0b101, FUNCT7_SRLW:Funct7 = 0b0000000
const FUNCT3_SRAW:Funct3 = 0b101, FUNCT7_SRAW:Funct7 = 0b0100000

// M extension — Integer multiplication and division
// OP (0110011) + funct7=0000001
const FUNCT3_MUL:Funct3 = 0b000, FUNCT7_MUL:Funct7 = 0b0000001
const FUNCT3_MULH:Funct3 = 0b001, FUNCT7_MULH:Funct7 = 0b0000001
const FUNCT3_MULHSU:Funct3 = 0b010, FUNCT7_MULHSU:Funct7 = 0b0000001
const FUNCT3_MULHU:Funct3 = 0b011, FUNCT7_MULHU:Funct7 = 0b0000001
const FUNCT3_DIV:Funct3 = 0b100, FUNCT7_DIV:Funct7 = 0b0000001
const FUNCT3_DIVU:Funct3 = 0b101, FUNCT7_DIVU:Funct7 = 0b0000001
const FUNCT3_REM:Funct3 = 0b110, FUNCT7_REM:Funct7 = 0b0000001
const FUNCT3_REMU:Funct3 = 0b111, FUNCT7_REMU:Funct7 = 0b0000001

// OP-32 (0111011) + funct7=0000001
const FUNCT3_MULW:Funct3 = 0b000, FUNCT7_MULW:Funct7 = 0b0000001
const FUNCT3_DIVW:Funct3 = 0b100, FUNCT7_DIVW:Funct7 = 0b0000001
const FUNCT3_DIVUW:Funct3 = 0b101, FUNCT7_DIVUW:Funct7 = 0b0000001
const FUNCT3_REMW:Funct3 = 0b110, FUNCT7_REMW:Funct7 = 0b0000001
const FUNCT3_REMUW:Funct3 = 0b111, FUNCT7_REMUW:Funct7 = 0b0000001

// ======================
// I-type funct3 values
// ======================
// LOAD
const FUNCT3_LB:Funct3 = 0b000 // Load Byte
const FUNCT3_LH:Funct3 = 0b001 // Load Halfword
const FUNCT3_LW:Funct3 = 0b010 // Load Word
const FUNCT3_LD:Funct3 = 0b011 // Load Doubleword
const FUNCT3_LBU:Funct3 = 0b100 // Load Byte Unsigned
const FUNCT3_LHU:Funct3 = 0b101 // Load Halfword Unsigned
const FUNCT3_LWU:Funct3 = 0b110 // Load Word Unsigned

// OP_IMM
const FUNCT3_ADDI:Funct3 = 0b000 // Add Immediate
const FUNCT3_SLTI:Funct3 = 0b010 // Set Less Than Immediate
const FUNCT3_SLTIU:Funct3 = 0b011 // Set Less Than Immediate Unsigned
const FUNCT3_XORI:Funct3 = 0b100 // XOR Immediate
const FUNCT3_ORI:Funct3 = 0b110 // OR Immediate
const FUNCT3_ANDI:Funct3 = 0b111 // AND Immediate
const FUNCT3_SLLI:Funct3 = 0b001, FUNCT6_SLLI:Funct6 = 0b000000 // Shift Left Logical Immediate
const FUNCT3_SRLI:Funct3 = 0b101, FUNCT6_SRLI:Funct6 = 0b000000 // Shift Right Logical Immediate
const FUNCT3_SRAI:Funct3 = 0b101, FUNCT6_SRAI:Funct6 = 0b010000 // Shift Right Arithmetic Immediate

// OP_IMM_32
const FUNCT3_ADDIW:Funct3 = 0b000 // Add Immediate Word
const FUNCT3_SLLIW:Funct3 = 0b001, FUNCT7_SLLIW:Funct7 = 0b0000000 // Shift Left Logical Immediate Word
const FUNCT3_SRLIW:Funct3 = 0b101, FUNCT7_SRLIW:Funct7 = 0b0000000 // Shift Right Logical Immediate Word
const FUNCT3_SRAIW:Funct3 = 0b101, FUNCT7_SRAIW:Funct7 = 0b0100000 // Shift Right Arithmetic Immediate Word

// JALR
const FUNCT3_JALR:Funct3 = 0b000 // JALR

// SYSTEM
const FUNCT3_ECALL:Funct3 = 0b000, FUNCT12_ECALL:Funct12 = 0b000000000000 // ECALL
const FUNCT3_EBREAK:Funct3 = 0b000, FUNCT12_EBREAK:Funct12 = 0b000000000001 // EBREAK

// ======================
// S-type funct3 values
// ======================

const FUNCT3_SB:Funct3 = 0b000 // Store Byte
const FUNCT3_SH:Funct3 = 0b001 // Store Halfword
const FUNCT3_SW:Funct3 = 0b010 // Store Word
const FUNCT3_SD:Funct3 = 0b011 // Store Doubleword

// ======================
// B-type funct3 values
// ======================

const FUNCT3_BEQ:Funct3 = 0b000
const FUNCT3_BNE:Funct3 = 0b001
const FUNCT3_BLT:Funct3 = 0b100
const FUNCT3_BGE:Funct3 = 0b101
const FUNCT3_BLTU:Funct3 = 0b110
const FUNCT3_BGEU:Funct3 = 0b111

// Sign extension constants
// sign extend to a DOUBLE WORD
const DWORD_SIGN_EXT_PREFIX_52_ONES:u52 = 0b1111111111111111111111111111111111111111111111111111
const MAX_UINT_64:u64 = 0xffffffffffffffff
const MAX_UINT_64_AS_U128:u128 = 0xffffffffffffffff
const MAX_UINT_32:u32 = 0xffffffff
const MAX_UINT_32_AS_U64:u64 = 0xffffffff
const U32_FIRST_BIT_MASK:u32 = 0x80000000
const U64_FIRST_BIT_MASK:u64 = 0x8000000000000000

const OVERFLOW_DIVIDEND:u64 = 0x8000000000000000
const NEGATIVE_ONE_AS_I64:u64 = 0xffffffffffffffff
const MASK_64_ERASE_LAST_BIT:u64 = 0xfffffffffffffffe

// ======================
// Syscalls
// ======================
const EXIT_SYSCALL:DoubleWord = 93
const WRITE_SYSCALL:DoubleWord = 64

// =========================================================================
// Unified instruction model (zisk-style pipeline) — pre-decoded at ELF time.
// These integer values MUST mirror the constants in the Go pre-decoder
// (arithmetization/src/test/scripts/elf_to_json_gen/main.go).
// =========================================================================

// ----- Operation (compute phase: result = op(a, b), or branch condition) -----

// ALU (64-bit). Immediate and register forms share the same op: operand b is
// either registers[rs2] or imm, selected by b_src.
const OPR_ADD:Operation = 0 // ADD, ADDI, AUIPC (a = pc)
const OPR_SUB:Operation = 1 // SUB
const OPR_SLL:Operation = 2 // SLL, SLLI
const OPR_SLT:Operation = 3 // SLT, SLTI
const OPR_SLTU:Operation = 4 // SLTU, SLTIU
const OPR_XOR:Operation = 5 // XOR, XORI
const OPR_SRL:Operation = 6 // SRL, SRLI
const OPR_SRA:Operation = 7 // SRA, SRAI
const OPR_OR:Operation = 8 // OR, ORI
const OPR_AND:Operation = 9 // AND, ANDI

// ALU word-width (*W), result sign-extended from 32 to 64 bits.
const OPR_ADDW:Operation = 10 // ADDW, ADDIW
const OPR_SUBW:Operation = 11 // SUBW
const OPR_SLLW:Operation = 12 // SLLW, SLLIW
const OPR_SRLW:Operation = 13 // SRLW, SRLIW
const OPR_SRAW:Operation = 14 // SRAW, SRAIW

// M-extension multiply/divide/remainder (64-bit).
const OPR_MUL:Operation = 15
const OPR_MULH:Operation = 16
const OPR_MULHSU:Operation = 17
const OPR_MULHU:Operation = 18
const OPR_DIV:Operation = 19
const OPR_DIVU:Operation = 20
const OPR_REM:Operation = 21
const OPR_REMU:Operation = 22

// M-extension word-width (*W).
const OPR_MULW:Operation = 23
const OPR_DIVW:Operation = 24
const OPR_DIVUW:Operation = 25
const OPR_REMW:Operation = 26
const OPR_REMUW:Operation = 27

// Moves / link.
const OPR_MOVE_LOADED:Operation = 28 // loads: result = value from the read phase
const OPR_MOVE_B:Operation = 29 // LUI: result = b (= imm)
const OPR_LINK:Operation = 30 // JAL, JALR: result = pc + 4

// Branch comparisons. result is the taken/not-taken condition (1/0).
const OPR_CMP_EQ:Operation = 31 // BEQ
const OPR_CMP_NE:Operation = 32 // BNE
const OPR_CMP_LT:Operation = 33 // BLT  (signed)
const OPR_CMP_GE:Operation = 34 // BGE  (signed)
const OPR_CMP_LTU:Operation = 35 // BLTU (unsigned)
const OPR_CMP_GEU:Operation = 36 // BGEU (unsigned)

// Precompile / no-op / invalid.
const OPR_KECCAK:Operation = 37 // custom-1 Keccak precompile (side effects)
const OPR_NOP:Operation = 38 // no compute (stores, FENCE, ECALL, rd=x0 folds)
const OPR_INVALID:Operation = 63

// ----- Operand a source -----
const A_RS1:ASrc = 0
const A_PC:ASrc = 1

// ----- Operand b source -----
const B_RS2:BSrc = 0
const B_IMM:BSrc = 1

// ----- Read phase: memory load width/extension (address = a + b) -----
const RK_NONE:ReadKind = 0
const RK_8S:ReadKind = 1 // LB
const RK_16S:ReadKind = 2 // LH
const RK_32S:ReadKind = 3 // LW
const RK_64:ReadKind = 4 // LD
const RK_8U:ReadKind = 5 // LBU
const RK_16U:ReadKind = 6 // LHU
const RK_32U:ReadKind = 7 // LWU

// ----- Write phase: writeback target -----
const WK_NONE:WriteKind = 0
const WK_REG:WriteKind = 1 // registers[rd] = result (rd==0 folded to WK_NONE at decode)
const WK_MEM8:WriteKind = 2 // SB: mem[a + b] = registers[rs2]
const WK_MEM16:WriteKind = 3 // SH
const WK_MEM32:WriteKind = 4 // SW
const WK_MEM64:WriteKind = 5 // SD

// ----- Advance-PC phase: program-counter update mode -----
const PK_NEXT:PcKind = 0 // pc + 4
const PK_BRANCH:PcKind = 1 // cond ? pc + imm : pc + 4
const PK_JUMP_REL:PcKind = 2 // JAL: pc + imm (= addr, since a = pc)
const PK_JUMP_ABS:PcKind = 3 // JALR: (rs1 + imm) & ~1 (= addr & ~1)
const PK_SYSCALL:PcKind = 4 // ECALL
const PK_HALT:PcKind = 5 // EBREAK
