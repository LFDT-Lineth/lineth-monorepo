// 32-bit "unsigned unsigned" multiplication
fn mul32_uu(lhs:u32, rhs:u32) -> (hi:u32, lo:u32) {
    hi::lo = (lhs as u64) * (rhs as u64)
}

// 64-bit "unsigned unsigned" multiplication
fn mul64_uu(lhs:u64, rhs:u64) -> (hi:u64, lo:u64) {
    hi::lo = (lhs as u128) * (rhs as u128)
}

// 64-bit "signed signed" multiplication
fn mul64_ss(lhs:u64, rhs:u64) -> (hi:u64, lo:u64) {
    var lhs_sign:u1 = sign_bit_of_double_word(lhs)
    var rhs_sign:u1 = sign_bit_of_double_word(rhs)
    var lhs_abs:u64 = absolute_value_double_word(lhs)
    var rhs_abs:u64 = absolute_value_double_word(rhs)
    // Perform unsigned multiplication
    var tmp_hi:u64
    var tmp_lo:u64
    tmp_hi, tmp_lo = mul64_uu(lhs_abs, rhs_abs)
    var val:u128 = tmp_hi::tmp_lo
    // Apply sign
    if (lhs_sign ^ rhs_sign) == 1 && val != 0 {
        hi::lo = (~val) + 1
    } else {
        hi::lo = val
    }
}

// 64-bit "signed unsigned" multiplication.
fn mul64_su(lhs:u64, rhs:u64) -> (hi:u64, lo:u64) {
    var lhs_abs:u64 = absolute_value_double_word(lhs)
    var lhs_sign:u1 = sign_bit_of_double_word(lhs)
    // Perform unsigned multiplication
    var tmp_hi:u64
    var tmp_lo:u64
    tmp_hi, tmp_lo = mul64_uu(lhs_abs, rhs)
    var val:u128 = tmp_hi::tmp_lo
    // Apply sign
    if lhs_sign == 1 && val != 0 {
        hi::lo = (~val) + 1
    } else {
        hi::lo = val
    }
}

///////////////////////////////
///  Division and Remainder  //
///////////////////////////////

// 64-bit unsigned div mod. Special case: if b == 0, then q = -1 and r = a.
fn divMod_64_uu(a:u64, b:u64) -> (q:u64, r:u64) {
    if b == 0 {
        q = NEGATIVE_ONE_AS_I64
        r = a
    } else {
        q, r = a /% b
    }
}

// 64-bit signed div mod. Special case: if b == 0, then q = -1 and r = lhs.
fn divMod_64_ss(a:u64, b:u64) -> (q:u64, r:u64) {
    var q_u:u64
    var r_u:u64
    // compute unsigned remainder
    q_u, r_u = divMod_64_uu(absolute_value_double_word(a), absolute_value_double_word(b))

    var a_sign:u1 = sign_bit_of_double_word(a)

    // special care when dividing by 0, do NOT apply sign to the quotient, just return -1 and the dividend as remainder
    if b == 0 {
        q = NEGATIVE_ONE_AS_I64
        r = a
        return
    }

    // General case: compute unsigned division and apply sign to the result
    // quotient is negative iff signs differ
    q = a_sign == sign_bit_of_double_word(b) ? q_u:negative_of_double_word(q_u)

    // remainder follows the dividend sign
    r = a_sign == 0 ? r_u:negative_of_double_word(r_u)
}

///////////////////////////////////////////
//////// same same but for 32-bit /////////
///////////////////////////////////////////

// 32-bit unsigned div mod. Special case: if b == 0, then q = -1 and r = a.
fn divMod_32_uu(a:u32, b:u32) -> (q:u32, r:u32) {
    if b == 0 {
        q = NEGATIVE_ONE_AS_I32
        r = a
    } else {
        q, r = a /% b
    }
}

// 32-bit signed div mod. Special case: if b == 0, then q = -1 and r = a.
fn divMod_32_ss(a:u32, b:u32) -> (q:u32, r:u32) {
    var q_u:u32
    var r_u:u32
    // compute unsigned remainder
    q_u, r_u = divMod_32_uu(absolute_value_word(a), absolute_value_word(b))

    var a_sign:u1 = sign_bit_of_word(a)

    // special care when dividing by 0, do NOT apply sign to the quotient, just return -1 and the dividend as remainder
    if b == 0 {
        q = NEGATIVE_ONE_AS_I32
        r = a
        return
    }

    // General case: compute unsigned division and apply sign to the result
    // quotient is negative iff signs differ
    q = a_sign == sign_bit_of_word(b) ? q_u:negative_of_word(q_u)

    // remainder follows the dividend sign
    r = a_sign == 0 ? r_u:negative_of_word(r_u)
}
