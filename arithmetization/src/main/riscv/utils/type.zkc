type ITypeComputeOp = u6
type ITypeWriteback = u3

// Semantic R-type micro-op tags (pre-decoded at ELF time).
type RTypeComputeOp = u6

// Semantic S-type micro-op tags (pre-decoded at ELF time).
type STypeComputeOp = u6

// Semantic B-type micro-op tags (pre-decoded at ELF time).
type BTypeComputeOp = u6

// Semantic J-type micro-op tags (pre-decoded at ELF time).
type JTypeComputeOp = u6

// Semantic U-type micro-op tags (pre-decoded at ELF time).
