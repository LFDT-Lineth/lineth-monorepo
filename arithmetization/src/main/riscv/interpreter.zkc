include "memory.zkc"
include "utils/constants.zkc"
include "utils/compute_ops.zkc"
include "utils/register_utils.zkc"
include "utils/absolute_value.zkc"
include "utils/bit_flip.zkc"
include "utils/negative.zkc"
include "utils/sign_bit.zkc"
include "utils/sign_extend.zkc"
include "utils/signed_comparisons.zkc"
include "utils/signed_sum.zkc"
include "ram/read.zkc"
include "ram/write.zkc"
include "../lib/keccak/impl.zkc"

// Execute a single pre-decoded RISC-V instruction and return the next program
// counter. The instruction type no longer drives a dispatch: every instruction
// is pre-decoded (see `decoded` in memory.zkc) into a uniform record processed
// by the same four-phase pipeline (zisk-style):
//
//   1. read    — gather operands a, b and perform any memory load
//   2. compute — result = operation(a, b)   (factorized across all formats)
//   3. write   — register or memory writeback
//   4. advance — compute the next pc
fn interpreter<registers, ram, state_row0, state_row1, state_row2, state_row3, state_row4, b0, b1, b2, b3, b4, c, d, padded_input_block, poseidon2_state>(index:u64, pc:Address) -> (new_pc:Address) {

    var compute_op:ComputeOp = decoded_core[index]

    var it_imm:DoubleWord
    var it_rs1:Register
    var it_rd:Register
    var r_rs1:Register
    var r_rs2:Register
    var r_rd:Register
    var v1:DoubleWord
    var v2:DoubleWord
    var shift_discard_6:u58
    var shift_amount_6:u6
    var shift_discard_5:u27
    var shift_amount_5:u5
    var word_working_copy:Word
    var overflow:SignBit
    var v1_upper:Word
    var v1_lower:Word
    var v2_upper:Word
    var v2_lower:Word
    var product_upper:Word
    var product_lower:Word
    var word_wip:Word
    var result:DoubleWord
    var rs1_plus_imm:u64
    var st_imm:DoubleWord
    var st_rs1:Register
    var st_rs2:Register
    var b_imm:DoubleWord
    var b_rs1:Register
    var b_rs2:Register
    var mem_address:Address
    var j_imm:DoubleWord
    var j_rd:Register
    var u_imm:DoubleWord
    var u_rd:Register

    new_pc = (pc + 4) as Address

    switch compute_op {
        case COMPUTE_MISC_MEM: {
        }
        case READ8_SGN: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "READ8_SGN "
                        print_i_memory_operands(it_rd, it_rs1, it_imm)
                        result = sgn_extension_u8_u64(read_8(rs1_plus_imm))
        }
        case READ8_SGN_WB: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "READ8_SGN "
                        print_i_memory_operands(it_rd, it_rs1, it_imm)
                        registers[it_rd] = sgn_extension_u8_u64(read_8(rs1_plus_imm))
        }
        case READ16_SGN: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "READ16_SGN "
                        print_i_memory_operands(it_rd, it_rs1, it_imm)
                        result = sgn_extension_u16_u64(read_16(rs1_plus_imm))
        }
        case READ16_SGN_WB: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "READ16_SGN "
                        print_i_memory_operands(it_rd, it_rs1, it_imm)
                        registers[it_rd] = sgn_extension_u16_u64(read_16(rs1_plus_imm))
        }
        case READ32_SGN: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "READ32_SGN "
                        print_i_memory_operands(it_rd, it_rs1, it_imm)
                        result = sgn_extension_u32_u64(read_32(rs1_plus_imm))
        }
        case READ32_SGN_WB: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "READ32_SGN "
                        print_i_memory_operands(it_rd, it_rs1, it_imm)
                        registers[it_rd] = sgn_extension_u32_u64(read_32(rs1_plus_imm))
        }
        case READ64: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "READ64 "
                        print_i_memory_operands(it_rd, it_rs1, it_imm)
                        result = read_64(rs1_plus_imm) as DoubleWord
        }
        case READ64_WB: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "READ64 "
                        print_i_memory_operands(it_rd, it_rs1, it_imm)
                        registers[it_rd] = read_64(rs1_plus_imm) as DoubleWord
        }
        case READ8_ZEXT: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "READ8_ZEXT "
                        print_i_memory_operands(it_rd, it_rs1, it_imm)
                        result = read_8(rs1_plus_imm) as DoubleWord
        }
        case READ8_ZEXT_WB: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "READ8_ZEXT "
                        print_i_memory_operands(it_rd, it_rs1, it_imm)
                        registers[it_rd] = read_8(rs1_plus_imm) as DoubleWord
        }
        case READ16_ZEXT: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "READ16_ZEXT "
                        print_i_memory_operands(it_rd, it_rs1, it_imm)
                        result = read_16(rs1_plus_imm) as DoubleWord
        }
        case READ16_ZEXT_WB: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "READ16_ZEXT "
                        print_i_memory_operands(it_rd, it_rs1, it_imm)
                        registers[it_rd] = read_16(rs1_plus_imm) as DoubleWord
        }
        case READ32_ZEXT: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "READ32_ZEXT "
                        print_i_memory_operands(it_rd, it_rs1, it_imm)
                        result = read_32(rs1_plus_imm) as DoubleWord
        }
        case READ32_ZEXT_WB: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "READ32_ZEXT "
                        print_i_memory_operands(it_rd, it_rs1, it_imm)
                        registers[it_rd] = read_32(rs1_plus_imm) as DoubleWord
        }
        case OP_ADDI: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "OP_ADDI "
                        print_i_operands(it_rd, it_rs1, it_imm)
                        result = rs1_plus_imm
        }
        case OP_ADDI_WB: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "OP_ADDI "
                        print_i_operands(it_rd, it_rs1, it_imm)
                        registers[it_rd] = rs1_plus_imm
        }
        case OP_SLLI: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            var uimm6:UImm6 = it_imm as UImm6
                        printf "OP_SLLI "
                        print_i_shift6_operands(it_rd, it_rs1, uimm6)
                        result = registers[it_rs1] << uimm6
        }
        case OP_SLLI_WB: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            var uimm6:UImm6 = it_imm as UImm6
                        printf "OP_SLLI "
                        print_i_shift6_operands(it_rd, it_rs1, uimm6)
                        registers[it_rd] = registers[it_rs1] << uimm6
        }
        case OP_SLTI: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "OP_SLTI "
                        print_i_operands(it_rd, it_rs1, it_imm)
                        result = signed_LT(registers[it_rs1], it_imm) as DoubleWord
        }
        case OP_SLTI_WB: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "OP_SLTI "
                        print_i_operands(it_rd, it_rs1, it_imm)
                        registers[it_rd] = signed_LT(registers[it_rs1], it_imm) as DoubleWord
        }
        case OP_SLTIU: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "OP_SLTIU "
                        print_i_operands(it_rd, it_rs1, it_imm)
                        // Warn: this is an unsigned comparison (even if imm12 is SGN_EXT)
                        result = registers[it_rs1] < it_imm ? 1 : 0
        }
        case OP_SLTIU_WB: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "OP_SLTIU "
                        print_i_operands(it_rd, it_rs1, it_imm)
                        // Warn: this is an unsigned comparison (even if imm12 is SGN_EXT)
                        registers[it_rd] = registers[it_rs1] < it_imm ? 1 : 0
        }
        case OP_XORI: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "OP_XORI "
                        print_i_operands(it_rd, it_rs1, it_imm)
                        result = registers[it_rs1] ^ it_imm
        }
        case OP_XORI_WB: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "OP_XORI "
                        print_i_operands(it_rd, it_rs1, it_imm)
                        registers[it_rd] = registers[it_rs1] ^ it_imm
        }
        case OP_SRLI: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            var uimm6:UImm6 = it_imm as UImm6
                        printf "OP_SRLI "
                        print_i_shift6_operands(it_rd, it_rs1, uimm6)
                        result = registers[it_rs1] >> uimm6
        }
        case OP_SRLI_WB: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            var uimm6:UImm6 = it_imm as UImm6
                        printf "OP_SRLI "
                        print_i_shift6_operands(it_rd, it_rs1, uimm6)
                        registers[it_rd] = registers[it_rs1] >> uimm6
        }
        case OP_SRAI: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            var uimm6:UImm6 = it_imm as UImm6
                        printf "OP_SRAI "
                        print_i_shift6_operands(it_rd, it_rs1, uimm6)
                        result = _ashr_u64(registers[it_rs1], uimm6)
        }
        case OP_SRAI_WB: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            var uimm6:UImm6 = it_imm as UImm6
                        printf "OP_SRAI "
                        print_i_shift6_operands(it_rd, it_rs1, uimm6)
                        registers[it_rd] = _ashr_u64(registers[it_rs1], uimm6)
        }
        case OP_ORI: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "OP_ORI "
                        print_i_operands(it_rd, it_rs1, it_imm)
                        result = registers[it_rs1] | it_imm
        }
        case OP_ORI_WB: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "OP_ORI "
                        print_i_operands(it_rd, it_rs1, it_imm)
                        registers[it_rd] = registers[it_rs1] | it_imm
        }
        case OP_ANDI: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "OP_ANDI "
                        print_i_operands(it_rd, it_rs1, it_imm)
                        result = registers[it_rs1] & it_imm
        }
        case OP_ANDI_WB: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "OP_ANDI "
                        print_i_operands(it_rd, it_rs1, it_imm)
                        registers[it_rd] = registers[it_rs1] & it_imm
        }
        case OP_ADDIW: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "OP_ADDIW "
                        print_i_operands(it_rd, it_rs1, it_imm)
                        result = sgn_extension_u32_u64((rs1_plus_imm & MAX_UINT_32_AS_U64) as Word)
        }
        case OP_ADDIW_WB: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "OP_ADDIW "
                        print_i_operands(it_rd, it_rs1, it_imm)
                        registers[it_rd] = sgn_extension_u32_u64((rs1_plus_imm & MAX_UINT_32_AS_U64) as Word)
        }
        case OP_SLLIW: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            var uimm5:UImm5 = it_imm as UImm5
                        printf "OP_SLLIW "
                        print_i_shift5_operands(it_rd, it_rs1, uimm5)
                        result = sgn_extension_u32_u64(((registers[it_rs1] & MAX_UINT_32_AS_U64) as Word) << uimm5)
        }
        case OP_SLLIW_WB: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            var uimm5:UImm5 = it_imm as UImm5
                        printf "OP_SLLIW "
                        print_i_shift5_operands(it_rd, it_rs1, uimm5)
                        registers[it_rd] = sgn_extension_u32_u64(((registers[it_rs1] & MAX_UINT_32_AS_U64) as Word) << uimm5)
        }
        case OP_SRLIW: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            var uimm5:UImm5 = it_imm as UImm5
                        printf "OP_SRLIW "
                        print_i_shift5_operands(it_rd, it_rs1, uimm5)
                        result = sgn_extension_u32_u64(((registers[it_rs1] & MAX_UINT_32_AS_U64) as Word) >> uimm5)
        }
        case OP_SRLIW_WB: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            var uimm5:UImm5 = it_imm as UImm5
                        printf "OP_SRLIW "
                        print_i_shift5_operands(it_rd, it_rs1, uimm5)
                        registers[it_rd] = sgn_extension_u32_u64(((registers[it_rs1] & MAX_UINT_32_AS_U64) as Word) >> uimm5)
        }
        case OP_SRAIW: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            var uimm5:UImm5 = it_imm as UImm5
                        printf "OP_SRAIW "
                        print_i_shift5_operands(it_rd, it_rs1, uimm5)
                        result = sgn_extension_u32_u64(_ashr_u32(registers[it_rs1], uimm5))
        }
        case OP_SRAIW_WB: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            var uimm5:UImm5 = it_imm as UImm5
                        printf "OP_SRAIW "
                        print_i_shift5_operands(it_rd, it_rs1, uimm5)
                        registers[it_rd] = sgn_extension_u32_u64(_ashr_u32(registers[it_rs1], uimm5))
        }
        case ITYPE_JALR: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "ITYPE_JALR "
                        print_i_memory_operands(it_rd, it_rs1, it_imm)
                        result = (pc + 4) as DoubleWord
                        new_pc = rs1_plus_imm & MASK_64_ERASE_LAST_BIT
        }
        case ITYPE_JALR_WB: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "ITYPE_JALR "
                        print_i_memory_operands(it_rd, it_rs1, it_imm)
                        new_pc = rs1_plus_imm & MASK_64_ERASE_LAST_BIT
                        registers[it_rd] = (pc + 4) as DoubleWord
        }
        case ITYPE_ECALL: {
            printf "ITYPE_ECALL\n"
                        new_pc = process_syscall(pc)
        }
        case ITYPE_EBREAK: {
            it_imm, it_rs1, it_rd = decoded_itype[index]
            rs1_plus_imm = signed_sum_of_double_word(registers[it_rs1], it_imm)
            printf "[ERROR] ITYPE_EBREAK instruction triggered\n"
                        fail
        }
        case RTYPE_ADD: {
            r_rs1, r_rs2, r_rd = decoded_rtype[index]
            v1 = registers[r_rs1]
            v2 = registers[r_rs2]
            printf "RTYPE_ADD "
                        print_r_operands(r_rd, r_rs1, r_rs2)
                        overflow::result = (v1 as u65) + (v2 as u65)
        }
        case RTYPE_SUB: {
            r_rs1, r_rs2, r_rd = decoded_rtype[index]
            v1 = registers[r_rs1]
            v2 = registers[r_rs2]
            printf "RTYPE_SUB "
                        print_r_operands(r_rd, r_rs1, r_rs2)
                        overflow::result = ((1 as u1)::(v1 as u64)) - (v2 as u65)
        }
        case RTYPE_SLL: {
            r_rs1, r_rs2, r_rd = decoded_rtype[index]
            v1 = registers[r_rs1]
            v2 = registers[r_rs2]
            printf "RTYPE_SLL "
                        print_r_operands(r_rd, r_rs1, r_rs2)
                        shift_discard_6::shift_amount_6 = v2
                        result = v1 << shift_amount_6
        }
        case RTYPE_SLT: {
            r_rs1, r_rs2, r_rd = decoded_rtype[index]
            v1 = registers[r_rs1]
            v2 = registers[r_rs2]
            printf "RTYPE_SLT "
                        print_r_operands(r_rd, r_rs1, r_rs2)
                        result = signed_LT(v1, v2) as DoubleWord
        }
        case RTYPE_SLTU: {
            r_rs1, r_rs2, r_rd = decoded_rtype[index]
            v1 = registers[r_rs1]
            v2 = registers[r_rs2]
            printf "RTYPE_SLTU "
                        print_r_operands(r_rd, r_rs1, r_rs2)
                        if (v1 < v2) {
                        result = 1
                        } else {
                        result = 0
                        }
        }
        case RTYPE_XOR: {
            r_rs1, r_rs2, r_rd = decoded_rtype[index]
            v1 = registers[r_rs1]
            v2 = registers[r_rs2]
            printf "RTYPE_XOR "
                        print_r_operands(r_rd, r_rs1, r_rs2)
                        result = v1 ^ v2
        }
        case RTYPE_SRL: {
            r_rs1, r_rs2, r_rd = decoded_rtype[index]
            v1 = registers[r_rs1]
            v2 = registers[r_rs2]
            printf "RTYPE_SRL "
                        print_r_operands(r_rd, r_rs1, r_rs2)
                        shift_discard_6::shift_amount_6 = v2
                        result = v1 >> shift_amount_6
        }
        case RTYPE_SRA: {
            r_rs1, r_rs2, r_rd = decoded_rtype[index]
            v1 = registers[r_rs1]
            v2 = registers[r_rs2]
            printf "RTYPE_SRA "
                        print_r_operands(r_rd, r_rs1, r_rs2)
                        shift_discard_6::shift_amount_6 = v2
                        result = _ashr_u64(v1, shift_amount_6)
        }
        case RTYPE_OR: {
            r_rs1, r_rs2, r_rd = decoded_rtype[index]
            v1 = registers[r_rs1]
            v2 = registers[r_rs2]
            printf "RTYPE_OR "
                        print_r_operands(r_rd, r_rs1, r_rs2)
                        result = v1 | v2
        }
        case RTYPE_AND: {
            r_rs1, r_rs2, r_rd = decoded_rtype[index]
            v1 = registers[r_rs1]
            v2 = registers[r_rs2]
            printf "RTYPE_AND "
                        print_r_operands(r_rd, r_rs1, r_rs2)
                        result = v1 & v2
        }
        case RTYPE_MUL: {
            r_rs1, r_rs2, r_rd = decoded_rtype[index]
            v1 = registers[r_rs1]
            v2 = registers[r_rs2]
