include "memory.zkc"
include "../common/constants.zkc"
include "utils/register_utils.zkc"
include "utils/absolute_value.zkc"
include "utils/bit_flip.zkc"
include "utils/negative.zkc"
include "utils/sign_bit.zkc"
include "utils/sign_extend.zkc"
include "utils/signed_comparisons.zkc"
include "utils/signed_sum.zkc"
include "utils/multiplication.zkc"
include "ram/read.zkc"
include "ram/write.zkc"
include "../lib/keccak/impl.zkc"
include "../lib/poseidon2/ram.zkc"
include "../lib/io/write_output.zkc"

// Execute one instruction slot and return the next program counter.
//
// The raw RISC-V instruction type semantics are pre-decoded at ELF time
// into a compute op and operands : compute_op + imm + rs1 + rs2 + rd
// (see decoded in memory.zkc).
//
// Runtime dispatch is on the pre-decoded semantic compute op (`compute_op`).
// Invalid opcodes (COMPUTE_INVALID) are handled by the default arm.
// 
// Each slot is justified with the predecoding justification loop in `main.zkc`
// (it will be done offline by `predecoding/main.zkc` in the future) :
// raw blob words must match `decoded[index]` in memory.zkc
// (compute_op + imm + rs1 + rs2 + rd).
//
// The switch below is grouped by former format (I/J/U/B/S/R, MISC_MEM) for
// readability only. 
// Each operation that may write rd has a pair of compute op: BASE (compute only)
// and BASE_WB, WB for writeback, that computes and writes the result to registers[rd]
// (compute + registers[rd] = result). When rd is x0, the BASE opcode is encoded at
// ELF time; otherwise BASE_WB is used. Except for the foldable no-ops : they are 
// rewritten to COMPUTE_MISC_MEM at ELF time and only advance pc.
//
// =======
// I-type  
// =======
//
// In the predecoding phase, the operands for I-type instructions come from a
// common 25-bit encoding (opcode stripped) that is laid out as:
//
//   imm12 :: rs1 :: funct3 :: rd
//
// Shift amounts are normalized at ELF time; the immediate is sign-extended into `imm`:
//
// var signext_imm12_64:DoubleWord = sgn_extension_u12_u64(imm12)
// var imm:u64 = signed_sum_of_double_word(registers[rs1], signext_imm12_64)
//
// ========
// R-type
// ========
// 
// In the predecoding phase, the operands for R-type instructions come from the 25-bit
// encoding (opcode stripped) that is laid out as:
// 
//   funct7 :: rs2 :: rs1 :: funct3 :: rd
//
// Supported operation groups:
//
//   Base RV64I — register arithmetic/logic (64-bit):
//     ADD, SUB, SLL, SLT, SLTU, XOR, SRL, SRA, OR, AND
//
//   RV64I *W — word-width (32-bit) variants, result sign-extended to 64 bits:
//     ADDW, SUBW, SLLW, SRLW, SRAW
//
//   M-extension — integer multiply/divide/remainder (64-bit):
//     MUL, MULH, MULHSU, MULHU, DIV, DIVU, REM, REMU
//
//   M-extension *W — word-width multiply/divide/remainder, sign-extended to 64 bits:
//     MULW, DIVW, DIVUW, REMW, REMUW
//
//   Custom-1 — Keccak precompile (no register writeback)
//
// =======
// S-type  
// =======
//
// In the predecoding phase, the operands for S-type instructions come from the 25-bit
// encoding (opcode stripped) that splits the 12-bit signed immediate across two fields so
// that rs1 and rs2 occupy the same bit positions as in other formats:
//
//   imm[11] :: imm[10:5] :: rs2 :: rs1 :: funct3 :: imm[4:0]
//
// The immediate is reassembled as imm[11] :: imm[10:5] :: imm[4:0] and
// sign-extended to 64 bits at ELF time into `imm`.
// 
// var imm:DoubleWord = sgn_extension_u12_u64(imm12)
//
// Store variants selected by compute_op (from funct3 at ELF time):
//   STYPE_STORE8  (funct3 = 0b000) — store byte       (8 bits)
//   STYPE_STORE16 (funct3 = 0b001) — store halfword   (16 bits)
//   STYPE_STORE32 (funct3 = 0b010) — store word       (32 bits)
//   STYPE_STORE64 (funct3 = 0b011) — store doubleword (64 bits)
//
// Effect:
//   mem[rs1 + imm] ← lower N bits of rs2 
//
// =======
// B-type  
// =======
// 
// In the predecoding phase, the operands for B-type instructions come from a
// common 25-bit encoding (opcode stripped) that is laid out as:
//
//   imm[12] :: imm[10:5] :: rs2 :: rs1 :: compute_op(funct3) :: imm[4:1] :: imm[11]
//
// The 13-bit signed PC-relative branch offset is reassembled and sign-extended
// at ELF time into `imm`:
//
//    var imm:DoubleWord
//    if imm_sign == 1 {
//      imm = DWORD_SIGN_EXT_PREFIX_52_ONES::imm_11::imm_10_5::imm_4_1::(0 as u1)
//    } else {
//      imm = (imm_11::imm_10_5::imm_4_1::(0 as u1)) as DoubleWord
//    }
//
// The six branch variants and their conditions are:
//   BEQ  (compute_op = BRANCH_BEQ = funct3 = 0b000) — branch if rs1 == rs2
//   BNE  (compute_op = BRANCH_BNE = funct3 = 0b001) — branch if rs1 != rs2
//   BLT  (compute_op = BRANCH_BLT = funct3 = 0b100) — branch if rs1 <  rs2 (signed)
//   BGE  (compute_op = BRANCH_BGE = funct3 = 0b101) — branch if rs1 >= rs2 (signed)
//   BLTU (compute_op = BRANCH_BLTU = funct3 = 0b110) — branch if rs1 <  rs2 (unsigned)
//   BGEU (compute_op = BRANCH_BGEU = funct3 = 0b111) — branch if rs1 >= rs2 (unsigned)
//
// When the branch condition is false, pc_new = pc + 4 (fall-through).
// When the branch condition is true,  pc_new = pc + imm (taken branch).
//
// =======
// J-type  
// =======
// 
// In the predecoding phase, the operands for J-type instructions come from a
// common 25-bit encoding (opcode stripped) that is laid out as:
//
//   imm[20] :: imm[10:1] :: imm[11] :: imm[19:12] :: rd
//
// The 21-bit signed jump offset is then reassembled:
//
//  var imm21:u21 = ((imm20::imm19_12::imm11::imm10_1) as u21) << 1
//
// and sign-extended into `imm`:
//
//  var imm:DoubleWord = sgn_extension_u21_u64(imm21)
//
// Effect:
//   JTYPE_JAL    — pc_new = pc + imm
//   JTYPE_JAL_WB — pc_new = pc + imm; rd = pc + 4
// 
// =======
// U-type  
// =======
// 
// In the predecoding phase, the operands for U-type instructions come from the 25-bit
// encoding (opcode stripped) is simply:
//
//   imm20 :: rd
//
// The upper immediate is placed into bits [31:12] of a 32-bit word (lower 12 bits
// zeroed) and sign-extended to 64 bits at ELF time into `imm`.
//
//   var imm:DoubleWord = sgn_extension_u32_u64(((imm20 as u32) << 12) as u32)
// 
// ================
// COMPUTE_MISC_MEM
// ================
//
// Two sources at ELF time:
//
//   1. FENCE / FENCE.I (opcode MISCMEM) — architecturally a no-op on this VM.
//   2. Folded no-ops — raw instructions that only write x0 and have no memory,
//      branch, or non-x0 register effects, e.g. add x0,x0,x0, addi x0,x0,0,
//      lui x0,imm, and valid OP-IMM/OP-IMM-32 with rd=rs1=x0.
//
fn interpreter<registers, ram, keccak_state, poseidon2_state>(index:u64, pc:Address, output_write_address:OutputAddress) -> (new_pc:Address, new_output_write_address:OutputAddress) {

    var compute_op:ComputeOp
    var imm:DoubleWord
    var rs1:Register
    var rs2:Register
    var rd:Register
    compute_op, imm, rs1, rs2, rd = decoded[index]

    var v1:DoubleWord = registers[rs1]
    var v2:DoubleWord = registers[rs2]
    var shift_discard_6:u58
    var shift_amount_6:u6
    var overflow:SignBit
    var result:DoubleWord
    var rs1_plus_imm:u64

    rs1_plus_imm = signed_sum_of_double_word(v1, imm)

    switch compute_op {
        // ==============
        // I-type — LOAD 
        // ==============
        case READ8_ZEXT_WB: {
            printf "READ8_ZEXT_WB(a) "
            print_i_memory_operands(rd, rs1, imm)
            result = read_8(rs1_plus_imm) as DoubleWord
        }
        case READ32_SGN_WB: {
            printf "READ32_SGN_WB(a) "
            print_i_memory_operands(rd, rs1, imm)
            result = sgn_extension_u32_u64(read_32(rs1_plus_imm))
        }
        case READ64_WB: {
            printf "READ64_WB(a) "
            print_i_memory_operands(rd, rs1, imm)
            result = read_64(rs1_plus_imm) as DoubleWord
        }
        // ================
        // I-type 
        // ================
        case OP_ADDI_WB: {
            printf "OP_ADDI_WB(a) "
            print_i_operands(rd, rs1, imm)
            result = rs1_plus_imm
        }
        case OP_SLLI_WB: {
            var uimm6:UImm6 = imm as UImm6
            printf "OP_SLLI_WB(a) "
            print_i_shift6_operands(rd, rs1, uimm6)
            result = v1 << uimm6
        }
        case OP_SRLI_WB: {
            var uimm6:UImm6 = imm as UImm6
            printf "OP_SRLI_WB(a) "
            print_i_shift6_operands(rd, rs1, uimm6)
            result = v1 >> uimm6
        }
        case OP_ANDI_WB: {
            printf "OP_ANDI_WB(a) "
            print_i_operands(rd, rs1, imm)
            result = v1 & imm
        }
        case OP_XORI_WB: {
            printf "OP_XORI_WB(a) "
            print_i_operands(rd, rs1, imm)
            result = v1 ^ imm
        }

        // ============================
        // R-type 
        // ============================                
        case RTYPE_ADD_WB: {
            printf "RTYPE_ADD_WB(a) "
            print_r_operands(rd, rs1, rs2)
            overflow::result = (v1 as u65) + (v2 as u65)
        }
        case RTYPE_AND_WB: {
            printf "RTYPE_AND_WB(a) "
            print_r_operands(rd, rs1, rs2)
            result = v1 & v2
        }
        case RTYPE_OR_WB: {
            printf "RTYPE_OR_WB(a) "
            print_r_operands(rd, rs1, rs2)
            result = v1 | v2
        }
        case RTYPE_SUB_WB: {
            printf "RTYPE_SUB_WB(a) "
            print_r_operands(rd, rs1, rs2)
            overflow::result = ((1 as u1)::(v1 as u64)) - (v2 as u65)
        }
        case RTYPE_XOR_WB: {
            printf "RTYPE_XOR_WB(a) "
            print_r_operands(rd, rs1, rs2)
            result = v1 ^ v2
        }
        case RTYPE_SLL_WB: {
            printf "RTYPE_SLL_WB(a) "
            print_r_operands(rd, rs1, rs2)
            shift_discard_6::shift_amount_6 = v2
            result = v1 << shift_amount_6
        }
        case RTYPE_SRL_WB: {
            printf "RTYPE_SRL_WB(a) "
            print_r_operands(rd, rs1, rs2)
            shift_discard_6::shift_amount_6 = v2
            result = v1 >> shift_amount_6
        }
        // =======
        // S-type 
        // =======        
        case STYPE_STORE64: {
            printf "STYPE_STORE64(a) "
            print_s_operands(rs2, rs1, imm)
            write_64(rs1_plus_imm, v2)
            // Increment PC
            new_pc = (pc + 4) as Address
            // Copy output address
            new_output_write_address = output_write_address
            // Early return
            return
        }
        case STYPE_STORE8: {
            printf "STYPE_STORE8(a) "
            print_s_operands(rs2, rs1, imm)
            write_8(rs1_plus_imm, (v2 & (0xFF as u64)) as u8)
            // Increment PC
            new_pc = (pc + 4) as Address
            // Copy output address
            new_output_write_address = output_write_address
            // Early return
            return
        }

        // =======
        // B-type 
        // =======        
        case BRANCH_BEQ: {
            printf "BRANCH_BEQ(a) "
            print_b_operands(rs1, rs2, imm)
            if v1 == v2 {
                new_pc = signed_sum_of_double_word(pc, imm)
            } else {
                // Fall thru
                new_pc = (pc + 4) as Address
            }
            // Copy output address
            new_output_write_address = output_write_address
            // Early return
            return
        }
        case BRANCH_BNE: {
            printf "BRANCH_BNE(a) "
            print_b_operands(rs1, rs2, imm)
            if v1 != v2 {
                new_pc = signed_sum_of_double_word(pc, imm)
            } else {
                // Fall thru
                new_pc = (pc + 4) as Address
            }
            // Copy output address
            new_output_write_address = output_write_address
            // Early return
            return
        }
        case BRANCH_BLTU: {
            printf "BRANCH_BLTU(a) "
            print_b_operands(rs1, rs2, imm)
            if v1<v2 {
                new_pc = signed_sum_of_double_word(pc, imm)
            } else {
                // Fall thru
                new_pc = (pc + 4) as Address
            }
            // Copy output address
            new_output_write_address = output_write_address
            // Early return
            return
        }
        // =======
        // U-type 
        // =======
        case UTYPE_AUIPC_WB: {
            printf "UTYPE_AUIPC_WB(a) "
            print_u_operands(rd, (imm >> 12) as Imm20)
            result = signed_sum_of_double_word(imm, pc) as DoubleWord
        }

        default: {
            // Fall back on expensive function
            new_pc, new_output_write_address = interpreter_b(index, pc, output_write_address)
            return
        }
    }
    // Increment PC
    new_pc = (pc + 4) as Address
    // Copy output address
    new_output_write_address = output_write_address
    // write back
    registers[rd] = result
}

fn interpreter_b<registers, ram, keccak_state, poseidon2_state>(index:u64, pc:Address, output_write_address:OutputAddress) -> (new_pc:Address, new_output_write_address:OutputAddress) {

    var compute_op:ComputeOp
    var imm:DoubleWord
    var rs1:Register
    var rs2:Register
    var rd:Register
    compute_op, imm, rs1, rs2, rd = decoded[index]

    var v1:DoubleWord = registers[rs1]
    var v2:DoubleWord = registers[rs2]
    var result:DoubleWord
    var rs1_plus_imm:u64

    rs1_plus_imm = signed_sum_of_double_word(v1, imm)

    switch compute_op {
        // ==============
        // I-type
        // ==============
        case READ8_SGN_WB: {
            printf "READ8_SGN_WB(b) "
            print_i_memory_operands(rd, rs1, imm)
            result = sgn_extension_u8_u64(read_8(rs1_plus_imm))
        }
        case READ16_SGN_WB: {
            printf "READ16_SGN_WB(b) "
            print_i_memory_operands(rd, rs1, imm)
            result = sgn_extension_u16_u64(read_16(rs1_plus_imm))
        }
        case READ16_ZEXT_WB: {
            printf "READ16_ZEXT_WB(b) "
            print_i_memory_operands(rd, rs1, imm)
            result = read_16(rs1_plus_imm) as DoubleWord
        }
        case READ32_ZEXT_WB: {
            printf "READ32_ZEXT_WB(b) "
            print_i_memory_operands(rd, rs1, imm)
            result = read_32(rs1_plus_imm) as DoubleWord
        }
        case OP_SLTI_WB: {
            printf "OP_SLTI_WB(b) "
            print_i_operands(rd, rs1, imm)
            result = signed_LT(v1, imm) as DoubleWord
        }
        case OP_SLTIU_WB: {
            printf "OP_SLTIU_WB(b) "
            print_i_operands(rd, rs1, imm)
            // Warn: this is an unsigned comparison (even if imm12 is SGN_EXT)
            result = v1<imm ? 1:0
        }
        case OP_SRAI_WB: {
            var uimm6:UImm6 = imm as UImm6
            printf "OP_SRAI_WB(b) "
            print_i_shift6_operands(rd, rs1, uimm6)
            result = _ashr_u64(v1, uimm6)
        }
        case OP_ORI_WB: {
            printf "OP_ORI_WB(b) "
            print_i_operands(rd, rs1, imm)
            result = v1 | imm
        }
        case OP_SLLIW_WB: {
            var uimm5:UImm5 = imm as UImm5
            printf "OP_SLLIW_WB(b) "
            print_i_shift5_operands(rd, rs1, uimm5)
            result = sgn_extension_u32_u64(((v1 & MAX_UINT_32_AS_U64) as Word) << uimm5)
        }
        case OP_SRLIW_WB: {
            var uimm5:UImm5 = imm as UImm5
            printf "OP_SRLIW_WB(b) "
            print_i_shift5_operands(rd, rs1, uimm5)
            result = sgn_extension_u32_u64(((v1 & MAX_UINT_32_AS_U64) as Word) >> uimm5)
        }
        case OP_SRAIW_WB: {
            var uimm5:UImm5 = imm as UImm5
            printf "OP_SRAIW_WB(b) "
            print_i_shift5_operands(rd, rs1, uimm5)
            result = sgn_extension_u32_u64(_ashr_u32(v1, uimm5))
        }
        case OP_ADDIW_WB: {
            printf "OP_ADDIW_WB(b) "
            print_i_operands(rd, rs1, imm)
            result = sgn_extension_u32_u64((rs1_plus_imm & MAX_UINT_32_AS_U64) as Word)
        }
        case ITYPE_JALR: {
            printf "ITYPE_JALR(b) "
            print_i_memory_operands(rd, rs1, imm)
            new_pc = rs1_plus_imm & MASK_64_ERASE_LAST_BIT
            // Copy output address
            new_output_write_address = output_write_address
            return
        }
        case ITYPE_JALR_WB: {
            printf "ITYPE_JALR_WB(b) "
            print_i_memory_operands(rd, rs1, imm)
            new_pc = rs1_plus_imm & MASK_64_ERASE_LAST_BIT
            // Copy output address
            new_output_write_address = output_write_address
            // Write back
            registers[rd] = (pc + 4) as DoubleWord
            // Early Return
            return
        }
        // =======
        // B-type 
        // =======        
        case BRANCH_BLT: {
            printf "BRANCH_BLT(b) "
            print_b_operands(rs1, rs2, imm)
            if signed_LT(v1, v2) == 1 {
                new_pc = signed_sum_of_double_word(pc, imm)
            } else {
                // Fall thru
                new_pc = (pc + 4) as Address
            }
            // Copy output address
            new_output_write_address = output_write_address
            // Early return
            return
        }
        case BRANCH_BGE: {
            printf "BRANCH_BGE(b) "
            print_b_operands(rs1, rs2, imm)
            if signed_LT(v1, v2) == 0 {
                new_pc = signed_sum_of_double_word(pc, imm)
            } else {
                // Fall thru
                new_pc = (pc + 4) as Address
            }
            // Copy output address
            new_output_write_address = output_write_address
            // Early return
            return
        }
        case BRANCH_BGEU: {
            printf "BRANCH_BGEU(b) "
            print_b_operands(rs1, rs2, imm)
            if v1 >= v2 {
                new_pc = signed_sum_of_double_word(pc, imm)
            } else {
                // Fall thru
                new_pc = (pc + 4) as Address
            }
            // Copy output address
            new_output_write_address = output_write_address
            // Early return
            return
        }
        default: {
            // Fall back on expensive function
            new_pc, new_output_write_address = interpreter_c(index, pc, output_write_address)
            return
        }
    }
    // Increment PC
    new_pc = (pc + 4) as Address
    // Copy output address
    new_output_write_address = output_write_address
    // write back
    registers[rd] = result
}

fn interpreter_c<registers, ram, keccak_state, poseidon2_state>(index:u64, pc:Address, output_write_address:OutputAddress) -> (new_pc:Address, new_output_write_address:OutputAddress) {

    var compute_op:ComputeOp
    var imm:DoubleWord
    var rs1:Register
    var rs2:Register
    var rd:Register
    compute_op, imm, rs1, rs2, rd = decoded[index]

    var v1:DoubleWord = registers[rs1]
    var v2:DoubleWord = registers[rs2]
    var shift_discard_6:u58
    var shift_amount_6:u6
    var shift_discard_5:u27
    var shift_amount_5:u5
    var overflow:SignBit
    var v1_upper:Word
    var v1_lower:Word
    var v2_upper:Word
    var v2_lower:Word
    var product_upper:Word
    var product_lower:Word
    var product_hi:DoubleWord
    var product_lo:DoubleWord
    var word_wip:Word
    var result:DoubleWord
    var rs1_plus_imm:u64
    var mem_address:Address

    new_pc = (pc + 4) as Address
    new_output_write_address = output_write_address

    switch compute_op {
        // =========
        // MISC_MEM 
        // =========
        case COMPUTE_MISC_MEM: {
        }
        // ==============
        // I-type — LOAD 
        // ==============
        case READ8_SGN: {
            rs1_plus_imm = signed_sum_of_double_word(v1, imm)
            printf "READ8_SGN(c) "
            print_i_memory_operands(rd, rs1, imm)
            result = sgn_extension_u8_u64(read_8(rs1_plus_imm))
        }
        case READ16_SGN: {
            rs1_plus_imm = signed_sum_of_double_word(v1, imm)
            printf "READ16_SGN(c) "
            print_i_memory_operands(rd, rs1, imm)
            result = sgn_extension_u16_u64(read_16(rs1_plus_imm))
        }
        case READ32_SGN: {
            rs1_plus_imm = signed_sum_of_double_word(v1, imm)
            printf "READ32_SGN(c) "
            print_i_memory_operands(rd, rs1, imm)
            result = sgn_extension_u32_u64(read_32(rs1_plus_imm))
        }
        case READ64: {
            rs1_plus_imm = signed_sum_of_double_word(v1, imm)
            printf "READ64(c) "
            print_i_memory_operands(rd, rs1, imm)
            result = read_64(rs1_plus_imm) as DoubleWord
        }
        case READ8_ZEXT: {
            rs1_plus_imm = signed_sum_of_double_word(v1, imm)
            printf "READ8_ZEXT(c) "
            print_i_memory_operands(rd, rs1, imm)
            result = read_8(rs1_plus_imm) as DoubleWord
        }
        case READ16_ZEXT: {
            rs1_plus_imm = signed_sum_of_double_word(v1, imm)
            printf "READ16_ZEXT(c) "
            print_i_memory_operands(rd, rs1, imm)
            result = read_16(rs1_plus_imm) as DoubleWord
        }
        case READ32_ZEXT: {
            rs1_plus_imm = signed_sum_of_double_word(v1, imm)
            printf "READ32_ZEXT(c) "
            print_i_memory_operands(rd, rs1, imm)
            result = read_32(rs1_plus_imm) as DoubleWord
        }
        // ================
        // I-type — OP-IMM 
        // ================
        case OP_ADDI: {
            rs1_plus_imm = signed_sum_of_double_word(v1, imm)
            printf "OP_ADDI(c) "
            print_i_operands(rd, rs1, imm)
            result = rs1_plus_imm
        }
        case OP_SLLI: {
            rs1_plus_imm = signed_sum_of_double_word(v1, imm)
            var uimm6:UImm6 = imm as UImm6
            printf "OP_SLLI(c) "
            print_i_shift6_operands(rd, rs1, uimm6)
            result = v1 << uimm6
        }
        case OP_SLTI: {
            rs1_plus_imm = signed_sum_of_double_word(v1, imm)
            printf "OP_SLTI(c) "
            print_i_operands(rd, rs1, imm)
            result = signed_LT(v1, imm) as DoubleWord
        }
        case OP_SLTIU: {
            rs1_plus_imm = signed_sum_of_double_word(v1, imm)
            printf "OP_SLTIU(c) "
            print_i_operands(rd, rs1, imm)
            // Warn: this is an unsigned comparison (even if imm12 is SGN_EXT)
            result = v1<imm ? 1:0
        }
        case OP_XORI: {
            rs1_plus_imm = signed_sum_of_double_word(v1, imm)
            printf "OP_XORI(c) "
            print_i_operands(rd, rs1, imm)
            result = v1 ^ imm
        }
        case OP_SRLI: {
            rs1_plus_imm = signed_sum_of_double_word(v1, imm)
            var uimm6:UImm6 = imm as UImm6
            printf "OP_SRLI(c) "
            print_i_shift6_operands(rd, rs1, uimm6)
            result = v1 >> uimm6
        }
        case OP_SRAI: {
            rs1_plus_imm = signed_sum_of_double_word(v1, imm)
            var uimm6:UImm6 = imm as UImm6
            printf "OP_SRAI(c) "
            print_i_shift6_operands(rd, rs1, uimm6)
            result = _ashr_u64(v1, uimm6)
        }
        case OP_ORI: {
            rs1_plus_imm = signed_sum_of_double_word(v1, imm)
            printf "OP_ORI(c) "
            print_i_operands(rd, rs1, imm)
            result = v1 | imm
        }
        case OP_ANDI: {
            rs1_plus_imm = signed_sum_of_double_word(v1, imm)
            printf "OP_ANDI(c) "
            print_i_operands(rd, rs1, imm)
            result = v1 & imm
        }
        // ==========================
        // I-type — OP-IMM-32 (former I_TYPE)
        // ==========================
        case OP_ADDIW: {
            rs1_plus_imm = signed_sum_of_double_word(v1, imm)
            printf "OP_ADDIW(c) "
            print_i_operands(rd, rs1, imm)
            result = sgn_extension_u32_u64((rs1_plus_imm & MAX_UINT_32_AS_U64) as Word)
        }

        case OP_SLLIW: {
            rs1_plus_imm = signed_sum_of_double_word(v1, imm)
            var uimm5:UImm5 = imm as UImm5
            printf "OP_SLLIW(c) "
            print_i_shift5_operands(rd, rs1, uimm5)
            result = sgn_extension_u32_u64(((v1 & MAX_UINT_32_AS_U64) as Word) << uimm5)
        }
        case OP_SRLIW: {
            rs1_plus_imm = signed_sum_of_double_word(v1, imm)
            var uimm5:UImm5 = imm as UImm5
            printf "OP_SRLIW(c) "
            print_i_shift5_operands(rd, rs1, uimm5)
            result = sgn_extension_u32_u64(((v1 & MAX_UINT_32_AS_U64) as Word) >> uimm5)
        }
        case OP_SRAIW: {
            rs1_plus_imm = signed_sum_of_double_word(v1, imm)
            var uimm5:UImm5 = imm as UImm5
            printf "OP_SRAIW(c) "
            print_i_shift5_operands(rd, rs1, uimm5)
            result = sgn_extension_u32_u64(_ashr_u32(v1, uimm5))
        }

        // =======================
        // I-type — JALR / SYSTEM
        // =======================

        case ITYPE_ECALL: {
            printf "ITYPE_ECALL(c)\n"
            new_pc = process_syscall(pc)
        }
        case ITYPE_EBREAK: {
            rs1_plus_imm = signed_sum_of_double_word(v1, imm)
            printf "[ERROR] ITYPE_EBREAK instruction triggered(c)\n"
            fail
        }
        // ==========================
        // R-type — base ops (former R_TYPE)
        // ==========================
        case RTYPE_ADD: {
            printf "RTYPE_ADD(c) "
            print_r_operands(rd, rs1, rs2)
            overflow::result = (v1 as u65) + (v2 as u65)
        }
        case RTYPE_SUB: {
            printf "RTYPE_SUB(c) "
            print_r_operands(rd, rs1, rs2)
            overflow::result = ((1 as u1)::(v1 as u64)) - (v2 as u65)
        }
        case RTYPE_SLL: {
            printf "RTYPE_SLL(c) "
            print_r_operands(rd, rs1, rs2)
            shift_discard_6::shift_amount_6 = v2
            result = v1 << shift_amount_6
        }
        case RTYPE_SLT: {
            printf "RTYPE_SLT(c) "
            print_r_operands(rd, rs1, rs2)
            result = signed_LT(v1, v2) as DoubleWord
        }
        case RTYPE_SLTU: {
            printf "RTYPE_SLTU(c) "
            print_r_operands(rd, rs1, rs2)
            result = v1<v2 ? 1:0
        }
        case RTYPE_SRL: {
            printf "RTYPE_SRL(c) "
            print_r_operands(rd, rs1, rs2)
            shift_discard_6::shift_amount_6 = v2
            result = v1 >> shift_amount_6
        }
        case RTYPE_SRA: {
            printf "RTYPE_SRA(c) "
            print_r_operands(rd, rs1, rs2)
            shift_discard_6::shift_amount_6 = v2
            result = _ashr_u64(v1, shift_amount_6)
        }
        case RTYPE_OR: {
            printf "RTYPE_OR(c) "
            print_r_operands(rd, rs1, rs2)
            result = v1 | v2
        }
        case RTYPE_AND: {
            printf "RTYPE_AND(c) "
            print_r_operands(rd, rs1, rs2)
            result = v1 & v2
        }
        case RTYPE_XOR: {
            printf "RTYPE_XOR(c) "
            print_r_operands(rd, rs1, rs2)
            result = v1 ^ v2
        }
        case RTYPE_MUL: {
            printf "RTYPE_MUL(c) "
            print_r_operands(rd, rs1, rs2)
            product_hi, product_lo = mul64_uu(v1, v2)
            result = product_lo
        }
        case RTYPE_MULH: {
            printf "RTYPE_MULH(c) "
            print_r_operands(rd, rs1, rs2)
            product_hi, product_lo = mul64_ss(v1, v2)
            result = product_hi
        }
        case RTYPE_MULHSU: {
            printf "RTYPE_MULHSU(c) "
            print_r_operands(rd, rs1, rs2)
            product_hi, product_lo = mul64_su(v1, v2)
            result = product_hi
        }
        case RTYPE_MULHU: {
            printf "RTYPE_MULHU(c) "
            print_r_operands(rd, rs1, rs2)
            product_hi, product_lo = mul64_uu(v1, v2)
            result = product_hi
        }
        case RTYPE_DIV: {
            printf "RTYPE_DIV(c) "
            print_r_operands(rd, rs1, rs2)
            if (v1 == OVERFLOW_DIVIDEND) && (v2 == NEGATIVE_ONE_AS_I64) {
                result = OVERFLOW_DIVIDEND
            } else {
                result = v2 == 0 ? NEGATIVE_ONE_AS_I64:div64_ss(v1, v2)
            }
        }
        case RTYPE_DIVU: {
            printf "RTYPE_DIVU(c) "
            print_r_operands(rd, rs1, rs2)
            if v2 == 0 {
                result = NEGATIVE_ONE_AS_I64
            } else {
                result = div64_uu(v1, v2)
            }
        }
        case RTYPE_REM: {
            printf "RTYPE_REM(c) "
            print_r_operands(rd, rs1, rs2)
            result = rem64_ss(v1, v2)
        }
        case RTYPE_REMU: {
            printf "RTYPE_REMU(c) "
            print_r_operands(rd, rs1, rs2)
            result = rem64_uu(v1, v2)
        }
        case RTYPE_ADDW: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_ADDW(c) "
            print_r_operands(rd, rs1, rs2)
            overflow::word_wip = (v1_lower as u33) + (v2_lower as u33)
            result = sgn_extension_u32_u64(word_wip)
        }
        case RTYPE_SUBW: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_SUBW(c) "
            print_r_operands(rd, rs1, rs2)
            overflow::word_wip = ((1 as u1)::v1_lower) - (v2_lower as u33)
            result = sgn_extension_u32_u64(word_wip)
        }
        case RTYPE_SLLW: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_SLLW(c) "
            print_r_operands(rd, rs1, rs2)
            shift_discard_5::shift_amount_5 = v2_lower
            result = sgn_extension_u32_u64(v1_lower << shift_amount_5)
        }
        case RTYPE_SRLW: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_SRLW(c) "
            print_r_operands(rd, rs1, rs2)
            shift_discard_5::shift_amount_5 = v2_lower
            result = sgn_extension_u32_u64(v1_lower >> shift_amount_5)
        }
        case RTYPE_SRAW: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_SRAW(c) "
            print_r_operands(rd, rs1, rs2)
            shift_discard_5::shift_amount_5 = v2_lower
            if (sign_bit_of_word(v1_lower) == 1) {
                result = sgn_extension_u32_u64(bit_flip_word((bit_flip_word(v1_lower) >> shift_amount_5)))
            } else {
                result = sgn_extension_u32_u64(v1_lower >> shift_amount_5)
            }
        }
        case RTYPE_MULW: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_MULW(c) "
            print_r_operands(rd, rs1, rs2)
            product_upper, product_lower = mul32_uu(v1_lower, v2_lower)
            result = sgn_extension_u32_u64(product_lower)
        }
        case RTYPE_DIVW: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_DIVW(c) "
            print_r_operands(rd, rs1, rs2)
            if v2_lower == 0 {
                result = NEGATIVE_ONE_AS_I64
            } else {
                word_wip = div32_ss(v1_lower, v2_lower)
                result = sgn_extension_u32_u64(word_wip)
            }
        }
        case RTYPE_DIVUW: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_DIVUW(c) "
            print_r_operands(rd, rs1, rs2)
            if v2_lower == 0 {
                result = NEGATIVE_ONE_AS_I64
            } else {
                word_wip = div32_uu(v1_lower, v2_lower)
                result = sgn_extension_u32_u64(word_wip)
            }
        }
        case RTYPE_REMW: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_REMW(c) "
            print_r_operands(rd, rs1, rs2)
            word_wip = rem32_ss(v1_lower, v2_lower)
            result = sgn_extension_u32_u64(word_wip)
        }
        case RTYPE_REMUW: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_REMUW(c) "
            print_r_operands(rd, rs1, rs2)
            word_wip = rem32_uu(v1_lower, v2_lower)
            result = sgn_extension_u32_u64(word_wip)
        }
        case RTYPE_KECCAK: {
            printf "RTYPE_KECCAK(c) "
            keccak(v1 as Address, v2 as u32, registers[rd] as Address)
            // fall through
        }
        case RTYPE_POSEIDON2: {
            printf "RTYPE_POSEIDON2(c) "
            // Note: registers[rd] isn't changed by this instruction, it's merely read.
            // poseidon2(input_addr, output_addr) applies the permutation to the
            // STATE_WIDTH field elements at input_addr, writing the result to output_addr.
            poseidon2(v1 as Address, registers[rd] as Address)
            // fall through
        }
        case RTYPE_WRITE_OUTPUT: {
            printf "RTYPE_WRITE_OUTPUT(c) "
            new_output_write_address = write_output(v1 as Address, v2 as OutputSize, output_write_address)
            // fall through
        }
        // ============================
        // R-type — writeback variants 
        // ============================                
        case RTYPE_SLT_WB: {
            printf "RTYPE_SLT_WB(c) "
            print_r_operands(rd, rs1, rs2)
            registers[rd] = signed_LT(v1, v2) as DoubleWord
        }
        case RTYPE_SLTU_WB: {
            printf "RTYPE_SLTU_WB(c) "
            print_r_operands(rd, rs1, rs2)
            registers[rd] = v1<v2 ? 1:0
        }
        case RTYPE_SRA_WB: {
            printf "RTYPE_SRA_WB(c) "
            print_r_operands(rd, rs1, rs2)
            shift_discard_6::shift_amount_6 = v2
            registers[rd] = _ashr_u64(v1, shift_amount_6)
        }
        case RTYPE_MUL_WB: {
            printf "RTYPE_MUL_WB(c) "
            print_r_operands(rd, rs1, rs2)
            product_hi, product_lo = mul64_uu(v1, v2)
            registers[rd] = product_lo
        }
        case RTYPE_MULH_WB: {
            printf "RTYPE_MULH_WB(c) "
            print_r_operands(rd, rs1, rs2)
            product_hi, product_lo = mul64_ss(v1, v2)
            registers[rd] = product_hi
        }
        case RTYPE_MULHSU_WB: {
            printf "RTYPE_MULHSU_WB(c) "
            print_r_operands(rd, rs1, rs2)
            product_hi, product_lo = mul64_su(v1, v2)
            registers[rd] = product_hi
        }
        case RTYPE_MULHU_WB: {
            printf "RTYPE_MULHU_WB(c) "
            print_r_operands(rd, rs1, rs2)
            product_hi, product_lo = mul64_uu(v1, v2)
            registers[rd] = product_hi
        }
        case RTYPE_DIV_WB: {
            printf "RTYPE_DIV_WB(c) "
            print_r_operands(rd, rs1, rs2)
            if (v1 == OVERFLOW_DIVIDEND) && (v2 == NEGATIVE_ONE_AS_I64) {
                result = OVERFLOW_DIVIDEND
            } else {
                result = v2 == 0 ? NEGATIVE_ONE_AS_I64:div64_ss(v1, v2)
            }
            registers[rd] = result
        }
        case RTYPE_DIVU_WB: {
            printf "RTYPE_DIVU_WB(c) "
            print_r_operands(rd, rs1, rs2)
            if v2 == 0 {
                registers[rd] = NEGATIVE_ONE_AS_I64
            } else {
                registers[rd] = div64_uu(v1, v2)
            }
        }
        case RTYPE_REM_WB: {
            printf "RTYPE_REM_WB(c) "
            print_r_operands(rd, rs1, rs2)
            registers[rd] = rem64_ss(v1, v2)
        }
        case RTYPE_REMU_WB: {
            printf "RTYPE_REMU_WB(c) "
            print_r_operands(rd, rs1, rs2)
            registers[rd] = rem64_uu(v1, v2)
        }
        case RTYPE_ADDW_WB: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_ADDW_WB(c) "
            print_r_operands(rd, rs1, rs2)
            overflow::word_wip = (v1_lower as u33) + (v2_lower as u33)
            registers[rd] = sgn_extension_u32_u64(word_wip)
        }
        case RTYPE_SUBW_WB: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_SUBW_WB(c) "
            print_r_operands(rd, rs1, rs2)
            overflow::word_wip = ((1 as u1)::v1_lower) - (v2_lower as u33)
            registers[rd] = sgn_extension_u32_u64(word_wip)
        }
        case RTYPE_SLLW_WB: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_SLLW_WB(c) "
            print_r_operands(rd, rs1, rs2)
            shift_discard_5::shift_amount_5 = v2_lower
            registers[rd] = sgn_extension_u32_u64(v1_lower << shift_amount_5)
        }
        case RTYPE_SRLW_WB: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_SRLW_WB(c) "
            print_r_operands(rd, rs1, rs2)
            shift_discard_5::shift_amount_5 = v2_lower
            registers[rd] = sgn_extension_u32_u64(v1_lower >> shift_amount_5)
        }
        case RTYPE_SRAW_WB: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_SRAW_WB(c) "
            print_r_operands(rd, rs1, rs2)
            shift_discard_5::shift_amount_5 = v2_lower
            if (sign_bit_of_word(v1_lower) == 1) {
                registers[rd] = sgn_extension_u32_u64(bit_flip_word((bit_flip_word(v1_lower) >> shift_amount_5)))
            } else {
                registers[rd] = sgn_extension_u32_u64(v1_lower >> shift_amount_5)
            }
        }
        case RTYPE_MULW_WB: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_MULW_WB(c) "
            print_r_operands(rd, rs1, rs2)
            product_upper, product_lower = mul32_uu(v1_lower, v2_lower)
            registers[rd] = sgn_extension_u32_u64(product_lower)
        }
        case RTYPE_DIVW_WB: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_DIVW_WB(c) "
            print_r_operands(rd, rs1, rs2)
            if v2_lower == 0 {
                registers[rd] = NEGATIVE_ONE_AS_I64
            } else {
                word_wip = div32_ss(v1_lower, v2_lower)
                registers[rd] = sgn_extension_u32_u64(word_wip)
            }
        }
        case RTYPE_DIVUW_WB: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_DIVUW_WB(c) "
            print_r_operands(rd, rs1, rs2)
            if v2_lower == 0 {
                registers[rd] = NEGATIVE_ONE_AS_I64
            } else {
                word_wip = div32_uu(v1_lower, v2_lower)
                registers[rd] = sgn_extension_u32_u64(word_wip)
            }
        }
        case RTYPE_REMW_WB: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_REMW_WB(c) "
            print_r_operands(rd, rs1, rs2)
            word_wip = rem32_ss(v1_lower, v2_lower)
            registers[rd] = sgn_extension_u32_u64(word_wip)
        }
        case RTYPE_REMUW_WB: {
            v1_upper::v1_lower = v1
            v2_upper::v2_lower = v2
            printf "RTYPE_REMUW_WB(c) "
            print_r_operands(rd, rs1, rs2)
            word_wip = rem32_uu(v1_lower, v2_lower)
            registers[rd] = sgn_extension_u32_u64(word_wip)
        }
        // =======
        // S-type 
        // =======        
        case STYPE_STORE16: {
            mem_address = signed_sum_of_double_word(v1, imm) as Address
            printf "STYPE_STORE16(c) "
            print_s_operands(rs2, rs1, imm)
            write_16(mem_address, (v2 & (0xFFFF as u64)) as u16)
        }
        case STYPE_STORE32: {
            mem_address = signed_sum_of_double_word(v1, imm) as Address
            printf "STYPE_STORE32(c) "
            print_s_operands(rs2, rs1, imm)
            write_32(mem_address, (v2 & (0xFFFFFFFF as u64)) as u32)
        }
        // =======
        // J-type 
        // =======
        case JTYPE_JAL: {
            printf "JTYPE_JAL(c) "
            print_j_operands(rd, imm)
            new_pc = signed_sum_of_double_word(pc, imm) as Address
        }
        case JTYPE_JAL_WB: {
            printf "JTYPE_JAL_WB(c) "
            print_j_operands(rd, imm)
            new_pc = signed_sum_of_double_word(pc, imm) as Address
            registers[rd] = signed_sum_of_double_word(pc, 4)
        }
        // =======
        // U-type 
        // =======
        case UTYPE_LUI: {
            printf "UTYPE_LUI(c) "
            print_u_operands(rd, (imm >> 12) as Imm20)
        }
        case UTYPE_LUI_WB: {
            printf "UTYPE_LUI_WB(c) "
            print_u_operands(rd, (imm >> 12) as Imm20)
            registers[rd] = imm
        }
        case UTYPE_AUIPC: {
            printf "UTYPE_AUIPC(c) "
            print_u_operands(rd, (imm >> 12) as Imm20)
            result = signed_sum_of_double_word(imm, pc) as DoubleWord
        }
        default: {
            printf "[ERROR] Unsupported compute_op %d\n", compute_op
            fail
        }
    }
}

fn process_syscall<registers, ram>(pc:Address) -> (new_pc:Address) {
    new_pc = (pc + 4) as Address
    var call_num:DoubleWord = registers[17]
    switch call_num {
        case EXIT_SYSCALL: {
            printf "ECALL for exit\n"
            var a0:DoubleWord = registers[10]
            if a0 == 0 {
                printf "EXIT CODE = 0\n"
            } else {
                fail "EXIT CODE = %d\n", a0
            }
            new_pc = MAX_UINT_64
        }
        case WRITE_SYSCALL: {
            printf "ECALL for write\n"
            var a1:Address = registers[11] as Address
            var a2:DoubleWord = registers[12]
            var addr:Address = a1
            for i:DoubleWord = 0; i<a2; i = i + 1 {
                printf "%c", read_8(addr)
                addr = addr + 1
            }
            printf "\n"
            registers[10] = a2
        }
        default: {
            fail "unsupported system call (%d)", call_num
        }
    }
}


