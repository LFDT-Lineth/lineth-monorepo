                        } else {
                        if (sign_bit_of_word(v1_lower) == sign_bit_of_word(v2_lower)) {
                        registers[r_rd] = sgn_extension_u32_u64((absolute_value_word(v1_lower) / absolute_value_word(v2_lower)))
                        } else {
                        registers[r_rd] = sgn_extension_u32_u64(negative_of_word((absolute_value_word(v1_lower) / absolute_value_word(v2_lower))))
                        }
                        }
        }
        case RTYPE_DIVUW_WB: {
            r_rs1, r_rs2, r_rd = decoded_rtype[index]
            v1 = registers[r_rs1]
            v2 = registers[r_rs2]
            v1_upper::v1_lower = v1
                        v2_upper::v2_lower = v2
                        printf "RTYPE_DIVUW "
                        print_r_operands(r_rd, r_rs1, r_rs2)
                        if (v2_lower == 0) {
                        registers[r_rd] = NEGATIVE_ONE_AS_I64
                        } else {
                        registers[r_rd] = sgn_extension_u32_u64(v1_lower / v2_lower)
                        }
        }
        case RTYPE_REMW_WB: {
            r_rs1, r_rs2, r_rd = decoded_rtype[index]
            v1 = registers[r_rs1]
            v2 = registers[r_rs2]
            v1_upper::v1_lower = v1
                        v2_upper::v2_lower = v2
                        printf "RTYPE_REMW "
                        print_r_operands(r_rd, r_rs1, r_rs2)
                        if (v2_lower == 0) {
                        registers[r_rd] = sgn_extension_u32_u64(v1_lower)
                        } else {
                        if (sign_bit_of_word(v1_lower) == 0) {
                        registers[r_rd] = sgn_extension_u32_u64(absolute_value_word(v1_lower) % absolute_value_word(v2_lower))
                        } else {
                        registers[r_rd] = sgn_extension_u32_u64(negative_of_word((absolute_value_word(v1_lower) % absolute_value_word(v2_lower))))
                        }
                        }
        }
        case RTYPE_REMUW_WB: {
            r_rs1, r_rs2, r_rd = decoded_rtype[index]
            v1 = registers[r_rs1]
            v2 = registers[r_rs2]
            v1_upper::v1_lower = v1
                        v2_upper::v2_lower = v2
                        printf "RTYPE_REMUW "
                        print_r_operands(r_rd, r_rs1, r_rs2)
                        if (v2_lower == 0) {
                        registers[r_rd] = sgn_extension_u32_u64(v1_lower)
                        } else {
                        registers[r_rd] = sgn_extension_u32_u64(v1_lower % v2_lower)
                        }
        }
        case STYPE_STORE8: {
            st_imm, st_rs2, st_rs1 = decoded_stype[index]
            mem_address = signed_sum_of_double_word(registers[st_rs1], st_imm) as Address
            printf "STYPE_STORE8 "
                        print_s_operands(st_rs2, st_rs1, st_imm)
                        write_8(mem_address, (registers[st_rs2] & (0xFF as u64)) as u8)
        }
        case STYPE_STORE16: {
            st_imm, st_rs2, st_rs1 = decoded_stype[index]
            mem_address = signed_sum_of_double_word(registers[st_rs1], st_imm) as Address
            printf "STYPE_STORE16 "
                        print_s_operands(st_rs2, st_rs1, st_imm)
                        write_16(mem_address, (registers[st_rs2] & (0xFFFF as u64)) as u16)
        }
        case STYPE_STORE32: {
            st_imm, st_rs2, st_rs1 = decoded_stype[index]
            mem_address = signed_sum_of_double_word(registers[st_rs1], st_imm) as Address
            printf "STYPE_STORE32 "
                        print_s_operands(st_rs2, st_rs1, st_imm)
                        write_32(mem_address, (registers[st_rs2] & (0xFFFFFFFF as u64)) as u32)
        }
        case STYPE_STORE64: {
            st_imm, st_rs2, st_rs1 = decoded_stype[index]
            mem_address = signed_sum_of_double_word(registers[st_rs1], st_imm) as Address
            printf "STYPE_STORE64 "
                        print_s_operands(st_rs2, st_rs1, st_imm)
                        write_64(mem_address, registers[st_rs2])
        }
        case BRANCH_BEQ: {
            b_imm, b_rs2, b_rs1 = decoded_btype[index]
            printf "BRANCH_BEQ "
                        print_b_operands(b_rs1, b_rs2, b_imm)
                        if registers[b_rs1] == registers[b_rs2] {
                            // the branch case
                            new_pc = signed_sum_of_double_word(pc, b_imm)
                        }
        }
        case BRANCH_BNE: {
            b_imm, b_rs2, b_rs1 = decoded_btype[index]
            printf "BRANCH_BNE "
                        print_b_operands(b_rs1, b_rs2, b_imm)
                        if registers[b_rs1] != registers[b_rs2] {
                            // the branch case
                            new_pc = signed_sum_of_double_word(pc, b_imm)
                        }
        }
        case BRANCH_BLT: {
            b_imm, b_rs2, b_rs1 = decoded_btype[index]
            printf "BRANCH_BLT "
                        print_b_operands(b_rs1, b_rs2, b_imm)
                        if signed_LT(registers[b_rs1], registers[b_rs2]) == 1 {
                            // the branch case
                            new_pc = signed_sum_of_double_word(pc, b_imm)
                        }
        }
        case BRANCH_BGE: {
            b_imm, b_rs2, b_rs1 = decoded_btype[index]
            printf "BRANCH_BGE "
                        print_b_operands(b_rs1, b_rs2, b_imm)
                        if signed_LT(registers[b_rs1], registers[b_rs2]) == 0 {
                            // the branch case
                            new_pc = signed_sum_of_double_word(pc, b_imm)
                        }
        }
        case BRANCH_BLTU: {
            b_imm, b_rs2, b_rs1 = decoded_btype[index]
            printf "BRANCH_BLTU "
                        print_b_operands(b_rs1, b_rs2, b_imm)
                        if registers[b_rs1]<registers[b_rs2] {
                            // the branch case
                            new_pc = signed_sum_of_double_word(pc, b_imm)
                        }
        }
        case BRANCH_BGEU: {
            b_imm, b_rs2, b_rs1 = decoded_btype[index]
            printf "BRANCH_BGEU "
                        print_b_operands(b_rs1, b_rs2, b_imm)
                        if registers[b_rs1] >= registers[b_rs2] {
                            // the branch case
                            new_pc = signed_sum_of_double_word(pc, b_imm)
                        }
        }
        case JTYPE_JAL: {
            j_imm, j_rd = decoded_jtype[index]
            printf "JTYPE_JAL "
                        print_j_operands(j_rd, j_imm)
                        new_pc = signed_sum_of_double_word(pc, j_imm) as Address
        }
        case JTYPE_JAL_WB: {
            j_imm, j_rd = decoded_jtype[index]
            printf "JTYPE_JAL "
                        print_j_operands(j_rd, j_imm)
                        new_pc = signed_sum_of_double_word(pc, j_imm) as Address
                        registers[j_rd] = signed_sum_of_double_word(pc, 4)
        }
        case UTYPE_LUI: {
            u_imm, u_rd = decoded_utype[index]
            printf "UTYPE_LUI "
                        print_u_operands(u_rd, (u_imm >> 12) as Imm20)
        }
        case UTYPE_LUI_WB: {
            u_imm, u_rd = decoded_utype[index]
            printf "UTYPE_LUI "
                        print_u_operands(u_rd, (u_imm >> 12) as Imm20)
                        registers[u_rd] = u_imm
        }
        case UTYPE_AUIPC: {
            u_imm, u_rd = decoded_utype[index]
            printf "UTYPE_AUIPC "
                        print_u_operands(u_rd, (u_imm >> 12) as Imm20)
                        result = signed_sum_of_double_word(u_imm, pc) as DoubleWord
        }
        case UTYPE_AUIPC_WB: {
            u_imm, u_rd = decoded_utype[index]
            printf "UTYPE_AUIPC "
                        print_u_operands(u_rd, (u_imm >> 12) as Imm20)
                        registers[u_rd] = signed_sum_of_double_word(u_imm, pc) as DoubleWord
        }
        default: {
            printf "[ERROR] Unsupported compute_op %d\n", compute_op
            fail
        }
    }
}

fn process_syscall<registers, ram>(pc:Address) -> (new_pc:Address) {
    var call_num:DoubleWord = registers[17]
    switch call_num {
        case EXIT_SYSCALL: {
            printf "ECALL for exit\n"
            var a0:DoubleWord = registers[10]
            if a0 == 0 {
                printf "EXIT CODE = 0\n"
            } else {
                fail "EXIT CODE = %d\n", a0
            }
            new_pc = MAX_UINT_64
        }
        case WRITE_SYSCALL: {
            printf "ECALL for write\n"
            var a1:Address = registers[11] as Address
            var a2:DoubleWord = registers[12]
            var addr:Address = a1
            for i:DoubleWord = 0; i<a2; i = i + 1 {
                printf "%c", read_8(addr)
                addr = addr + 1
            }
            printf "\n"
            registers[10] = a2
            new_pc = (pc + 4) as Address
        }
        default: {
            fail "unsupported system call (%d)", call_num
        }
    }
}
