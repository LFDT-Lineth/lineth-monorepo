        }
        case BRANCH_BNE: {
            printf "BRANCH_BNE "
            print_b_operands(rs1, rs2, imm)
            if registers[rs1] != registers[rs2] {
                // the branch case
                new_pc = signed_sum_of_double_word(pc, imm)
            }
        }
        case BRANCH_BLT: {
            printf "BRANCH_BLT "
            print_b_operands(rs1, rs2, imm)
            if signed_LT(registers[rs1], registers[rs2]) == 1 {
                // the branch case
                new_pc = signed_sum_of_double_word(pc, imm)
            }
        }
        case BRANCH_BGE: {
            printf "BRANCH_BGE "
            print_b_operands(rs1, rs2, imm)
            if signed_LT(registers[rs1], registers[rs2]) == 0 {
                // the branch case
                new_pc = signed_sum_of_double_word(pc, imm)
            }
        }
        case BRANCH_BLTU: {
            printf "BRANCH_BLTU "
            print_b_operands(rs1, rs2, imm)
            if registers[rs1]<registers[rs2] {
                // the branch case
                new_pc = signed_sum_of_double_word(pc, imm)
            }
        }
        case BRANCH_BGEU: {
            printf "BRANCH_BGEU "
            print_b_operands(rs1, rs2, imm)
            if registers[rs1] >= registers[rs2] {
                // the branch case
                new_pc = signed_sum_of_double_word(pc, imm)
            }
        }
        // =======
        // J-type 
        // =======
        case JTYPE_JAL: {
            printf "JTYPE_JAL "
            print_j_operands(rd, imm)
            new_pc = signed_sum_of_double_word(pc, imm) as Address
        }
        case JTYPE_JAL_WB: {
            printf "JTYPE_JAL "
            print_j_operands(rd, imm)
            new_pc = signed_sum_of_double_word(pc, imm) as Address
            registers[rd] = signed_sum_of_double_word(pc, 4)
        }
        // =======
        // U-type 
        // =======
        case UTYPE_LUI: {
            printf "UTYPE_LUI "
            print_u_operands(rd, (imm >> 12) as Imm20)
        }
        case UTYPE_LUI_WB: {
            printf "UTYPE_LUI "
            print_u_operands(rd, (imm >> 12) as Imm20)
            registers[rd] = imm
        }
        case UTYPE_AUIPC: {
            printf "UTYPE_AUIPC "
            print_u_operands(rd, (imm >> 12) as Imm20)
            result = signed_sum_of_double_word(imm, pc) as DoubleWord
        }
        case UTYPE_AUIPC_WB: {
            printf "UTYPE_AUIPC "
            print_u_operands(rd, (imm >> 12) as Imm20)
            registers[rd] = signed_sum_of_double_word(imm, pc) as DoubleWord
        }
        default: {
            printf "[ERROR] Unsupported compute_op %d\n", compute_op
            fail
        }
    }
}

fn process_syscall<registers, ram>(pc:Address) -> (new_pc:Address) {
    var call_num:DoubleWord = registers[17]
    switch call_num {
        case EXIT_SYSCALL: {
            printf "ECALL for exit\n"
            var a0:DoubleWord = registers[10]
            if a0 == 0 {
                printf "EXIT CODE = 0\n"
            } else {
                fail "EXIT CODE = %d\n", a0
            }
            new_pc = MAX_UINT_64
        }
        case WRITE_SYSCALL: {
            printf "ECALL for write\n"
            var a1:Address = registers[11] as Address
            var a2:DoubleWord = registers[12]
            var addr:Address = a1
            for i:DoubleWord = 0; i<a2; i = i + 1 {
                printf "%c", read_8(addr)
                addr = addr + 1
            }
            printf "\n"
            registers[10] = a2
            new_pc = (pc + 4) as Address
        }
        default: {
            fail "unsupported system call (%d)", call_num
        }
    }
}
