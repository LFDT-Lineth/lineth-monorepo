include "utils/constants.zkc"
include "utils/register_utils.zkc"
include "utils/type.zkc"
include "instruction_processing/b_type.zkc"
include "instruction_processing/r_type.zkc"
include "instruction_processing/i_type.zkc"
include "instruction_processing/s_type.zkc"
include "instruction_processing/j_type.zkc"
include "instruction_processing/u_type.zkc"

fn interpreter<registers, ram, state_row0, state_row1, state_row2, state_row3, state_row4, b0, b1, b2, b3, b4, c, d, padded_input_block, poseidon2_state>(index:u64, pc:Address) -> (new_pc:Address) {

    // The opcode, instruction type and parameters are pre-decoded externally
    // (see decoded_core in memory.zkc) and looked up by instruction index.
    var opcode:Opcode
    var instruction_type:Type
    var instruction_parameters:u25
    opcode, instruction_type, instruction_parameters = decoded_core[index]

    switch instruction_type {
        case R_TYPE: {
            process_R_type_instruction(index)
            new_pc = pc + 4 as Address
        }
        case I_TYPE: {
            new_pc = process_I_type_instruction(index, pc)
        }
        case S_TYPE: {
            process_S_type_instruction(index)
            new_pc = pc + 4 as Address
        }
        case B_TYPE: {
            new_pc = process_B_type_instruction(index, pc)
        }
        case U_TYPE: {
            process_U_type_instruction(opcode, index, pc)
            new_pc = pc + 4 as Address
        }
        case J_TYPE: {
            new_pc = process_J_type_instruction(index, pc)
        }
        case MISC_MEM_TYPE: {
            // FENCE / FENCE.I, and statically folded rd=x0 no-ops — advance PC only.
            new_pc = pc + 4 as Address
        }
        default: {
            printf "[ERROR] Unsupported instruction type %d\n", instruction_type
            fail
        }
    }
}