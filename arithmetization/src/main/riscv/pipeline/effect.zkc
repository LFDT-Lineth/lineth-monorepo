include "../memory.zkc"
include "../utils/constants.zkc"
include "../utils/absolute_value.zkc"
include "../utils/bit_flip.zkc"
include "../utils/negative.zkc"
include "../utils/sign_bit.zkc"
include "../utils/sign_extend.zkc"
include "../utils/signed_comparisons.zkc"
include "../utils/signed_sum.zkc"
include "../../lib/keccak/impl.zkc"

// =========================================================================
// COMPUTE phase of the unified interpreter pipeline.
//
// A single factorized switch over `operation`, taking the two operands a and b
// (already gathered by the read phase) and producing a `result`:
//
//   - ALU / MUL / DIV ops:   result = a <op> b  (64-bit and word-width *W)
//   - OPR_MOVE_LOADED:       result = loaded     (loads — see read.zkc)
//   - OPR_MOVE_B:            result = b          (LUI)
//   - OPR_LINK:              result = pc + 4     (JAL / JALR link address)
//   - OPR_CMP_*:             result = branch condition (1 = taken, 0 = not)
//   - OPR_KECCAK:            custom-1 precompile side effects; result = 0
//   - OPR_NOP:               no computation; result = 0
//
// Immediate and register ALU forms share the same op: operand b is either
// registers[rs2] or the immediate (selected upstream by b_src), so e.g. ADD and
// ADDI, SLL and SLLI, etc. collapse into one arm. `rd` is needed only by the
// Keccak precompile (which reads registers[rd] for the output address).
//
// Signed operations (SLT, SRA, MULH, MULHSU, DIV, REM and their *W variants)
// treat operands as two's-complement integers. Division and remainder follow
// RISC-V semantics: division by zero returns -1 (or the dividend for REM), and
// signed overflow (INT_MIN / -1) returns INT_MIN (or 0 for REM).
fn compute<registers, ram, state_row0, state_row1, state_row2, state_row3, state_row4, b0, b1, b2, b3, b4, c, d, padded_input_block>(operation:Operation, a:DoubleWord, b:DoubleWord, loaded:DoubleWord, pc:Address, rd:Register) -> (result:DoubleWord) {

    var v1_sign:SignBit
    var v2_sign:SignBit
    var v1_abs:UnsignedDoubleWord
    var v2_abs:UnsignedDoubleWord
    var shift_discard_6:u58 // 58 + 6 = 64, used for DoubleWords
    var shift_amount_6:u6
    var shift_discard_5:u59 // 59 + 5 = 64, low 5 bits select the word shift amount
    var shift_amount_5:u5
    var word_working_copy:Word
    var overflow:SignBit
    var a_upper:Word
    var a_lower:Word
    var b_upper:Word
    var b_lower:Word
    var a_lower_abs:Word
    var b_lower_abs:Word
    var product_upper:Word
    var product_lower:Word
    var word_wip:Word
    var sign_bit:SignBit

    result = 0

    // Note. If x = 0b... and y = 0b... are two bit strings of length N
    // and you interpret them either as uintN or intN, then the underlying
    // bit string of their additions is the same in both interpretations.
    // This also holds for subtraction.

    switch operation {

        // ===============================
        // ----- ALU (64-bit) -----
        // ===============================

        case OPR_ADD: {
            printf "ADD\n"
            overflow::result = (a as u65) + (b as u65)
        }
        case OPR_SUB: {
            printf "SUB\n"
            overflow::result = ((1 as u1)::(a as u64)) - (b as u65)
        }
        case OPR_SLL: {
            printf "SLL\n"
            shift_discard_6::shift_amount_6 = b
            result = a << shift_amount_6
        }
        case OPR_SLT: {
            printf "SLT\n"
            result = signed_LT(a, b) as DoubleWord
        }
        case OPR_SLTU: {
            printf "SLTU\n"
            if (a<b) {
                result = 1
            } else {
                result = 0
            }
        }
        case OPR_XOR: {
            printf "XOR\n"
            result = a ^ b
        }
        case OPR_SRL: {
            printf "SRL\n"
            shift_discard_6::shift_amount_6 = b
            result = a >> shift_amount_6
        }
        case OPR_SRA: {
            printf "SRA\n"
            shift_discard_6::shift_amount_6 = b
            result = _ashr_u64(a, shift_amount_6)
        }
        case OPR_OR: {
            printf "OR\n"
            result = a | b
        }
        case OPR_AND: {
            printf "AND\n"
            result = a & b
        }

        // ===============================
        // ----- ALU word-width (*W) -----
        // ===============================

        case OPR_ADDW: {
            printf "ADDW\n"
            a_upper::a_lower = a
            b_upper::b_lower = b
            overflow::word_wip = (a_lower as u33) + (b_lower as u33)
            result = sgn_extension_u32_u64(word_wip)
        }
        case OPR_SUBW: {
            printf "SUBW\n"
            a_upper::a_lower = a
            b_upper::b_lower = b
            overflow::word_wip = ((1 as u1)::a_lower) - (b_lower as u33)
            result = sgn_extension_u32_u64(word_wip)
        }
        case OPR_SLLW: {
            printf "SLLW\n"
            a_upper::a_lower = a
            shift_discard_5::shift_amount_5 = b
            result = sgn_extension_u32_u64(a_lower << shift_amount_5)
        }
        case OPR_SRLW: {
            printf "SRLW\n"
            a_upper::a_lower = a
            shift_discard_5::shift_amount_5 = b
            result = sgn_extension_u32_u64(a_lower >> shift_amount_5)
        }
        case OPR_SRAW: {
            printf "SRAW\n"
            a_upper::a_lower = a
            shift_discard_5::shift_amount_5 = b
            if (sign_bit_of_word(a_lower) == 1) {
                word_working_copy = bit_flip_word(a_lower)
            } else {
                word_working_copy = a_lower
            }
            word_working_copy = word_working_copy >> shift_amount_5
            if (sign_bit_of_word(a_lower) == 1) {
                word_working_copy = bit_flip_word(word_working_copy)
            }
            result = sgn_extension_u32_u64(word_working_copy)
        }

        // ===============================
        // ----- M-extension (64-bit) -----
        // ===============================

        case OPR_MUL: {
            printf "MUL\n"
            result = (((a as u128) * (b as u128)) & MAX_UINT_64_AS_U128) as u64
        }
        case OPR_MULH: {
            printf "MULH\n"
            v1_sign = sign_bit_of_double_word(a)
            v2_sign = sign_bit_of_double_word(b)
            v1_abs = absolute_value_double_word(a)
            v2_abs = absolute_value_double_word(b)
            var v1_times_v2_as_u128:u128 = (v1_abs as u128) * (v2_abs as u128)
            if (v1_sign ^ v2_sign) == 1 && v1_times_v2_as_u128 != 0 {
                v1_times_v2_as_u128 = (~v1_times_v2_as_u128) + 1
            }
            result = (v1_times_v2_as_u128 >> 64) as u64
        }
        case OPR_MULHSU: {
            printf "MULHSU\n"
            v1_abs = absolute_value_double_word(a)
            var v1_times_v2_as_u128:u128 = (v1_abs as u128) * (b as u128)
            v1_sign = sign_bit_of_double_word(a)
            if v1_sign == 1 && v1_times_v2_as_u128 != 0 {
                v1_times_v2_as_u128 = (~v1_times_v2_as_u128) + 1
            }
            result = (v1_times_v2_as_u128 >> 64) as u64
        }
        case OPR_MULHU: {
            printf "MULHU\n"
            result = (((a as u128) * (b as u128)) >> 64) as u64
        }
        case OPR_DIV: {
            printf "DIV\n"
            if b == 0 {
                result = NEGATIVE_ONE_AS_I64
            } else if (a == OVERFLOW_DIVIDEND) && (b == NEGATIVE_ONE_AS_I64) {
                result = OVERFLOW_DIVIDEND
            } else {
                v1_sign = sign_bit_of_double_word(a)
                v2_sign = sign_bit_of_double_word(b)
                v1_abs = absolute_value_double_word(a)
                v2_abs = absolute_value_double_word(b)
                result = v1_abs / v2_abs
                if (v1_sign ^ v2_sign) == 1 {
                    result = negative_of_double_word(result)
                }
            }
        }
        case OPR_DIVU: {
            printf "DIVU\n"
            if b == 0 {
                result = NEGATIVE_ONE_AS_I64
            } else {
                result = a / b
            }
        }
        case OPR_REM: {
            printf "REM\n"
            if b == 0 {
                result = a
            } else if (a == OVERFLOW_DIVIDEND) && (b == NEGATIVE_ONE_AS_I64) {
                result = 0
            } else {
                v1_sign = sign_bit_of_double_word(a)
                v1_abs = absolute_value_double_word(a)
                v2_abs = absolute_value_double_word(b)
                result = v1_abs % v2_abs
                if v1_sign == 1 {
                    result = negative_of_double_word(result)
                }
            }
        }
        case OPR_REMU: {
            printf "REMU\n"
            if b == 0 {
                result = a
            } else {
                result = a % b
            }
        }

        // ===============================
        // ----- M-extension word-width (*W) -----
        // ===============================

        case OPR_MULW: {
            printf "MULW\n"
            a_upper::a_lower = a
            b_upper::b_lower = b
            product_upper::product_lower = (a_lower as DoubleWord) * (b_lower as DoubleWord)
            sign_bit = sign_bit_of_word(product_lower)
            if (sign_bit == 1) {
                result = MAX_UINT_32::product_lower
            } else {
                result = product_lower as DoubleWord
            }
        }
        case OPR_DIVW: {
            printf "DIVW\n"
            a_upper::a_lower = a
            b_upper::b_lower = b
            a_lower_abs = absolute_value_word(a_lower)
            b_lower_abs = absolute_value_word(b_lower)
            if (b_lower == 0) {
                result = NEGATIVE_ONE_AS_I64
            } else {
                word_wip = a_lower_abs / b_lower_abs
                if (sign_bit_of_word(a_lower) == sign_bit_of_word(b_lower)) {
                    result = sgn_extension_u32_u64(word_wip)
                } else {
                    result = sgn_extension_u32_u64(negative_of_word(word_wip))
                }
            }
        }
        case OPR_DIVUW: {
            printf "DIVUW\n"
            a_upper::a_lower = a
            b_upper::b_lower = b
            if (b_lower == 0) {
                result = NEGATIVE_ONE_AS_I64
            } else {
                result = sgn_extension_u32_u64(a_lower / b_lower)
            }
        }
        case OPR_REMW: {
            printf "REMW\n"
            a_upper::a_lower = a
            b_upper::b_lower = b
            a_lower_abs = absolute_value_word(a_lower)
            b_lower_abs = absolute_value_word(b_lower)
            if (b_lower == 0) {
                result = sgn_extension_u32_u64(a_lower)
            } else {
                word_wip = a_lower_abs % b_lower_abs
                if (sign_bit_of_word(a_lower) == 0) {
                    result = sgn_extension_u32_u64(word_wip)
                } else {
                    result = sgn_extension_u32_u64(negative_of_word(word_wip))
                }
            }
        }
        case OPR_REMUW: {
            printf "REMUW\n"
            a_upper::a_lower = a
            b_upper::b_lower = b
            if (b_lower == 0) {
                result = sgn_extension_u32_u64(a_lower)
            } else {
                result = sgn_extension_u32_u64(a_lower % b_lower)
            }
        }

        // ===============================
        // ----- Moves / link -----
        // ===============================

        case OPR_MOVE_LOADED: {
            printf "LOAD\n"
            result = loaded
        }
        case OPR_MOVE_B: {
            printf "LUI\n"
            result = b
        }
        case OPR_LINK: {
            printf "LINK\n"
            result = signed_sum_of_double_word(pc, 4)
        }

        // ===============================
        // ----- Branch comparisons -----
        // result is the taken (1) / not-taken (0) condition.
        // ===============================

        case OPR_CMP_EQ: {
            printf "BEQ\n"
            if a == b {
                result = 1
            } else {
                result = 0
            }
        }
        case OPR_CMP_NE: {
            printf "BNE\n"
            if a != b {
                result = 1
            } else {
                result = 0
            }
        }
        case OPR_CMP_LT: {
            printf "BLT\n"
            result = signed_LT(a, b) as DoubleWord
        }
        case OPR_CMP_GE: {
            printf "BGE\n"
            if signed_LT(a, b) == 0 {
                result = 1
            } else {
                result = 0
            }
        }
        case OPR_CMP_LTU: {
            printf "BLTU\n"
            if a<b {
                result = 1
            } else {
                result = 0
            }
        }
        case OPR_CMP_GEU: {
            printf "BGEU\n"
            if a >= b {
                result = 1
            } else {
                result = 0
            }
        }

        // ===============================
        // ----- Precompile / no-op -----
        // ===============================

        case OPR_KECCAK: {
            printf "KECCAK precompile\n"
            keccak(a as Address, b as u32, registers[rd] as Address)
            result = 0
        }
        case OPR_NOP: {
            result = 0
        }
        case OPR_INVALID: {
            printf "[ERROR] Unsupported instruction (invalid semantic op)\n"
            fail
        }
        default: {
            printf "[ERROR] Unsupported operation %d\n", operation
            fail
        }
    }
}
