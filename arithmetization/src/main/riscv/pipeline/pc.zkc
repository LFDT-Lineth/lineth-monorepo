include "../memory.zkc"
include "../ram/read.zkc"
include "../utils/constants.zkc"
include "../utils/signed_sum.zkc"

// =========================================================================
// ADVANCE-PC phase of the unified interpreter pipeline.
//
// Computes the next program counter from the pc-update mode:
//   - PK_NEXT:     pc + 4
//   - PK_BRANCH:   cond ? pc + imm : pc + 4   (cond = compute result)
//   - PK_JUMP_REL: address                    (JAL: address = pc + imm)
//   - PK_JUMP_ABS: address & ~1               (JALR: address = rs1 + imm)
//   - PK_SYSCALL:  process_syscall(pc)        (ECALL)
//   - PK_HALT:     EBREAK — abort execution
//
// `address` is the effective address a + b already computed by the caller, and
// doubles as the jump target for JAL (a = pc) and JALR (a = rs1).
// =========================================================================
fn advance_pc<registers, ram>(pc_kind:PcKind, pc:Address, imm:DoubleWord, address:Address, cond:DoubleWord) -> (new_pc:Address) {
    switch pc_kind {
        case PK_NEXT: {
            new_pc = pc + 4
        }
        case PK_BRANCH: {
            if cond == 1 {
                new_pc = signed_sum_of_double_word(pc, imm) as Address
            } else {
                new_pc = pc + 4
            }
        }
        case PK_JUMP_REL: {
            new_pc = address
        }
        case PK_JUMP_ABS: {
            new_pc = address & MASK_64_ERASE_LAST_BIT
        }
        case PK_SYSCALL: {
            new_pc = process_syscall(pc)
        }
        case PK_HALT: {
            printf "[ERROR] EBREAK instruction triggered\n"
            fail
        }
        default: {
            printf "[ERROR] Unsupported pc kind %d\n", pc_kind
            fail
        }
    }
}

// RISC-V system call handler (ECALL). a7 (x17) selects the call; arguments are
// passed in a0.. (x10..). Only the calls exercised by our test programs and the
// ACT4 framework are implemented.
fn process_syscall<registers, ram>(pc:Address) -> (new_pc:Address) {
    var call_num:DoubleWord = registers[17]
    //
    switch call_num {
        case EXIT_SYSCALL: { // exit
            printf "ECALL for exit\n"
            var a0:DoubleWord = registers[10] // exit code
            if a0 == 0 {
                printf "EXIT CODE = 0\n"
            } else {
                fail "EXIT CODE = %d\n", a0
            }
            // set stop signal to terminate execution
            new_pc = MAX_UINT_64
        }
        case WRITE_SYSCALL: {
            // write(fd, buf, count) — Linux RISC-V syscall convention
            // a0 = fd (ignored — we treat every write as going to stdout);
            // a1 = pointer to byte buffer in RAM;
            // a2 = number of bytes to write.
            // ACT4's RVMODEL_IO_WRITE_STR (in rvmodel_macros.h) issues this
            // syscall so the framework's failure messages (failing PC,
            // label, expected vs actual) surface on our printf channel
            // verbatim — each byte is rendered as its ASCII character via
            // the zkc %c format specifier (issue #1759).
            printf "ECALL for write\n"
            var a1:Address = registers[11] as Address // buf
            var a2:DoubleWord = registers[12] // count
            var addr:Address = a1
            for i:DoubleWord = 0; i<a2; i = i + 1 {
                printf "%c", read_8(addr)
                addr = addr + 1
            }
            printf "\n"
            registers[10] = a2 // return value: bytes written
            new_pc = (pc + 4) as Address
        }
        default: {
            fail "unsupported system call (%d)", call_num
        }
    }
}
