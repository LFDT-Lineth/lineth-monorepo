include "../common/type.zkc"

// Include the canonical public inputs for the RISC-V arithmetization.
// The interpreter and the pre-decoding justification pass are compiled
// as two separate programs (riscv/main.zkc and predecoding/main.zkc)
// but consume the same input JSON, so both must agree on this surface
// exactly.
include "../common/inputs.zkc"

// Represents the available Random Access Memory (RAM) for the guest program.
// This will act as the program memory space and will contain, amongst other things,
// the program executable itself and all data coming from loadable sections of the ELF
// (e.g., .data, .rodata).
#[paged]
memory ram[u48](address:Address) -> (word:u32)

// Represents the Register File to use when executing the guest program.  That
// is, the value of all registers at the given moment.
memory registers[u48](id:Register) -> (value:DoubleWord)

// guest program output
pub output guest_output(address:u32) -> (byte:u8)

