include "../common/type.zkc"

// Include the canonical public inputs for the RISC-V arithmetization.
// The interpreter and the pre-decoding justification pass are compiled
// as two separate programs (riscv/main.zkc and predecoding/main.zkc)
// but consume the same input JSON, so both must agree on this surface
// exactly.
include "../common/inputs.zkc"

// Represents the available Random Access Memory (RAM) for the guest program.
// This will act as the program memory space and will contain, amongst other things,
// the program executable itself and all data coming from loadable sections of the ELF
// (e.g., .data, .rodata).
#[paged]
memory ram[u48](address:Address) -> (word:u32)

// Represents the Register File to use when executing the guest program.  That
// is, the value of all registers at the given moment.
memory registers[u48](id:Register) -> (value:DoubleWord)

// guest program output
//
// `output_mode` selects how much of the output `write_output` records:
//   - OUTPUT_MODE_FULL (1): `guest_output` receives every output byte, of any
//     size. Meant for fast execution, where it serves as the output log.
//   - otherwise (0): `guest_output` receives only the first OUTPUT_PREFIX_LEN
//     bytes, so tracing never pays for the rest of the output.
// Both modes write the same prefix, so a mode-0 output is always a prefix of
// the mode-1 output for the same run. The data is u8 (not u1) so that callers
// encode the mode as a plain byte (u1 inputs are bit-packed MSB-first).
pub input output_mode(address:u1) -> (mode:u8)
pub output guest_output(address:OutputAddress) -> (byte:u8)
memory guest_output_tmp[u16](address:u16) -> (byte:u8)
// Number of output bytes written so far. Only touched in OUTPUT_MODE_FULL, so
// it adds no trace rows otherwise; it lives in memory rather than being
// threaded through the interpreter to keep every interpreter step narrow.
memory output_cursor[u48](address:u1) -> (cursor:OutputAddress)
pub output guest_output_hash(address:u3) -> (word:u32)

// keccak related memory: all keccak working vectors live in ONE memory,
// in 8-aligned regions (5 slots used per region): state rows, pi buffer
// rows, theta's C and D, and the 17-lane padded input block at PIB.
memory keccak_state[u32](address:u7) -> (state:lane)
const ROW0:u7 = 0
const ROW1:u7 = 8
const ROW2:u7 = 16
const ROW3:u7 = 24
const ROW4:u7 = 32
const B0:u7 = 40
const B1:u7 = 48
const B2:u7 = 56
const B3:u7 = 64
const B4:u7 = 72
const C:u7 = 80
const D:u7 = 88
const PIB:u7 = 96
