include "utils/type.zkc"

// Represents the available Random Access Memory (RAM) for the guest program.
// This will act as the program memory space and will contain, amongst other things,
// the program executable itself and all data coming from loadable sections of the ELF
// (e.g., .data, .rodata).
memory ram(address:Address) -> (word:u32)

// Represents the Register File to use when executing the guest program.  That
// is, the value of all registers at the given moment.
memory registers(id:Register) -> (value:DoubleWord)

// Entry point of the RISC-V executable binary and number of sparse memory blobs to copy into RAM before execution
pub input entry_point_and_blobs_count(i:u1) -> (entry_point:Address, blobs_count:u64)

// RAM offset where each blob must be written and umber of bytes in each blob
pub input blobs_offset_and_size(i:u64) -> (blob_offset:Address, blob_size:Length)

// Concatenated bytes for all sparse memory blobs, in blob order
pub input blobs_data(i:Address) -> (byte:u8)

// keccak related memory
memory state_row0(address:u3) -> (state:lane)
memory state_row1(address:u3) -> (state:lane)
memory state_row2(address:u3) -> (state:lane)
memory state_row3(address:u3) -> (state:lane)
memory state_row4(address:u3) -> (state:lane)
memory b0(address:u3) -> (state:lane)
memory b1(address:u3) -> (state:lane)
memory b2(address:u3) -> (state:lane)
memory b3(address:u3) -> (state:lane)
memory b4(address:u3) -> (state:lane)
memory c(address:u3) -> (state:lane)
memory d(address:u3) -> (state:lane)
memory padded_input_block(address:u5) -> (state:lane)

// Lowest executable instruction address (4-aligned). Used to convert a pc into
// an index into the pre-decoded instruction tables below: index = (pc - base) >> 2
pub input instruction_base(i:u1) -> (base:Address)

// Pre-decoded instruction stream, indexed by instruction index (one record per
// 4-byte word of the executable region). Replaces the in-interpreter decode of
// `instruction_parameters::opcode = instruction` and `instruction_type_from_opcode`.
pub input decoded_core(i:u64) -> (opcode:Opcode, instruction_type:Type, instruction_parameters:u25)

// Pre-decoded I-type semantic micro-ops, indexed by the same instruction index.
// Replaces runtime opcode/funct3 disambiguation in i_type.zkc with a flat
// compute_op switch. Writeback to rd is folded into *_WB opcode variants.
// The 12-bit immediate (normalized for shifts at ELF time) is sign-extended
// into imm.
pub input decoded_itype(i:u64) -> (compute_op:ITypeComputeOp, imm:DoubleWord, rs1:Register, rd:Register)

// Pre-decoded R-type semantic micro-ops, indexed by the same instruction index.
// Writeback to rd is folded into *_WB opcode variants.
pub input decoded_rtype(i:u64) -> (compute_op:RTypeComputeOp, rs1:Register, rs2:Register, rd:Register)

// Pre-decoded S-type semantic micro-ops, indexed by the same instruction index.
// Store width is encoded directly in compute_op (STYPE_STORE8, …).
// The 12-bit store immediate is reassembled and sign-extended at ELF time into imm.
pub input decoded_stype(i:u64) -> (compute_op:STypeComputeOp, imm:DoubleWord, rs2:Register, rs1:Register)

// Pre-decoded B-type semantic micro-ops, indexed by the same instruction index.
// compute_op holds the raw branch funct3 (BRANCH_BEQ, …). The 13-bit signed
// branch offset is reassembled and sign-extended at ELF time into imm.
pub input decoded_btype(i:u64) -> (compute_op:BTypeComputeOp, imm:DoubleWord, rs2:Register, rs1:Register)

// Pre-decoded J-type semantic micro-ops, indexed by the same instruction index.
// Writeback of the link address is folded into JTYPE_JAL_WB. The 21-bit signed
// jump offset is reassembled and sign-extended at ELF time into imm.
pub input decoded_jtype(i:u64) -> (compute_op:JTypeComputeOp, imm:DoubleWord, rd:Register)

// Pre-decoded U-type semantic micro-ops, indexed by the same instruction index.
// Writeback to rd is folded into *_WB opcode variants. The upper immediate
// (imm20 << 12) is sign-extended to 64 bits at ELF time into imm.
pub input decoded_utype(i:u64) -> (compute_op:UTypeComputeOp, imm:DoubleWord, rd:Register)
