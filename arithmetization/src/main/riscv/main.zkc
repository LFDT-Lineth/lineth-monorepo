// -- Interpreting the riscV proved-transpiled program -- START
// include "../predecoding/predecoding.zkc"
// include "../predecoding/read_instruction.zkc"
// include "../predecoding/executable_region.zkc"
// -- Interpreting the riscV proved-transpiled program -- END

fn main<registers, ram>() {
    var entry_point:Address
    var blobs_count:u32
    entry_point, blobs_count = entry_point_and_blobs_count[0]

    // Base address of the pre-decoded instruction tables (lowest executable
    // instruction address). Used to map pc -> instruction index.
    var base:Address = instruction_base[0]

    // ==========================
    // Transpilation proof
    // ==========================

    // Note: static linear pass over the executable region;
    // This section is pending decision and is commented for now.
    // It can be done once per guest upgrade.
    // To re-enable predecoding :
    // - uncomment all sections labeled from
    // "-- Interpreting the riscV proved-transpiled program -- START"
    //   to
    // -- Interpreting the riscV proved-transpiled program -- END
    // - comment the section labeled from
    // -- Interpreting the riscV unproved-transpiled program -- START
    //   to
    // -- Interpreting the riscV unproved-transpiled program -- END

    // var pc_predecoding:Address = base
    // var exec_end:Address = executable_region_end()
    // while pc_predecoding<exec_end {
    //     var instruction:Instruction = read_instruction_from_blobs(pc_predecoding)
    //     predecoding(pc_predecoding, instruction)
    //     pc_predecoding = (pc_predecoding + 4) as Address
    // }

    // =============================
    // Loading blobs data into RAM
    // =============================

    // Preliminary check to ensure no-overlaps among blobs (note that blobs include the IN_BYTES field)
    for i:u32 = 0; i<(blobs_count-1); i = i + 1 {
        var blob_offset:Address
        var blob_size:Length
        blob_offset, blob_size = blobs_offset_and_size[i]
        var blob_start:Address = blob_offset
        var blob_end:Address = blob_offset + blob_size
        printf "\n# Checking blob_%x[%x,%x]...\n", i, blob_start, blob_end
        for j:u32 = i+1; j<blobs_count; j = j + 1 {
            var other_blob_offset:Address
            var other_blob_size:Length
            other_blob_offset, other_blob_size = blobs_offset_and_size[j]
            var other_blob_start:Address = other_blob_offset
            var other_blob_end:Address = other_blob_offset + other_blob_size
            printf "...against blob_%x[%x,%x]", j, other_blob_start, other_blob_end
            if blob_start < other_blob_end && blob_end > other_blob_start {
                fail
            } else {
                printf " ok\n"
            }
        }
    }

    var internal_offset:Length = 0 // internal offset to blobs_data
    for i:u32 = 0; i<blobs_count; i = i + 1 {
        var blob_offset:Address
        var blob_size:Length
        blob_offset, blob_size = blobs_offset_and_size[i]
        // printf "blobs_offset_and_size[%d] == %x :: %x\n", i, blob_offset, blob_size
        for j:Length = 0; j<blob_size; j = j + 1 {
            // printf "blobs_data[%d + %d] = %x\n", internal_offset, j, blobs_data[internal_offset + j]
            write_8(blob_offset + (j as Address), blobs_data[internal_offset + j])
        }
        internal_offset = internal_offset + blob_size
    }

    // ==========================
    // Execution of the program
    // ==========================

    // -- Interpreting the riscV proved-transpiled program -- START
    // parameters: base, pc, exec_end, output_write_address
    // interpreter!(0, base, entry_point, exec_end, 0)
    // -- Interpreting the riscV proved-transpiled program -- END

    // -- Interpreting the riscV unproved-transpiled program -- START
    // parameters: base, pc, output_write_address
    interpreter!(base, entry_point)
    // -- Interpreting the riscV unproved-transpiled program -- END
}
