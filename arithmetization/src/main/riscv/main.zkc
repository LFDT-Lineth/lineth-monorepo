// TODO @Ghost
fn main<registers, ram, keccak_state, poseidon2_state>() {
    var entry_point:Address
    var blobs_count:u64
    entry_point, blobs_count = entry_point_and_blobs_count[0]

    // Base address of the pre-decoded instruction tables (lowest executable
    // instruction address). Used to map pc -> instruction index.
    var base:Address = instruction_base[0]

    // ==========================
    // Predecoding justification
    // ==========================

    // Note: static linear pass over the executable region;
    // This section is pending decision and is commented for now.
    // It can be done once per guest upgrade.
    // To re-enable predecoding : 
    // - uncomment all sections labeled from "PREDECODING SECTION"
    //   to "PREDECODING SECTION END"
    // - comment the section labeled from "NO PREDECODING"
    //   to "NO PREDECODING END"

    // var pc_predecoding:Address = base
    // var exec_end:Address = executable_region_end()
    // while pc_predecoding<exec_end {
    //     var instruction:Instruction = read_instruction_from_blobs(pc_predecoding)
    //     predecoding(pc_predecoding, instruction)
    //     pc_predecoding = (pc_predecoding + 4) as Address
    // }

    // =============================
    // Loading blobs data into RAM
    // =============================

    var internal_offset:Length = 0 // internal offset to blobs_data
    for i:u64 = 0; i<blobs_count; i = i + 1 {
        var blob_offset:Address
        var blob_size:Length
        blob_offset, blob_size = blobs_offset_and_size[i]
        // printf "blobs_offset_and_size[%d] == %x :: %x\n", i, blob_offset, blob_size
        for j:Address = 0; j<blob_size; j = j + 1 {
            // printf "blobs_data[%d + %d] = %x\n", internal_offset, j, blobs_data[internal_offset + j]
            write_8(blob_offset + j, blobs_data[internal_offset + j])
        }
        internal_offset = internal_offset + blob_size
    }

    // ==========================
    // Execution of the program
    // ==========================

    // -- PREDECODING SECTION -- 
    // main_loop(entry_point, base, exec_end)
    // -- PREDECODING SECTION END-- 

    // -- NO PREDECODING -- 
    interpreter!(0, base, entry_point, 0)
    // -- NO PREDECODING END-- 
}