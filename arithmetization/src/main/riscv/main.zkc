include "interpreter.zkc"
include "ram/read.zkc"
include "ram/write.zkc"
include "utils/sign_extend.zkc"
include "../common/constants.zkc"
include "utils/signed_comparisons.zkc"
include "utils/absolute_value.zkc"
include "utils/bit_flip.zkc"
include "utils/signed_comparisons.zkc"
include "utils/sign_bit.zkc"
include "utils/negative.zkc"
include "utils/register_utils.zkc"
include "memory.zkc"
include "../predecoding/predecoding.zkc"
include "../predecoding/read_instruction.zkc"
include "../predecoding/executable_region.zkc"
include "../lib/poseidon2/ram.zkc"

// TODO @Ghost
fn main<registers, ram, state_row0, state_row1, state_row2, state_row3, state_row4, b0, b1, b2, b3, b4, c, d, padded_input_block, poseidon2_state>() {
    var clock_cycle:u32 = 0
    var entry_point:Address
    var blobs_count:u64
    entry_point, blobs_count = entry_point_and_blobs_count[0]
    var pc:Address = entry_point

    // Base address of the pre-decoded instruction tables (lowest executable
    // instruction address). Used to map pc -> instruction index.
    var base:Address = instruction_base[0]

    // ==========================
    // Predecoding justification
    // ==========================

    // Note: static linear pass over the executable region;
    // Will be done once per guest upgrade.
    var pc_predecoding:Address = base
    var end_predecoding:Address = executable_region_end()
    while pc_predecoding < end_predecoding {
        var instruction:Instruction = read_instruction_from_blobs(pc_predecoding)
        predecoding(pc_predecoding, instruction)
        pc_predecoding = (pc_predecoding + 4) as Address
    }

    // =============================
    // Loading blobs data into RAM
    // =============================

    var internal_offset:Length = 0 // internal offset to blobs_data
    for i:u64 = 0; i<blobs_count; i = i + 1 {
        var blob_offset:Address
        var blob_size:Length
        blob_offset, blob_size = blobs_offset_and_size[i]
        // printf "blobs_offset_and_size[%d] == %x :: %x\n", i, blob_offset, blob_size
        for j:Address = 0; j<blob_size; j = j + 1 {
            // printf "blobs_data[%d + %d] = %x\n", internal_offset, j, blobs_data[internal_offset + j]
            write_8(blob_offset + j, blobs_data[internal_offset + j])
        }
        internal_offset = internal_offset + blob_size
    }

    // ==========================
    // Execution of the program
    // ==========================

    // We interpret pc == MAX_UINT_64 as the stop signal, which is set by the ecall instruction
    while pc != MAX_UINT_64 {
        var index:u64 = (pc - base) >> 2

        // clock cycle starts at 1
        clock_cycle = clock_cycle + 1
        printf "\n----------------------------------------------------------------- PC=%d, clock cycle: %d\n", pc, clock_cycle

        pc = interpreter(index, pc)
    }
}

