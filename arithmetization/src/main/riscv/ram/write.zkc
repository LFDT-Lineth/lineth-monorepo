include "../memory.zkc"
include "../utils/bswap.zkc"
include "../utils/constants.zkc"

fn write_8<ram>(address:Address, value:u8) -> () {
    var boffset:u2
    var woffset:u62
    var tmp0:u8, tmp1:u8, tmp2:u8, tmp3:u8
    var word:u32
    //
    woffset::boffset = address
    // Read four bytes
    tmp3::tmp2::tmp1::tmp0 = ram[woffset as u64]
    //
    switch boffset {
        case 0: {
            word = tmp3::tmp2::tmp1::value
        }
        case 1: {
            word = tmp3::tmp2::value::tmp0
        }
        case 2: {
            word = tmp3::value::tmp1::tmp0
        }
        default: {
            word = value::tmp2::tmp1::tmp0
        }
    }
    //
    ram[woffset as u64] = word
}

fn write_16<ram>(address:Address, value:u16) -> () {
    var boffset:u2
    var woffset:u62
    var hi:u16, lo:u16
    //
    woffset::boffset = address
    //
    switch boffset {
        case 0: {
            hi::lo = ram[woffset as u64]
            ram[woffset as u64] = hi::value
        }
        case 2: {
            hi::lo = ram[woffset as u64]
            ram[woffset as u64] = value::lo
        }
        default: {
            // Case 1, 3 and default case are collapse to reduce the number of instructions. 
            // Default case cannot happen as offset is the result of % 4.
            var b0:u8
            var b1:u8
            b1::b0 = value
            write_8(address, b0)
            write_8(address + 1, b1)
        }
    }
}

fn write_32<ram>(address:Address, value:u32) -> () {
    var boffset:u2
    var woffset:u62
    //
    woffset::boffset = address
    // check for aligned write
    if boffset == 0 {
        ram[woffset as u64] = value
        return
    }
    // unaligned case
    var lo:u16, hi:u16
    // decompose value
    hi::lo = value
    // write limbs
    write_16(address, lo)
    write_16(address + 2, hi)
}

fn write_64<ram>(address:Address, value:u64) -> () {
    var boffset:u2
    var woffset:u62
    var lo:u32, hi:u32
    // decompose value
    hi::lo = value
    // decompose address
    woffset::boffset = address
    // check for aligned write
    if boffset == 0 {
        ram[woffset as u64] = lo
        ram[(woffset + 1) as u64] = hi
        return
    }
    // unaligned case
    write_32(address, lo)
    write_32(address + 4, hi)
}

fn write_u16_be<ram>(address:Address, value:u16) {
    var hi:u8, lo:u8
    hi::lo = value
    write_8(address, hi)
    write_8(address + 1, lo)
}

fn write_u32_be<ram>(address:Address, value:u32) {
    var hi:u16, lo:u16
    hi::lo = value
    write_u16_be(address, hi)
    write_u16_be(address + 2, lo)
}

fn write_u64_be<ram>(address:Address, value:u64) {
    var hi:u32, lo:u32
    hi::lo = value
    write_u32_be(address, hi)
    write_u32_be(address + 4, lo)
}

fn write_u128_be<ram>(address:Address, value:u128) {
    var hi:u64, lo:u64
    hi::lo = value
    write_u64_be(address, hi)
    write_u64_be(address + 8, lo)
}

// Write a 32-byte big-endian integer to memory (MSB at `address`).
fn write_u256_be<ram>(address:Address, value:u256) {
    var hi:u128, lo:u128
    hi::lo = value
    write_u128_be(address, hi)
    write_u128_be(address + 16, lo)
}

// Write a 48-byte big-endian integer to memory (MSB at `address`), the
// BLS12-381 Fp serialisation width. Word-at-a-time for the same reason as
// read_u384_be -- see the note there on why the doubling ladder is not used and
// why callers should keep Fp buffers 4-byte aligned.
fn write_u384_be<ram>(address:Address, value:u384) {
    var w0:Word, w1:Word, w2:Word, w3:Word, w4:Word, w5:Word
    var w6:Word, w7:Word, w8:Word, w9:Word, w10:Word, w11:Word
    w0::w1::w2::w3::w4::w5::w6::w7::w8::w9::w10::w11 = value
    write_32(address, bswap_32(w0))
    write_32(address + 4, bswap_32(w1))
    write_32(address + 8, bswap_32(w2))
    write_32(address + 12, bswap_32(w3))
    write_32(address + 16, bswap_32(w4))
    write_32(address + 20, bswap_32(w5))
    write_32(address + 24, bswap_32(w6))
    write_32(address + 28, bswap_32(w7))
    write_32(address + 32, bswap_32(w8))
    write_32(address + 36, bswap_32(w9))
    write_32(address + 40, bswap_32(w10))
    write_32(address + 44, bswap_32(w11))
}
