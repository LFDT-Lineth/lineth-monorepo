#[native]
fn mulmod_256(lhsL:u256, rhsL:u256, modL:u256) -> (remainder:u256) {
    if modL == 0 {
        fail
    }
    // integer product result `product = lhsL * rhsL`
    var product:u512 = (lhsL as u512) * (rhsL as u512)

    var overflow:u256
    var quotient:u256
    var overflow2:u256
    overflow::quotient, overflow2::remainder = product /% (modL as u512)
    if overflow != 0 {
        fail
    }
    // XXX(ivo): two ways of computing the remainder. First one is approx 20% faster
    // overflow2::remainder = product - ((quotient as u512) * (modL as u512))
    //overflow2::remainder = product % (modL as u512)
    // OPTIMIZATION (blocked): under zkc >= v1.2.27 the combined `/%` operator
    //   var q:u512, rem:u512;  q, rem = product /% (modL as u512);  overflow::remainder = rem
    // uses ~25% fewer cells and drops the degree-5 constraints (measured). It
    // requires bumping zkc to v1.2.27, which currently breaks the prover-ray
    // zkcdriver Go API (lookup.Vector.Terms, register.Id, air.Assertion,
    // air.ColumnAccess). Apply once prover-ray is migrated to the v1.2.27 API.
    if overflow2 != 0 {
        fail
    }
}

// Returns the canonical representative of `val` in [0, modL), i.e. val mod modL.
// Callers that branch on raw (unreduced) equality/inequality of field elements
// must reduce their inputs through this first, otherwise non-canonical encodings
// (e.g. val = x + modL) alias the same residue while comparing as distinct u256
// values. Implemented as multiplication by 1 modulo modL.
fn reduce_256(val:u256, modL:u256) -> (remainder:u256) {
    remainder = mulmod_256(1, val, modL)
    if remainder >= modL {
        fail
    }
}

// addmod_256 adds two values and reduces modulo modL. Assumes inputs are already
// reduced
fn addmod_256(lhsL:u256, rhsL:u256, modL:u256) -> (remainder:u256) {
    if modL == 0 {
        fail
    }
    var sum:u257 = (lhsL as u257) + (rhsL as u257)
    if sum >= (modL as u257) {
        sum = sum - (modL as u257)
    }
    var overflow:u1
    overflow::remainder = sum
    if overflow != 0 {
        fail
    }
}

// submod_256 computes subtraction and mod reduces. It assumes inputs are already reduced
fn submod_256(lhsL:u256, rhsL:u256, modL:u256) -> (remainder:u256) {
    if modL == 0 {
        fail
    }
    var lhs:u257
    if rhsL>lhsL {
        lhs = (lhsL as u257) + (modL as u257)
    } else {
        lhs = (lhsL as u257)
    }
    var overflow:u1
    overflow::remainder = lhs - (rhsL as u257)
    if overflow != 0 {
        fail
    }
}

// Multiply `x` by a SMALL constant `k` modulo `modL`, via double-and-add over the
// bits of `k`. Every step is a cheap addmod (a 257-bit add + one conditional
// subtract), so this replaces a general mulmod_256 — a 512-bit product + divmod,
// by far the widest module in the trace — whenever the multiplier is a small
// constant. Used for the RCB complete-addition term b3 = 3*b (b3 = 9 for BN254,
// 21 for secp256k1). The loop runs (bit-length of k) times, so it is cheapest for
// small k. Assumes `x` is already reduced (x < modL); `k` may be any width.
fn mul_small_mod(x:u256, k:u256, modL:u256) -> (res:u256) {
    res = 0
    var acc:u256 = x // acc = (2^i)*x mod modL on iteration i
    var bits:u256 = k
    while bits != 0 {
        var rest:u255, bit:u1
        rest::bit = bits
        if bit == 1 {
            res = addmod_256(res, acc, modL)
        }
        acc = addmod_256(acc, acc, modL)
        bits = rest as u256
    }
}

#[native]
fn expmod_unconstrained_256(base:u256, exp:u256, mod:u256) -> (res:u256) {
    if exp == 0 {
        res = 1 % mod
    } else {
        var half:u256
        var bit:u1
        half::bit = exp as u257
        var half_res:u256 = expmod_unconstrained_256(base, half, mod)
        var sq:u256 = mulmod_256(half_res, half_res, mod)
        if bit == 1 {
            res = mulmod_256(sq, base, mod)
        } else {
            res = sq
        }
    }
}

fn invmod_256(inp:u256, modL:u256) -> (inv:u256) {
    // we first hint the inversion
    inv = expmod_unconstrained_256(inp, modL - 2, modL)
    // compute the product using the native product
    var prod:u256 = mulmod_256(inv, inp, modL)
    // now we check that the hinted inversion result is correct
    if prod != 1 {
        fail
    }
}
