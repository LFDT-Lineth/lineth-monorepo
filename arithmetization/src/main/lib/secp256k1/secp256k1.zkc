include "../nonnative/u256.zkc"
include "../nonnative/sw_add_mul_formulas.zkc"

// ----- curve parameters ------

// secp256k1 modulus (base field). NOTE: this is the field prime p, NOT the
// group order n. Scalars are reduced mod n, never mod p.
const p:u256 = 0xfffffffffffffffffffffffffffffffffffffffffffffffffffffffefffffc2f

// secp256k1 group order n (number of points in the prime-order subgroup).
// Scalars must lie in [0, n); secp_scalar_mul rejects k >= n.
const n:u256 = 0xfffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364141

const b:u256 = 7
// b3 = 3*b, the complete-addition constant for the shared short-Weierstrass law.
const b3:u256 = 21

// Base point (generator) G of the prime-order subgroup.
const Gx:u256 = 0x79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798
const Gy:u256 = 0x483ada7726a3c4655da4fbfc0e1108a8fd17b448a68554199c47d08ffb10d4b8

// Square-root exponent: since p = 3 (mod 4), sqrt(a) = a^((p+1)/4) mod p.
const p_plus_1_over_4:u256 = 0x3fffffffffffffffffffffffffffffffffffffffffffffffffffffffbfffff0c

// Returns the curve generator G = (Gx, Gy).
fn generator_secp256k1() -> (x:u256, y:u256) {
    x = Gx
    y = Gy
}

// ----- assertion methods ------

// fails if (x, y) is not a finite point on y^2 = x^3 + 7 over Fp,
// expects canonical inputs (x, y < p); callers reduce via reduce_256.
fn assert_on_curve_affine_secp256k1(x:u256, y:u256) {
    // let's handle the special case of (0,0)
    if is_infinity_affine_secp256k1(x, y) == 1 {
        return
    }
    var y2:u256 = mulmod_256(y, y, p)
    var x2:u256 = mulmod_256(x, x, p)
    var x3:u256 = mulmod_256(x2, x, p)
    var rhs:u256 = addmod_256(x3, b, p)
    if rhs != y2 {
        fail
    }
}

fn is_infinity_affine_secp256k1(x:u256, y:u256) -> (res:u1) {
    res = 0
    if (x == 0) && (y == 0) {
        res = 1
    }
}

fn is_equal_affine_secp256k1(Px:u256, Py:u256, Qx:u256, Qy:u256) -> (res:u1) {
    res = 0
    if (Px == Qx) && (Py == Qy) {
        res = 1
    }
}

// ------ conversion methods -------

fn affine_to_projective_secp256k1(x:u256, y:u256) -> (X:u256, Y:u256, Z:u256) {
    if is_infinity_affine_secp256k1(x, y) == 1 {
        X = 0
        Y = 1
        Z = 0
    } else {
        X = x
        Y = y
        Z = 1
    }
}

fn projective_to_affine_secp256k1(X:u256, Y:u256, Z:u256) -> (x:u256, y:u256) {
    if Z == 0 {
        x = 0
        y = 0
    } else {
        var z_inv:u256 = invmod_256(Z, p)
        x = mulmod_256(X, z_inv, p)
        y = mulmod_256(Y, z_inv, p)
    }
}

// ------ square root / quadratic residue ------

// Modular square root over Fp for secp256k1 (p = 3 mod 4).
//
// Returns (y, is_qr):
//   is_qr = 1  => a is a quadratic residue and y*y = a mod p (y is a root)
//   is_qr = 0  => a is a non-residue; y*y = -a mod p (a witness that a has no root)
// Assumption: a is already reduced mod p. 
// The candidate `y = a^((p+1)/4) mod p` is a hint (unconstrained), verified here:
//   y^2 = a^((p+1)/2) = a * a^((p-1)/2) = a * legendre(a)
// so y^2 = a when a is a QR, and y^2 = -a when a is a QNR (since -1 is a QNR).
// Constraining BOTH branches makes the result deterministic: a QR cannot be
// passed off as a QNR (no root of -a exists) and vice versa.
// Note: a = 0 cannot occur for a = x^3 + 7, as secp256k1 has no 2-torsion.
fn sqrt_secp256k1(a:u256) -> (y:u256, is_qr:u1) {
    // hint: candidate root (or root of -a) via Fermat-style exponentiation
    y = expmod_unconstrained_256(a, p_plus_1_over_4, p)
    // canonicalize hinted value so bit decomposition / comparisons are sound
    y = reduce_256(y, p)
    var y2:u256 = mulmod_256(y, y, p)
    if y2 == a {
        is_qr = 1
    } else {
        is_qr = 0
        // soundness: a is a genuine non-residue iff -a is a residue; y must root it
        var neg_a:u256 = submod_256(0, a, p)
        if y2 != neg_a {
            fail
        }
    }
}

// ------ projective ------

// Complete projective addition for secp256k1 (a=0, b3=21). Thin wrapper over the
// shared short-Weierstrass law in nonnative/sw_add_mul_formulas.zkc.
fn add_projective_secp256k1(X1:u256, Y1:u256, Z1:u256, X2:u256, Y2:u256, Z2:u256) -> (X3:u256, Y3:u256, Z3:u256) {
    X3, Y3, Z3 = sw_add_projective(X1, Y1, Z1, X2, Y2, Z2, p, b3)
}

// Dedicated projective doubling for secp256k1 (a=0). Thin wrapper over the shared
// short-Weierstrass doubling in nonnative/sw_add_mul_formulas.zkc.
// Precondition: P != O (Z1 != 0, Y1 != 0 — guaranteed for valid secp256k1 subgroup points).
fn double_projective_secp256k1(X1:u256, Y1:u256, Z1:u256) -> (X3:u256, Y3:u256, Z3:u256) {
    X3, Y3, Z3 = sw_double_projective(X1, Y1, Z1, p)
}

// Scalar multiplication over projective coords (double-and-add). Thin wrapper
// over the shared short-Weierstrass ladder in nonnative/sw_add_mul_formulas.zkc.
fn scalar_mul_projective_secp256k1(k:u256, PX:u256, PY:u256, PZ:u256) -> (QX:u256, QY:u256, QZ:u256) {
    QX, QY, QZ = sw_scalar_mul_projective(k, PX, PY, PZ, p, b3)
}

// ------ affine -------
fn scalar_mul_affine_secp256k1(k:u256, Px:u256, Py:u256) -> (Qx:u256, Qy:u256) {
    if k >= n {
        fail
    }
    Qx = 0
    Qy = 0
    if k == 0 {
        return
    }

    var PX:u256, PY:u256, PZ:u256
    PX, PY, PZ = affine_to_projective_secp256k1(Px, Py)

    var QX:u256, QY:u256, QZ:u256
    QX, QY, QZ = scalar_mul_projective_secp256k1(k, PX, PY, PZ)

    Qx, Qy = projective_to_affine_secp256k1(QX, QY, QZ)
}
