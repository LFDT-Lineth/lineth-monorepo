// Poseidon2 permutation parameters (gnark-crypto KoalaBear Poseidon2):
//   width t          = 16
//   S-box degree α   = 3
//   full rounds  R_F = 6  (= 3 + 3, applied as FULL_ROUNDS_HALF on each side)
//   partial rnds R_P = 21
const STATE_WIDTH:u8 = 16

// Poseidon2 does
//   - FULL_ROUNDS_HALF full    rounds
//   - PRTL_ROUNDS      partial rounds
//   - FULL_ROUNDS_HALF full    rounds
// whence
const FULL_ROUNDS_HALF:u8 = 3 // 6 = 3 + 3 full rounds
const PRTL_ROUNDS:u8 = 21
const TOTAL_ROUNDS:u8 = FULL_ROUNDS_HALF + PRTL_ROUNDS + FULL_ROUNDS_HALF

// The external (full-round) linear layer operates on 4-felt chunks of the
// state via the fixed M4 matrix, followed by a cross-chunk sum.
const M4_CHUNKS:u8 = 4 // STATE_WIDTH / 4

// =====================================================================
// Poseidon2 round keys
// =====================================================================
//
// 27 rows ≡ 27 rounds
//          ≡ 3        + 21        + 3
//          ≡ 3 (full) + 21 (prtl) + 3 (full)
//
// R_{a,b} = Rij with ij = STATE_WIDTH × a + b.
//
// Note. Poseidon2 only adds a single round key to lane 0 during the partial
// rounds; the remaining 15 entries of each partial-round row are therefore
// zero and never read (see add_round_key_partial in poseidon2.zkc).
static round_keys(ij:u16) -> (Rij:𝔽) {
    0x747e80c9, 0x7d5ff3d1, 0x79440df5, 0x000413c5, 0x41d0a44f, 0x0a1c440d, 0x4d06e84c, 0x5c15b822, 0x4734c87b, 0x4d3a8a8e, 0x078f1df5, 0x1a1cd0b8, 0x79bffc5d, 0x60b1b050, 0x583a8f51, 0x7a64f2cc,
