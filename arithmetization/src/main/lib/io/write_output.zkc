// new_output_write_address = write_output(v1 as Address, v2 as OutputSize, output_write_address)

fn www<ram>(offset:Address, size:OutputSize, output_write_address:OutputAddress) -> (new_output_write_address:OutputAddress) {
  new_output_write_address = output_write_address + size

    for i:OutputAddress = 0; i < size; i = i + 1 {
      guest_output[output_write_address + i] = read_8(offset + (i as Address))
    }
}
