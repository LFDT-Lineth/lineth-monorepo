include "../../riscv/memory.zkc"
include "../../riscv/ram/read.zkc"

// Number of guest output bytes traced into `guest_output`.
const OUTPUT_COMMITMENT_LEN:OutputAddress = 32

// Copy the first OUTPUT_COMMITMENT_LEN bytes of guest RAM starting at byte address `offset`
// into the public `guest_output` buffer at `output_write_address`, returning the advanced cursor.
// The rest of the output is not traced: the host reads it instead (see gopkg/guestoutput).
fn write_output<ram, guest_output_tmp>(offset:Address, output_write_address:OutputAddress) -> (new_output_write_address:OutputAddress) {
    new_output_write_address = output_write_address + OUTPUT_COMMITMENT_LEN

    for i:OutputAddress = 0; i<OUTPUT_COMMITMENT_LEN; i = i + 1 {
        var byte_read:u8 = read_8(offset + (i as Address))
        guest_output[output_write_address + i] = byte_read
        guest_output_tmp[output_write_address + i] = byte_read
    }
}
