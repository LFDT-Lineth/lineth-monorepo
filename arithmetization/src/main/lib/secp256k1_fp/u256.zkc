// Register names are an interface: prover-ray proves `mulmod_256` with its
// NonNative gadget and looks the columns up by these names.
#[native]
fn mulmod_256(lhsL:u256, rhsL:u256, modL:u256) -> (remainder:u256) {
    if modL == 0 {
        fail
    }
    // integer product result `product = lhsL * rhsL`
    var product:u512 = (lhsL as u512) * (rhsL as u512)

    var overflow:u256
    var quotient:u256
    overflow::quotient = product / (modL as u512)
    if overflow != 0 {
        fail
    }
    var overflow2:u256
    overflow2::remainder = product - ((quotient as u512) * (modL as u512))
    if overflow2 != 0 {
        fail
    }
}
