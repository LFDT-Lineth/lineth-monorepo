include "common.zkc"
include "hint.zkc"

// p - 2
const SECP256K1_P_MINUS_2:u256 = 0xfffffffffffffffffffffffffffffffffffffffffffffffffffffffefffffc2d

// custom-1, funct3 0b011, funct7 2. out = a^-1 mod p, and 0 when a = 0 (mod p).
// The inverse is hinted (a^(p-2)) and checked with one constrained product.
fn secp256k1_fp_inv<ram>(a_addr:Address, out_addr:Address) {
    var a:u256 = secp256k1_fp_canonical(secp256k1_fp_read(a_addr))
    if a == 0 {
        secp256k1_fp_write(out_addr, 0)
    } else {
        var inv:u256 = expmod_unconstrained_256(a, SECP256K1_P_MINUS_2, SECP256K1_P)
        var prod:u256 = mulmod_256(inv, a, SECP256K1_P)
        if prod != 1 {
            fail "secp256k1 fp inv: bad hint"
        }
        secp256k1_fp_write(out_addr, inv)
    }
}
