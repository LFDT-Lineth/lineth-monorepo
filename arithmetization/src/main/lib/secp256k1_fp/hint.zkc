// Unconstrained hint (prover-ray leaves `expmod_unconstrained_256` unconstrained, so it is a real
// hint). Whatever it returns is always checked by a constrained `mulmod_256`. Register names are an
// interface, as for `mulmod_256`.
#[native]
fn expmod_unconstrained_256(base:u256, exp:u256, mod:u256) -> (res:u256) {
    if exp == 0 {
        res = 1 % mod
    } else {
        var half:u256
        var bit:u1
        half::bit = exp as u257
        var half_res:u256 = expmod_unconstrained_256(base, half, mod)
        var sq:u256 = mulmod_256(half_res, half_res, mod)
        if bit == 1 {
            res = mulmod_256(sq, base, mod)
        } else {
            res = sq
        }
    }
}
