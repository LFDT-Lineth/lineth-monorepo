include "fp2.zkc"

// ============================================================================
// Fp6 and Fp12, the upper two levels of the BLS12-381 tower.
//
//     Fp6  = Fp2[v]/(v^3 - xi),  xi = 1 + u        element (c0, c1, c2)
//     Fp12 = Fp6[w]/(w^2 - v)                      element (c0, c1)
//
// WHY THESE LIVE IN MEMORY? zkc caps a call at 255 split registers; a u384 is
// 24 limbs at KOALABEAR_16, so a function takes at most TEN u384 arguments.
// Eleven panics with "too many call arguments". An Fp6 multiply passed by value
// would need 12 arguments and an Fp12 multiply 24, so both are impossible as
// value functions. Everything from Fp6 up therefore addresses a scratch memory
// and passes cell indices, while Fp2 and below stay in registers where they are
// far cheaper.
//
// LAYOUT. One Fp element per cell. An Fp6 at address A occupies 6 cells:
//     A+0,A+1  = c0 (an Fp2: real, imaginary)
//     A+2,A+3  = c1
//     A+4,A+5  = c2
// An Fp12 at address A occupies 12 cells: its c0 (an Fp6) at A, its c1 at A+6.
//
// ALIASING. The fp6_* primitives load every operand into registers before
// storing anything, so their destination MAY alias their sources. The fp12_*
// routines go through fixed scratch blocks and therefore require their
// destination to be DISJOINT from their sources -- see the note on each.
// ============================================================================

// 512 cells = 42 Fp12 values. Addresses below FP12_SCRATCH are the caller's.
memory bls_fp12_mem[u32](address:u9) -> (limb:u384)

// Scratch blocks, one region per routine so that a routine calling another
// cannot clobber it. fp6_* never touches scratch, so only the fp12_* routines
// need disjoint regions.
const FP12_SCRATCH:u9 = 256
const MUL_T0:u9 = 256
const MUL_T1:u9 = 262
const MUL_T2:u9 = 268
const MUL_T3:u9 = 274
const SQR_T0:u9 = 280
const SQR_T1:u9 = 286
const SQR_T2:u9 = 292
const LIN_T0:u9 = 298
const LIN_T1:u9 = 304
const LIN_T2:u9 = 310

// ----- Fp2 cell accessors -----

#[inline]
fn fp2_load_bls12_381<bls_fp12_mem>(a:u9) -> (c0:u384, c1:u384) {
    c0 = bls_fp12_mem[a]
    c1 = bls_fp12_mem[a + 1]
}

#[inline]
fn fp2_store_bls12_381<bls_fp12_mem>(a:u9, c0:u384, c1:u384) {
    bls_fp12_mem[a] = c0
    bls_fp12_mem[a + 1] = c1
}

// ----- Fp6 -----

fn fp6_copy_bls12_381<bls_fp12_mem>(a:u9, o:u9) {
    var t0:u384, t1:u384
    t0, t1 = fp2_load_bls12_381(a)
    var t2:u384, t3:u384
    t2, t3 = fp2_load_bls12_381(a + 2)
    var t4:u384, t5:u384
    t4, t5 = fp2_load_bls12_381(a + 4)
    fp2_store_bls12_381(o, t0, t1)
    fp2_store_bls12_381(o + 2, t2, t3)
    fp2_store_bls12_381(o + 4, t4, t5)
}

fn fp6_set_zero_bls12_381<bls_fp12_mem>(o:u9) {
    fp2_store_bls12_381(o, 0, 0)
    fp2_store_bls12_381(o + 2, 0, 0)
    fp2_store_bls12_381(o + 4, 0, 0)
}

fn fp6_add_bls12_381<bls_fp12_mem>(a:u9, b:u9, o:u9) {
    var a00:u384, a01:u384, a10:u384, a11:u384, a20:u384, a21:u384
    a00, a01 = fp2_load_bls12_381(a)
    a10, a11 = fp2_load_bls12_381(a + 2)
    a20, a21 = fp2_load_bls12_381(a + 4)
    var b00:u384, b01:u384, b10:u384, b11:u384, b20:u384, b21:u384
    b00, b01 = fp2_load_bls12_381(b)
    b10, b11 = fp2_load_bls12_381(b + 2)
    b20, b21 = fp2_load_bls12_381(b + 4)

    var c0:u384, c1:u384
    c0, c1 = fp2_add_bls12_381(a00, a01, b00, b01)
    fp2_store_bls12_381(o, c0, c1)
    c0, c1 = fp2_add_bls12_381(a10, a11, b10, b11)
    fp2_store_bls12_381(o + 2, c0, c1)
    c0, c1 = fp2_add_bls12_381(a20, a21, b20, b21)
    fp2_store_bls12_381(o + 4, c0, c1)
}

fn fp6_sub_bls12_381<bls_fp12_mem>(a:u9, b:u9, o:u9) {
    var a00:u384, a01:u384, a10:u384, a11:u384, a20:u384, a21:u384
    a00, a01 = fp2_load_bls12_381(a)
    a10, a11 = fp2_load_bls12_381(a + 2)
    a20, a21 = fp2_load_bls12_381(a + 4)
    var b00:u384, b01:u384, b10:u384, b11:u384, b20:u384, b21:u384
    b00, b01 = fp2_load_bls12_381(b)
    b10, b11 = fp2_load_bls12_381(b + 2)
    b20, b21 = fp2_load_bls12_381(b + 4)

    var c0:u384, c1:u384
    c0, c1 = fp2_sub_bls12_381(a00, a01, b00, b01)
    fp2_store_bls12_381(o, c0, c1)
    c0, c1 = fp2_sub_bls12_381(a10, a11, b10, b11)
    fp2_store_bls12_381(o + 2, c0, c1)
    c0, c1 = fp2_sub_bls12_381(a20, a21, b20, b21)
    fp2_store_bls12_381(o + 4, c0, c1)
}

fn fp6_neg_bls12_381<bls_fp12_mem>(a:u9, o:u9) {
    var a00:u384, a01:u384, a10:u384, a11:u384, a20:u384, a21:u384
    a00, a01 = fp2_load_bls12_381(a)
    a10, a11 = fp2_load_bls12_381(a + 2)
    a20, a21 = fp2_load_bls12_381(a + 4)

    var c0:u384, c1:u384
    c0, c1 = fp2_neg_bls12_381(a00, a01)
    fp2_store_bls12_381(o, c0, c1)
    c0, c1 = fp2_neg_bls12_381(a10, a11)
    fp2_store_bls12_381(o + 2, c0, c1)
    c0, c1 = fp2_neg_bls12_381(a20, a21)
    fp2_store_bls12_381(o + 4, c0, c1)
}

// Multiplication by v: (c0, c1, c2)*v = xi*c2 + c0*v + c1*v^2, since v^3 = xi.
fn fp6_mul_by_v_bls12_381<bls_fp12_mem>(a:u9, o:u9) {
    var a00:u384, a01:u384, a10:u384, a11:u384, a20:u384, a21:u384
    a00, a01 = fp2_load_bls12_381(a)
    a10, a11 = fp2_load_bls12_381(a + 2)
    a20, a21 = fp2_load_bls12_381(a + 4)

    var c0:u384, c1:u384
    c0, c1 = fp2_mul_by_nonresidue_bls12_381(a20, a21)
    fp2_store_bls12_381(o, c0, c1)
    fp2_store_bls12_381(o + 2, a00, a01)
    fp2_store_bls12_381(o + 4, a10, a11)
}

// Karatsuba multiplication over the cubic extension: 6 Fp2 multiplications.
//   c0 = a0b0 + xi*((a1+a2)(b1+b2) - a1b1 - a2b2)
//   c1 = (a0+a1)(b0+b1) - a0b0 - a1b1 + xi*a2b2
//   c2 = (a0+a2)(b0+b2) - a0b0 - a2b2 + a1b1
// Destination may alias either source: everything is loaded up front.
fn fp6_mul_bls12_381<bls_fp12_mem>(a:u9, b:u9, o:u9) {
    var a00:u384, a01:u384, a10:u384, a11:u384, a20:u384, a21:u384
    a00, a01 = fp2_load_bls12_381(a)
    a10, a11 = fp2_load_bls12_381(a + 2)
    a20, a21 = fp2_load_bls12_381(a + 4)
    var b00:u384, b01:u384, b10:u384, b11:u384, b20:u384, b21:u384
    b00, b01 = fp2_load_bls12_381(b)
    b10, b11 = fp2_load_bls12_381(b + 2)
    b20, b21 = fp2_load_bls12_381(b + 4)

    var v00:u384, v01:u384, v10:u384, v11:u384, v20:u384, v21:u384
    v00, v01 = fp2_mul_bls12_381(a00, a01, b00, b01)
    v10, v11 = fp2_mul_bls12_381(a10, a11, b10, b11)
    v20, v21 = fp2_mul_bls12_381(a20, a21, b20, b21)

    var s0:u384, s1:u384, t0:u384, t1:u384, m0:u384, m1:u384

    // c0 = v0 + xi*((a1+a2)(b1+b2) - v1 - v2)
    s0, s1 = fp2_add_bls12_381(a10, a11, a20, a21)
    t0, t1 = fp2_add_bls12_381(b10, b11, b20, b21)
    m0, m1 = fp2_mul_bls12_381(s0, s1, t0, t1)
    m0, m1 = fp2_sub_bls12_381(m0, m1, v10, v11)
    m0, m1 = fp2_sub_bls12_381(m0, m1, v20, v21)
    m0, m1 = fp2_mul_by_nonresidue_bls12_381(m0, m1)
    var c00:u384, c01:u384
    c00, c01 = fp2_add_bls12_381(v00, v01, m0, m1)

    // c1 = (a0+a1)(b0+b1) - v0 - v1 + xi*v2
    s0, s1 = fp2_add_bls12_381(a00, a01, a10, a11)
    t0, t1 = fp2_add_bls12_381(b00, b01, b10, b11)
    m0, m1 = fp2_mul_bls12_381(s0, s1, t0, t1)
    m0, m1 = fp2_sub_bls12_381(m0, m1, v00, v01)
    m0, m1 = fp2_sub_bls12_381(m0, m1, v10, v11)
    var n0:u384, n1:u384
    n0, n1 = fp2_mul_by_nonresidue_bls12_381(v20, v21)
    var c10:u384, c11:u384
    c10, c11 = fp2_add_bls12_381(m0, m1, n0, n1)

    // c2 = (a0+a2)(b0+b2) - v0 - v2 + v1
    s0, s1 = fp2_add_bls12_381(a00, a01, a20, a21)
    t0, t1 = fp2_add_bls12_381(b00, b01, b20, b21)
    m0, m1 = fp2_mul_bls12_381(s0, s1, t0, t1)
    m0, m1 = fp2_sub_bls12_381(m0, m1, v00, v01)
    m0, m1 = fp2_sub_bls12_381(m0, m1, v20, v21)
    var c20:u384, c21:u384
    c20, c21 = fp2_add_bls12_381(m0, m1, v10, v11)

    fp2_store_bls12_381(o, c00, c01)
    fp2_store_bls12_381(o + 2, c10, c11)
    fp2_store_bls12_381(o + 4, c20, c21)
}

// ----- Fp12 -----

fn fp12_set_one_bls12_381<bls_fp12_mem>(o:u9) {
    fp2_store_bls12_381(o, 1, 0)
    fp2_store_bls12_381(o + 2, 0, 0)
    fp2_store_bls12_381(o + 4, 0, 0)
    fp6_set_zero_bls12_381(o + 6)
}

fn fp12_copy_bls12_381<bls_fp12_mem>(a:u9, o:u9) {
    fp6_copy_bls12_381(a, o)
    fp6_copy_bls12_381(a + 6, o + 6)
}

// Conjugation over Fp6, i.e. the p^6-power Frobenius: (c0, c1) -> (c0, -c1).
fn fp12_conj_bls12_381<bls_fp12_mem>(a:u9, o:u9) {
    fp6_copy_bls12_381(a, o)
    fp6_neg_bls12_381(a + 6, o + 6)
}

// Karatsuba over the quadratic extension (w^2 = v): 3 Fp6 multiplications.
//   c0 = a0b0 + v*(a1b1)
//   c1 = (a0+a1)(b0+b1) - a0b0 - a1b1
// DESTINATION MUST BE DISJOINT from both sources.
fn fp12_mul_bls12_381<bls_fp12_mem>(a:u9, b:u9, o:u9) {
    fp6_mul_bls12_381(a, b, MUL_T0)                    // v0 = a0*b0
    fp6_mul_bls12_381(a + 6, b + 6, MUL_T1)            // v1 = a1*b1

    fp6_add_bls12_381(a, a + 6, MUL_T2)                // a0+a1
    fp6_add_bls12_381(b, b + 6, MUL_T3)                // b0+b1
    fp6_mul_bls12_381(MUL_T2, MUL_T3, MUL_T2)          // (a0+a1)(b0+b1)

    fp6_sub_bls12_381(MUL_T2, MUL_T0, MUL_T2)
    fp6_sub_bls12_381(MUL_T2, MUL_T1, o + 6)           // c1

    fp6_mul_by_v_bls12_381(MUL_T1, MUL_T3)             // v*v1
    fp6_add_bls12_381(MUL_T0, MUL_T3, o)               // c0
}

// Squaring, as the Karatsuba multiply specialised to a == b: 2 Fp6
// multiplications instead of 3.
//   t  = a0*a1
//   c1 = 2t
//   c0 = (a0+a1)(a0 + v*a1) - t - v*t
// DESTINATION MUST BE DISJOINT from the source.
fn fp12_sqr_bls12_381<bls_fp12_mem>(a:u9, o:u9) {
    fp6_mul_bls12_381(a, a + 6, SQR_T0)                // t = a0*a1

    fp6_mul_by_v_bls12_381(a + 6, SQR_T1)              // v*a1
    fp6_add_bls12_381(a, SQR_T1, SQR_T1)               // a0 + v*a1
    fp6_add_bls12_381(a, a + 6, SQR_T2)                // a0 + a1
    fp6_mul_bls12_381(SQR_T1, SQR_T2, SQR_T1)          // (a0+a1)(a0+v*a1)

    fp6_sub_bls12_381(SQR_T1, SQR_T0, SQR_T1)
    fp6_mul_by_v_bls12_381(SQR_T0, SQR_T2)             // v*t
    fp6_sub_bls12_381(SQR_T1, SQR_T2, o)               // c0

    fp6_add_bls12_381(SQR_T0, SQR_T0, o + 6)           // c1 = 2t
}

// Multiply by a Miller line.
//
// A line evaluated at a G1 point is sparse: only three of its six Fp2
// coefficients are non-zero. In the basis used here (see g2 / pairing) they sit
// at c0.0, c1.1 and c1.2, so the line is
//     L = ( (L0, 0, 0), (0, L3, L5) ).
// Passing those three Fp2 values as six u384 arguments plus two addresses is 8
// arguments, comfortably inside the ten-argument cap, and avoids materialising
// the line in memory.
//
// Specialising Karatsuba to this shape costs 15 Fp2 multiplications against 18
// for a dense fp12_mul. DESTINATION MUST BE DISJOINT from the source.
fn fp12_mul_by_line_bls12_381<bls_fp12_mem>(f:u9,
                                            L00:u384, L01:u384,
                                            L30:u384, L31:u384,
                                            L50:u384, L51:u384,
                                            o:u9) {
    // v0 = f0 * (L0, 0, 0): a cubic-extension multiply by a degree-0 element is
    // just scaling every coefficient, 3 Fp2 multiplications.
    var t0:u384, t1:u384, c0:u384, c1:u384
    t0, t1 = fp2_load_bls12_381(f)
    c0, c1 = fp2_mul_bls12_381(t0, t1, L00, L01)
    fp2_store_bls12_381(LIN_T0, c0, c1)
    t0, t1 = fp2_load_bls12_381(f + 2)
    c0, c1 = fp2_mul_bls12_381(t0, t1, L00, L01)
    fp2_store_bls12_381(LIN_T0 + 2, c0, c1)
    t0, t1 = fp2_load_bls12_381(f + 4)
    c0, c1 = fp2_mul_bls12_381(t0, t1, L00, L01)
    fp2_store_bls12_381(LIN_T0 + 4, c0, c1)

    // v1 = f1 * (0, L3, L5), written out directly (6 Fp2 multiplications):
    //   d0 = xi*(f1.1*L5 + f1.2*L3)
    //   d1 = f1.0*L3 + xi*(f1.2*L5)
    //   d2 = f1.0*L5 + f1.1*L3
    var f00:u384, f01:u384, f10:u384, f11:u384, f20:u384, f21:u384
    f00, f01 = fp2_load_bls12_381(f + 6)
    f10, f11 = fp2_load_bls12_381(f + 8)
    f20, f21 = fp2_load_bls12_381(f + 10)

    var p0:u384, p1:u384, q0:u384, q1:u384
    p0, p1 = fp2_mul_bls12_381(f10, f11, L50, L51)
    q0, q1 = fp2_mul_bls12_381(f20, f21, L30, L31)
    p0, p1 = fp2_add_bls12_381(p0, p1, q0, q1)
    p0, p1 = fp2_mul_by_nonresidue_bls12_381(p0, p1)
    fp2_store_bls12_381(LIN_T1, p0, p1)

    p0, p1 = fp2_mul_bls12_381(f00, f01, L30, L31)
    q0, q1 = fp2_mul_bls12_381(f20, f21, L50, L51)
    q0, q1 = fp2_mul_by_nonresidue_bls12_381(q0, q1)
    p0, p1 = fp2_add_bls12_381(p0, p1, q0, q1)
    fp2_store_bls12_381(LIN_T1 + 2, p0, p1)

    p0, p1 = fp2_mul_bls12_381(f00, f01, L50, L51)
    q0, q1 = fp2_mul_bls12_381(f10, f11, L30, L31)
    p0, p1 = fp2_add_bls12_381(p0, p1, q0, q1)
    fp2_store_bls12_381(LIN_T1 + 4, p0, p1)

    // (f0 + f1) * (L0, L3, L5): the sum of the line's halves is dense, so this
    // is one ordinary Fp6 multiply.
    fp2_store_bls12_381(LIN_T2, L00, L01)
    fp2_store_bls12_381(LIN_T2 + 2, L30, L31)
    fp2_store_bls12_381(LIN_T2 + 4, L50, L51)
    fp6_add_bls12_381(f, f + 6, o + 6)
    fp6_mul_bls12_381(o + 6, LIN_T2, o + 6)
    fp6_sub_bls12_381(o + 6, LIN_T0, o + 6)
    fp6_sub_bls12_381(o + 6, LIN_T1, o + 6)            // c1

    fp6_mul_by_v_bls12_381(LIN_T1, LIN_T2)             // v*v1
    fp6_add_bls12_381(LIN_T0, LIN_T2, o)               // c0
}
