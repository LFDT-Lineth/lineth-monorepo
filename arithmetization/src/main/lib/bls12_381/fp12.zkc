include "fp2.zkc"

// ============================================================================
// Fp6 and Fp12, the upper two levels of the BLS12-381 tower.
//
//     Fp6  = Fp2[v]/(v^3 - xi),  xi = 1 + u        element (c0, c1, c2)
//     Fp12 = Fp6[w]/(w^2 - v)                      element (c0, c1)
//
// WHY THESE LIVE IN MEMORY? zkc caps a call at 255 split registers; a u384 is
// 24 limbs at KOALABEAR_16, so a function takes at most TEN u384 arguments.
// Eleven panics with "too many call arguments". An Fp6 multiply passed by value
// would need 12 arguments and an Fp12 multiply 24, so both are impossible as
// value functions. Everything from Fp6 up therefore addresses a scratch memory
// and passes cell indices, while Fp2 and below stay in registers where they are
// far cheaper.
//
// LAYOUT. One Fp element per cell. An Fp6 at address A occupies 6 cells:
//     A+0,A+1  = c0 (an Fp2: real, imaginary)
//     A+2,A+3  = c1
//     A+4,A+5  = c2
// An Fp12 at address A occupies 12 cells: its c0 (an Fp6) at A, its c1 at A+6.
//
// ALIASING. The fp6_* primitives load every operand into registers before
// storing anything, so their destination MAY alias their sources. The fp12_*
// routines go through fixed scratch blocks and therefore require their
// destination to be DISJOINT from their sources -- see the note on each.
// ============================================================================

// ----------------------------------------------------------------------------
// REGION MAP. One flat memory serves the whole pairing, carved into fixed
// regions so no routine can clobber another. Every Fp12 slot is 12 cells.
//
//   0    .. 191    user      16 Fp12 slots, free for callers and unit tests
//   192  .. 959    pairs     BLS12_381_MAX_PAIRS x 12 (see pairing.zkc)
//   960  .. 1091   work      pairing internals: Miller, expt, final exp
//   1152 .. 1223   scratch   primitives below (Fp6-sized blocks)
//
// The address type is u12 rather than u9 because the pair area alone needs 768
// cells. Widening costs nothing: zkc memories are sparse, so only cells that
// are actually touched appear in the trace.
// ----------------------------------------------------------------------------
memory bls_fp12_mem[u32](address:u12) -> (limb:u384)

const BLS_MEM_USER:u12  = 0
const BLS_MEM_PAIRS:u12 = 192
const BLS_MEM_WORK:u12  = 960

// Scratch blocks, one region per routine so that a routine calling another
// cannot clobber it. fp6_* never touches scratch, so only the fp12_* routines
// need disjoint regions.
const FP12_SCRATCH:u12 = 1152
const MUL_T0:u12 = 1152
const MUL_T1:u12 = 1158
const MUL_T2:u12 = 1164
const MUL_T3:u12 = 1170
const SQR_T0:u12 = 1176
const SQR_T1:u12 = 1182
const SQR_T2:u12 = 1188
const LIN_T0:u12 = 1194
const LIN_T1:u12 = 1200
const LIN_T2:u12 = 1206
const INV_T0:u12 = 1212
const INV_T1:u12 = 1218

// ----- Fp2 cell accessors -----

#[inline]
fn fp2_load_bls12_381<bls_fp12_mem>(a:u12) -> (c0:u384, c1:u384) {
    c0 = bls_fp12_mem[a]
    c1 = bls_fp12_mem[a + 1]
}

#[inline]
fn fp2_store_bls12_381<bls_fp12_mem>(a:u12, c0:u384, c1:u384) {
    bls_fp12_mem[a] = c0
    bls_fp12_mem[a + 1] = c1
}

// ----- Fp6 -----

fn fp6_copy_bls12_381<bls_fp12_mem>(a:u12, o:u12) {
    var t0:u384, t1:u384
    t0, t1 = fp2_load_bls12_381(a)
    var t2:u384, t3:u384
    t2, t3 = fp2_load_bls12_381(a + 2)
    var t4:u384, t5:u384
    t4, t5 = fp2_load_bls12_381(a + 4)
    fp2_store_bls12_381(o, t0, t1)
    fp2_store_bls12_381(o + 2, t2, t3)
    fp2_store_bls12_381(o + 4, t4, t5)
}

fn fp6_set_zero_bls12_381<bls_fp12_mem>(o:u12) {
    fp2_store_bls12_381(o, 0, 0)
    fp2_store_bls12_381(o + 2, 0, 0)
    fp2_store_bls12_381(o + 4, 0, 0)
}

fn fp6_add_bls12_381<bls_fp12_mem>(a:u12, b:u12, o:u12) {
    var a00:u384, a01:u384, a10:u384, a11:u384, a20:u384, a21:u384
    a00, a01 = fp2_load_bls12_381(a)
    a10, a11 = fp2_load_bls12_381(a + 2)
    a20, a21 = fp2_load_bls12_381(a + 4)
    var b00:u384, b01:u384, b10:u384, b11:u384, b20:u384, b21:u384
    b00, b01 = fp2_load_bls12_381(b)
    b10, b11 = fp2_load_bls12_381(b + 2)
    b20, b21 = fp2_load_bls12_381(b + 4)

    var c0:u384, c1:u384
    c0, c1 = fp2_add_bls12_381(a00, a01, b00, b01)
    fp2_store_bls12_381(o, c0, c1)
    c0, c1 = fp2_add_bls12_381(a10, a11, b10, b11)
    fp2_store_bls12_381(o + 2, c0, c1)
    c0, c1 = fp2_add_bls12_381(a20, a21, b20, b21)
    fp2_store_bls12_381(o + 4, c0, c1)
}

fn fp6_sub_bls12_381<bls_fp12_mem>(a:u12, b:u12, o:u12) {
    var a00:u384, a01:u384, a10:u384, a11:u384, a20:u384, a21:u384
    a00, a01 = fp2_load_bls12_381(a)
    a10, a11 = fp2_load_bls12_381(a + 2)
    a20, a21 = fp2_load_bls12_381(a + 4)
    var b00:u384, b01:u384, b10:u384, b11:u384, b20:u384, b21:u384
    b00, b01 = fp2_load_bls12_381(b)
    b10, b11 = fp2_load_bls12_381(b + 2)
    b20, b21 = fp2_load_bls12_381(b + 4)

    var c0:u384, c1:u384
    c0, c1 = fp2_sub_bls12_381(a00, a01, b00, b01)
    fp2_store_bls12_381(o, c0, c1)
    c0, c1 = fp2_sub_bls12_381(a10, a11, b10, b11)
    fp2_store_bls12_381(o + 2, c0, c1)
    c0, c1 = fp2_sub_bls12_381(a20, a21, b20, b21)
    fp2_store_bls12_381(o + 4, c0, c1)
}

fn fp6_neg_bls12_381<bls_fp12_mem>(a:u12, o:u12) {
    var a00:u384, a01:u384, a10:u384, a11:u384, a20:u384, a21:u384
    a00, a01 = fp2_load_bls12_381(a)
    a10, a11 = fp2_load_bls12_381(a + 2)
    a20, a21 = fp2_load_bls12_381(a + 4)

    var c0:u384, c1:u384
    c0, c1 = fp2_neg_bls12_381(a00, a01)
    fp2_store_bls12_381(o, c0, c1)
    c0, c1 = fp2_neg_bls12_381(a10, a11)
    fp2_store_bls12_381(o + 2, c0, c1)
    c0, c1 = fp2_neg_bls12_381(a20, a21)
    fp2_store_bls12_381(o + 4, c0, c1)
}

// Multiplication by v: (c0, c1, c2)*v = xi*c2 + c0*v + c1*v^2, since v^3 = xi.
fn fp6_mul_by_v_bls12_381<bls_fp12_mem>(a:u12, o:u12) {
    var a00:u384, a01:u384, a10:u384, a11:u384, a20:u384, a21:u384
    a00, a01 = fp2_load_bls12_381(a)
    a10, a11 = fp2_load_bls12_381(a + 2)
    a20, a21 = fp2_load_bls12_381(a + 4)

    var c0:u384, c1:u384
    c0, c1 = fp2_mul_by_nonresidue_bls12_381(a20, a21)
    fp2_store_bls12_381(o, c0, c1)
    fp2_store_bls12_381(o + 2, a00, a01)
    fp2_store_bls12_381(o + 4, a10, a11)
}

// Karatsuba multiplication over the cubic extension: 6 Fp2 multiplications.
//   c0 = a0b0 + xi*((a1+a2)(b1+b2) - a1b1 - a2b2)
//   c1 = (a0+a1)(b0+b1) - a0b0 - a1b1 + xi*a2b2
//   c2 = (a0+a2)(b0+b2) - a0b0 - a2b2 + a1b1
// Destination may alias either source: everything is loaded up front.
fn fp6_mul_bls12_381<bls_fp12_mem>(a:u12, b:u12, o:u12) {
    var a00:u384, a01:u384, a10:u384, a11:u384, a20:u384, a21:u384
    a00, a01 = fp2_load_bls12_381(a)
    a10, a11 = fp2_load_bls12_381(a + 2)
    a20, a21 = fp2_load_bls12_381(a + 4)
    var b00:u384, b01:u384, b10:u384, b11:u384, b20:u384, b21:u384
    b00, b01 = fp2_load_bls12_381(b)
    b10, b11 = fp2_load_bls12_381(b + 2)
    b20, b21 = fp2_load_bls12_381(b + 4)

    var v00:u384, v01:u384, v10:u384, v11:u384, v20:u384, v21:u384
    v00, v01 = fp2_mul_bls12_381(a00, a01, b00, b01)
    v10, v11 = fp2_mul_bls12_381(a10, a11, b10, b11)
    v20, v21 = fp2_mul_bls12_381(a20, a21, b20, b21)

    var s0:u384, s1:u384, t0:u384, t1:u384, m0:u384, m1:u384

    // c0 = v0 + xi*((a1+a2)(b1+b2) - v1 - v2)
    s0, s1 = fp2_add_bls12_381(a10, a11, a20, a21)
    t0, t1 = fp2_add_bls12_381(b10, b11, b20, b21)
    m0, m1 = fp2_mul_bls12_381(s0, s1, t0, t1)
    m0, m1 = fp2_sub_bls12_381(m0, m1, v10, v11)
    m0, m1 = fp2_sub_bls12_381(m0, m1, v20, v21)
    m0, m1 = fp2_mul_by_nonresidue_bls12_381(m0, m1)
    var c00:u384, c01:u384
    c00, c01 = fp2_add_bls12_381(v00, v01, m0, m1)

    // c1 = (a0+a1)(b0+b1) - v0 - v1 + xi*v2
    s0, s1 = fp2_add_bls12_381(a00, a01, a10, a11)
    t0, t1 = fp2_add_bls12_381(b00, b01, b10, b11)
    m0, m1 = fp2_mul_bls12_381(s0, s1, t0, t1)
    m0, m1 = fp2_sub_bls12_381(m0, m1, v00, v01)
    m0, m1 = fp2_sub_bls12_381(m0, m1, v10, v11)
    var n0:u384, n1:u384
    n0, n1 = fp2_mul_by_nonresidue_bls12_381(v20, v21)
    var c10:u384, c11:u384
    c10, c11 = fp2_add_bls12_381(m0, m1, n0, n1)

    // c2 = (a0+a2)(b0+b2) - v0 - v2 + v1
    s0, s1 = fp2_add_bls12_381(a00, a01, a20, a21)
    t0, t1 = fp2_add_bls12_381(b00, b01, b20, b21)
    m0, m1 = fp2_mul_bls12_381(s0, s1, t0, t1)
    m0, m1 = fp2_sub_bls12_381(m0, m1, v00, v01)
    m0, m1 = fp2_sub_bls12_381(m0, m1, v20, v21)
    var c20:u384, c21:u384
    c20, c21 = fp2_add_bls12_381(m0, m1, v10, v11)

    fp2_store_bls12_381(o, c00, c01)
    fp2_store_bls12_381(o + 2, c10, c11)
    fp2_store_bls12_381(o + 4, c20, c21)
}

// ----- Fp12 -----

fn fp12_set_one_bls12_381<bls_fp12_mem>(o:u12) {
    fp2_store_bls12_381(o, 1, 0)
    fp2_store_bls12_381(o + 2, 0, 0)
    fp2_store_bls12_381(o + 4, 0, 0)
    fp6_set_zero_bls12_381(o + 6)
}

fn fp12_copy_bls12_381<bls_fp12_mem>(a:u12, o:u12) {
    fp6_copy_bls12_381(a, o)
    fp6_copy_bls12_381(a + 6, o + 6)
}

// Conjugation over Fp6, i.e. the p^6-power Frobenius: (c0, c1) -> (c0, -c1).
fn fp12_conj_bls12_381<bls_fp12_mem>(a:u12, o:u12) {
    fp6_copy_bls12_381(a, o)
    fp6_neg_bls12_381(a + 6, o + 6)
}

// Karatsuba over the quadratic extension (w^2 = v): 3 Fp6 multiplications.
//   c0 = a0b0 + v*(a1b1)
//   c1 = (a0+a1)(b0+b1) - a0b0 - a1b1
// DESTINATION MUST BE DISJOINT from both sources.
fn fp12_mul_bls12_381<bls_fp12_mem>(a:u12, b:u12, o:u12) {
    fp6_mul_bls12_381(a, b, MUL_T0)                    // v0 = a0*b0
    fp6_mul_bls12_381(a + 6, b + 6, MUL_T1)            // v1 = a1*b1

    fp6_add_bls12_381(a, a + 6, MUL_T2)                // a0+a1
    fp6_add_bls12_381(b, b + 6, MUL_T3)                // b0+b1
    fp6_mul_bls12_381(MUL_T2, MUL_T3, MUL_T2)          // (a0+a1)(b0+b1)

    fp6_sub_bls12_381(MUL_T2, MUL_T0, MUL_T2)
    fp6_sub_bls12_381(MUL_T2, MUL_T1, o + 6)           // c1

    fp6_mul_by_v_bls12_381(MUL_T1, MUL_T3)             // v*v1
    fp6_add_bls12_381(MUL_T0, MUL_T3, o)               // c0
}

// Squaring, as the Karatsuba multiply specialised to a == b: 2 Fp6
// multiplications instead of 3.
//   t  = a0*a1
//   c1 = 2t
//   c0 = (a0+a1)(a0 + v*a1) - t - v*t
// DESTINATION MUST BE DISJOINT from the source.
fn fp12_sqr_bls12_381<bls_fp12_mem>(a:u12, o:u12) {
    fp6_mul_bls12_381(a, a + 6, SQR_T0)                // t = a0*a1

    fp6_mul_by_v_bls12_381(a + 6, SQR_T1)              // v*a1
    fp6_add_bls12_381(a, SQR_T1, SQR_T1)               // a0 + v*a1
    fp6_add_bls12_381(a, a + 6, SQR_T2)                // a0 + a1
    fp6_mul_bls12_381(SQR_T1, SQR_T2, SQR_T1)          // (a0+a1)(a0+v*a1)

    fp6_sub_bls12_381(SQR_T1, SQR_T0, SQR_T1)
    fp6_mul_by_v_bls12_381(SQR_T0, SQR_T2)             // v*t
    fp6_sub_bls12_381(SQR_T1, SQR_T2, o)               // c0

    fp6_add_bls12_381(SQR_T0, SQR_T0, o + 6)           // c1 = 2t
}

// Multiply by a Miller line.
//
// A line evaluated at a G1 point is sparse: only three of its six Fp2
// coefficients are non-zero. In the basis used here (see g2 / pairing) they sit
// at c0.0, c1.1 and c1.2, so the line is
//     L = ( (L0, 0, 0), (0, L3, L5) ).
// Passing those three Fp2 values as six u384 arguments plus two addresses is 8
// arguments, comfortably inside the ten-argument cap, and avoids materialising
// the line in memory.
//
// Specialising Karatsuba to this shape costs 15 Fp2 multiplications against 18
// for a dense fp12_mul. DESTINATION MUST BE DISJOINT from the source.
fn fp12_mul_by_line_bls12_381<bls_fp12_mem>(f:u12,
                                            L00:u384, L01:u384,
                                            L30:u384, L31:u384,
                                            L50:u384, L51:u384,
                                            o:u12) {
    // v0 = f0 * (L0, 0, 0): a cubic-extension multiply by a degree-0 element is
    // just scaling every coefficient, 3 Fp2 multiplications.
    var t0:u384, t1:u384, c0:u384, c1:u384
    t0, t1 = fp2_load_bls12_381(f)
    c0, c1 = fp2_mul_bls12_381(t0, t1, L00, L01)
    fp2_store_bls12_381(LIN_T0, c0, c1)
    t0, t1 = fp2_load_bls12_381(f + 2)
    c0, c1 = fp2_mul_bls12_381(t0, t1, L00, L01)
    fp2_store_bls12_381(LIN_T0 + 2, c0, c1)
    t0, t1 = fp2_load_bls12_381(f + 4)
    c0, c1 = fp2_mul_bls12_381(t0, t1, L00, L01)
    fp2_store_bls12_381(LIN_T0 + 4, c0, c1)

    // v1 = f1 * (0, L3, L5), written out directly (6 Fp2 multiplications):
    //   d0 = xi*(f1.1*L5 + f1.2*L3)
    //   d1 = f1.0*L3 + xi*(f1.2*L5)
    //   d2 = f1.0*L5 + f1.1*L3
    var f00:u384, f01:u384, f10:u384, f11:u384, f20:u384, f21:u384
    f00, f01 = fp2_load_bls12_381(f + 6)
    f10, f11 = fp2_load_bls12_381(f + 8)
    f20, f21 = fp2_load_bls12_381(f + 10)

    var p0:u384, p1:u384, q0:u384, q1:u384
    p0, p1 = fp2_mul_bls12_381(f10, f11, L50, L51)
    q0, q1 = fp2_mul_bls12_381(f20, f21, L30, L31)
    p0, p1 = fp2_add_bls12_381(p0, p1, q0, q1)
    p0, p1 = fp2_mul_by_nonresidue_bls12_381(p0, p1)
    fp2_store_bls12_381(LIN_T1, p0, p1)

    p0, p1 = fp2_mul_bls12_381(f00, f01, L30, L31)
    q0, q1 = fp2_mul_bls12_381(f20, f21, L50, L51)
    q0, q1 = fp2_mul_by_nonresidue_bls12_381(q0, q1)
    p0, p1 = fp2_add_bls12_381(p0, p1, q0, q1)
    fp2_store_bls12_381(LIN_T1 + 2, p0, p1)

    p0, p1 = fp2_mul_bls12_381(f00, f01, L50, L51)
    q0, q1 = fp2_mul_bls12_381(f10, f11, L30, L31)
    p0, p1 = fp2_add_bls12_381(p0, p1, q0, q1)
    fp2_store_bls12_381(LIN_T1 + 4, p0, p1)

    // (f0 + f1) * (L0, L3, L5): the sum of the line's halves is dense, so this
    // is one ordinary Fp6 multiply.
    fp2_store_bls12_381(LIN_T2, L00, L01)
    fp2_store_bls12_381(LIN_T2 + 2, L30, L31)
    fp2_store_bls12_381(LIN_T2 + 4, L50, L51)
    fp6_add_bls12_381(f, f + 6, o + 6)
    fp6_mul_bls12_381(o + 6, LIN_T2, o + 6)
    fp6_sub_bls12_381(o + 6, LIN_T0, o + 6)
    fp6_sub_bls12_381(o + 6, LIN_T1, o + 6)            // c1

    fp6_mul_by_v_bls12_381(LIN_T1, LIN_T2)             // v*v1
    fp6_add_bls12_381(LIN_T0, LIN_T2, o)               // c0
}

// ----- Fp6 inversion -----

// 1/(a0 + a1 v + a2 v^2) over Fp2[v]/(v^3 - xi), via the cofactor formula
//   t0 = a0^2 - xi*a1*a2      t1 = xi*a2^2 - a0*a1      t2 = a1^2 - a0*a2
//   d  = a0*t0 + xi*(a2*t1 + a1*t2)
// The denominator d lies in Fp2, so this needs exactly ONE Fp2 inversion and
// hence one invmod_384 -- the whole reason the tower is worth building.
//
// Register-only: everything is loaded before anything is stored, so the
// destination MAY alias the source. Fails on zero (no inverse).
fn fp6_inv_bls12_381<bls_fp12_mem>(a:u12, o:u12) {
    var a00:u384, a01:u384, a10:u384, a11:u384, a20:u384, a21:u384
    a00, a01 = fp2_load_bls12_381(a)
    a10, a11 = fp2_load_bls12_381(a + 2)
    a20, a21 = fp2_load_bls12_381(a + 4)

    var s0:u384, s1:u384, m0:u384, m1:u384

    // t0 = a0^2 - xi*(a1*a2)
    s0, s1 = fp2_sqr_bls12_381(a00, a01)
    m0, m1 = fp2_mul_bls12_381(a10, a11, a20, a21)
    m0, m1 = fp2_mul_by_nonresidue_bls12_381(m0, m1)
    var t00:u384, t01:u384
    t00, t01 = fp2_sub_bls12_381(s0, s1, m0, m1)

    // t1 = xi*a2^2 - a0*a1
    s0, s1 = fp2_sqr_bls12_381(a20, a21)
    s0, s1 = fp2_mul_by_nonresidue_bls12_381(s0, s1)
    m0, m1 = fp2_mul_bls12_381(a00, a01, a10, a11)
    var t10:u384, t11:u384
    t10, t11 = fp2_sub_bls12_381(s0, s1, m0, m1)

    // t2 = a1^2 - a0*a2
    s0, s1 = fp2_sqr_bls12_381(a10, a11)
    m0, m1 = fp2_mul_bls12_381(a00, a01, a20, a21)
    var t20:u384, t21:u384
    t20, t21 = fp2_sub_bls12_381(s0, s1, m0, m1)

    // d = a0*t0 + xi*(a2*t1) + xi*(a1*t2)
    var d0:u384, d1:u384
    d0, d1 = fp2_mul_bls12_381(a00, a01, t00, t01)
    m0, m1 = fp2_mul_bls12_381(a20, a21, t10, t11)
    m0, m1 = fp2_mul_by_nonresidue_bls12_381(m0, m1)
    d0, d1 = fp2_add_bls12_381(d0, d1, m0, m1)
    m0, m1 = fp2_mul_bls12_381(a10, a11, t20, t21)
    m0, m1 = fp2_mul_by_nonresidue_bls12_381(m0, m1)
    d0, d1 = fp2_add_bls12_381(d0, d1, m0, m1)

    var di0:u384, di1:u384
    di0, di1 = fp2_inv_bls12_381(d0, d1)

    var c0:u384, c1:u384
    c0, c1 = fp2_mul_bls12_381(t00, t01, di0, di1)
    fp2_store_bls12_381(o, c0, c1)
    c0, c1 = fp2_mul_bls12_381(t10, t11, di0, di1)
    fp2_store_bls12_381(o + 2, c0, c1)
    c0, c1 = fp2_mul_bls12_381(t20, t21, di0, di1)
    fp2_store_bls12_381(o + 4, c0, c1)
}

// 1/(c0 + c1 w) = (c0 - c1 w) / (c0^2 - v*c1^2). The denominator lies in Fp6,
// so this is one Fp6 inversion, i.e. still one invmod_384 overall.
// DESTINATION MUST BE DISJOINT from the source.
fn fp12_inv_bls12_381<bls_fp12_mem>(a:u12, o:u12) {
    fp6_mul_bls12_381(a, a, INV_T0)                    // c0^2
    fp6_mul_bls12_381(a + 6, a + 6, INV_T1)            // c1^2
    fp6_mul_by_v_bls12_381(INV_T1, INV_T1)             // v*c1^2
    fp6_sub_bls12_381(INV_T0, INV_T1, INV_T0)          // c0^2 - v*c1^2
    fp6_inv_bls12_381(INV_T0, INV_T0)

    fp6_mul_bls12_381(a, INV_T0, o)
    fp6_mul_bls12_381(a + 6, INV_T0, o + 6)
    fp6_neg_bls12_381(o + 6, o + 6)
}

// ----- predicates -----

fn fp12_is_one_bls12_381<bls_fp12_mem>(a:u12) -> (res:u1) {
    res = 0
    if bls_fp12_mem[a] != 1 {
        return
    }
    for i:u5 = 1; i < 12; i = i + 1 {
        if bls_fp12_mem[a + (i as u12)] != 0 {
            return
        }
    }
    res = 1
}

// ----- Frobenius -----
//
// Writing an element as sum d_i w^i with d_i in Fp2 and w^6 = xi, the p-power
// Frobenius is  a^p = sum conj(d_i) * gamma_i * w^i  with gamma_i = xi^(i(p-1)/6),
// because Frobenius acts on Fp2 by conjugation (see fp2.zkc). The tower slots
// map to powers of w as
//     c0.b0 c0.b1 c0.b2 c1.b0 c1.b1 c1.b2  ->  w^0 w^2 w^4 w^1 w^3 w^5
// which is why the constants below are applied in the order 2,4,1,3,5.
// gamma_0 = 1, so c0.b0 needs only the conjugation.

const BLS12_381_FROB1_C1_C0:u384 = 0x1904d3bf02bb0667c231beb4202c0d1f0fd603fd3cbd5f4f7b2443d784bab9c4f67ea53d63e7813d8d0775ed92235fb8
const BLS12_381_FROB1_C1_C1:u384 = 0x00fc3e2b36c4e03288e9e902231f9fb854a14787b6c7b36fec0c8ec971f63c5f282d5ac14d6c7ec22cf78a126ddc4af3
const BLS12_381_FROB1_C2_C0:u384 = 0
const BLS12_381_FROB1_C2_C1:u384 = 0x1a0111ea397fe699ec02408663d4de85aa0d857d89759ad4897d29650fb85f9b409427eb4f49fffd8bfd00000000aaac
const BLS12_381_FROB1_C3_C0:u384 = 0x06af0e0437ff400b6831e36d6bd17ffe48395dabc2d3435e77f76e17009241c5ee67992f72ec05f4c81084fbede3cc09
const BLS12_381_FROB1_C3_C1:u384 = 0x06af0e0437ff400b6831e36d6bd17ffe48395dabc2d3435e77f76e17009241c5ee67992f72ec05f4c81084fbede3cc09
const BLS12_381_FROB1_C4_C0:u384 = 0x1a0111ea397fe699ec02408663d4de85aa0d857d89759ad4897d29650fb85f9b409427eb4f49fffd8bfd00000000aaad
const BLS12_381_FROB1_C4_C1:u384 = 0
const BLS12_381_FROB1_C5_C0:u384 = 0x05b2cfd9013a5fd8df47fa6b48b1e045f39816240c0b8fee8beadf4d8e9c0566c63a3e6e257f87329b18fae980078116
const BLS12_381_FROB1_C5_C1:u384 = 0x144e4211384586c16bd3ad4afa99cc9170df3560e77982d0db45f3536814f0bd5871c1908bd478cd1ee605167ff82995

// For p^2 the conjugations cancel and every gamma lands in Fp, so these are
// single coordinates applied with fp2_mul_by_fp (2 mulmods, not 3).
const BLS12_381_FROB2_C1:u384 = 0x5f19672fdf76ce51ba69c6076a0f77eaddb3a93be6f89688de17d813620a00022e01fffffffeffff
const BLS12_381_FROB2_C2:u384 = 0x5f19672fdf76ce51ba69c6076a0f77eaddb3a93be6f89688de17d813620a00022e01fffffffefffe
const BLS12_381_FROB2_C3:u384 = 0x1a0111ea397fe69a4b1ba7b6434bacd764774b84f38512bf6730d2a0f6b0f6241eabfffeb153ffffb9feffffffffaaaa
const BLS12_381_FROB2_C4:u384 = 0x1a0111ea397fe699ec02408663d4de85aa0d857d89759ad4897d29650fb85f9b409427eb4f49fffd8bfd00000000aaac
const BLS12_381_FROB2_C5:u384 = 0x1a0111ea397fe699ec02408663d4de85aa0d857d89759ad4897d29650fb85f9b409427eb4f49fffd8bfd00000000aaad

// a^p. Register-only, so the destination MAY alias the source.
fn fp12_frobenius_bls12_381<bls_fp12_mem>(a:u12, o:u12) {
    var b00:u384, b01:u384, b10:u384, b11:u384, b20:u384, b21:u384
    b00, b01 = fp2_load_bls12_381(a)
    b10, b11 = fp2_load_bls12_381(a + 2)
    b20, b21 = fp2_load_bls12_381(a + 4)
    var b30:u384, b31:u384, b40:u384, b41:u384, b50:u384, b51:u384
    b30, b31 = fp2_load_bls12_381(a + 6)
    b40, b41 = fp2_load_bls12_381(a + 8)
    b50, b51 = fp2_load_bls12_381(a + 10)

    var c0:u384, c1:u384, k0:u384, k1:u384

    // w^0: gamma_0 = 1
    c0, c1 = fp2_conjugate_bls12_381(b00, b01)
    fp2_store_bls12_381(o, c0, c1)

    // w^2
    k0, k1 = fp2_conjugate_bls12_381(b10, b11)
    c0, c1 = fp2_mul_bls12_381(k0, k1, BLS12_381_FROB1_C2_C0, BLS12_381_FROB1_C2_C1)
    fp2_store_bls12_381(o + 2, c0, c1)

    // w^4
    k0, k1 = fp2_conjugate_bls12_381(b20, b21)
    c0, c1 = fp2_mul_bls12_381(k0, k1, BLS12_381_FROB1_C4_C0, BLS12_381_FROB1_C4_C1)
    fp2_store_bls12_381(o + 4, c0, c1)

    // w^1
    k0, k1 = fp2_conjugate_bls12_381(b30, b31)
    c0, c1 = fp2_mul_bls12_381(k0, k1, BLS12_381_FROB1_C1_C0, BLS12_381_FROB1_C1_C1)
    fp2_store_bls12_381(o + 6, c0, c1)

    // w^3
    k0, k1 = fp2_conjugate_bls12_381(b40, b41)
    c0, c1 = fp2_mul_bls12_381(k0, k1, BLS12_381_FROB1_C3_C0, BLS12_381_FROB1_C3_C1)
    fp2_store_bls12_381(o + 8, c0, c1)

    // w^5
    k0, k1 = fp2_conjugate_bls12_381(b50, b51)
    c0, c1 = fp2_mul_bls12_381(k0, k1, BLS12_381_FROB1_C5_C0, BLS12_381_FROB1_C5_C1)
    fp2_store_bls12_381(o + 10, c0, c1)
}

// a^(p^2). Register-only, so the destination MAY alias the source.
fn fp12_frobenius_sq_bls12_381<bls_fp12_mem>(a:u12, o:u12) {
    var b00:u384, b01:u384, b10:u384, b11:u384, b20:u384, b21:u384
    b00, b01 = fp2_load_bls12_381(a)
    b10, b11 = fp2_load_bls12_381(a + 2)
    b20, b21 = fp2_load_bls12_381(a + 4)
    var b30:u384, b31:u384, b40:u384, b41:u384, b50:u384, b51:u384
    b30, b31 = fp2_load_bls12_381(a + 6)
    b40, b41 = fp2_load_bls12_381(a + 8)
    b50, b51 = fp2_load_bls12_381(a + 10)

    var c0:u384, c1:u384

    fp2_store_bls12_381(o, b00, b01)
    c0, c1 = fp2_mul_by_fp_bls12_381(b10, b11, BLS12_381_FROB2_C2)
    fp2_store_bls12_381(o + 2, c0, c1)
    c0, c1 = fp2_mul_by_fp_bls12_381(b20, b21, BLS12_381_FROB2_C4)
    fp2_store_bls12_381(o + 4, c0, c1)
    c0, c1 = fp2_mul_by_fp_bls12_381(b30, b31, BLS12_381_FROB2_C1)
    fp2_store_bls12_381(o + 6, c0, c1)
    c0, c1 = fp2_mul_by_fp_bls12_381(b40, b41, BLS12_381_FROB2_C3)
    fp2_store_bls12_381(o + 8, c0, c1)
    c0, c1 = fp2_mul_by_fp_bls12_381(b50, b51, BLS12_381_FROB2_C5)
    fp2_store_bls12_381(o + 10, c0, c1)
}

// ----- cyclotomic squaring -----

// Granger-Scott squaring, https://eprint.iacr.org/2009/565.pdf section 3.2.
//
// PRECONDITION: a lies in the cyclotomic subgroup, a^(p^6+1) == 1. That holds
// for anything downstream of the easy part of the final exponentiation, and
// NOWHERE ELSE -- calling this on a general Fp12 element silently returns
// garbage. Use fp12_sqr_bls12_381 if unsure.
//
// Costs 9 Fp2 squarings (18 mulmods) against the 36 of a general fp12_sqr, so
// the exponentiations in the final exponentiation are twice as cheap.
// Register-only, so the destination MAY alias the source.
fn fp12_cyclotomic_sqr_bls12_381<bls_fp12_mem>(a:u12, o:u12) {
    var x00:u384, x01:u384, x10:u384, x11:u384, x20:u384, x21:u384
    x00, x01 = fp2_load_bls12_381(a)
    x10, x11 = fp2_load_bls12_381(a + 2)
    x20, x21 = fp2_load_bls12_381(a + 4)
    var x30:u384, x31:u384, x40:u384, x41:u384, x50:u384, x51:u384
    x30, x31 = fp2_load_bls12_381(a + 6)
    x40, x41 = fp2_load_bls12_381(a + 8)
    x50, x51 = fp2_load_bls12_381(a + 10)

    var s0:u384, s1:u384

    // t0 = x4^2, t1 = x0^2, t6 = 2*x4*x0 via (x4+x0)^2 - t0 - t1
    var t00:u384, t01:u384
    t00, t01 = fp2_sqr_bls12_381(x40, x41)
    var t10:u384, t11:u384
    t10, t11 = fp2_sqr_bls12_381(x00, x01)
    s0, s1 = fp2_add_bls12_381(x40, x41, x00, x01)
    var t60:u384, t61:u384
    t60, t61 = fp2_sqr_bls12_381(s0, s1)
    t60, t61 = fp2_sub_bls12_381(t60, t61, t00, t01)
    t60, t61 = fp2_sub_bls12_381(t60, t61, t10, t11)

    // t2 = x2^2, t3 = x3^2, t7 = 2*x2*x3
    var t20:u384, t21:u384
    t20, t21 = fp2_sqr_bls12_381(x20, x21)
    var t30:u384, t31:u384
    t30, t31 = fp2_sqr_bls12_381(x30, x31)
    s0, s1 = fp2_add_bls12_381(x20, x21, x30, x31)
    var t70:u384, t71:u384
    t70, t71 = fp2_sqr_bls12_381(s0, s1)
    t70, t71 = fp2_sub_bls12_381(t70, t71, t20, t21)
    t70, t71 = fp2_sub_bls12_381(t70, t71, t30, t31)

    // t4 = x5^2, t5 = x1^2, t8 = xi*(2*x5*x1)
    var t40:u384, t41:u384
    t40, t41 = fp2_sqr_bls12_381(x50, x51)
    var t50:u384, t51:u384
    t50, t51 = fp2_sqr_bls12_381(x10, x11)
    s0, s1 = fp2_add_bls12_381(x50, x51, x10, x11)
    var t80:u384, t81:u384
    t80, t81 = fp2_sqr_bls12_381(s0, s1)
    t80, t81 = fp2_sub_bls12_381(t80, t81, t40, t41)
    t80, t81 = fp2_sub_bls12_381(t80, t81, t50, t51)
    t80, t81 = fp2_mul_by_nonresidue_bls12_381(t80, t81)

    t00, t01 = fp2_mul_by_nonresidue_bls12_381(t00, t01)
    t00, t01 = fp2_add_bls12_381(t00, t01, t10, t11)
    t20, t21 = fp2_mul_by_nonresidue_bls12_381(t20, t21)
    t20, t21 = fp2_add_bls12_381(t20, t21, t30, t31)
    t40, t41 = fp2_mul_by_nonresidue_bls12_381(t40, t41)
    t40, t41 = fp2_add_bls12_381(t40, t41, t50, t51)

    // z_i = 3*t - 2*x for the c0 half, 3*t + 2*x for the c1 half
    var z0:u384, z1:u384
    z0, z1 = fp2_sub_bls12_381(t00, t01, x00, x01)
    z0, z1 = fp2_add_bls12_381(z0, z1, z0, z1)
    z0, z1 = fp2_add_bls12_381(z0, z1, t00, t01)
    fp2_store_bls12_381(o, z0, z1)

    z0, z1 = fp2_sub_bls12_381(t20, t21, x10, x11)
    z0, z1 = fp2_add_bls12_381(z0, z1, z0, z1)
    z0, z1 = fp2_add_bls12_381(z0, z1, t20, t21)
    fp2_store_bls12_381(o + 2, z0, z1)

    z0, z1 = fp2_sub_bls12_381(t40, t41, x20, x21)
    z0, z1 = fp2_add_bls12_381(z0, z1, z0, z1)
    z0, z1 = fp2_add_bls12_381(z0, z1, t40, t41)
    fp2_store_bls12_381(o + 4, z0, z1)

    z0, z1 = fp2_add_bls12_381(t80, t81, x30, x31)
    z0, z1 = fp2_add_bls12_381(z0, z1, z0, z1)
    z0, z1 = fp2_add_bls12_381(z0, z1, t80, t81)
    fp2_store_bls12_381(o + 6, z0, z1)

    z0, z1 = fp2_add_bls12_381(t60, t61, x40, x41)
    z0, z1 = fp2_add_bls12_381(z0, z1, z0, z1)
    z0, z1 = fp2_add_bls12_381(z0, z1, t60, t61)
    fp2_store_bls12_381(o + 8, z0, z1)

    z0, z1 = fp2_add_bls12_381(t70, t71, x50, x51)
    z0, z1 = fp2_add_bls12_381(z0, z1, z0, z1)
    z0, z1 = fp2_add_bls12_381(z0, z1, t70, t71)
    fp2_store_bls12_381(o + 10, z0, z1)
}
