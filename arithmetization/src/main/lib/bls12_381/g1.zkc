include "constants.zkc"
include "../nonnative/sw_add_mul_formulas_384.zkc"

// ============================================================================
// BLS12-381 G1: the group of Fp-rational points on y^2 = x^3 + 4.
//
// This is the curve behind the EIP-2537 BLS12_G1ADD (0x0b) and BLS12_G1MSM
// (0x0c) precompiles.
//
// The projective group law (complete addition, doubling, scalar mul) is shared
// via nonnative/sw_add_mul_formulas_384.zkc — the 384-bit mirror of the u256
// sw_add_mul_formulas.zkc that secp256k1 and BN254 use. This file just supplies
// the BLS12-381 constants (p, b3 = 12) and the affine/validity layer. Design
// notes:
//   - b = 4, so the complete-addition constant is b3 = 3*b = 12
//     (secp256k1: 21, BN254: 9).
//   - No sqrt / point decompression: G1ADD takes full (x, y) coordinates.
//   - Unlike BN254 G1, the cofactor is NOT 1, so "on the curve" does not imply
//     "in the prime-order subgroup". EIP-2537 requires no subgroup check for
//     G1ADD ("There is no subgroup check for the G1 addition precompile"), and
//     addition is well defined on the whole curve, so is_valid_affine_* below
//     deliberately accepts off-subgroup points. G1MSM and the pairing DO
//     require one, and will add it separately.
//   - On-curve validity is exposed as a boolean predicate rather than a hard
//     `fail`, so callers can implement the EVM "invalid point => precompile
//     failure / frame revert" path as a soft failure (returning a status)
//     instead of aborting the whole proof.
// ============================================================================

// The generator, the coordinate conversions and the group law live in
// g1_group.zkc -- see the header there for why they are a separate file.

// ----- validity / assertions ------

// The point at infinity O is encoded as the affine pair (0, 0) (matching the
// EIP-2537 ABI, which uses an all-zero point). Note (0,0) does NOT satisfy the
// curve equation; it is treated as the identity by convention. It is therefore
// valid input AND valid output, and cannot be used as a failure sentinel.
fn is_infinity_affine_bls12_381_g1(x:u384, y:u384) -> (res:u1) {
    res = 0
    if (x == 0) && (y == 0) {
        res = 1
    }
}

// Returns one iff (x, y) is a canonical, FINITE point of the curve.
// Non-canonical coordinates (>= p) return zero rather than being reduced: an
// out-of-range coordinate is an invalid EVM input, and the precompile must be
// able to prove that, so this must not `fail`.
fn is_on_curve_affine_bls12_381_g1(x:u384, y:u384) -> (res:u1) {
    res = 0
    if x >= BLS12_381_P || y >= BLS12_381_P {
        return
    }
    if is_infinity_affine_bls12_381_g1(x, y) == 1 {
        return
    }
    var y2:u384 = mulmod_384(y, y, BLS12_381_P)
    var x2:u384 = mulmod_384(x, x, BLS12_381_P)
    var x3:u384 = mulmod_384(x2, x, BLS12_381_P)
    var rhs:u384 = addmod_384(x3, BLS12_381_B, BLS12_381_P)
    if rhs == y2 {
        res = 1
    }
}

// Returns one iff (x, y) is accepted as G1ADD input by EIP-2537: canonical
// coordinates, and either the encoded infinity or a genuine curve point.
// No subgroup check — see the header note.
fn is_valid_affine_bls12_381_g1(x:u384, y:u384) -> (res:u1) {
    res = 0
    if x >= BLS12_381_P || y >= BLS12_381_P {
        return
    }
    if is_infinity_affine_bls12_381_g1(x, y) == 1 {
        res = 1
        return
    }
    res = is_on_curve_affine_bls12_381_g1(x, y)
}

// ----- subgroup check -----

// A primitive cube root of unity in Fp. It defines the GLV endomorphism
// phi(x, y) = (beta*x, y), which acts on the prime-order subgroup as
// multiplication by lambda = x^2 - 1.
const BLS12_381_BETA:u384 = 0x1a0111ea397fe699ec02408663d4de85aa0d857d89759ad4897d29650fb85f9b409427eb4f49fffd8bfd00000000aaac

// x^2, the square of the curve seed. Sign is irrelevant here: (-|x|)^2 = |x|^2.
const BLS12_381_SEED_SQ:u384 = 0xac45a4010001a4020000000100000000

// Prime-order subgroup membership, required by PAIRING_CHECK (and by G1MSM),
// but NOT by G1ADD -- G1's cofactor is not 1, so "on the curve" is strictly
// weaker than "in the subgroup".
//
// Uses the endomorphism identity [x^2] phi(P) == -P rather than the naive
// [r]P == O. r is 255 bits and x^2 is 128, so this halves the ladder.
//
// The comparison is done PROJECTIVELY, cross-multiplying by Z instead of
// converting the ladder output to affine. That trades one invmod_384 -- a
// Fermat exponentiation, ~613 mulmod_384 on its own -- for two mulmods.
//
// Unlike G2, there is no free ride available here: the Miller loop accumulates
// multiples of Q, never of P, so this ladder cannot be shared with anything.
// (For G2 the pairing skips the equivalent function entirely -- see
// t_matches_psi_bls12_381 in pairing.zkc.)
//
// PRECONDITION: the caller has already established that (x, y) is on the curve.
// This predicate only tests subgroup membership.
fn is_in_subgroup_affine_bls12_381_g1(x:u384, y:u384) -> (res:u1) {
    res = 0
    if is_infinity_affine_bls12_381_g1(x, y) == 1 {
        // the identity is in every subgroup
        res = 1
        return
    }

    // phi(P) = (beta*x, y)
    var px:u384 = mulmod_384(BLS12_381_BETA, x, BLS12_381_P)

    var RX:u384, RY:u384, RZ:u384
    RX, RY, RZ = sw_scalar_mul_projective_384(BLS12_381_SEED_SQ, px, y, 1,
    BLS12_381_P, BLS12_381_B3)

    // P is finite and of order > 1 here, so -P is finite: an infinite [x^2]phi(P)
    // cannot match it.
    if RZ == 0 {
        return
    }

    // (RX : RY : RZ) == (x, -y)  <=>  RX == x*RZ  and  RY == -y*RZ
    var ny:u384 = submod_384(0, y, BLS12_381_P)
    var ex:u384 = mulmod_384(x, RZ, BLS12_381_P)
    var ey:u384 = mulmod_384(ny, RZ, BLS12_381_P)
    if (RX == ex) && (RY == ey) {
        res = 1
    }
}
