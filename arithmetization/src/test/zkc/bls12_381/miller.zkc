// ===================================================================
// Unit test for the BLS12-381 Miller loop
// (arithmetization/src/main/lib/bls12_381/pairing.zkc).
//
// Expected values come from a from-scratch Python reference that was
// itself validated by full bilinearity -- e(aP,bQ) == e(P,Q)^(ab) for
// several a,b -- after the final exponentiation. That check is what
// pins the line placement: the WRONG (D-twist) placement still satisfied
// both non-degeneracy and e^r == 1, and only bilinearity rejected it.
//
// The Miller output on its own is not a pairing value, so it has no
// intrinsic algebraic property to test against here; these fixtures are
// exact cell-by-cell comparisons against that reference. Once the final
// exponentiation lands, the bilinearity identities become testable
// directly in zkc and should be added.
//
// This is the most expensive harness in the tree: 63 iterations, each an
// Fp12 squaring plus a sparse line multiply plus a doubling step.
// ===================================================================

include "../../../main/lib/bls12_381/pairing.zkc"

pub input px(address:u1) -> (v:u384)
pub input py(address:u1) -> (v:u384)
pub input qx0(address:u1) -> (v:u384)
pub input qx1(address:u1) -> (v:u384)
pub input qy0(address:u1) -> (v:u384)
pub input qy1(address:u1) -> (v:u384)

pub input want(address:u4) -> (v:u384)

const OUT:u12 = 0

fn main<bls_fp12_mem>() {
    miller_loop_bls12_381(px[0], py[0], qx0[0], qx1[0], qy0[0], qy1[0], OUT)

    for i:u5 = 0; i < 12; i = i + 1 {
        if bls_fp12_mem[OUT + (i as u12)] != want[i as u4] {
            fail
        }
    }
}
