
# Benchmark fixtures are DERIVED from ~/linea-blob-corpus, which deliberately
# lives outside the repo: the methodology belongs on the branch, the raw data
# does not. These are regenerated by docs/blob-compression/dictionary_vs_window.py
# (--cycles), which also records the era and chunk they came from in
# fixture_params.zig. A missing fixture is a clean @embedFile compile error,
# which is preferable to building a benchmark against stale or absent input.
bench_zstd_c/prefix.bin
bench_zstd_c/zstd_compressed.bin
bench_zstd_c/fixture_params.zig

# Transient per-config copies made by the --cycles sweep for parallel runs.
.par-*
