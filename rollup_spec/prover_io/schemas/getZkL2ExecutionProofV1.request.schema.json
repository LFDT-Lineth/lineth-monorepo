{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linea.build/schemas/getZkL2ExecutionProofV1.request.schema.json",
  "title": "getZkL2ExecutionProof V1 request",
  "description": "Coordinator -> prover l2-execution proof request. The shared, versioned contract for the l2-execution guest input (L2ExecutionProofPrivateInput). Each payload carries a SSZ-decoded `statelessInput` mirroring the `StatelessInput` (newPayloadRequest + executionWitness + chainConfig + publicKeys).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "guestProgramId",
    "proofRequest"
  ],
  "properties": {
    "guestProgramId": { "$ref": "#/$defs/hash32" },
    "proofRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chainConfig", "parentFtxRollingHash", "parentLastProcessedFtxNumber", "payloads"],
      "properties": {
        "chainConfig": {
          "type": "object",
          "additionalProperties": false,
          "required": ["l2MessageServiceAddress", "coinbase", "chainId"],
          "properties": {
            "l2MessageServiceAddress": { "$ref": "#/$defs/address" },
            "coinbase": { "$ref": "#/$defs/address" },
            "chainId": { "$ref": "#/$defs/uint" }
          }
        },
        "parentFtxRollingHash": { "$ref": "#/$defs/hash32" },
        "parentLastProcessedFtxNumber": { "$ref": "#/$defs/uint" },
        "payloads": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/payload" }
        }
      }
    }
  },
  "$defs": {
    "uint": { "type": "integer", "minimum": 0 },
    "hex": {
      "description": "0x-prefixed, even-length (whole-byte) hex string.",
      "type": "string",
      "pattern": "^0x([0-9a-fA-F]{2})*$"
    },
    "bytes": {
      "description": "0x-prefixed hex byte blob of any length (empty allowed).",
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]*$"
    },
    "quantity": {
      "description": "0x-prefixed hex quantity with at least one digit (e.g. baseFeePerGas).",
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]+$"
    },
    "hash32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "acceptance": {
      "type": "string",
      "enum": [
        "INCLUDED",
        "BAD_NONCE",
        "BAD_BALANCE",
        "FILTERED_ADDRESS_FROM",
        "FILTERED_ADDRESS_TO"
      ]
    },
    "withdrawal": {
      "description": "Mirrors SSZ SszWithdrawal (CL Capella withdrawal).",
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "validatorIndex", "address", "amount"],
      "properties": {
        "index": { "$ref": "#/$defs/uint" },
        "validatorIndex": { "$ref": "#/$defs/uint" },
        "address": { "$ref": "#/$defs/address" },
        "amount": { "$ref": "#/$defs/uint" }
      }
    },
    "executionPayload": {
      "description": "Mirrors SSZ SszExecutionPayload.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parentHash",
        "feeRecipient",
        "stateRoot",
        "receiptsRoot",
        "logsBloom",
        "prevRandao",
        "blockNumber",
        "gasLimit",
        "gasUsed",
        "timestamp",
        "extraData",
        "baseFeePerGas",
        "blockHash",
        "transactions",
        "withdrawals",
        "blobGasUsed",
        "excessBlobGas",
        "blockAccessList"
      ],
      "properties": {
        "parentHash": { "$ref": "#/$defs/hash32" },
        "feeRecipient": { "$ref": "#/$defs/address" },
        "stateRoot": { "$ref": "#/$defs/hash32" },
        "receiptsRoot": { "$ref": "#/$defs/hash32" },
        "logsBloom": { "$ref": "#/$defs/bytes" },
        "prevRandao": { "$ref": "#/$defs/hash32" },
        "blockNumber": { "$ref": "#/$defs/uint" },
        "gasLimit": { "$ref": "#/$defs/uint" },
        "gasUsed": { "$ref": "#/$defs/uint" },
        "timestamp": { "$ref": "#/$defs/uint" },
        "extraData": { "$ref": "#/$defs/bytes" },
        "baseFeePerGas": { "$ref": "#/$defs/quantity" },
        "blockHash": { "$ref": "#/$defs/hash32" },
        "transactions": { "type": "array", "items": { "$ref": "#/$defs/bytes" } },
        "withdrawals": { "type": "array", "items": { "$ref": "#/$defs/withdrawal" } },
        "blobGasUsed": { "$ref": "#/$defs/uint" },
        "excessBlobGas": { "$ref": "#/$defs/uint" },
        "blockAccessList": { "$ref": "#/$defs/bytes" }
      }
    },
    "executionRequests": {
      "description": "EIP-7685 typed execution requests, grouped by kind.",
      "type": "object",
      "additionalProperties": false,
      "required": ["deposits", "withdrawals", "consolidations"],
      "properties": {
        "deposits": { "type": "array", "items": { "$ref": "#/$defs/bytes" } },
        "withdrawals": { "type": "array", "items": { "$ref": "#/$defs/bytes" } },
        "consolidations": { "type": "array", "items": { "$ref": "#/$defs/bytes" } }
      }
    },
    "newPayloadRequest": {
      "description": "Mirrors SSZ SszNewPayloadRequest.",
      "type": "object",
      "additionalProperties": false,
      "required": ["executionPayload", "versionedHashes", "parentBeaconBlockRoot", "executionRequests"],
      "properties": {
        "executionPayload": { "$ref": "#/$defs/executionPayload" },
        "versionedHashes": { "type": "array", "items": { "$ref": "#/$defs/hash32" } },
        "parentBeaconBlockRoot": { "$ref": "#/$defs/hash32" },
        "executionRequests": { "$ref": "#/$defs/executionRequests" }
      }
    },
    "executionWitness": {
      "description": "Mirrors SSZ SszExecutionWitness (state / codes / headers node lists).",
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "codes", "headers"],
      "properties": {
        "state": { "type": "array", "items": { "$ref": "#/$defs/bytes" } },
        "codes": { "type": "array", "items": { "$ref": "#/$defs/bytes" } },
        "headers": { "type": "array", "items": { "$ref": "#/$defs/bytes" } }
      }
    },
    "statelessChainConfig": {
      "description": "Chain config carried inside the stateless input (SSZ SszChainConfig holds chainId; forkName is a JSON-only mirror).",
      "type": "object",
      "additionalProperties": false,
      "required": ["chainId"],
      "properties": {
        "chainId": { "$ref": "#/$defs/uint" },
        "forkName": { "type": "string" }
      }
    },
    "statelessInput": {
      "description": "Mirrors SSZ SszStatelessInput.",
      "type": "object",
      "additionalProperties": false,
      "required": ["newPayloadRequest", "executionWitness", "chainConfig", "publicKeys"],
      "properties": {
        "newPayloadRequest": { "$ref": "#/$defs/newPayloadRequest" },
        "executionWitness": { "$ref": "#/$defs/executionWitness" },
        "chainConfig": { "$ref": "#/$defs/statelessChainConfig" },
        "publicKeys": { "type": "array", "items": { "$ref": "#/$defs/bytes" } }
      }
    },
    "forcedTransaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "deadline", "signedTxRlp", "acceptance"],
      "properties": {
        "number": { "$ref": "#/$defs/uint" },
        "deadline": { "$ref": "#/$defs/uint" },
        "signedTxRlp": { "$ref": "#/$defs/hex" },
        "acceptance": { "$ref": "#/$defs/acceptance" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statelessInput", "rollupExtension"],
      "properties": {
        "statelessInput": { "$ref": "#/$defs/statelessInput" },
        "rollupExtension": {
          "type": "object",
          "additionalProperties": false,
          "required": ["forcedTransactions"],
          "properties": {
            "forcedTransactions": {
              "type": "array",
              "items": { "$ref": "#/$defs/forcedTransaction" }
            }
          }
        }
      }
    }
  }
}
