{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linea.build/schemas/getZkRollupProofV1.request.schema.json",
  "title": "getZkRollupProof V1 request",
  "description": "Coordinator -> prover rollup proof request. The shared, versioned contract for the rollup guest input (RollupProofPrivateInput): a {guestProgramId, proofRequest} envelope embedding the l2-execution proofs it recursively verifies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "guestProgramId",
    "proofRequest"
  ],
  "properties": {
    "guestProgramId": { "$ref": "#/$defs/hash32" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "proofRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chainId",
        "conflations",
        "chunks",
        "parentDrh",
        "startOffset",
        "l2ExecutionProofs"
      ],
      "properties": {
        "chainId": { "$ref": "#/$defs/uint" },
        "conflations": {
          "description": "One conflation per l2ExecutionProof, paired 1:1 in order (§2.2, §3.1).",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/conflation" }
        },
        "chunks": {
          "description": "Every chunk this proof touches, in stream order (§3.1, §3.4): each entry is the chunk's L1-anchored KZG versioned hash.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hash32" }
        },
        "opaquePrefixBytes": {
          "description": "Foreign bytes before startOffset in the FIRST touched chunk only (§3.1); empty (0x) or absent otherwise.",
          "$ref": "#/$defs/hex"
        },
        "opaqueSuffixBytes": {
          "description": "Foreign bytes after endOffset in the LAST touched chunk only (§3.1); empty (0x) or absent otherwise.",
          "$ref": "#/$defs/hex"
        },
        "parentDrh": { "$ref": "#/$defs/hash32" },
        "startOffset": {
          "description": "This proof's start position within the first touched chunk (§3.4). 0 means a fresh chunk start; a value in (0, chunkSize) means a mid-chunk start requiring boundaryPrevDrh.",
          "$ref": "#/$defs/uint"
        },
        "boundaryPrevDrh": {
          "description": "Required only when startOffset > 0 (§3.4): the DRH value before the first touched chunk, opening its preimage against parentDrh.",
          "$ref": "#/$defs/hash32"
        },
        "l2ExecutionProofs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/l2ExecutionProof" }
        }
      }
    }
  },
  "$defs": {
    "uint": { "type": "integer", "minimum": 0 },
    "hex": { "type": "string", "pattern": "^0x([0-9a-fA-F]{2})*$" },
    "hash32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "metadata": {
      "description": "Non-contractual, debug/ops-only fields. NOT consumed by the guest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startBlockNumber": { "$ref": "#/$defs/uint" },
        "endBlockNumber": { "$ref": "#/$defs/uint" }
      }
    },
    "conflation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockRlps"],
      "properties": {
        "blockRlps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hex" }
        }
      }
    },
    "l2ExecutionPublicInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parentBlockHash",
        "endBlockHash",
        "endBlockNumber",
        "endBlockTimestamp",
        "l2L1MessagesHash",
        "parentL1L2BridgeRollingHash",
        "parentL1L2BridgeRollingHashMessageNumber",
        "endL1L2BridgeRollingHash",
        "endL1L2BridgeRollingHashMessageNumber",
        "dynamicChainConfigHash",
        "parentFtxRollingHash",
        "parentProcessedFtxNumber",
        "endFtxRollingHash",
        "endProcessedFtxNumber",
        "filteredAddressesHash",
        "txFromsHash"
      ],
      "properties": {
        "parentBlockHash": { "$ref": "#/$defs/hash32" },
        "endBlockHash": { "$ref": "#/$defs/hash32" },
        "endBlockNumber": { "$ref": "#/$defs/uint" },
        "endBlockTimestamp": { "$ref": "#/$defs/uint" },
        "l2L1MessagesHash": { "$ref": "#/$defs/hash32" },
        "parentL1L2BridgeRollingHash": { "$ref": "#/$defs/hash32" },
        "parentL1L2BridgeRollingHashMessageNumber": { "$ref": "#/$defs/uint" },
        "endL1L2BridgeRollingHash": { "$ref": "#/$defs/hash32" },
        "endL1L2BridgeRollingHashMessageNumber": { "$ref": "#/$defs/uint" },
        "dynamicChainConfigHash": { "$ref": "#/$defs/hash32" },
        "parentFtxRollingHash": { "$ref": "#/$defs/hash32" },
        "parentProcessedFtxNumber": { "$ref": "#/$defs/uint" },
        "endFtxRollingHash": { "$ref": "#/$defs/hash32" },
        "endProcessedFtxNumber": { "$ref": "#/$defs/uint" },
        "filteredAddressesHash": { "$ref": "#/$defs/hash32" },
        "txFromsHash": { "$ref": "#/$defs/hash32" }
      }
    },
    "l2ExecutionProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof",
        "startBlockNumber",
        "publicInputs",
        "l2L1Messages",
        "txFroms",
        "filteredAddresses",
        "programVk"
      ],
      "properties": {
        "proof": { "$ref": "#/$defs/hex" },
        "startBlockNumber": { "$ref": "#/$defs/uint" },
        "publicInputs": { "$ref": "#/$defs/l2ExecutionPublicInputs" },
        "l2L1Messages": { "type": "array", "items": { "$ref": "#/$defs/hash32" } },
        "txFroms": { "type": "array", "items": { "$ref": "#/$defs/address" } },
        "filteredAddresses": { "type": "array", "items": { "$ref": "#/$defs/address" } },
        "programVk": { "$ref": "#/$defs/hash32" }
      }
    }
  }
}
