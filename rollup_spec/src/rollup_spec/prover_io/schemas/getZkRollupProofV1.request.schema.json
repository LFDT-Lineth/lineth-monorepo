{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linea.build/schemas/getZkRollupProofV1.request.schema.json",
  "title": "getZkRollupProof V1 request",
  "description": "Coordinator -> prover rollup proof request. The shared, versioned contract for the rollup guest input (RollupProofPrivateInput): a {guestProgramId, provingSystem, proofRequest} envelope embedding the l2-execution proofs it recursively verifies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "guestProgramId",
    "provingSystem",
    "proofRequest"
  ],
  "properties": {
    "guestProgramId": { "$ref": "#/$defs/hash32" },
    "provingSystem": { "type": "string", "minLength": 1 },
    "metadata": { "$ref": "#/$defs/metadata" },
    "proofRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chainId",
        "conflations",
        "chunks",
        "parentDataRollingHash",
        "parentDataTailTake",
        "l2ExecutionProofs"
      ],
      "properties": {
        "chainId": { "$ref": "#/$defs/uint" },
        "conflations": {
          "description": "One conflation per l2ExecutionProof, paired 1:1 in order (§2.2, §3.1).",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/conflation" }
        },
        "chunks": {
          "description": "Every touched chunk in stream order. Each carries its physical DA bytes and L1-anchored binding hash; only blob chunks can be shared at proof boundaries.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["chunkHash", "isCalldata", "blobBytes", "calldataBytes"],
            "additionalProperties": false,
            "allOf": [
              {
                "if": { "properties": { "isCalldata": { "const": true } } },
                "then": { "properties": { "calldataBytes": { "type": "string", "minLength": 4 }, "blobBytes": { "const": "0x" } } },
                "else": { "properties": { "calldataBytes": { "const": "0x" }, "blobBytes": { "$ref": "#/$defs/physicalBlob" } } }
              }
            ],
            "properties": {
              "chunkHash": {
                "description": "The chunk's L1-anchored binding hash: a KZG versioned hash for a blob chunk, keccak256(_compressedData) for a calldata chunk (§3.1).",
                "$ref": "#/$defs/hash32"
              },
              "isCalldata": {
                "description": "Selects the in-guest check: false verifies the physical blob's KZG versioned hash; true verifies keccak256 of exact calldataBytes.",
                "type": "boolean"
              },
              "blobBytes": {
                "description": "Physical EIP-4844 blob (131072 bytes of 4096 field elements), canonically packed; empty 0x for calldata.",
                "$ref": "#/$defs/hex"
              },
              "calldataBytes": {
                "description": "Exact submitted calldata bytes, empty 0x for blobs.",
                "$ref": "#/$defs/hex"
              }
            }
          }
        },
        "parentDataRollingHash": {
          "description": "The dataRollingHash accumulator value this proof starts from, paired with parentDataTailTake (§2.2, §3.1). If parentDataTailTake = 0, this is R_0 (the accumulator before the first touched chunk, folded forward normally from chunk 1). If parentDataTailTake > 0 (mid-chunk start), this is already R_1 (the accumulator after the first touched chunk), whose preimage is opened via boundaryPrevDataRollingHash before folding continues from chunk 2 (if any).",
          "$ref": "#/$defs/hash32"
        },
        "parentDataTailTake": {
          "description": "0 at a chunk boundary; positive N takes exactly the last N bytes of the actual unpacked first blob payload, requires N < its length and boundaryPrevDataRollingHash.",
          "$ref": "#/$defs/tailCount"
        },
        "boundaryPrevDataRollingHash": {
          "description": "Required only when parentDataTailTake > 0 (§3.4): the dataRollingHash value before the first touched chunk, opening its preimage against parentDataRollingHash.",
          "$ref": "#/$defs/hash32"
        },
        "l2ExecutionProofs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/l2ExecutionProof" }
        }
      }
    }
  },
  "$defs": {
    "uint": { "type": "integer", "minimum": 0 },
    "uint64": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
    "tailCount": { "type": "integer", "minimum": 0, "maximum": 130046 },
    "hex": { "type": "string", "pattern": "^0x([0-9a-fA-F]{2})*$" },
    "physicalBlob": { "type": "string", "minLength": 262146, "maxLength": 262146, "pattern": "^0x[0-9a-fA-F]{262144}$" },
    "hash32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "metadata": {
      "description": "Non-contractual, debug/ops-only fields. NOT consumed by the guest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startBlockNumber": { "$ref": "#/$defs/uint" },
        "endBlockNumber": { "$ref": "#/$defs/uint" },
        "startBlockTimestamp": { "$ref": "#/$defs/uint" },
        "endBlockTimestamp": { "$ref": "#/$defs/uint" },
        "transactionsCount": { "$ref": "#/$defs/uint" },
        "totalGasUsed": { "$ref": "#/$defs/uint" }
      }
    },
    "conflation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockRlps"],
      "properties": {
        "blockRlps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hex" }
        }
      }
    },
    "l2ExecutionPublicInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parentBlockHash",
        "endBlockHash",
        "endBlockNumber",
        "endBlockTimestamp",
        "l2L1Messages",
        "parentL1L2BridgeRollingHash",
        "parentL1L2BridgeRollingHashMessageNumber",
        "endL1L2BridgeRollingHash",
        "endL1L2BridgeRollingHashMessageNumber",
        "dynamicChainConfigHash",
        "parentFtxRollingHash",
        "parentFtxNumber",
        "endFtxRollingHash",
        "endProcessedFtxNumber",
        "filteredAddressesHash",
        "txFromsHash",
        "blockCount",
        "l2MessagingBlocksOffsets"
      ],
      "properties": {
        "parentBlockHash": { "$ref": "#/$defs/hash32" },
        "endBlockHash": { "$ref": "#/$defs/hash32" },
        "endBlockNumber": { "$ref": "#/$defs/uint" },
        "endBlockTimestamp": { "$ref": "#/$defs/uint" },
        "l2L1Messages": { "type": "array", "items": { "$ref": "#/$defs/hash32" } },
        "parentL1L2BridgeRollingHash": { "$ref": "#/$defs/hash32" },
        "parentL1L2BridgeRollingHashMessageNumber": { "$ref": "#/$defs/uint" },
        "endL1L2BridgeRollingHash": { "$ref": "#/$defs/hash32" },
        "endL1L2BridgeRollingHashMessageNumber": { "$ref": "#/$defs/uint" },
        "dynamicChainConfigHash": { "$ref": "#/$defs/hash32" },
        "parentFtxRollingHash": { "$ref": "#/$defs/hash32" },
        "parentFtxNumber": { "$ref": "#/$defs/uint" },
        "endFtxRollingHash": { "$ref": "#/$defs/hash32" },
        "endProcessedFtxNumber": { "$ref": "#/$defs/uint" },
        "filteredAddressesHash": { "$ref": "#/$defs/hash32" },
        "txFromsHash": { "$ref": "#/$defs/hash32" },
        "blockCount": { "$ref": "#/$defs/uint" },
        "l2MessagingBlocksOffsets": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } }
      }
    },
    "l2ExecutionProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof",
        "startBlockNumber",
        "publicInputs",
        "filteredAddresses",
        "programVk"
      ],
      "properties": {
        "proof": { "$ref": "#/$defs/hex" },
        "startBlockNumber": { "$ref": "#/$defs/uint" },
        "publicInputs": { "$ref": "#/$defs/l2ExecutionPublicInputs" },
        "filteredAddresses": { "type": "array", "items": { "$ref": "#/$defs/address" } },
        "programVk": { "$ref": "#/$defs/hash32" }
      }
    }
  }
}
