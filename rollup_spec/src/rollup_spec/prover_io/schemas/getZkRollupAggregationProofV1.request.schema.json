{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linea.build/schemas/getZkRollupAggregationProofV1.request.schema.json",
  "title": "getZkRollupAggregationProof V1 request",
  "description": "Coordinator -> prover rollup-aggregation proof request. The shared, versioned contract for the rollup-aggregation guest input (RollupAggregationProofPrivateInput): a {guestProgramId, provingSystem, proofRequest} envelope embedding the rollup proofs it recursively verifies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "guestProgramId",
    "provingSystem",
    "proofRequest"
  ],
  "properties": {
    "guestProgramId": { "$ref": "#/$defs/hash32" },
    "provingSystem": { "type": "string", "minLength": 1 },
    "metadata": { "$ref": "#/$defs/metadata" },
    "proofRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rollupProofs"],
      "properties": {
        "rollupProofs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rollupProof" }
        }
      }
    }
  },
  "$defs": {
    "uint": { "type": "integer", "minimum": 0 },
    "hex": { "type": "string", "pattern": "^0x([0-9a-fA-F]{2})*$" },
    "hash32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "metadata": {
      "description": "Non-contractual, debug/ops-only fields. NOT consumed by the guest",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startBlockNumber": { "$ref": "#/$defs/uint" },
        "endBlockNumber": { "$ref": "#/$defs/uint" },
        "startBlockTimestamp": { "$ref": "#/$defs/uint" },
        "endBlockTimestamp": { "$ref": "#/$defs/uint" },
        "transactionsCount": { "$ref": "#/$defs/uint" },
        "totalGasUsed": { "$ref": "#/$defs/uint" }
      }
    },
    "rollupProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof",
        "startBlockNumber",
        "guestOutput",
        "programVk"
      ],
      "properties": {
        "proof": { "$ref": "#/$defs/hex" },
        "startBlockNumber": { "$ref": "#/$defs/uint" },
        "guestOutput": {
          "description": "The rollup guest output, as in the getZkRollupProofV1 response.",
          "$ref": "#/$defs/hex"
        },
        "programVk": { "$ref": "#/$defs/hash32" }
      }
    }
  }
}
