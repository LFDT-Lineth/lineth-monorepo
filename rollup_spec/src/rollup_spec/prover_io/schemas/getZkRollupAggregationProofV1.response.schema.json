{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linea.build/schemas/getZkRollupAggregationProofV1.response.schema.json",
  "title": "getZkRollupAggregationProof V1 response",
  "description": "Prover -> coordinator rollup-aggregation proof response (the final proof). The shared, versioned contract for the rollup-aggregation guest output (a FinalizationSubmission) and the coordinator's Jackson mapper. The public inputs carry L2-to-L1 roots and filtered addresses; l2MessagingBlocksOffsets remains top-level calldata metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proverVersion",
    "proof",
    "startBlockNumber",
    "publicInputs",
    "l2MessagingBlocksOffsets"
  ],
  "properties": {
    "proverVersion": { "type": "string" },
    "proof": { "$ref": "#/$defs/hex" },
    "startBlockNumber": { "$ref": "#/$defs/uint" },
    "publicInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endBlockNumber",
        "endBlockTimestamp",
        "parentL1L2BridgeRollingHash",
        "parentL1L2BridgeRollingHashMessageNumber",
        "endL1L2BridgeRollingHash",
        "endL1L2BridgeRollingHashMessageNumber",
        "dynamicChainConfigHash",
        "parentFtxRollingHash",
        "parentFtxNumber",
        "endFtxRollingHash",
        "endProcessedFtxNumber",
        "parentDataRollingHash",
        "endDataRollingHash",
        "parentBlockHash",
        "endBlockHash",
        "startOffset",
        "endOffset",
        "l2L1Roots",
        "filteredAddresses",
        "programVks"
      ],
      "properties": {
        "endBlockNumber": { "$ref": "#/$defs/uint" },
        "endBlockTimestamp": { "$ref": "#/$defs/uint" },
        "parentL1L2BridgeRollingHash": { "$ref": "#/$defs/hash32" },
        "parentL1L2BridgeRollingHashMessageNumber": { "$ref": "#/$defs/uint" },
        "endL1L2BridgeRollingHash": { "$ref": "#/$defs/hash32" },
        "endL1L2BridgeRollingHashMessageNumber": { "$ref": "#/$defs/uint" },
        "dynamicChainConfigHash": { "$ref": "#/$defs/hash32" },
        "parentFtxRollingHash": { "$ref": "#/$defs/hash32" },
        "parentFtxNumber": { "$ref": "#/$defs/uint" },
        "endFtxRollingHash": { "$ref": "#/$defs/hash32" },
        "endProcessedFtxNumber": { "$ref": "#/$defs/uint" },
        "parentDataRollingHash": { "$ref": "#/$defs/hash32" },
        "endDataRollingHash": { "$ref": "#/$defs/hash32" },
        "parentBlockHash": { "$ref": "#/$defs/hash32" },
        "endBlockHash": { "$ref": "#/$defs/hash32" },
        "startOffset": {
          "description": "Canonical start position: 0 at a fully consumed chunk boundary, positive only inside a shared blob (§3.1).",
          "$ref": "#/$defs/offset"
        },
        "endOffset": {
          "description": "Canonical end position: 0 after fully consuming a calldata or blob chunk, positive only inside a shared terminal blob (§3.1).",
          "$ref": "#/$defs/offset"
        },
        "l2L1Roots": {
          "type": "array",
          "items": { "$ref": "#/$defs/hash32" }
        },
        "filteredAddresses": {
          "type": "array",
          "items": { "$ref": "#/$defs/address" }
        },
        "programVks": {
          "description": "Distinct, sorted ascending by byte value: the canonical encoding of the set of guest program VKs verified beneath this proof (order carries no meaning).",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hash32" }
        }
      }
    },
    "l2MessagingBlocksOffsets": {
      "type": "array",
      "items": { "$ref": "#/$defs/uint" }
    }
  },
  "$defs": {
    "uint": { "type": "integer", "minimum": 0 },
    "offset": { "type": "integer", "minimum": 0, "maximum": 131071 },
    "hex": { "type": "string", "pattern": "^0x([0-9a-fA-F]{2})*$" },
    "hash32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
  }
}
