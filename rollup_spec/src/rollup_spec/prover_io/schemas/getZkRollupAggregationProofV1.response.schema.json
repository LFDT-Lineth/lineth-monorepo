{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linea.build/schemas/getZkRollupAggregationProofV1.response.schema.json",
  "title": "getZkRollupAggregationProof V1 response",
  "description": "Prover -> coordinator rollup-aggregation proof response (the final proof). The shared, versioned contract for the rollup-aggregation guest output (a FinalizationSubmission) and the coordinator's Jackson mapper. The public inputs carry L2-to-L1 roots, filtered addresses, and verified l2MessagingBlocksOffsets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proverVersion",
    "proof",
    "startBlockNumber",
    "publicInputs"
  ],
  "properties": {
    "proverVersion": { "type": "string" },
    "proof": { "$ref": "#/$defs/hex" },
    "startBlockNumber": { "$ref": "#/$defs/uint" },
    "publicInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endBlockNumber",
        "endBlockTimestamp",
        "parentL1L2BridgeRollingHash",
        "parentL1L2BridgeRollingHashMessageNumber",
        "endL1L2BridgeRollingHash",
        "endL1L2BridgeRollingHashMessageNumber",
        "dynamicChainConfigHash",
        "parentFtxRollingHash",
        "parentFtxNumber",
        "endFtxRollingHash",
        "endProcessedFtxNumber",
        "parentDataRollingHash",
        "endDataRollingHash",
        "parentBlockHash",
        "endBlockHash",
        "parentDataTailTakeBytes",
        "finalDataTailDiscardBytes",
        "l2L1Roots",
        "l2L1TreeDepth",
        "filteredAddresses",
        "programIds",
        "l2MessagingBlocksOffsets"
      ],
      "properties": {
        "endBlockNumber": { "$ref": "#/$defs/uint" },
        "endBlockTimestamp": { "$ref": "#/$defs/uint" },
        "parentL1L2BridgeRollingHash": { "$ref": "#/$defs/hash32" },
        "parentL1L2BridgeRollingHashMessageNumber": { "$ref": "#/$defs/uint" },
        "endL1L2BridgeRollingHash": { "$ref": "#/$defs/hash32" },
        "endL1L2BridgeRollingHashMessageNumber": { "$ref": "#/$defs/uint" },
        "dynamicChainConfigHash": { "$ref": "#/$defs/hash32" },
        "parentFtxRollingHash": { "$ref": "#/$defs/hash32" },
        "parentFtxNumber": { "$ref": "#/$defs/uint" },
        "endFtxRollingHash": { "$ref": "#/$defs/hash32" },
        "endProcessedFtxNumber": { "$ref": "#/$defs/uint" },
        "parentDataRollingHash": { "$ref": "#/$defs/hash32" },
        "endDataRollingHash": { "$ref": "#/$defs/hash32" },
        "parentBlockHash": { "$ref": "#/$defs/hash32" },
        "endBlockHash": { "$ref": "#/$defs/hash32" },
        "parentDataTailTakeBytes": {
          "description": "0 at a chunk boundary; positive N takes the final N bytes of the actual unpacked first blob payload, requiring N < its length (§3.1).",
          "$ref": "#/$defs/tailCount"
        },
        "finalDataTailDiscardBytes": {
          "description": "Guest-derived unconsumed suffix byte count of the last blob payload: 0 at a fully consumed chunk boundary; positive N requires N < the actual unpacked last blob payload length (§3.1).",
          "$ref": "#/$defs/tailCount"
        },
        "l2L1TreeDepth": {
          "description": "Guest-proven depth of each L2-to-L1 message tree; the guest implementation chooses the depth.",
          "type": "integer", "minimum": 1, "maximum": 18446744073709551615
        },
        "l2L1Roots": {
          "type": "array",
          "items": { "$ref": "#/$defs/hash32" }
        },
        "filteredAddresses": {
          "description": "Distinct, sorted ascending by byte value: the canonical encoding of the set of addresses named by forced transactions refused in this range (order carries no meaning).",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/address" }
        },
        "programIds": {
          "description": "Distinct, sorted ascending by byte value: the canonical encoding of the set of guest program IDs approved by L1 (order carries no meaning).",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hash32" }
        },
        "l2MessagingBlocksOffsets": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } }
      }
    }
  },
  "$defs": {
    "uint": { "type": "integer", "minimum": 0 },
    "tailCount": { "type": "integer", "minimum": 0, "maximum": 130046 },
    "hex": { "type": "string", "pattern": "^0x([0-9a-fA-F]{2})*$" },
    "hash32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
  }
}
