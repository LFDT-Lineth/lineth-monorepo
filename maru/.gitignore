# Maru-specific ignores. Generic Gradle/IDE rules live in the monorepo root .gitignore.

# JVM artifacts not covered by the root .gitignore
*.class
*.hprof
hs_err_pid*
replay_pid*

# Local config overrides
*.local.toml

# Generated files
docker/initialization/*.json

# Ignore .cursor config but commit shared team rules (BUGBOT.md, rules/).
.cursor/*
!.cursor/BUGBOT.md
!.cursor/rules/
