type tAddr = u8

// Unlike a mulmod that fails on a zero modulus, this native function accepts
// it: a call with modL == 0 is traced as quotient = 0, remainder = lhsL * rhsL.
// This lets the test feed a zero-modulus call to the prover instead of having
// zkc stop it at tracing time.
//
// zkc only exports the inputs and outputs of a #[native] function, and the
// driver finds the quotient column by name, so quotient is a second output.
#[native]
fn mulmod_64(lhsL:u64, rhsL:u64, modL:u64) -> (remainder:u64, quotient:u64) {
    var product:u128 = (lhsL as u128) * (rhsL as u128)
    var overflow:u64
    if modL == 0 {
        quotient = 0
        remainder = (product as u64)
    } else {
        overflow::quotient = product / (modL as u128)
        var overflow2:u64
        overflow2::remainder = product - ((quotient as u128) * (modL as u128))
    }
}

pub input in_lhs(address:tAddr) -> (val:u64)
pub input in_rhs(address:tAddr) -> (val:u64)
pub input in_mod(address:tAddr) -> (val:u64)

fn main() {
    var lhs:u64 = in_lhs[0]
    var rhs:u64 = in_rhs[0]
    var mod:u64 = in_mod[0]
    var res:u64
    var quo:u64
    res, quo = mulmod_64(lhs, rhs, mod)
}
