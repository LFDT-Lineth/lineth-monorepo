// Fibonacci(100) computed entirely with fixed, in-program constants: no
// `pub input` table is declared, so this program has no lookup-backed
// "memory" at all. Fib(100) mod 2^32 is checked against a hardcoded constant
// (u32 addition wraps mod 2^32).
fn main() {
    var a:u32, b:u32, t:u32
    var i:u16

    a = 0
    b = 1
    i = 0

    while i != 100 {
        t = ((a as u64 + b as u64) & 0xffffffff) as u32
        a = b
        b = t
        i = i + 1
    }

    if a != 3314859971 {
        fail
    }
}
