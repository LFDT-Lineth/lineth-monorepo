include "./nonnative_utils.zkc"

type tAddr       = u8
type tCarry      = u8

const p:tWidth = 0xfffffffffffffffffffffffffffffffffffffffffffffffffffffffefffffc2f
pub input in_x1(address:tAddr) -> (val:tWidth)
pub input in_y1(address:tAddr) -> (val:tWidth)
pub input in_x2(address:tAddr) -> (val:tWidth)
pub input in_y2(address:tAddr) -> (val:tWidth)
pub input in_x3(address:tAddr) -> (val:tWidth)
pub input in_y3(address:tAddr) -> (val:tWidth)


fn main() {

    var x1:tWidth = in_x1[0]
    var y1:tWidth = in_y1[0]
    var x2:tWidth = in_x2[0]
    var y2:tWidth = in_y2[0]
    var x3:tWidth = in_x3[0]
    var y3:tWidth = in_y3[0]

    // Check P1, P2, and P3 are on y^2 = x^3 + 7 over Fp.
    assert_on_curve_secp256k1(x1, y1)
    assert_on_curve_secp256k1(x2, y2)
    assert_on_curve_secp256k1(x3, y3)

    // apply ec_add for secp256k1
    var x3_:tWidth, y3_:tWidth
    x3_, y3_ = ec_add_secp256k1(x1, y1, x2, y2)

    // validate the result
    if (x3 != x3_) || (y3 != y3_) {
        fail
    }
    
}

// fails if (x, y) is not a finite point on y^2 = x^3 + 7 over Fp
fn assert_on_curve_secp256k1(x:tWidth, y:tWidth) {
    var y2:tWidth = mulmod_256(y, y, p)
    var x2:tWidth = mulmod_256(x, x, p)
    var x3:tWidth = mulmod_256(x2, x, p)
    var rhs:tWidth = addmod_256(x3, 7, p)
    if rhs != y2 {
        fail
    }
}

// complete finite-point addition for secp256k1 (infinity case not yet handled)
fn ec_add_secp256k1(x1:tWidth, y1:tWidth, x2:tWidth, y2:tWidth) -> (x3:tWidth, y3:tWidth) {
    if x1 != x2 {
        // --- Distinct finite-point addition ---
        // lambda = (y2 - y1) * inv(x2 - x1)
        var dy:tWidth = submod_256(y2, y1, p)
        var dx:tWidth = submod_256(x2, x1, p)
        var inv_dx:tWidth = invmod_256(dx, p)
        var lambda:tWidth = mulmod_256(dy, inv_dx, p)

        // x3 = lambda^2 - x1 - x2
        var lambda2:tWidth = mulmod_256(lambda, lambda, p)
        var lambda2_minus_x1:tWidth = submod_256(lambda2, x1, p)
        x3 = submod_256(lambda2_minus_x1, x2, p)

        // y3 = lambda * (x1 - x3) - y1
        var x1_minus_x3:tWidth = submod_256(x1, x3, p)
        var lambda_x1_x3:tWidth = mulmod_256(lambda, x1_minus_x3, p)
        y3 = submod_256(lambda_x1_x3, y1, p)
    } else {
        // x1 == x2: inverse or doubling
        var neg_y1:tWidth = submod_256(0, y1, p)
        if y2 == neg_y1 {
            // --- Inverse / vertical case: P + (-P) = O (includes y1 = 0) ---
            // Infinity not yet represented; return (0, 0) as sentinel
            x3 = 0
            y3 = 0
        } else {
            // --- Doubling case: x1 = x2, y1 = y2, y1 != 0 ---
            // lambda = 3*x1^2 / (2*y1)
            var x1sq:tWidth = mulmod_256(x1, x1, p)
            var num:tWidth = mulmod_256(3, x1sq, p)
            var den:tWidth = mulmod_256(2, y1, p)
            var inv_den:tWidth = invmod_256(den, p)
            var lambda_:tWidth = mulmod_256(num, inv_den, p)

            // x3 = lambda^2 - 2*x1
            var lambda2_:tWidth = mulmod_256(lambda_, lambda_, p)
            var two_x1:tWidth = mulmod_256(2, x1, p)
            x3 = submod_256(lambda2_, two_x1, p)

            // y3 = lambda * (x1 - x3) - y1
            var x1_minus_x3_:tWidth = submod_256(x1, x3, p)
            var lambda_x1_x3_:tWidth = mulmod_256(lambda_, x1_minus_x3_, p)
            y3 = submod_256(lambda_x1_x3_, y1, p)
        }
    }
}