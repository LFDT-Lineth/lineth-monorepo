type tWidth      = u256
type tWidthLarge = u512

#[native]
fn mulmod_256(lhsL:tWidth, rhsL:tWidth, modL:tWidth) -> (remainder:tWidth) {
    // integer product result `product = lhsL * rhsL`
    var product:tWidthLarge = (lhsL as tWidthLarge) * (rhsL as tWidthLarge)

    var overflow:tWidth
    var quotient:tWidth
    overflow::quotient = product / (modL as tWidthLarge)
    if overflow != 0 {
        fail
    }
    var overflow2:tWidth
    // XXX(ivo): two ways of computing the remainder. First one is approx 20% faster
    overflow2::remainder = product - ((quotient as tWidthLarge) * (modL as tWidthLarge))
    //overflow2::remainder = product % (modL as tWidthLarge)
    if overflow2 != 0 {
        fail
    }
}

// Returns the canonical representative of `val` in [0, modL), i.e. val mod modL.
// Callers that branch on raw (unreduced) equality/inequality of field elements
// must reduce their inputs through this first, otherwise non-canonical encodings
// (e.g. val = x + modL) alias the same residue while comparing as distinct u256
// values. Implemented as addmod with 0, which reduces its inputs.
fn reduce_256(val:tWidth, modL:tWidth) -> (remainder:tWidth) {
    var zero:tWidth = 0
    remainder = addmod_256(val, zero, modL)
}

//#[native] <- to be implemented as native if expensive
fn addmod_256(lhsL:tWidth, rhsL:tWidth, modL:tWidth) -> (remainder:tWidth) {
    if modL == 0 {
        fail
    }

    var add:tWidthLarge = (lhsL as tWidthLarge) + (rhsL as tWidthLarge)
    var quotient:tWidthLarge = add / (modL as tWidthLarge)
    var remainderLarge:tWidthLarge = add - (quotient * (modL as tWidthLarge))

    var overflow:tWidth
    overflow::remainder = remainderLarge
    if overflow != 0 {
        fail
    }
}


fn submod_256(lhsL:tWidth, rhsL:tWidth, modL:tWidth) -> (remainder:tWidth) {
    if modL == 0 {
        fail
    }

    // Standalone-safe version:
    //   lhs - rhs mod modL
    // = lhs + (modL - (rhs mod modL)) mod modL
    //
    // Reducing rhs first avoids underflow in `modL - rhs` when callers pass a
    // non-canonical rhs. If callers already guarantee rhsL < modL, this can be
    // optimized to `addmod_256(lhsL, modL - rhsL, modL)`.
    var zero:tWidth = 0
    var rhsReduced:tWidth = addmod_256(rhsL, zero, modL)
    var negRhs:tWidth = modL - rhsReduced
    remainder = addmod_256(lhsL, negRhs, modL)
}



fn invmod_256(inp:tWidth, modL:tWidth) -> (inv:tWidth) {
    if modL == 0 {
        fail
    }
    if inp == 0 {
        fail
    }
    if inp == 1 {
        inv = 1
        return
    }

    // Fermat's little theorem: inp^(modL-2) mod modL = inp^(-1) mod modL
    // Uses square-and-multiply over the 256 bits of the exponent.
    var exp:tWidth = modL - 2
    var base:tWidth = inp
    inv = 1

    for i:u64 = 0; i < (256 as u64); i = i+1 {
        if (exp & 1) == 1 {
            inv = mulmod_256(inv, base, modL)
        }
        base = mulmod_256(base, base, modL)
        exp = exp >> 1
    }
}
