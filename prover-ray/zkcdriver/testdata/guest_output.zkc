pub input data(address:u8) -> (byte:u8)
pub output guest_output(address:u8) -> (byte:u8)

// Copy four input bytes into a public write-once output memory, at consecutive
// addresses starting at zero. The memory is named and shaped like the RISC-V
// interpreter's guest_output, so the public-input binding can be tested without
// compiling the whole interpreter.
fn main() {
    guest_output[0] = data[0]
    guest_output[1] = data[1]
    guest_output[2] = data[2]
    guest_output[3] = data[3]
}
