// invariants:
// - 0 < r < n
//    - fail if not satisfied
// - v \in {27, 28}
//    - fail if not satisfied
// - 0 < s < n/2 + 1 (gnark <= n-1/2) (for txn validation, strictRange = 1),
//    - fail if not satisfied
// - 0 < s < n (for precompile, strictRange = 0)
//    - fail if not satisfied
// - residue check (in step 1): if r^3+7 is a QNR (sqrt_secp256k1 is_qr==0)
//    - assign PKX = 0, PKY = 0, return
//
// steps:
// 1. Compute R from r (use curve equation, sqrt function, and parity bit)
// 2. Compute u1 = -r^{-1}*z, u2 = r^{-1}*s
//      - if u1G = -u2R, assign PKX = 0, PKY = 0, return
//      - if u1 = 0 (z being 0), (PKX, PKY) = u2*R
// 3. Compute PKX, PKY = u1*G + u2*R
// 4. Return PKX, PKY (public key, not the not the ecrecover-precompile address)
include ./lib/secp256k1/secp256k1.zkc

