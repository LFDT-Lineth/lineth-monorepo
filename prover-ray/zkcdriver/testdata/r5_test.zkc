type tSegment = u2
type tAddr = u8

// Segment metadata, similar in shape to main.zkc's offset/size tables.
pub input segments(address:tSegment) -> (offset:tAddr, count:tAddr)
// Data rows are tuple-valued so the driver has to materialize more than one
// column per memory access.
pub input values(address:tAddr) -> (lhs:u16, rhs:u16)
// Each row's claimed result is checked inside the worker loop.
pub input expected(address:tAddr) -> (sum:u16)
// Per-segment totals and the final grand total are checked separately.
pub input segment_totals(address:tSegment) -> (sum:u16)
pub input grand_total(address:u1) -> (sum:u16)

fn check_row(i:tAddr) -> (sum:u16) {
    var lhs:u16, rhs:u16
    lhs, rhs = values[i]
    sum = lhs + rhs
    if sum != expected[i] {
        fail
    }
}

fn check_segment(offset:tAddr, count:tAddr) -> (segment_sum:u16) {
    segment_sum = 0
    for j:tAddr = 0; j<count; j = j + 1 {
        segment_sum = segment_sum + check_row(offset + j)
    }
}

fn main() {
    var segments_count:tSegment = 2
    var total:u16 = 0

    for i:tSegment = 0; i<segments_count; i = i + 1 {
        var offset:tAddr, count:tAddr
        offset, count = segments[i]

        var segment_sum:u16 = check_segment(offset, count)
        if segment_sum != segment_totals[i] {
            fail
        }
        total = total + segment_sum
    }

    if total != grand_total[0] {
        fail
    }
}
