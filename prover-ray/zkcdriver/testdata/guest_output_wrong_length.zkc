pub input data(address:u8) -> (byte:u8)
pub output guest_output(address:u8) -> (byte:u8)
pub output guest_output_hash(address:u3) -> (word:u32)

// Same as guest_output_hash.zkc, but one hash word short: it writes seven words
// where the binding expects risc5.NumGuestPublicOutputs = 8, so the last address
// of the memory is 6 instead of 7. This is the shape the length constraint has to
// reject — without it a prover could resize the hash memory and pick which of its
// rows end up as the public inputs.
//
// The mismatch is short rather than long because the address type bounds it: a u3
// address cannot reach a ninth word, so too-few is the only wrong length this
// memory can express.
fn main() {
    guest_output[0] = data[0]
    guest_output[1] = data[1]
    guest_output[2] = data[2]
    guest_output[3] = data[3]
    guest_output[4] = data[4]
    guest_output[5] = data[5]
    guest_output[6] = data[6]
    guest_output[7] = data[7]

    guest_output_hash[0] = 0x00010002
    guest_output_hash[1] = 0x00030004
    guest_output_hash[2] = 0x00050006
    guest_output_hash[3] = 0x00070008
    guest_output_hash[4] = 0x0009000a
    guest_output_hash[5] = 0x000b000c
    guest_output_hash[6] = 0x000d000e
}
