include "./lib/nonnative/u64.zkc"

type tAddr = u8

pub input in_base(address:tAddr) -> (val:u64)
pub input in_exp(address:tAddr) -> (val:u64)
pub input in_mod(address:tAddr) -> (val:u64)
pub input in_res(address:tAddr) -> (val:u64)

fn main() {
    var base:u64 = in_base[0]
    var exp:u64 = in_exp[0]
    var mod:u64 = in_mod[0]
    var expected:u64 = in_res[0]
    var res:u64 = modexp_recursion(base, exp, mod)
    if res != in_res[0] {
        fail
    }
}

// recursive modexp seems to be better than the loop
fn modexp_recursion(base:u64, exp:u64, mod:u64) -> (res:u64) {
    if exp == 0 {
        res = 1 % mod
    } else {
        var half:u64
        var bit:u1
        half::bit = exp as u65
        var half_res:u64 = modexp_recursion(base, half, mod)
        var sq:u64 = mulmod_64(half_res, half_res, mod)
        if bit == 1 {
            res = mulmod_64(sq, base, mod)
        } else {
            res = sq
        }
    }
}

fn modexp_loop(base:u64, exp:u64, mod:u64) -> (res:u64) {
    var acc:u64 = base
    var e:u64 = exp
    var half:u64
    var bit:u1
    res = 1 % mod
    while e != 0 {
        half::bit = e as u65
        if bit == 1 {
            res = mulmod_64(res, acc, mod)
        }
        acc = mulmod_64(acc, acc, mod)
        e = half
    }
}