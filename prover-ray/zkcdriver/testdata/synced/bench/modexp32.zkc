pub input data(address:u32) -> (word:u32)

fn main() {
    var n:u32 = data[0]
    var k:u32 = data[1]
    var m:u32 = data[2]
    var res:u32 = data[3]
    //
    if modexp(n, k, m) != res {
        fail
    }
}

// Compute n^k % m where m > 0.  This is more efficient that doing Pow(n,k) % m.
// In essence, this works by recursive decomposing the work and squaring the
// results.
fn modexp(n:u32, k:u32, m:u32) -> (r:u32) {
    // PRE: m > 0 (division/remainder by zero fails).
    var nm:u32 = n % m
    // Base cases.
    if k == 0 || m == 1 {
        r = 1 % m
    } else if k == 1 {
        r = nm as u32
    } else {
        // Recursive case: np = ModPow(nm, k/2, m).
        var np:u32 = modexp(nm, k / 2, m)
        // Square, reducing mod m.
        var np2:u32 = mulmod(np, np, m)
        //
        if (k % 2) == 0 {
            // Even: n^(2j) = (n^j)^2
            r = np2 as u32
        } else {
            // Odd: n^(2j+1) = (n^j)^2 * n
            r = mulmod(np2, nm, m)
        }
    }
}

fn mulmod(x:u32, y:u32, m:u32) -> (r:u32) {
    var tmp:u64 = ((x as u64) * (y as u64)) % (m as u64)
    //
    r = tmp as u32
}
