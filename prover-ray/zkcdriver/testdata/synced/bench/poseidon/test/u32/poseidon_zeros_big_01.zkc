include "../ram.zkc"
include "../../u32/poseidon.zkc"
include "results.zkc"

// ===================================================================
// poseidon (u32) — big benchmark: hash of 2^14 (zero) field elements
// ===================================================================

const NUMBER_OF_FELTS:u32 = 1 << 14

fn main<ram, poseidon_state>() {

    var message_offset:Address = 0
    var message_size_in_bytes:u32 = NUMBER_OF_FELTS * (BYTES_PER_FELT as u32)

    // ram is empty (all-zero input)
    poseidon(message_offset, message_size_in_bytes, 256, 0)

    for i:u8 = 0; i<STATE_WIDTH; i = i + 1 {
        if results_poseidon_zeros_2_to_the_14(i) != read_from_state(i) {
            printf "\tω[%x] = %x,\tσ[%x] = %x\n", i, results_poseidon_zeros_2_to_the_14(i), i, read_from_state(i)
            fail
        }
    }
}
