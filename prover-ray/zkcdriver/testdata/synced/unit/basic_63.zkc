pub input data(address:u16) -> (byte:u12)
pub output hi(address:u16) -> (byte:u17)
pub output lo(address:u16) -> (byte:u8)

fn main() {
    var a:u55 = data[0] as u55
    var x:u25 = a as u25

    var tmp_hi:u17
    var tmp_lo:u8

    tmp_hi::tmp_lo = x

    // check expected outcome
    hi[0] = tmp_hi
    lo[0] = tmp_lo
    //
    return
}
