pub input data(address:u8) -> (byte:u8)
pub output out(address:u8) -> (byte:u8)

fn main() {
    var x:u8 = data[0]
    var r:u8
    // copy over data
    switch x {
        case 0: {
            printf "x=%d (0)\n", x
            r = 0
        }
        case 1: {
            printf "x=%d (1)\n", x
            r = 1
        }
        default: {
            printf "(default)\n"
            r = 2
        }
    }
    //
    out[0] = r
}
