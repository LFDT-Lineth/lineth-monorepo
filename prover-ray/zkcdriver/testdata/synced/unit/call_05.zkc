pub input data(address:u8) -> (byte:u8)

fn main() {
    var x:u8 = data[0]
    var r:u8 = data[1]

    if x == 0 {
        r = returnZero(x)
    } else {
        if x == 1 {
            r = returnOne(x)
        } else {
            r = returnTwo(x)
        }
    }

    return
}

fn returnZero(x:u8) -> (y:u8) {
    y = 0
    return
}

fn returnOne(x:u8) -> (y:u8) {
    y = 1
    return
}

fn returnTwo(x:u8) -> (y:u8) {
    y = 2
    return
}
