pub input data(address:u8) -> (byte:u8)

fn main() {
    var x:u8 = data[0]
    var y:u8 = data[1]
    x = ((x == 0) || (y == 0)) ? 0:sum(x, y)

    if (x != data[2]) {
        fail
    }
}

fn sum(x:u8, y:u8) -> (r:u8) {
    var xcast:u16 = x as u16
    var ycast:u16 = y as u16
    var tmp:u8
    var tmp_sum:u16 = xcast + ycast
    tmp::r = tmp_sum
    r = tmp == 0 ? r:255
    return
}
