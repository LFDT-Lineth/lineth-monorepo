pub input data(address:u8) -> (byte:u32)
pub output out(address:u8) -> (byte:u32)

fn main() {
    var x:u32 = data[0]
    var r:u32
    // copy over data
    switch x {
        case 0x00000001: {
            r = 1
        }
        case 0x00000010: {
            r = 2
        }
        case 0x00000100: {
            r = 3
        }
        case 0x00001000: {
            r = 4
        }
        case 0x00010000: {
            r = 5
        }
        case 0x00100000: {
            r = 6
        }
        case 0x01000000: {
            r = 7
        }
        case 0x10000000: {
            r = 8
        }
        default: {
            r = 0
        }
    }
    //
    out[0] = r
}
