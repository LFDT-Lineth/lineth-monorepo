pub input data(address:u16) -> (byte:u8)

fn main() {
    var a:u8 = data[0]
    var result:u8 = data[1]

    var b:u8
    b = f(a)
    // modify the call's argument in a skip_if to be sure 
    // the compiler creates a tmp register to hold the argument recall
    if (b != 0) {
        a = a + 1
    }
    if (b != result) {
        fail
    }
}

fn f(x:u8) -> (r:u8) {
    r = x / 2
    return
}

