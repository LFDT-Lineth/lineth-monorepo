// Read-write RAM with u32 data lines: register splitting subdivides the RAM's
// data (and address) registers into limbs.  The program writes two wide values
// into RAM and reads them back (swapped) into the output, so the value-checked
// accepts confirm a split RAM round-trips values correctly.
pub input data(address:u8) -> (word:u32)
pub output out(address:u8) -> (word:u32)
memory ram(address:u32) -> (word:u32)

fn main<ram>() {
    ram[0] = data[0]
    ram[1] = data[1]
    out[0] = ram[1]
    out[1] = ram[0]
}
