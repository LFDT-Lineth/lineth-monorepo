// A static ROM whose data lines (u32) are wider than the register width of the
// smaller test fields, so its constant contents are subdivided into limbs when
// register splitting runs.  The value-checked accepts confirm each row is
// reassembled to its original value.
static tbl(address:u16) -> (word:u32) {
    0x11112222,
    0x33334444,
    0xdeadbeef
}

pub input idx(address:u16) -> (word:u16)
pub output out(address:u16) -> (word:u32)

fn main() {
    var i:u16 = idx[0]
    out[0] = tbl[i]
    return
}
