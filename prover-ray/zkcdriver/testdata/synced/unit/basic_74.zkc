pub input data(address:u16) -> (w:u16)

fn main() {
    var lhs:u16 = data[0]
    var rhs:u16 = data[1]
    var hi:u16 = data[2]
    var lo:u16 = data[3]
    //
    lhs, rhs = mul(lhs, rhs)
    //
    if lhs != hi || rhs != lo {
        fail
    }
}

fn mul(x:u16, y:u16) -> (hi:u16, lo:u16) {
    hi::lo = (x * y) as u32
}
