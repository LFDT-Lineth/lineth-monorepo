pub input data(address:u16) -> (w:u32)

fn main() {
    var lhs:u32 = data[0]
    var rhs:u32 = data[1]
    var res:u32 = data[2]
    var tmp:u16 = f(rhs)
    //
    if g(lhs, tmp) != res {
        fail
    }
}

fn f(x:u32) -> (y:u16) {
    y = (x & 0xffff) as u16
}

fn g(x:u32, y:u16) -> (z:u32) {
    z = x & (y as u32)
}
