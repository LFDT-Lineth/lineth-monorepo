pub input data(address:u8) -> (byte:u8)
pub output result(address:u8) -> (word:u16)

// Check that a subtraction with register and constant subtrahends wraps
// two's-complement (in one step) on underflow.  The result type of
// "x - y - 2" is u10 (one sign bit above the wider side), so an underflow
// wraps modulo 2^10 and the wrapped value is observable through the
// widening cast.
fn main() {
    var x:u8 = data[0]
    var y:u8 = data[1]
    result[0] = (x - y - 2) as u16
    return
}
