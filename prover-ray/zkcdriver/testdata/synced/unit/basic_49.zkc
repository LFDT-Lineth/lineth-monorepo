pub input lhs(address:u16) -> (byte:u32)
pub input rhs(address:u16) -> (byte:u32)
pub output res(address:u16) -> (byte:u32)

// u32 × u32 → u32 product (overflow-checked).  Exercises register splitting for
// multiplication over multi-limb operands: each u32 operand is several limbs,
// so the schoolbook cross-products and column carries are all exercised.
fn main() {
    var lhs:u32 = lhs[0]
    var rhs:u32 = rhs[0]
    res[0] = lhs * rhs
    return
}
