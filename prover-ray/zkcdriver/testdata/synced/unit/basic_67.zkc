pub input data(address:u16) -> (byte:u16)

fn main() {
    var x:u16 = data[0]
    var y:u16 = data[1]

    if f(x) != y {
        fail
    }
}

// f requires more than 256 registers, forcing "wide" bytecode instruction
// forms (i.e. carrying u16 register operands).  The tail exercises a wide
// load-constant, the wide forms of / and %, and a wide conditional branch.
