pub input data(address:u16) -> (val:u64)

// Logically shift a u64 word right by n in [0,63] and check it against the
// expected value.  This is a ZkC port of the assembly utility test
// asm/util/bit_shr (ported from u256 down to u64).
//
// The implementation decomposes the shift amount bit-by-bit, starting from the
// most significant bit, conditionally shifting right by a power of two at each
// level.  A shift right by k discards the low k bits and zero-extends the high
// (64-k) bits via `hi as u64` where `hi::lo = word`.
fn main() {
    var word:u64 = data[0]
    var n:u6 = data[1] as u6
    var expected:u64 = data[2]
    //
    var res:u64
    res = bit_shr64(word, n)
    //
    if res != expected {
        fail
    }
    // native variant
    var res_native:u64
    res_native = bit_shr64_native(word, n)
    if res_native != expected {
        fail
    }
    return
}

fn bit_shr64(word:u64, n:u6) -> (res:u64) {
    var b:u1
    var m:u5
    b::m = n
    if b == 0 {
        res = bit_shr64_u5(word, m)
    } else {
        // shift right by 32
        var hi:u32
        var lo:u32
        hi::lo = word
        res = bit_shr64_u5(hi as u64, m)
    }
    return
}

fn bit_shr64_u5(word:u64, n:u5) -> (res:u64) {
    var b:u1
    var m:u4
    b::m = n
    if b == 0 {
        res = bit_shr64_u4(word, m)
    } else {
        // shift right by 16
        var hi:u48
        var lo:u16
        hi::lo = word
        res = bit_shr64_u4(hi as u64, m)
    }
    return
}

fn bit_shr64_u4(word:u64, n:u4) -> (res:u64) {
    var b:u1
    var m:u3
    b::m = n
    if b == 0 {
        res = bit_shr64_u3(word, m)
    } else {
        // shift right by 8
        var hi:u56
        var lo:u8
        hi::lo = word
        res = bit_shr64_u3(hi as u64, m)
    }
    return
}

fn bit_shr64_u3(word:u64, n:u3) -> (res:u64) {
    var b:u1
    var m:u2
    b::m = n
    if b == 0 {
        res = bit_shr64_u2(word, m)
    } else {
        // shift right by 4
        var hi:u60
        var lo:u4
        hi::lo = word
        res = bit_shr64_u2(hi as u64, m)
    }
    return
}

fn bit_shr64_u2(word:u64, n:u2) -> (res:u64) {
    var b:u1
    var m:u1
    b::m = n
    if b == 0 {
        res = bit_shr64_u1(word, m)
    } else {
        // shift right by 2
        var hi:u62
        var lo:u2
        hi::lo = word
        res = bit_shr64_u1(hi as u64, m)
    }
    return
}

fn bit_shr64_u1(word:u64, n:u1) -> (res:u64) {
    if n == 0 {
        res = word
        return
    }
    // shift right by 1
    var hi:u63
    var lo:u1
    hi::lo = word
    res = hi as u64
    return
}

// Logically shift a u64 word right by n in [0,63] using the native shift
// operator rather than recursive decomposition.
fn bit_shr64_native(word:u64, n:u6) -> (res:u64) {
    res = word >> n
    return
}
