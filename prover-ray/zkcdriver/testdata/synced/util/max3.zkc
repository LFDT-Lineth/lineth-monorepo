pub input data(address:u16) -> (val:u64)

// Determine the maximum of three u64 values and check it against the expected
// value.  This is a ZkC port of the assembly utility test asm/util/max3.  The
// assembly detects the ordering via subtraction borrows; ZkC expresses the
// same comparisons directly.
fn main() {
    var arg1:u64 = data[0]
    var arg2:u64 = data[1]
    var arg3:u64 = data[2]
    var expected:u64 = data[3]
    //
    if max3_u64(arg1, arg2, arg3) != expected {
        fail
    }
    return
}

fn max3_u64(arg1:u64, arg2:u64, arg3:u64) -> (res:u64) {
    if arg1 >= arg2 {
        // arg1 >= arg2
        if arg1 >= arg3 {
            res = arg1
        } else {
            res = arg3
        }
    } else {
        // arg2 > arg1
        if arg2 >= arg3 {
            res = arg2
        } else {
            res = arg3
        }
    }
    return
}
