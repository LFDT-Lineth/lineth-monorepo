pub input data(address:u16) -> (val:u64)

// Find the index (counting from the most significant byte, which is index 0) of
// the first non-zero byte in a u64 word, and check it against the expected
// value.  This is a ZkC port of the assembly utility test asm/util/first_byte
// (ported from u256 down to u64).
//
// The implementation recursively splits the word in half: if the high half is
// non-zero the first non-zero byte lies there, otherwise it lies in the low
// half (offset by the half-width in bytes).
fn main() {
    var word:u64 = data[0]
    var expected:u8 = data[1] as u8
    //
    if (first_nonzero_byte64(word) as u8) != expected {
        fail
    }
    // native variant
    if (first_nonzero_byte64_native(word) as u8) != expected {
        fail
    }
    return
}

fn first_nonzero_byte64(word:u64) -> (res:u3) {
    var hi:u32
    var lo:u32
    hi::lo = word
    if hi != 0 {
        res = first_nonzero_byte32(hi) as u3
    } else {
        var tmp:u2 = first_nonzero_byte32(lo)
        res = (tmp as u3) + 4
    }
    return
}

fn first_nonzero_byte32(word:u32) -> (res:u2) {
    var hi:u16
    var lo:u16
    hi::lo = word
    if hi != 0 {
        res = first_nonzero_byte16(hi) as u2
    } else {
        var tmp:u1 = first_nonzero_byte16(lo)
        res = (tmp as u2) + 2
    }
    return
}

fn first_nonzero_byte16(word:u16) -> (res:u1) {
    var hi:u8
    var lo:u8
    hi::lo = word
    if hi != 0 {
        res = 0
    } else {
        res = 1
    }
    return
}

// Find the index (from the most significant byte) of the first non-zero byte
// using a native loop over the bytes rather than recursive decomposition.
fn first_nonzero_byte64_native(word:u64) -> (res:u3) {
    var b:u8
    var shift:u6
    var found:u1
    res = 7
    found = 0
    for i:u4 = 0; i<8; i = i + 1 {
        shift = (7 - (i as u6)) * 8
        b = ((word >> shift) & 0xff) as u8
        if b != 0 {
            if found == 0 {
                res = i as u3
                found = 1
            }
        }
    }
    return
}
