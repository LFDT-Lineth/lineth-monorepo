pub input data(address:u16) -> (val:u64)

// Set the nth most-significant byte of a u64 word to a given value, leaving all
// other bytes untouched (n==0 sets the most significant byte), and check the
// result against the expected value.  This is a ZkC port of the assembly
// utility test asm/util/set_byte (ported from u256 down to u64).
//
// The implementation recursively splits the word in half, recurses into the
// half containing the target byte, and recombines via `::`.
fn main() {
    var word:u64 = data[0]
    var n:u3 = data[1] as u3
    var value:u8 = data[2] as u8
    var expected:u64 = data[3]
    //
    if set_byte64(word, n, value) != expected {
        fail
    }
    // native variant
    if set_byte64_native(word, n, value) != expected {
        fail
    }
    return
}

fn set_byte64(word:u64, n:u3, value:u8) -> (res:u64) {
    var hi:u32
    var lo:u32
    hi::lo = word
    var b:u1
    var m:u2
    var v:u32
    b::m = n
    if b == 0 {
        v = set_byte32(hi, m, value)
        res = v::lo
    } else {
        v = set_byte32(lo, m, value)
        res = hi::v
    }
    return
}

fn set_byte32(word:u32, n:u2, value:u8) -> (res:u32) {
    var hi:u16
    var lo:u16
    hi::lo = word
    var b:u1
    var m:u1
    var v:u16
    b::m = n
    if b == 0 {
        v = set_byte16(hi, m, value)
        res = v::lo
    } else {
        v = set_byte16(lo, m, value)
        res = hi::v
    }
    return
}

fn set_byte16(word:u16, n:u1, value:u8) -> (res:u16) {
    var hi:u8
    var lo:u8
    hi::lo = word
    if n == 0 {
        res = value::lo
    } else {
        res = hi::value
    }
    return
}

// Set the nth most-significant byte of a u64 word using native bitwise
// operators rather than recursive decomposition: clear the target byte with a
// mask, then or in the shifted value.
fn set_byte64_native(word:u64, n:u3, value:u8) -> (res:u64) {
    var shift:u6 = (7 - (n as u6)) * 8
    var bytemask:u64 = (0xff as u64) << shift
    res = (word & ~bytemask) | ((value as u64) << shift)
    return
}
