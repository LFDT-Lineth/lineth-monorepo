pub input data(address:u16) -> (val:u64)

// Logically shift a u64 word left by n in [0,63] and check it against the
// expected value.  This is a ZkC port of the assembly utility test
// asm/util/bit_shl (ported from u256 down to u64).
//
// The implementation decomposes the shift amount bit-by-bit, starting from the
// most significant bit, conditionally shifting left by a power of two at each
// level.  A shift left by k discards the high k bits and moves the low (64-k)
// bits up via `lo::z` where `hi::lo = word` and z is a k-bit zero.
fn main() {
    var word:u64 = data[0]
    var n:u6 = data[1] as u6
    var expected:u64 = data[2]
    //
    var res:u64
    res = bit_shl64(word, n)
    //
    if res != expected {
        fail
    }
    // native variant
    var res_native:u64
    res_native = bit_shl64_native(word, n)
    if res_native != expected {
        fail
    }
    return
}

fn bit_shl64(word:u64, n:u6) -> (res:u64) {
    var b:u1
    var m:u5
    b::m = n
    if b == 0 {
        res = bit_shl64_u5(word, m)
    } else {
        // shift left by 32
        var hi:u32
        var lo:u32
        hi::lo = word
        var z:u32 = 0
        res = bit_shl64_u5(lo::z, m)
    }
    return
}

fn bit_shl64_u5(word:u64, n:u5) -> (res:u64) {
    var b:u1
    var m:u4
    b::m = n
    if b == 0 {
        res = bit_shl64_u4(word, m)
    } else {
        // shift left by 16
        var hi:u16
        var lo:u48
        hi::lo = word
        var z:u16 = 0
        res = bit_shl64_u4(lo::z, m)
    }
    return
}

fn bit_shl64_u4(word:u64, n:u4) -> (res:u64) {
    var b:u1
    var m:u3
    b::m = n
    if b == 0 {
        res = bit_shl64_u3(word, m)
    } else {
        // shift left by 8
        var hi:u8
        var lo:u56
        hi::lo = word
        var z:u8 = 0
        res = bit_shl64_u3(lo::z, m)
    }
    return
}

fn bit_shl64_u3(word:u64, n:u3) -> (res:u64) {
    var b:u1
    var m:u2
    b::m = n
    if b == 0 {
        res = bit_shl64_u2(word, m)
    } else {
        // shift left by 4
        var hi:u4
        var lo:u60
        hi::lo = word
        var z:u4 = 0
        res = bit_shl64_u2(lo::z, m)
    }
    return
}

fn bit_shl64_u2(word:u64, n:u2) -> (res:u64) {
    var b:u1
    var m:u1
    b::m = n
    if b == 0 {
        res = bit_shl64_u1(word, m)
    } else {
        // shift left by 2
        var hi:u2
        var lo:u62
        hi::lo = word
        var z:u2 = 0
        res = bit_shl64_u1(lo::z, m)
    }
    return
}

fn bit_shl64_u1(word:u64, n:u1) -> (res:u64) {
    if n == 0 {
        res = word
        return
    }
    // shift left by 1
    var hi:u1
    var lo:u63
    hi::lo = word
    var z:u1 = 0
    res = lo::z
    return
}

// Logically shift a u64 word left by n in [0,63] using the native shift
// operator rather than recursive decomposition.
fn bit_shl64_native(word:u64, n:u6) -> (res:u64) {
    res = word << n
    return
}
