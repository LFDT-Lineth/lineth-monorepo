pub input data(address:u16) -> (val:u64)

// Arithmetically shift a u64 word right by n in [0,63] and check it against the
// expected value.  This is a ZkC port of the assembly utility test
// asm/util/bit_sar (ported from u256 down to u64).
//
// The implementation decomposes the shift amount bit-by-bit, starting from the
// most significant bit, conditionally shifting right by a power of two at each
// level.  Unlike a logical shift, the vacated high k bits are filled with the
// sign bit (the most significant bit of the word): `sext::hi` where
// `hi::lo = word` and sext is a k-bit run of the sign.
fn main() {
    var word:u64 = data[0]
    var n:u6 = data[1] as u6
    var expected:u64 = data[2]
    //
    var res:u64
    res = bit_sar64(word, n)
    //
    if res != expected {
        fail
    }
    // native variant
    var res_native:u64
    res_native = bit_sar64_native(word, n)
    if res_native != expected {
        fail
    }
    return
}

fn bit_sar64(word:u64, n:u6) -> (res:u64) {
    var b:u1
    var m:u5
    b::m = n
    if b == 0 {
        res = bit_sar64_u5(word, m)
    } else {
        // arithmetic shift right by 32
        var hi:u32
        var lo:u32
        hi::lo = word
        var sign:u1
        var rest:u31
        sign::rest = hi
        var sext:u32 = (sign as u32) * 0xffffffff
        res = bit_sar64_u5(sext::hi, m)
    }
    return
}

fn bit_sar64_u5(word:u64, n:u5) -> (res:u64) {
    var b:u1
    var m:u4
    b::m = n
    if b == 0 {
        res = bit_sar64_u4(word, m)
    } else {
        // arithmetic shift right by 16
        var hi:u48
        var lo:u16
        hi::lo = word
        var sign:u1
        var rest:u47
        sign::rest = hi
        var sext:u16 = (sign as u16) * 0xffff
        res = bit_sar64_u4(sext::hi, m)
    }
    return
}

fn bit_sar64_u4(word:u64, n:u4) -> (res:u64) {
    var b:u1
    var m:u3
    b::m = n
    if b == 0 {
        res = bit_sar64_u3(word, m)
    } else {
        // arithmetic shift right by 8
        var hi:u56
        var lo:u8
        hi::lo = word
        var sign:u1
        var rest:u55
        sign::rest = hi
        var sext:u8 = (sign as u8) * 0xff
        res = bit_sar64_u3(sext::hi, m)
    }
    return
}

fn bit_sar64_u3(word:u64, n:u3) -> (res:u64) {
    var b:u1
    var m:u2
    b::m = n
    if b == 0 {
        res = bit_sar64_u2(word, m)
    } else {
        // arithmetic shift right by 4
        var hi:u60
        var lo:u4
        hi::lo = word
        var sign:u1
        var rest:u59
        sign::rest = hi
        var sext:u4 = (sign as u4) * 0xf
        res = bit_sar64_u2(sext::hi, m)
    }
    return
}

fn bit_sar64_u2(word:u64, n:u2) -> (res:u64) {
    var b:u1
    var m:u1
    b::m = n
    if b == 0 {
        res = bit_sar64_u1(word, m)
    } else {
        // arithmetic shift right by 2
        var hi:u62
        var lo:u2
        hi::lo = word
        var sign:u1
        var rest:u61
        sign::rest = hi
        var sext:u2 = (sign as u2) * 0b11
        res = bit_sar64_u1(sext::hi, m)
    }
    return
}

fn bit_sar64_u1(word:u64, n:u1) -> (res:u64) {
    if n == 0 {
        res = word
        return
    }
    // arithmetic shift right by 1
    var hi:u63
    var lo:u1
    hi::lo = word
    var sign:u1
    var rest:u62
    sign::rest = hi
    res = sign::hi
    return
}

// Arithmetically shift a u64 word right by n in [0,63] using native operators
// rather than recursive decomposition: a logical shift, with the vacated high
// bits filled with the sign bit when it is set.
fn bit_sar64_native(word:u64, n:u6) -> (res:u64) {
    var sign:u1 = (word >> 63) as u1
    var logical:u64 = word >> n
    var allones:u64 = 0xffffffffffffffff
    var mask:u64 = ~(allones >> n)
    if sign == 0 {
        res = logical
    } else {
        res = logical | mask
    }
    return
}
