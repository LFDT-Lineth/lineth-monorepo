pub input data(address:u16) -> (val:u64)

// Replace all bytes in [start, end) of a u64 word with a given value, where
// offset==0 represents the most significant byte, and check the result against
// the expected value.  This is a ZkC port of the assembly utility test
// asm/util/fill_bytes (ported from u256 down to u64).
//
// The implementation walks from start towards end, setting one byte per step
// via set_byte64 (inlined below) and recursing.
fn main() {
    var word:u64 = data[0]
    var start:u4 = data[1] as u4
    var end:u4 = data[2] as u4
    var value:u8 = data[3] as u8
    var expected:u64 = data[4]
    //
    if fill_bytes_between(word, start, end, value) != expected {
        fail
    }
    // native variant
    if fill_bytes_native(word, start, end, value) != expected {
        fail
    }
    return
}

fn fill_bytes_between(word:u64, start:u4, end:u4, value:u8) -> (res:u64) {
    // check termination
    if start == end {
        res = word
        return
    }
    // split offset: s == 1 indicates start has run past the last byte
    var s:u1
    var offset:u3
    s::offset = start
    if s == 1 {
        res = word
        return
    }
    // set given byte and recurse
    var nword:u64 = set_byte64(word, offset, value)
    res = fill_bytes_between(nword, (offset as u4) + 1, end, value)
    return
}

// ---- set_byte (see set_byte.zkc) --------------------------------------------

fn set_byte64(word:u64, n:u3, value:u8) -> (res:u64) {
    var hi:u32
    var lo:u32
    hi::lo = word
    var b:u1
    var m:u2
    var v:u32
    b::m = n
    if b == 0 {
        v = set_byte32(hi, m, value)
        res = v::lo
    } else {
        v = set_byte32(lo, m, value)
        res = hi::v
    }
    return
}

fn set_byte32(word:u32, n:u2, value:u8) -> (res:u32) {
    var hi:u16
    var lo:u16
    hi::lo = word
    var b:u1
    var m:u1
    var v:u16
    b::m = n
    if b == 0 {
        v = set_byte16(hi, m, value)
        res = v::lo
    } else {
        v = set_byte16(lo, m, value)
        res = hi::v
    }
    return
}

fn set_byte16(word:u16, n:u1, value:u8) -> (res:u16) {
    var hi:u8
    var lo:u8
    hi::lo = word
    if n == 0 {
        res = value::lo
    } else {
        res = hi::value
    }
    return
}

// Replace all bytes in [start, end) of a u64 word with a given value using
// native bitwise operators rather than recursive decomposition: build a mask
// covering the byte range and blend the repeated value into it.
fn fill_bytes_native(word:u64, start:u4, end:u4, value:u8) -> (res:u64) {
    if start >= end {
        res = word
        return
    }
    var width:u7 = ((end - start) as u7) * 8
    var lo:u7 = (8 - (end as u7)) * 8
    var allones:u64 = 0xffffffffffffffff
    var mask:u64 = (allones >> ((64 - width) as u6)) << (lo as u6)
    var pattern:u64 = (value as u64) * 0x0101010101010101
    res = (word & ~mask) | (pattern & mask)
    return
}
