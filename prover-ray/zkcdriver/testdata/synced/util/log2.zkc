pub input data(address:u16) -> (val:u64)

// Compute floor(log2(word)) for a non-zero u64 word and check it against the
// expected value.  This is a ZkC port of the assembly utility test
// asm/util/log2 (ported from u256 down to u64).
//
// The implementation recursively splits the word in half: if the high half is
// non-zero the result lies there (offset by the half-width), otherwise it lies
// in the low half.
fn main() {
    var word:u64 = data[0]
    var expected:u8 = data[1] as u8
    //
    if (log2_u64(word) as u8) != expected {
        fail
    }
    // native variant
    if (log2_native(word) as u8) != expected {
        fail
    }
    return
}

fn log2_u64(arg:u64) -> (res:u6) {
    var hi:u32
    var lo:u32
    hi::lo = arg
    var tmp:u5
    if hi == 0 {
        tmp = log2_u32(lo)
        res = tmp as u6
    } else {
        tmp = log2_u32(hi)
        res = (tmp as u6) + 32
    }
    return
}

fn log2_u32(arg:u32) -> (res:u5) {
    var hi:u16
    var lo:u16
    hi::lo = arg
    var tmp:u4
    if hi == 0 {
        tmp = log2_u16(lo)
        res = tmp as u5
    } else {
        tmp = log2_u16(hi)
        res = (tmp as u5) + 16
    }
    return
}

fn log2_u16(arg:u16) -> (res:u4) {
    var hi:u8
    var lo:u8
    hi::lo = arg
    var tmp:u3
    if hi == 0 {
        tmp = log2_u8(lo)
        res = tmp as u4
    } else {
        tmp = log2_u8(hi)
        res = (tmp as u4) + 8
    }
    return
}

fn log2_u8(arg:u8) -> (res:u3) {
    var hi:u4
    var lo:u4
    hi::lo = arg
    var tmp:u2
    if hi == 0 {
        tmp = log2_u4(lo)
        res = tmp as u3
    } else {
        tmp = log2_u4(hi)
        res = (tmp as u3) + 4
    }
    return
}

fn log2_u4(arg:u4) -> (res:u2) {
    var hi:u2
    var lo:u2
    hi::lo = arg
    var tmp:u1
    if hi == 0 {
        tmp = log2_u2(lo)
        res = tmp as u2
    } else {
        tmp = log2_u2(hi)
        res = (tmp as u2) + 2
    }
    return
}

fn log2_u2(arg:u2) -> (res:u1) {
    var hi:u1
    var lo:u1
    hi::lo = arg
    if hi == 0 {
        res = 0
    } else {
        res = 1
    }
    return
}

// Compute floor(log2(word)) for a non-zero u64 word using a native loop over
// the bits rather than recursive decomposition.
fn log2_native(arg:u64) -> (res:u6) {
    var bit:u1
    res = 0
    for i:u7 = 0; i<64; i = i + 1 {
        bit = ((arg >> (i as u6)) & 1) as u1
        if bit == 1 {
            res = i as u6
        }
    }
    return
}
