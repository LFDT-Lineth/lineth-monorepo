include "../../../arithmetization/src/main/lib/nonnative/u128.zkc"

type tAddr = u8

pub input in_base(address:tAddr) -> (val:u128)
pub input in_exp(address:tAddr) -> (val:u128)
pub input in_mod(address:tAddr) -> (val:u128)
pub input in_res(address:tAddr) -> (val:u128)

fn main() {
    var base:u128 = in_base[0]
    var exp:u128 = in_exp[0]
    var mod:u128 = in_mod[0]
    var expected:u128 = in_res[0]
    var res:u128 = modexp_recursion(base, exp, mod)
    if res != in_res[0] {
        fail
    }
}

// recursive modexp seems to be better than the loop
fn modexp_recursion(base:u128, exp:u128, mod:u128) -> (res:u128) {
    if exp == 0 {
        res = 1 % mod
    } else {
        var half:u128
        var bit:u1
        half::bit = exp as u129
        var half_res:u128 = modexp_recursion(base, half, mod)
        var sq:u128 = mulmod_128(half_res, half_res, mod)
        if bit == 1 {
            res = mulmod_128(sq, base, mod)
        } else {
            res = sq
        }
    }
}

fn modexp_loop(base:u128, exp:u128, mod:u128) -> (res:u128) {
    var acc:u128 = base
    var e:u128 = exp
    var half:u128
    var bit:u1
    res = 1 % mod
    while e != 0 {
        half::bit = e as u129
        if bit == 1 {
            res = mulmod_128(res, acc, mod)
        }
        acc = mulmod_128(acc, acc, mod)
        e = half
    }
}