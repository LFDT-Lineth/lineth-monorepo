include "./nonnative_utils.zkc"

type tWidthOf    = u257
type tAddr       = u8

pub input in_base(address:tAddr) -> (val:tWidth)
pub input in_exp(address:tAddr) -> (val:tWidth)
pub input in_mod(address:tAddr) -> (val:tWidth)
pub input in_res(address:tAddr) -> (val:tWidth)

fn main() {
    var base:tWidth = in_base[0]
    var exp:tWidth = in_exp[0]
    var mod:tWidth = in_mod[0]
    var expected:tWidth = in_res[0]
    var res:tWidth = modexp_recursion(base, exp, mod)
    if res != in_res[0] {
        fail
    }
    //var res_loop:tWidth = modexp_loop(base, exp, mod)
    //if res_loop != in_res[0] {
    //    fail
    //}
}

fn modexp_recursion(base:tWidth, exp:tWidth, mod:tWidth) -> (res:tWidth) {
    if exp == 0 {
        res = 1 % mod
    } else {
        var half:tWidth
        var bit:u1
        half::bit = exp as tWidthOf
        var half_res:tWidth = modexp_recursion(base, half, mod)
        var sq:tWidth = mulmod_256(half_res, half_res, mod)
        if bit == 1 {
            res = mulmod_256(sq, base, mod)
        } else {
            res = sq
        }
    }
}

fn modexp_loop(base:tWidth, exp:tWidth, mod:tWidth) -> (res:tWidth) {
    var acc:tWidth = base
    var e:tWidth = exp
    var half:tWidth
    var bit:u1
    res = 1 % mod
    while e != 0 {
        half::bit = e as tWidthOf
        if bit == 1 {
            res = mulmod_256(res, acc, mod)
        }
        acc = mulmod_256(acc, acc, mod)
        e = half
    }
}