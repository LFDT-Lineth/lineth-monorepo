// Single-case driver for ecrecover.accepts.
//
// The test fixture inlines comments for every test case. To run the tests, run
// the `TestSecp256k1Ecrecover` test in native_modules_test.go.
//
// Manually using zkc directly, run:
//
//   # ACCEPTS — every line must exit 0
//   i=0; grep '^{' ecrecover.accepts | while IFS= read -r line; do
//   printf '%s\n' "$line" > /tmp/case.json
//   if go tool zkc exec -c /tmp/case.json ecrecover_run.zkc >/dev/null 2>&1; then
//     echo "accept[$i] ok"
//   else
//     echo "accept[$i] FAIL"
//   fi
//   i=$((i+1))
//   done

include "../../../arithmetization/src/main/lib/secp256k1/ecrecover.zkc"

pub input in_msg(address:u1) -> (val:u256)
pub input in_r(address:u1) -> (val:u256)
pub input in_s(address:u1) -> (val:u256)
pub input in_v(address:u1) -> (val:u8)
pub input in_pkx(address:u1) -> (val:u256)
pub input in_pky(address:u1) -> (val:u256)
pub input in_success(address:u1) -> (val:u8)

fn main() {
    var v:u5 = in_v[0] as u5
    var pkx:u256, pky:u256, ok:u1
    pkx, pky, ok = ecrecover_generic(in_msg[0], in_r[0], in_s[0], v)

    // ecrecover_generic is total: valid inputs give (pubkey, isSuccess=1);
    // invalid/degenerate inputs give ((0,0), isSuccess=0). Every case must match
    // its expected (pkx, pky, isSuccess) triple — this driver only fails on a
    // mismatch, never because ecrecover soft-failed.
    var exp_ok:u1 = in_success[0] as u1
    if (pkx != in_pkx[0]) || (pky != in_pky[0]) || (ok != exp_ok) {
        fail
    }
}
