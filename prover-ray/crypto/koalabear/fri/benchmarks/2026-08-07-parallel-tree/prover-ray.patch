+// hashTreeLevel computes one complete level of internal nodes. Children belong
+// to already-computed lower levels, so writes within [levelStart,
+// levelStart+levelSize) are independent. If leaves is non-empty, it contains
+// exactly one auxiliary leaf per node at this level.
+func hashTreeLevel(
+	nodes []field.Octuplet,
+	aux []*field.Octuplet,
+	leaves []field.Octuplet,
+	levelStart, levelSize int,
+) {
+	if levelSize <= 0 || levelStart != levelSize-1 {
+		panic("fri: hashTreeLevel: invalid level geometry")
+	}
+	if len(leaves) != 0 && len(leaves) != levelSize {
+		panic("fri: hashTreeLevel: invalid auxiliary leaf count")
+	}
+	lastNode := levelStart + levelSize - 1
+	if lastNode >= len(aux) || 2*lastNode+2 >= len(nodes) {
+		panic("fri: hashTreeLevel: level exceeds tree bounds")
+	}
+
+	hashRange := func(start, end int) {
+		for j := start; j < end; j++ {
+			k := levelStart + j
+			if len(leaves) != 0 {
+				aux[k] = &leaves[j]
+			}
+			nodes[k] = hashNode(nodes[2*k+1], nodes[2*k+2], aux[k])
+		}
+	}
+
+	if levelSize < minParallelTreeLevel {
+		hashRange(0, levelSize)
+		return
+	}
+	parallel.Execute(levelSize, hashRange)
+}
