+func sampledLeafIndices(n int) []int {
+	if n == 1 {
+		return nil
+	}
+	indices := []int{0, n / 2, n - 1}
+	if n <= 32 {
+		indices = make([]int, n)
+		for i := range indices {
+			indices[i] = i
+		}
+	}
+	return indices
