.{
    .name = .l2_execution_guest,
    .version = "0.0.0",
    .fingerprint = 0x16d3d5ae145fe30c,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .zesu = .{
            .url = "https://github.com/Consensys-Incorporated/zesu/archive/2835883c929407ff7252f7f70924436833d767c7.tar.gz",
            .hash = "zesu-0.1.0-UtqpADrkRgCDa2Q8oghvNCEGFguQic--Rv8uGWFjwqp2",
        },
        // Shared build helpers.
        .build_common = .{ .path = "../build_common" },
        // Lineth zkVM accelerator wrappers.
        .lineth_accelerators = .{ .path = "../lineth_accelerators" },
        .zlob = .{
            .url = "https://github.com/dmtrKovalenko/zlob/archive/refs/tags/v1.6.5.tar.gz",
            .hash = "zlob-1.6.5-zzE2lWoNCQCFLMTpuNAhGEPVNsyTbftabd_2_A6fEHob",
            .lazy = true,
        },
        // Generic riscv-guests utilities (sibling path dependency): the SSZ codec the guest input
        // and output are encoded with, and the l2-execution proof wire contract.
        .guest_common = .{ .path = "../guest_common" },
        // A generic SSZ serialize/deserialize library over plain Zig structs, targeting the same
        // Zig version this package pins. The guest's codec reaches it through guest_common; the
        // test-side vanilla StatelessInput encoder serializes with it directly. Pinned to the
        // v0.0.11 tag.
        .ssz = .{
            .url = "https://github.com/blockblaz/ssz.zig/archive/refs/tags/v0.0.11.tar.gz",
            .hash = "ssz-0.0.9-Lfwd68m_AwAFGpz2g1kHvokWjp_UsvqDb3Z2D46w5s_-",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src", // production guest code (compiled into the rv64im object/ELF)
        "test", // host-only: unit tests, spec-test harness, fixture parsing
        "tools", // host-only: native runners and wrappers
    },
}
