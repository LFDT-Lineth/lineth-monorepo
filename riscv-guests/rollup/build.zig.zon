.{
    .name = .rollup_guest,
    .version = "0.0.0",
    .fingerprint = 0x9e91b56136b3846b,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Shared build helpers for all riscv-guests packages (sibling path dependency).
        .build_common = .{ .path = "../build_common" },
        // Lineth zkVM accelerator wrappers (sibling path dependency): only `write_output` (the
        // zkvm-standards io-interface custom opcode) is used — this guest runs no EVM and needs no
        // other precompile accelerator.
        .lineth_accelerators = .{ .path = "../lineth-accelerators" },
        // Generic riscv-guests utilities (sibling path dependency): the SSZ decode/encode
        // primitives `rollup_ssz.zig`'s container codec builds on.
        .guest_common = .{ .path = "../guest-common" },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src", // production guest code (compiled into the rv64im object/ELF)
        "test", // host-only: unit tests and committed sample input
    },
}
