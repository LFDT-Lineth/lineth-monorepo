.{
    .name = .lineth_da,
    .version = "0.0.0",
    .fingerprint = 0xbe4e7bdc63102eff,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Shared build helpers (pinned toolchain, the common freestanding rv64im guest target, the
        // standalone-ELF link).
        .build_common = .{ .path = "../build_common" },
        // zkVM io-interface (read_input/write_output) for the smoke guests, and, opt-in through
        // -Dzkvm-provide, the zkvm_* crypto providers the package's sha256, keccak256 and KZG
        // point evaluation resolve to.
        .lineth_accelerators = .{ .path = "../lineth_accelerators" },
        // Block and transaction decoding, sender recovery and the crypto accelerator interface of
        // the truncation and the blob verification.
        .zesu = .{
            .url = "https://github.com/Consensys-Incorporated/zesu/archive/2835883c929407ff7252f7f70924436833d767c7.tar.gz",
            .hash = "zesu-0.1.0-UtqpADrkRgCDa2Q8oghvNCEGFguQic--Rv8uGWFjwqp2",
        },
        // facebook/zstd v1.5.6, the unmodified upstream release tarball (sha256
        // 8c29e06cf42aacc1eafc4077ae2ec6c6fcb96a626157e0593d5e82a34fd403c1). Source-only package:
        // build.zig selects the decoder sources for guest and host builds and the compressor
        // sources for host tests and tools.
        .zstd = .{
            .url = "https://github.com/facebook/zstd/releases/download/v1.5.6/zstd-1.5.6.tar.gz",
            .hash = "N-V-__8AAKbffQDMlwdeMxqHyyAcA6AYoVIjJdaqhEYZpGFG",
        },
        // ethereum/c-kzg-4844 v2.1.5: the official EIP-4844 reference vectors (tests/ directory)
        // the blob verification tests and the blob_sample tool read, and the C library that
        // computes the commitments and proofs of the native tests and tools. Host builds only.
        .c_kzg_4844 = .{
            .url = "https://github.com/ethereum/c-kzg-4844/archive/refs/tags/v2.1.5.tar.gz",
            .hash = "N-V-__8AALYXygU1iU8DU-qtzr7I31mr2vWOmfRVDNFAlTWj",
            .lazy = true,
        },
        // supranational/blst at the commit c-kzg-4844 v2.1.5 pins as its submodule: the BLS12-381
        // library under c-kzg-4844. Host builds only.
        .blst = .{
            .url = "https://github.com/supranational/blst/archive/6d960cd05d6fe2b5bc9ba161edf0c1a131b87c4c.tar.gz",
            .hash = "N-V-__8AAKDMOgDp0ule4-ieF6xoW2euEGpOwOyBPo-KRj_a",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src", // production code (compiled into the rv64im object/ELF) and the freestanding C headers
        "dictionaries", // zstd dictionaries embedded by the guests
        "test", // unit tests and test support (host), and the rv64im smoke guests
        "tools", // host-only: native programs
    },
}
