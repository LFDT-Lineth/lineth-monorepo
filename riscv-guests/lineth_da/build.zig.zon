.{
    .name = .lineth_da,
    .version = "0.0.0",
    .fingerprint = 0xbe4e7bdc63102eff,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Shared build helpers (pinned toolchain, the common freestanding rv64im guest target, the
        // native test wiring).
        .build_common = .{ .path = "../build_common" },
        // The accelerator calls the package makes (sha256, keccak256, blob verification) and, through
        // -Dzkvm-provide, the zkvm_* crypto providers they resolve to in the native tests.
        .lineth_accelerators = .{ .path = "../lineth_accelerators" },
        // The SSZ list views of the chunk witness.
        .guest_common = .{ .path = "../guest_common" },
        // Block and transaction decoding, sender recovery and the trie of the truncation.
        .zesu = .{
            .url = "https://github.com/Consensys-Incorporated/zesu/archive/2835883c929407ff7252f7f70924436833d767c7.tar.gz",
            .hash = "zesu-0.1.0-UtqpADrkRgCDa2Q8oghvNCEGFguQic--Rv8uGWFjwqp2",
        },
        // facebook/zstd v1.5.6, the unmodified upstream release tarball (sha256
        // 8c29e06cf42aacc1eafc4077ae2ec6c6fcb96a626157e0593d5e82a34fd403c1). Source-only package:
        // build.zig selects the decoder sources for guest and host builds and the compressor
        // sources for native builds.
        .zstd = .{
            .url = "https://github.com/facebook/zstd/releases/download/v1.5.6/zstd-1.5.6.tar.gz",
            .hash = "N-V-__8AAKbffQDMlwdeMxqHyyAcA6AYoVIjJdaqhEYZpGFG",
        },
        // ethereum/c-kzg-4844 v2.1.5, for the official EIP-4844 reference vectors (its tests/
        // directory) that the blob verification tests read. Host builds only.
        .c_kzg_4844 = .{
            .url = "https://github.com/ethereum/c-kzg-4844/archive/refs/tags/v2.1.5.tar.gz",
            .hash = "N-V-__8AALYXygU1iU8DU-qtzr7I31mr2vWOmfRVDNFAlTWj",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src", // production code (compiled into the rv64im object/ELF) and the freestanding C headers
        "dictionaries", // zstd dictionaries embedded by the guests
        "test", // unit tests and test support (host)
    },
}
