.{
    .name = .lineth_accelerators,
    .version = "0.0.0",
    .fingerprint = 0xbb46af775b3e4be3,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Shared build helpers (pinned toolchain + the common freestanding rv64im guest target).
        .build_common = .{ .path = "../build_common" },
        // Fetched for -Dzkvm-provide: the zesu crypto backend and the Constantine archive that the
        // zkvm_* providers are built from.
        .zesu = .{
            .url = "https://github.com/Consensys-Incorporated/zesu/archive/2835883c929407ff7252f7f70924436833d767c7.tar.gz",
            .hash = "zesu-0.1.0-UtqpADrkRgCDa2Q8oghvNCEGFguQic--Rv8uGWFjwqp2",
            .lazy = true,
        },
        .guest_crypto_ctt = .{ .path = "../guest_crypto_ctt", .lazy = true },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src", // Zig wrapper modules (compiled into the rv64im guest)
        "include", // C interface headers for guest programs
    },
}
