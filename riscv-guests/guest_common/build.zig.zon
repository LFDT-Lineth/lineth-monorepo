.{
    .name = .guest_common,
    .version = "0.0.0",
    .fingerprint = 0xff235abbe665c79f,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Shared build helpers (pinned toolchain + the common freestanding rv64im guest target).
        .build_common = .{ .path = "../build_common" },
        // The accelerator calls the shared code hashes through and, for the native tests, the
        // zkvm_* providers they resolve to.
        .lineth_accelerators = .{ .path = "../lineth_accelerators" },
        // A generic SSZ serialize/deserialize library over plain Zig structs; pinned to the v0.0.11 tag.
        .ssz = .{
            .url = "https://github.com/blockblaz/ssz.zig/archive/refs/tags/v0.0.11.tar.gz",
            .hash = "ssz-0.0.9-Lfwd68m_AwAFGpz2g1kHvokWjp_UsvqDb3Z2D46w5s_-",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src", // Generic Zig primitives (compiled into any consumer's rv64im guest or native tests)
        "test", // host-only: unit tests for the exposed primitives
    },
}
