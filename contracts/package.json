{
  "name": "contracts",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=12.17.0"
  },
  "scripts": {
    "build": "hardhat build",
    "test": "pnpm run autoupdate && hardhat test",
    "test:reportgas": "hardhat test --gas-stats",
    "coverage": "pnpm run autoupdate && SOLIDITY_COVERAGE=true hardhat test --coverage",
    "autoupdate": "cd ../prover && cmd/dev-tools/testcase-gen/compression-aggregation/autoupdate.sh && cd ../contracts",
    "prettier:sol": "prettier -c '**/*.sol'",
    "prettier:sol:fix": "prettier -w '**/*.sol'",
    "lint:sol": "solhint -f stylish 'src/**/*.sol'",
    "lint:sol:fix": "solhint --fix --noPrompt -f stylish 'src/**/*.sol'",
    "lint:ts": "eslint '**/*.{js,ts}'",
    "lint:ts:fix": "eslint --fix '**/*.{js,ts}'",
    "lint": "pnpm run lint:sol && pnpm run lint:ts && pnpm run prettier:sol",
    "lint:fix": "pnpm run lint:sol:fix && pnpm run lint:ts:fix && pnpm run prettier:sol:fix",
    "validate:address-registry": "tsx scripts/deployment/validateAddressRegistry.ts",
    "validate:deploy-scripts": "tsx scripts/deployment/validateDeployScripts.ts",
    "clean": "rimraf .openzeppelin build cache node_modules coverage",
    "clean:validations": "rimraf cache/validations.json && hardhat build --force",
    "solidity:docgen": "hardhat build && tsx scripts/docgen.ts"
  },
  "devDependencies": {
    "@chainlink/contracts": "1.5.0",
    "@chainsafe/blst": "2.2.0",
    "@chainsafe/persistent-merkle-tree": "1.3.1",
    "@ethereumjs/util": "10.1.3",
    "@lfdt-lineth/eslint-config": "workspace:*",
    "@lidofinance/lsv-cli": "1.9.0",
    "@lodestar/types": "1.50.1",
    "@nomicfoundation/hardhat-ignition": "3.1.9",
    "@nomicfoundation/hardhat-ignition-viem": "3.1.6",
    "@nomicfoundation/hardhat-keystore": "3.1.2",
    "@nomicfoundation/hardhat-network-helpers": "3.0.12",
    "@nomicfoundation/hardhat-node-test-runner": "3.1.2",
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@nomicfoundation/hardhat-verify": "3.1.4",
    "@nomicfoundation/hardhat-viem": "3.1.0",
    "@nomicfoundation/hardhat-viem-assertions": "3.1.5",
    "@nomicfoundation/ignition-core": "3.1.11",
    "@openzeppelin/contracts": "4.9.6",
    "@openzeppelin/contracts-upgradeable": "4.9.6",
    "@openzeppelin/hardhat-upgrades": "4.1.0",
    "@types/chai": "5.2.3",
    "@types/node": "24.19.2",
    "@types/yargs": "catalog:",
    "c-kzg": "4.1.0",
    "chai": "6.3.0",
    "colors": "1.4.0",
    "csv-parser": "3.2.1",
    "diff": "8.0.4",
    "dotenv": "catalog:",
    "ethers": "6.17.0",
    "forge-std": "github:foundry-rs/forge-std#1eea5bae12ae557d589f9f0f0edae2faa47cb262",
    "hardhat": "3.21.2",
    "hardhat-ignore-warnings": "0.3.0",
    "node-gyp": "12.4.0",
    "prettier": "catalog:",
    "prettier-plugin-solidity": "2.2.1",
    "solady": "0.1.26",
    "solhint": "6.2.5",
    "solidity-docgen": "0.6.0-beta.36",
    "tsx": "catalog:",
    "viem": "catalog:",
    "yargs": "catalog:"
  }
}
